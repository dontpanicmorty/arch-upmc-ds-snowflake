CREATE OR REPLACE PROCEDURE EDI_MAPPING.SPU_LOAD_ECOBA_CLAIMS()
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS 
$$

var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];

try
{
//Get Starting Formnbr_key
var get_incremental_start = "SELECT max(FORMNBR_KEY) from STAGING.ECOBA_FORMNBR where ECOBA_CLAIM_NBR is not null";
var get_incremental_start_snowflake = snowflake.createStatement(
    {
        sqlText: get_incremental_start
    }
);
    var res_get_incremental_start = get_incremental_start_snowflake.execute();
    res_get_incremental_start.next();

    var first_incremental_value_used = res_get_incremental_start.getColumnValue(1);


//DROP AND CREATE TEMP TABLE
    var drop_temp_table = "DROP TABLE IF EXISTS STAGING.ECOBA_CLAIMS_TEMP";
    var drop_temp_table_snowflake = snowflake.createStatement(
    {
        sqlText: drop_temp_table
    }
);
    var res_drop_temp_table = drop_temp_table_snowflake.execute();

