,CLAIM_DETAIL_DATE
)
(
select 'ECOBA' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CHE.HDR_PATIENTCONTROLNBR, '-', ''), '.', ''), '/', ''), ',', ''), '+', ''), ' ', '') 
|| Case when (CFE.FILE_CLAIM_TYPE = 'P') then 'E' else CFE.FILE_CLAIM_TYPE End 
|| case when (CDE.DETAIL_SERVICE_DATE is not null) then CDE.DETAIL_SERVICE_DATE when (CHE.HDR_DT is not null) then CHE.HDR_DT else '' end 
|| case when CDE.PROCEDURE_CODE is not null then LTRIM(RTRIM(CDE.PROCEDURE_CODE)) else '' end 
|| case when CDE.PROCEDURE_MODIFIER2 is not null then LTRIM(RTRIM(CDE.PROCEDURE_MODIFIER2)) else '' end 
|| case when CDE.PROCEDURE_MODIFIER3 is not null then LTRIM(RTRIM(CDE.PROCEDURE_MODIFIER3)) else '' end 
|| case when CDE.PROCEDURE_MODIFIER4 is not null then LTRIM(RTRIM(CDE.PROCEDURE_MODIFIER4)) else '' end 
|| CAST(CFE.FILE_KEY as varchar) 
|| CAST(CHE.CLAIM_KEY as varchar)
|| '00' as ECOBA_CLAIM_NBR
