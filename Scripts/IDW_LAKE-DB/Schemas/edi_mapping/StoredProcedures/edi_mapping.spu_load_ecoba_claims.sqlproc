from STAGING.ECOBA_CLAIMS_TEMP Temp join STAGING.ECOBA_FORMNBR fn on Temp.ECOBA_CLAIM_NBR = fn.ecoba_claim_nbr
where (Temp.MC400_DUPLICATE ='Y' and not exists 
(select 1 
from DATA_LOAD.ECOBA_DUPLICATE_AUDIT EDA 
where EDA.ECOBA_CLAIM_NBR = Temp.ECOBA_CLAIM_NBR and EDA.DETAIL_SEQ_NO = Temp.DETAIL_SEQ_NO));
`;

    var insert_duplicate_audit_data_snowflake = snowflake.createStatement(
    {
        sqlText: insert_duplicate_audit_data
    }
);
    var res_insert_duplicate_audit_data = insert_duplicate_audit_data_snowflake.execute();

var endTime = new Date().toISOString();
var result = "Succeeded";

    //log results to table
var sqlLogCommand = `
INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
    (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT)
    VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6);`;
    
    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds: 
            [
            procedureName
            ,"Procedure"
            ,startTime
            ,endTime
            ,result
            ,procedureName
            ]
        }
    );
}
catch (err)
{
    var endTime = new Date().toISOString();
    var result = "Failed";
    
    //log results to table
    var sqlLogCommand = `
        INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
            (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;
    
    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds: 
            [
            procedureName
            ,"Procedure"
            ,startTime
            ,endTime
            ,result
            ,procedureName
            ,err.code
            ,err.state
            ,err.message
            ,err.stackTraceTxt
            ]
        }
    );        
    return result;
}
return result;

    
$$;