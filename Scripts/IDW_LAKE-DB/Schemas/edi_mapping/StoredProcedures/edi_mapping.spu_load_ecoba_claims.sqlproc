ELSE NULL END as CLAIM_DETAIL_DATE

FROM EDI_MAPPING.CLAIM_HEADER_ECOBA CHE INNER JOIN EDI_MAPPING.CLAIM_FILE_ECOBA CFE ON CFE.FILE_KEY = CHE.FILE_KEY 
LEFT JOIN EDI_MAPPING.CLAIM_DETAIL_ECOBA CDE ON (CDE.CLAIM_KEY = CHE.CLAIM_KEY AND CDE.FILE_KEY = CHE.FILE_KEY)
);`;


    var insert_temp_data_snowflake = snowflake.createStatement(
    {
        sqlText: insert_temp_data
    }
);
    var res_insert_temp_data = insert_temp_data_snowflake.execute();


//Update the formnbr table    
var update_query = "update STAGING.ECOBA_FORMNBR fn SET fn.ECOBA_CLAIM_NBR = sd.ECOBA_CLAIM_NBR from (select ECOBA_CLAIM_NBR, ROW_NUMBER() over (order by ECOBA_CLAIM_NBR asc) "
update_query += "+ "+first_incremental_value_used+" as UpdateFormKey from STAGING.ECOBA_CLAIMS_TEMP t where ECOBA_CLAIM_NBR not in (select ecoba_claim_nbr from STAGING.ECOBA_FORMNBR where ecoba_claim_nbr is not null) group by t.ECOBA_CLAIM_NBR) sd where fn.Formnbr_key = sd.UpdateFormKey and fn.ECOBA_CLAIM_NBR is null;";

var update_query_snowflake = snowflake.createStatement(
           {
           sqlText: update_query
           }
        );
            var res_update_query = update_query_snowflake.execute();




    var drop_STG_table = "TRUNCATE TABLE IF EXISTS DATA_LOAD.ECOBA_CLAIMS_STG";
    var drop_STG_table_snowflake = snowflake.createStatement(
    {
        sqlText: drop_STG_table
    }
);
    var res_drop_STG_table = drop_STG_table_snowflake.execute();

//POPULATE ECOBA_CLAIMS_STG
let insert_STG_data = `INSERT INTO DATA_LOAD.ECOBA_CLAIMS_STG (CLAIM_NBR, PROCEDURE_ADJ, CLAIM_SEQUENCE, CLAIM_HEADER_DATE, ECOBA_CLAIM_NBR
