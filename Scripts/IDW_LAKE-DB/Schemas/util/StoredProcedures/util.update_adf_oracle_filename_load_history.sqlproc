CREATE OR REPLACE PROCEDURE UTIL.UPDATE_ADF_ORACLE_FILENAME_LOAD_HISTORY(FILENAME VARCHAR)
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
AS
$$
try {
    var sql_command = "INSERT INTO LOGDATA.ADF_ORACLE_FILENAME_LOAD_HISTORY VALUES(?, CURRENT_TIMESTAMP())";
    var statement = snowflake.createStatement({sqlText: sql_command, binds: [FILENAME]});
    statement.execute()
    return "Row Inserted Successfully"
}
catch (err) {
    return "Error occured: " + err;
}
$$;