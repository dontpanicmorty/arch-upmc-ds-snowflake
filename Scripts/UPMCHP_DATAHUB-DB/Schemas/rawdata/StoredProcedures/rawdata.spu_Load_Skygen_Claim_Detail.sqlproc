CREATE OR REPLACE PROCEDURE RAWDATA.SPU_LOAD_SKYGEN_CLAIM_DETAIL(JOB_ID VARCHAR)
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `RAWDATA.DWSKYGEN_CLAIM_DETAIL`

// Create temp table statement to be executed.
var sqlTempTableCommand =
`
CREATE OR REPLACE TEMPORARY TABLE RAWDATA.DWSKYGEN_CLAIM_DETAIL_TMP
AS
SELECT * FROM RAWDATA.DWSKYGEN_CLAIM_DETAIL_SELECT_VW
;`;

// Create merge statement to be executed.
var sqlMergeCommand =
`
MERGE INTO RAWDATA.DWSKYGEN_CLAIM_DETAIL AS tgt
USING (
        SELECT CLAIM_NBR
		,CLAIM_LINE_NBR
		,CLAIM_LINE_SEQ_NBR
		,PROCEDURE_ADJ_CODE
		,ADMIT_DATE
		,PROCEDURE_CODE
		,PROCEDURE_MODIFIER_01
		,SERVICE_BEGIN_DATE
		,SERVICE_END_DATE
		,ADJUSTMENT_REASON_CODE_01
		,ALLOWED_AMOUNT
		,BENEFIT_LEVEL_CODE
		,BENEFIT_LEVEL_DESC
		,BILLED_AMOUNT
		,CHECK_DATE
		,CHECK_NBR
		,CLAIM_RECEIVED_DATE
		,DEDUCTIBLE_AMOUNT
		,MEMBER_NBR
		,SUBSCRIBER_NBR
		,PAID_AMOUNT
		,NOT_COVERED_AMOUNT
		,PAY_STATUS
		,PAY_STATUS_DESC
		,PLACE_OF_SERVICE_CODE
		,PLACE_OF_SERVICE_TYPE
		,LOCATION_TYPE_CODE
		,PROCEDURE_QTY
		,RENDERING_PROVIDER_ID
		,TOOTH_SURFACE_CODE_LIST
		,TOOTH_ID
		,TOOTH_QUADRANT
		,TOOTH_ARCH
		,COINSURANCE_AMOUNT
		,CLEAN_CLAIM_IND
		,BENEFIT_CATEGORY_CODE
		,COPAY_AMOUNT
		,AP_POSTING_DATE
		,DENIAL_REASON_CODE_LIST
		,AUTH_ID
		,AUTH_NBR
		,AUTH_ITEM_NBR
		,THIRD_PARTY_PAID_AMOUNT
		,MEMBER_PAY_FLAG
		,PROCEDURE_DESC
		,MEMBER_AGE
        FROM RAWDATA.DWSKYGEN_CLAIM_DETAIL_TMP
    MINUS
		SELECT CLAIM_NBR
		,CLAIM_LINE_NBR
		,CLAIM_LINE_SEQ_NBR
		,PROCEDURE_ADJ_CODE
		,ADMIT_DATE
		,PROCEDURE_CODE
		,PROCEDURE_MODIFIER_01
		,SERVICE_BEGIN_DATE
		,SERVICE_END_DATE
		,ADJUSTMENT_REASON_CODE_01
		,ALLOWED_AMOUNT
		,BENEFIT_LEVEL_CODE
		,BENEFIT_LEVEL_DESC
		,BILLED_AMOUNT
		,CHECK_DATE
		,CHECK_NBR
		,CLAIM_RECEIVED_DATE
		,DEDUCTIBLE_AMOUNT
		,MEMBER_NBR
		,SUBSCRIBER_NBR
		,PAID_AMOUNT
		,NOT_COVERED_AMOUNT
		,PAY_STATUS
		,PAY_STATUS_DESC
		,PLACE_OF_SERVICE_CODE
		,PLACE_OF_SERVICE_TYPE
		,LOCATION_TYPE_CODE
		,PROCEDURE_QTY
		,RENDERING_PROVIDER_ID
		,TOOTH_SURFACE_CODE_LIST
		,TOOTH_ID
		,TOOTH_QUADRANT
		,TOOTH_ARCH
		,COINSURANCE_AMOUNT
		,CLEAN_CLAIM_IND
		,BENEFIT_CATEGORY_CODE
		,COPAY_AMOUNT
		,AP_POSTING_DATE
		,DENIAL_REASON_CODE_LIST
		,AUTH_ID
		,AUTH_NBR
		,AUTH_ITEM_NBR
		,THIRD_PARTY_PAID_AMOUNT
		,MEMBER_PAY_FLAG
		,PROCEDURE_DESC
		,MEMBER_AGE
        FROM RAWDATA.DWSKYGEN_CLAIM_DETAIL
    ) AS src /*returns everything in the source that is not a match in the target*/
ON (tgt.CLAIM_NBR = src.CLAIM_NBR
    AND tgt.CLAIM_LINE_NBR = src.CLAIM_LINE_NBR
	AND tgt.CLAIM_LINE_SEQ_NBR = src.CLAIM_LINE_SEQ_NBR
    AND tgt.PROCEDURE_ADJ_CODE = src.PROCEDURE_ADJ_CODE) /*key columns to determine if this is a new record or an udpate*/

WHEN NOT MATCHED
THEN INSERT
    (
		DWSKYGEN_CLAIM_DETAIL_KEY
		,INSERT_DATETIME
		,LAST_UPDATED_DATETIME
		,CLAIM_NBR
		,CLAIM_LINE_NBR
		,CLAIM_LINE_SEQ_NBR
		,PROCEDURE_ADJ_CODE
		,ADMIT_DATE
		,PROCEDURE_CODE
		,PROCEDURE_MODIFIER_01
		,SERVICE_BEGIN_DATE
		,SERVICE_END_DATE
		,ADJUSTMENT_REASON_CODE_01
		,ALLOWED_AMOUNT
		,BENEFIT_LEVEL_CODE
		,BENEFIT_LEVEL_DESC
		,BILLED_AMOUNT
		,CHECK_DATE
		,CHECK_NBR
		,CLAIM_RECEIVED_DATE
		,DEDUCTIBLE_AMOUNT
		,MEMBER_NBR
		,SUBSCRIBER_NBR
		,PAID_AMOUNT
		,NOT_COVERED_AMOUNT
		,PAY_STATUS
		,PAY_STATUS_DESC
		,PLACE_OF_SERVICE_CODE
		,PLACE_OF_SERVICE_TYPE
		,LOCATION_TYPE_CODE
		,PROCEDURE_QTY
		,RENDERING_PROVIDER_ID
		,TOOTH_SURFACE_CODE_LIST
		,TOOTH_ID
		,TOOTH_QUADRANT
		,TOOTH_ARCH
		,COINSURANCE_AMOUNT
		,CLEAN_CLAIM_IND
		,BENEFIT_CATEGORY_CODE
		,COPAY_AMOUNT
		,AP_POSTING_DATE
		,DENIAL_REASON_CODE_LIST
		,AUTH_ID
		,AUTH_NBR
		,AUTH_ITEM_NBR
		,THIRD_PARTY_PAID_AMOUNT
		,MEMBER_PAY_FLAG
		,PROCEDURE_DESC
		,MEMBER_AGE
    )
    VALUES
    (
        (SELECT IFNULL(MAX(DWSKYGEN_CLAIM_DETAIL_KEY), 1000) FROM RAWDATA.DWSKYGEN_CLAIM_DETAIL) + ROW_NUMBER() OVER (ORDER BY 1)
        ,CURRENT_TIMESTAMP()
        ,CURRENT_TIMESTAMP()
		,src.CLAIM_NBR
		,src.CLAIM_LINE_NBR
		,src.CLAIM_LINE_SEQ_NBR
		,src.PROCEDURE_ADJ_CODE
		,src.ADMIT_DATE
		,src.PROCEDURE_CODE
		,src.PROCEDURE_MODIFIER_01
		,src.SERVICE_BEGIN_DATE
		,src.SERVICE_END_DATE
		,src.ADJUSTMENT_REASON_CODE_01
		,src.ALLOWED_AMOUNT
		,src.BENEFIT_LEVEL_CODE
		,src.BENEFIT_LEVEL_DESC
		,src.BILLED_AMOUNT
		,src.CHECK_DATE
		,src.CHECK_NBR
		,src.CLAIM_RECEIVED_DATE
		,src.DEDUCTIBLE_AMOUNT
		,src.MEMBER_NBR
		,src.SUBSCRIBER_NBR
		,src.PAID_AMOUNT
		,src.NOT_COVERED_AMOUNT
		,src.PAY_STATUS
		,src.PAY_STATUS_DESC
		,src.PLACE_OF_SERVICE_CODE
		,src.PLACE_OF_SERVICE_TYPE
		,src.LOCATION_TYPE_CODE
		,src.PROCEDURE_QTY
		,src.RENDERING_PROVIDER_ID
		,src.TOOTH_SURFACE_CODE_LIST
		,src.TOOTH_ID
		,src.TOOTH_QUADRANT
		,src.TOOTH_ARCH
		,src.COINSURANCE_AMOUNT
		,src.CLEAN_CLAIM_IND
		,src.BENEFIT_CATEGORY_CODE
		,src.COPAY_AMOUNT
		,src.AP_POSTING_DATE
		,src.DENIAL_REASON_CODE_LIST
		,src.AUTH_ID
		,src.AUTH_NBR
		,src.AUTH_ITEM_NBR
		,src.THIRD_PARTY_PAID_AMOUNT
		,src.MEMBER_PAY_FLAG
		,src.PROCEDURE_DESC
		,src.MEMBER_AGE
    )

WHEN MATCHED
THEN UPDATE SET
		tgt.LAST_UPDATED_DATETIME = CURRENT_TIMESTAMP()
		,tgt.ADMIT_DATE = src.ADMIT_DATE
		,tgt.PROCEDURE_CODE = src.PROCEDURE_CODE
		,tgt.PROCEDURE_MODIFIER_01 = src.PROCEDURE_MODIFIER_01
		,tgt.SERVICE_BEGIN_DATE = src.SERVICE_BEGIN_DATE
		,tgt.SERVICE_END_DATE = src.SERVICE_END_DATE
		,tgt.ADJUSTMENT_REASON_CODE_01 = src.ADJUSTMENT_REASON_CODE_01
		,tgt.ALLOWED_AMOUNT = src.ALLOWED_AMOUNT
		,tgt.BENEFIT_LEVEL_CODE = src.BENEFIT_LEVEL_CODE
		,tgt.BENEFIT_LEVEL_DESC = src.BENEFIT_LEVEL_DESC
		,tgt.BILLED_AMOUNT = src.BILLED_AMOUNT
		,tgt.CHECK_DATE = src.CHECK_DATE
		,tgt.CHECK_NBR = src.CHECK_NBR
		,tgt.CLAIM_RECEIVED_DATE = src.CLAIM_RECEIVED_DATE
		,tgt.DEDUCTIBLE_AMOUNT = src.DEDUCTIBLE_AMOUNT
		,tgt.MEMBER_NBR = src.MEMBER_NBR
		,tgt.SUBSCRIBER_NBR = src.SUBSCRIBER_NBR
		,tgt.PAID_AMOUNT = src.PAID_AMOUNT
		,tgt.NOT_COVERED_AMOUNT = src.NOT_COVERED_AMOUNT
		,tgt.PAY_STATUS = src.PAY_STATUS
		,tgt.PAY_STATUS_DESC = src.PAY_STATUS_DESC
		,tgt.PLACE_OF_SERVICE_CODE = src.PLACE_OF_SERVICE_CODE
		,tgt.PLACE_OF_SERVICE_TYPE = src.PLACE_OF_SERVICE_TYPE
		,tgt.LOCATION_TYPE_CODE = src.LOCATION_TYPE_CODE
		,tgt.PROCEDURE_QTY = src.PROCEDURE_QTY
		,tgt.RENDERING_PROVIDER_ID = src.RENDERING_PROVIDER_ID
		,tgt.TOOTH_SURFACE_CODE_LIST = src.TOOTH_SURFACE_CODE_LIST
		,tgt.TOOTH_ID = src.TOOTH_ID
		,tgt.TOOTH_QUADRANT = src.TOOTH_QUADRANT
		,tgt.TOOTH_ARCH = src.TOOTH_ARCH
		,tgt.COINSURANCE_AMOUNT = src.COINSURANCE_AMOUNT
		,tgt.CLEAN_CLAIM_IND = src.CLEAN_CLAIM_IND
		,tgt.BENEFIT_CATEGORY_CODE = src.BENEFIT_CATEGORY_CODE
		,tgt.COPAY_AMOUNT = src.COPAY_AMOUNT
		,tgt.AP_POSTING_DATE = src.AP_POSTING_DATE
		,tgt.DENIAL_REASON_CODE_LIST = src.DENIAL_REASON_CODE_LIST
		,tgt.AUTH_ID = src.AUTH_ID
		,tgt.AUTH_NBR = src.AUTH_NBR
		,tgt.AUTH_ITEM_NBR = src.AUTH_ITEM_NBR
		,tgt.THIRD_PARTY_PAID_AMOUNT = src.THIRD_PARTY_PAID_AMOUNT
		,tgt.MEMBER_PAY_FLAG = src.MEMBER_PAY_FLAG
		,tgt.PROCEDURE_DESC = src.PROCEDURE_DESC
		,tgt.MEMBER_AGE = src.MEMBER_AGE
;`;

// set delete command which will update to is_logical_delete to true
var sqlDeleteCommand =
`
DELETE FROM RAWDATA.DWSKYGEN_CLAIM_DETAIL 
WHERE DWSKYGEN_CLAIM_DETAIL_KEY IN 
(
    SELECT DWSKYGEN_CLAIM_DETAIL.DWSKYGEN_CLAIM_DETAIL_KEY
    FROM RAWDATA.DWSKYGEN_CLAIM_DETAIL
        LEFT OUTER JOIN  RAWDATA.DWSKYGEN_CLAIM_DETAIL_TMP
            ON DWSKYGEN_CLAIM_DETAIL.CLAIM_NBR = DWSKYGEN_CLAIM_DETAIL_TMP.CLAIM_NBR
            AND DWSKYGEN_CLAIM_DETAIL.CLAIM_LINE_NBR = DWSKYGEN_CLAIM_DETAIL_TMP.CLAIM_LINE_NBR
			AND DWSKYGEN_CLAIM_DETAIL.CLAIM_LINE_SEQ_NBR = DWSKYGEN_CLAIM_DETAIL_TMP.CLAIM_LINE_SEQ_NBR
            AND DWSKYGEN_CLAIM_DETAIL.PROCEDURE_ADJ_CODE = DWSKYGEN_CLAIM_DETAIL_TMP.PROCEDURE_ADJ_CODE
	WHERE DWSKYGEN_CLAIM_DETAIL_TMP.CLAIM_NBR IS NULL
        AND DWSKYGEN_CLAIM_DETAIL_TMP.CLAIM_LINE_NBR IS NULL
		AND DWSKYGEN_CLAIM_DETAIL_TMP.CLAIM_LINE_SEQ_NBR IS NULL
        AND DWSKYGEN_CLAIM_DETAIL_TMP.PROCEDURE_ADJ_CODE IS NULL
);`;

try 
{
        //Stage source data to temp table to be reused later.
    var sfStatement = snowflake.createStatement({sqlText: sqlTempTableCommand});
    sfStatement.execute();
	
	//Execute Merge Command
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), result, sfStatement.getSqlText()]
        }
    );

    //Execute DELETE Command
    startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand});
    sfStatement.execute();
    endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsUpdated(), result, sfStatement.getSqlText()]
        }
    );
}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (JOB_ID, NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[JOB_ID, targetTableName, "TABLE", startTime, endTime, "Failed", sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt]
        }
    );        
    throw result;
}

//Validate what just loaded
sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_DUPE_CHECK('${JOB_ID}','${targetTableName}');`;
resultSet = snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK('${JOB_ID}','${targetTableName}');`;
resultSet = snowflake.execute({sqlText});

return result;
$$
;