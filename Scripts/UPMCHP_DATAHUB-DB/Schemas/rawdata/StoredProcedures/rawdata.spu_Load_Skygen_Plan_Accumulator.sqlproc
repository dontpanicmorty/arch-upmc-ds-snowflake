CREATE OR REPLACE PROCEDURE RAWDATA.SPU_LOAD_SKYGEN_PLAN_ACCUMULATOR(JOB_ID VARCHAR)
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `RAWDATA.DWSKYGEN_PLAN_ACCUMULATOR`

// Create temp table statement to be executed.
var sqlTempTableCommand =
`
CREATE OR REPLACE TEMPORARY TABLE RAWDATA.DWSKYGEN_PLAN_ACCUMULATOR_TMP
AS
SELECT * FROM RAWDATA.DWSKYGEN_PLAN_ACCUMULATOR_SELECT_VW
;`;

// Create merge statement to be executed.
var sqlMergeCommand =
`
MERGE INTO RAWDATA.DWSKYGEN_PLAN_ACCUMULATOR AS tgt
USING (
        SELECT  MEMBER_NBR,
	            TPA_CLIENT_ID,
	            TPA_ID,
	            TPA_DIV_ID,
	            DATA_SOURCE_NAME,
				CARE_TYPE_NAME,
				MEMBER_ACCUMULATOR_ID,
				MEMBER_ACCUMULATOR_DESC,
	            ACCUMULATOR_EFFECTIVE_START_DATE,
				ACCUMULATOR_EFFECTIVE_END_DATE,
	            PLAN_EFFECTIVE_START_DATE,
				PLAN_EFFECTIVE_END_DATE,
				BENEFIT_CODESET_NAME,
	            ACCUMULATOR_CATEGORY,
				CODESET_CLASSIFICATION_DESC,
				CODESET_CATEGORY_DESC,
	            BENEFIT_LEVEL_DESC,
	            GROUP_NBR,
	            GROUP_NAME,
	            SUB_GROUP_NBR,
	            PLAN_CODE,
	            PLAN_NAME,
	            PLAN_TYPE_CODE,
	            ENROLLEE_ID,
	            ELIGIBILITY_START_DATE,
	            ELIGIBILITY_END_DATE,
	            PRODUCT_ID,
	            CODESET_ID,
	            ACCUMULATOR_TYPE_CODE,
				ACCUMULATOR_TYPE_DESC,
				ACCUMULATOR_PERIOD_TYPE_DESC,
	            ACCUMULATOR_PERIOD_BENEFIT_LEVEL_CODE,
				ACCUMULATOR_PERIOD_BENEFIT_LEVEL_DESC,
				ACCUMULATOR_THRESHOLD_CODE,
				ACCUMULATOR_THRESHOLD_DESC,
	            SUBSCRIBER_TYPE_CODE,
				SUBSCRIBER_TYPE_DESC,
	            CODESET_CODE,
	            IN_NETWORK_FLAG,
	            CONSUMED_AMT,
	            THRESHOLD_AMT,
				ROLLOVER_MAX_AMT,
				COINSURANCE_FORMULA,
				DEDUCTIBLE_FORMULA,
				BENEFIT_MAX_FORMULA,
				OUT_OF_POCKET_FORMULA
        FROM RAWDATA.DWSKYGEN_PLAN_ACCUMULATOR_TMP
    MINUS
		SELECT   MEMBER_NBR
	            ,TPA_CLIENT_ID
	            ,TPA_ID
	            ,TPA_DIV_ID
	            ,DATA_SOURCE_NAME
				,CARE_TYPE_NAME
				,MEMBER_ACCUMULATOR_ID
				,MEMBER_ACCUMULATOR_DESC
	            ,ACCUMULATOR_EFFECTIVE_START_DATE
				,ACCUMULATOR_EFFECTIVE_END_DATE
	            ,PLAN_EFFECTIVE_START_DATE
				,PLAN_EFFECTIVE_END_DATE
	            ,BENEFIT_CODESET_NAME
	            ,ACCUMULATOR_CATEGORY
				,CODESET_CLASSIFICATION_DESC
				,CODESET_CATEGORY_DESC
	            ,BENEFIT_LEVEL_DESC
	            ,GROUP_NBR
	            ,GROUP_NAME
	            ,SUB_GROUP_NBR
	            ,PLAN_CODE
	            ,PLAN_NAME
	            ,PLAN_TYPE_CODE
	            ,ENROLLEE_ID
	            ,ELIGIBILITY_START_DATE
	            ,ELIGIBILITY_END_DATE
	            ,PRODUCT_ID
	            ,CODESET_ID
	            ,ACCUMULATOR_TYPE_CODE
				,ACCUMULATOR_TYPE_DESC
				,ACCUMULATOR_PERIOD_TYPE_DESC
	            ,ACCUMULATOR_PERIOD_BENEFIT_LEVEL_CODE
				,ACCUMULATOR_PERIOD_BENEFIT_LEVEL_DESC
				,ACCUMULATOR_THRESHOLD_CODE
				,ACCUMULATOR_THRESHOLD_DESC
	            ,SUBSCRIBER_TYPE_CODE
				,SUBSCRIBER_TYPE_DESC
	            ,CODESET_CODE
	            ,IN_NETWORK_FLAG
	            ,CONSUMED_AMT
	            ,THRESHOLD_AMT
				,ROLLOVER_MAX_AMT
				,COINSURANCE_FORMULA
				,DEDUCTIBLE_FORMULA
				,BENEFIT_MAX_FORMULA
				,OUT_OF_POCKET_FORMULA
        FROM RAWDATA.DWSKYGEN_PLAN_ACCUMULATOR
    ) AS src /*returns everything in the source that is not a match in the target*/
ON (tgt.TPA_CLIENT_ID = src.TPA_CLIENT_ID
AND tgt.TPA_ID = src.TPA_ID
AND tgt.TPA_DIV_ID = src.TPA_DIV_ID
AND tgt.DATA_SOURCE_NAME = src.DATA_SOURCE_NAME
AND tgt.CARE_TYPE_NAME = src.CARE_TYPE_NAME
AND tgt.PLAN_CODE = src.PLAN_CODE
AND tgt.ACCUMULATOR_TYPE_CODE = src.ACCUMULATOR_TYPE_CODE
AND tgt.ACCUMULATOR_PERIOD_BENEFIT_LEVEL_CODE = src.ACCUMULATOR_PERIOD_BENEFIT_LEVEL_CODE
AND tgt.SUBSCRIBER_TYPE_CODE = src.SUBSCRIBER_TYPE_CODE
AND tgt.CODESET_CODE = src.CODESET_CODE
AND tgt.IN_NETWORK_FLAG = src.IN_NETWORK_FLAG
AND tgt.GROUP_NBR = src.GROUP_NBR
AND tgt.SUB_GROUP_NBR = src.SUB_GROUP_NBR
AND tgt.ACCUMULATOR_THRESHOLD_CODE = src.ACCUMULATOR_THRESHOLD_CODE
AND tgt.ACCUMULATOR_EFFECTIVE_START_DATE = src.ACCUMULATOR_EFFECTIVE_START_DATE
AND tgt.MEMBER_NBR = src.MEMBER_NBR
) /*key columns to determine if this is a new record or an udpate*/

WHEN NOT MATCHED
THEN INSERT
    (
		DWSKYGEN_PLAN_ACCUMULATOR_KEY
		,INSERT_DATETIME
		,LAST_UPDATED_DATETIME
        ,MEMBER_NBR
	    ,TPA_CLIENT_ID
	    ,TPA_ID
	    ,TPA_DIV_ID
	    ,DATA_SOURCE_NAME
		,CARE_TYPE_NAME
		,MEMBER_ACCUMULATOR_ID
		,MEMBER_ACCUMULATOR_DESC
	    ,ACCUMULATOR_EFFECTIVE_START_DATE
		,ACCUMULATOR_EFFECTIVE_END_DATE
	    ,PLAN_EFFECTIVE_START_DATE
		,PLAN_EFFECTIVE_END_DATE
	    ,BENEFIT_CODESET_NAME
	    ,ACCUMULATOR_CATEGORY
		,CODESET_CLASSIFICATION_DESC
		,CODESET_CATEGORY_DESC
	    ,BENEFIT_LEVEL_DESC
	    ,GROUP_NBR
	    ,GROUP_NAME
	    ,SUB_GROUP_NBR
	    ,PLAN_CODE
	    ,PLAN_NAME
	    ,PLAN_TYPE_CODE
	    ,ENROLLEE_ID
	    ,ELIGIBILITY_START_DATE
	    ,ELIGIBILITY_END_DATE
	    ,PRODUCT_ID
	    ,CODESET_ID
	    ,ACCUMULATOR_TYPE_CODE
		,ACCUMULATOR_TYPE_DESC
		,ACCUMULATOR_PERIOD_TYPE_DESC
	    ,ACCUMULATOR_PERIOD_BENEFIT_LEVEL_CODE
		,ACCUMULATOR_PERIOD_BENEFIT_LEVEL_DESC
		,ACCUMULATOR_THRESHOLD_CODE
		,ACCUMULATOR_THRESHOLD_DESC
	    ,SUBSCRIBER_TYPE_CODE
		,SUBSCRIBER_TYPE_DESC
	    ,CODESET_CODE
	    ,IN_NETWORK_FLAG
	    ,CONSUMED_AMT
	    ,THRESHOLD_AMT
		,ROLLOVER_MAX_AMT
		,COINSURANCE_FORMULA
		,DEDUCTIBLE_FORMULA
		,BENEFIT_MAX_FORMULA
		,OUT_OF_POCKET_FORMULA
    )
    VALUES
    (
        (SELECT IFNULL(MAX(DWSKYGEN_PLAN_ACCUMULATOR_KEY), 1000) FROM RAWDATA.DWSKYGEN_PLAN_ACCUMULATOR) + ROW_NUMBER() OVER (ORDER BY 1)
        ,CURRENT_TIMESTAMP()
        ,CURRENT_TIMESTAMP()
		,src.MEMBER_NBR
	    ,src.TPA_CLIENT_ID
	    ,src.TPA_ID
	    ,src.TPA_DIV_ID
	    ,src.DATA_SOURCE_NAME
		,src.CARE_TYPE_NAME
		,src.MEMBER_ACCUMULATOR_ID
		,src.MEMBER_ACCUMULATOR_DESC
	    ,src.ACCUMULATOR_EFFECTIVE_START_DATE
		,src.ACCUMULATOR_EFFECTIVE_END_DATE
	    ,src.PLAN_EFFECTIVE_START_DATE
		,src.PLAN_EFFECTIVE_END_DATE
	    ,src.BENEFIT_CODESET_NAME
	    ,src.ACCUMULATOR_CATEGORY
		,src.CODESET_CLASSIFICATION_DESC
		,src.CODESET_CATEGORY_DESC
	    ,src.BENEFIT_LEVEL_DESC
	    ,src.GROUP_NBR
	    ,src.GROUP_NAME
	    ,src.SUB_GROUP_NBR
	    ,src.PLAN_CODE
	    ,src.PLAN_NAME
	    ,src.PLAN_TYPE_CODE
	    ,src.ENROLLEE_ID
	    ,src.ELIGIBILITY_START_DATE
	    ,src.ELIGIBILITY_END_DATE
	    ,src.PRODUCT_ID
	    ,src.CODESET_ID
	    ,src.ACCUMULATOR_TYPE_CODE
		,src.ACCUMULATOR_TYPE_DESC
		,src.ACCUMULATOR_PERIOD_TYPE_DESC
	    ,src.ACCUMULATOR_PERIOD_BENEFIT_LEVEL_CODE
		,src.ACCUMULATOR_PERIOD_BENEFIT_LEVEL_DESC
		,src.ACCUMULATOR_THRESHOLD_CODE
		,src.ACCUMULATOR_THRESHOLD_DESC
	    ,src.SUBSCRIBER_TYPE_CODE
		,src.SUBSCRIBER_TYPE_DESC
	    ,src.CODESET_CODE
	    ,src.IN_NETWORK_FLAG
		,src.CONSUMED_AMT
	    ,src.THRESHOLD_AMT
		,src.ROLLOVER_MAX_AMT
		,src.COINSURANCE_FORMULA
		,src.DEDUCTIBLE_FORMULA
		,src.BENEFIT_MAX_FORMULA
		,src.OUT_OF_POCKET_FORMULA
    )

WHEN MATCHED
THEN UPDATE SET
		
		tgt.LAST_UPDATED_DATETIME = CURRENT_TIMESTAMP()
		,tgt.MEMBER_ACCUMULATOR_ID = src.MEMBER_ACCUMULATOR_ID
		,tgt.MEMBER_ACCUMULATOR_DESC = src.MEMBER_ACCUMULATOR_DESC
	    ,tgt.ACCUMULATOR_EFFECTIVE_END_DATE = src.ACCUMULATOR_EFFECTIVE_END_DATE
		,tgt.PLAN_EFFECTIVE_START_DATE = src.PLAN_EFFECTIVE_START_DATE
		,tgt.PLAN_EFFECTIVE_END_DATE = src.PLAN_EFFECTIVE_END_DATE
	    ,tgt.BENEFIT_CODESET_NAME = src.BENEFIT_CODESET_NAME
		,tgt.CODESET_CLASSIFICATION_DESC = src.CODESET_CLASSIFICATION_DESC
		,tgt.CODESET_CATEGORY_DESC = src.CODESET_CATEGORY_DESC
	    ,tgt.BENEFIT_LEVEL_DESC = src.BENEFIT_LEVEL_DESC
	    ,tgt.GROUP_NAME = src.GROUP_NAME
	    ,tgt.PLAN_NAME = src.PLAN_NAME
	    ,tgt.PLAN_TYPE_CODE = src.PLAN_TYPE_CODE
	    ,tgt.ENROLLEE_ID = src.ENROLLEE_ID
	    ,tgt.ELIGIBILITY_END_DATE = src.ELIGIBILITY_END_DATE
	    ,tgt.PRODUCT_ID = src.PRODUCT_ID
	    ,tgt.CODESET_ID = src.CODESET_ID
		,tgt.ACCUMULATOR_TYPE_DESC = src.ACCUMULATOR_TYPE_DESC
		,tgt.ACCUMULATOR_PERIOD_TYPE_DESC = src.ACCUMULATOR_PERIOD_TYPE_DESC
		,tgt.ACCUMULATOR_PERIOD_BENEFIT_LEVEL_DESC = src.ACCUMULATOR_PERIOD_BENEFIT_LEVEL_DESC
		,tgt.ACCUMULATOR_THRESHOLD_DESC = src.ACCUMULATOR_THRESHOLD_DESC
		,tgt.SUBSCRIBER_TYPE_DESC = src.SUBSCRIBER_TYPE_DESC
	    ,tgt.CONSUMED_AMT = src.CONSUMED_AMT
	    ,tgt.THRESHOLD_AMT = src.THRESHOLD_AMT
		,tgt.ROLLOVER_MAX_AMT = src.ROLLOVER_MAX_AMT
		,tgt.COINSURANCE_FORMULA = src.COINSURANCE_FORMULA
		,tgt.DEDUCTIBLE_FORMULA = src.DEDUCTIBLE_FORMULA
		,tgt.BENEFIT_MAX_FORMULA = src.BENEFIT_MAX_FORMULA
		,tgt.OUT_OF_POCKET_FORMULA = src.OUT_OF_POCKET_FORMULA
;`;

// set delete command which will update to is_logical_delete to true
var sqlDeleteCommand =
`
DELETE FROM RAWDATA.DWSKYGEN_PLAN_ACCUMULATOR
WHERE DWSKYGEN_PLAN_ACCUMULATOR_KEY IN 
(
    SELECT DWSKYGEN_PLAN_ACCUMULATOR.DWSKYGEN_PLAN_ACCUMULATOR_KEY
    FROM RAWDATA.DWSKYGEN_PLAN_ACCUMULATOR
        LEFT OUTER JOIN RAWDATA.DWSKYGEN_PLAN_ACCUMULATOR_TMP
            ON (DWSKYGEN_PLAN_ACCUMULATOR.TPA_CLIENT_ID = DWSKYGEN_PLAN_ACCUMULATOR_TMP.TPA_CLIENT_ID
			AND DWSKYGEN_PLAN_ACCUMULATOR.TPA_ID = DWSKYGEN_PLAN_ACCUMULATOR_TMP.TPA_ID
			AND DWSKYGEN_PLAN_ACCUMULATOR.TPA_DIV_ID = DWSKYGEN_PLAN_ACCUMULATOR_TMP.TPA_DIV_ID
			AND DWSKYGEN_PLAN_ACCUMULATOR.DATA_SOURCE_NAME = DWSKYGEN_PLAN_ACCUMULATOR_TMP.DATA_SOURCE_NAME
			AND DWSKYGEN_PLAN_ACCUMULATOR.CARE_TYPE_NAME = DWSKYGEN_PLAN_ACCUMULATOR_TMP.CARE_TYPE_NAME
			AND DWSKYGEN_PLAN_ACCUMULATOR.PLAN_CODE = DWSKYGEN_PLAN_ACCUMULATOR_TMP.PLAN_CODE
			AND DWSKYGEN_PLAN_ACCUMULATOR.ACCUMULATOR_TYPE_CODE = DWSKYGEN_PLAN_ACCUMULATOR_TMP.ACCUMULATOR_TYPE_CODE
			AND DWSKYGEN_PLAN_ACCUMULATOR.ACCUMULATOR_PERIOD_BENEFIT_LEVEL_CODE = DWSKYGEN_PLAN_ACCUMULATOR_TMP.ACCUMULATOR_PERIOD_BENEFIT_LEVEL_CODE
			AND DWSKYGEN_PLAN_ACCUMULATOR.SUBSCRIBER_TYPE_CODE = DWSKYGEN_PLAN_ACCUMULATOR_TMP.SUBSCRIBER_TYPE_CODE
			AND DWSKYGEN_PLAN_ACCUMULATOR.CODESET_CODE = DWSKYGEN_PLAN_ACCUMULATOR_TMP.CODESET_CODE
			AND DWSKYGEN_PLAN_ACCUMULATOR.IN_NETWORK_FLAG = DWSKYGEN_PLAN_ACCUMULATOR_TMP.IN_NETWORK_FLAG
			AND DWSKYGEN_PLAN_ACCUMULATOR.GROUP_NBR = DWSKYGEN_PLAN_ACCUMULATOR_TMP.GROUP_NBR
			AND DWSKYGEN_PLAN_ACCUMULATOR.SUB_GROUP_NBR = DWSKYGEN_PLAN_ACCUMULATOR_TMP.SUB_GROUP_NBR
			AND DWSKYGEN_PLAN_ACCUMULATOR.ACCUMULATOR_THRESHOLD_CODE = DWSKYGEN_PLAN_ACCUMULATOR_TMP.ACCUMULATOR_THRESHOLD_CODE
			AND DWSKYGEN_PLAN_ACCUMULATOR.ACCUMULATOR_EFFECTIVE_START_DATE = DWSKYGEN_PLAN_ACCUMULATOR_TMP.ACCUMULATOR_EFFECTIVE_START_DATE
			AND DWSKYGEN_PLAN_ACCUMULATOR.MEMBER_NBR = DWSKYGEN_PLAN_ACCUMULATOR_TMP.MEMBER_NBR)
	        
	WHERE  DWSKYGEN_PLAN_ACCUMULATOR_TMP.ACCUMULATOR_TYPE_CODE IS NULL
)
;`;

try 
{
        //Stage source data to temp table to be reused later.
    var sfStatement = snowflake.createStatement({sqlText: sqlTempTableCommand});
    sfStatement.execute();
	
	//Execute Merge Command
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), result, sfStatement.getSqlText()]
        }
    );

    //Execute DELETE Command
    startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand});
    sfStatement.execute();
    endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsUpdated(), result, sfStatement.getSqlText()]
        }
    );
}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (JOB_ID, NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[JOB_ID, targetTableName, "TABLE", startTime, endTime, "Failed", sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt]
        }
    );        
    throw result;
}

//Validate what just loaded
sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_DUPE_CHECK('${JOB_ID}','${targetTableName}');`;
resultSet = snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK('${JOB_ID}','${targetTableName}');`;
resultSet = snowflake.execute({sqlText});

return result;
$$
;