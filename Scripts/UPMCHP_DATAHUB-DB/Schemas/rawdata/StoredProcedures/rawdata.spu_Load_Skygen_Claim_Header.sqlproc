CREATE OR REPLACE PROCEDURE RAWDATA.SPU_LOAD_SKYGEN_CLAIM_HEADER(JOB_ID VARCHAR)
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `RAWDATA.DWSKYGEN_CLAIM_HEADER`

// Create temp table statement to be executed.
var sqlTempTableCommand =
`
CREATE OR REPLACE TEMPORARY TABLE RAWDATA.DWSKYGEN_CLAIM_HEADER_TMP
AS
SELECT * FROM RAWDATA.DWSKYGEN_CLAIM_HEADER_SELECT_VW
;`;

// Create merge statement to be executed.
var sqlMergeCommand =
`
MERGE INTO RAWDATA.DWSKYGEN_CLAIM_HEADER AS tgt
USING (
		SELECT 
		CLAIM_NBR
		,ADMIT_DATE
		,CLAIM_ENTRY_DATE
		,SKYGEN_CLAIM_TYPE_CODE
		,MEMBER_NBR
		,MEMBER_GENDER_CODE
		,PARTICIPATING_PROVIDER_CODE
		,PLAN_CATEGORY
		,PREDETERMINATION_CLAIM_ID
		,BILLING_PROVIDER_NPI
		,BILLING_PROVIDER_TAX_ID
        ,NETWORK_ID
		,NETWORK_NAME
		,RECORD_SOURCE_ID
        ,BILLING_PROVIDER_ID
		,PROVIDER_OFFICE_ID
		,CLIENT_CLAIM_ID
		,ENCOUNTER_ID
		,COMPANY_CODE
		,CORP_ID
		,GROUP_NBR
		,SUB_GROUP_NBR
		,PLAN_TYPE_CODE
		,PLAN_CODE
		,RIDER_CODES
		,ORIGINAL_ENCOUNTER_ID
        FROM RAWDATA.DWSKYGEN_CLAIM_HEADER_TMP
    MINUS
		SELECT 
		CLAIM_NBR
		,ADMIT_DATE
		,CLAIM_ENTRY_DATE
		,SKYGEN_CLAIM_TYPE_CODE
		,MEMBER_NBR
		,MEMBER_GENDER_CODE
		,PARTICIPATING_PROVIDER_CODE
		,PLAN_CATEGORY
		,PREDETERMINATION_CLAIM_ID
		,BILLING_PROVIDER_NPI
		,BILLING_PROVIDER_TAX_ID
		,NETWORK_ID
		,NETWORK_NAME
		,RECORD_SOURCE_ID
		,BILLING_PROVIDER_ID
		,PROVIDER_OFFICE_ID
		,CLIENT_CLAIM_ID
		,ENCOUNTER_ID
		,COMPANY_CODE
		,CORP_ID
		,GROUP_NBR
		,SUB_GROUP_NBR
		,PLAN_TYPE_CODE
		,PLAN_CODE
		,RIDER_CODES
		,ORIGINAL_ENCOUNTER_ID
        FROM RAWDATA.DWSKYGEN_CLAIM_HEADER
    ) AS src /*returns everything in the source that is not a match in the target*/
ON (tgt.CLAIM_NBR = src.CLAIM_NBR) /*key columns to determine if this is a new record or an udpate*/

WHEN NOT MATCHED
THEN INSERT
    (
		DWSKYGEN_CLAIM_HEADER_KEY
		,INSERT_DATETIME
		,LAST_UPDATED_DATETIME
		,CLAIM_NBR
		,ADMIT_DATE
		,CLAIM_ENTRY_DATE
		,SKYGEN_CLAIM_TYPE_CODE
		,MEMBER_NBR
		,MEMBER_GENDER_CODE
		,PARTICIPATING_PROVIDER_CODE
		,PLAN_CATEGORY
		,PREDETERMINATION_CLAIM_ID
		,BILLING_PROVIDER_NPI
		,BILLING_PROVIDER_TAX_ID
		,NETWORK_ID
		,NETWORK_NAME
		,RECORD_SOURCE_ID
		,BILLING_PROVIDER_ID
		,PROVIDER_OFFICE_ID
		,CLIENT_CLAIM_ID
		,ENCOUNTER_ID
		,COMPANY_CODE
		,CORP_ID
		,GROUP_NBR
		,SUB_GROUP_NBR
		,PLAN_TYPE_CODE
		,PLAN_CODE
		,RIDER_CODES	
		,ORIGINAL_ENCOUNTER_ID			
    )
    VALUES
    (
        (SELECT IFNULL(MAX(DWSKYGEN_CLAIM_HEADER_KEY), 1000) FROM RAWDATA.DWSKYGEN_CLAIM_HEADER) + ROW_NUMBER() OVER (ORDER BY 1)
        ,CURRENT_TIMESTAMP()
        ,CURRENT_TIMESTAMP()
		,src.CLAIM_NBR
		,src.ADMIT_DATE
		,src.CLAIM_ENTRY_DATE
		,src.SKYGEN_CLAIM_TYPE_CODE
		,src.MEMBER_NBR
		,src.MEMBER_GENDER_CODE
		,src.PARTICIPATING_PROVIDER_CODE
		,src.PLAN_CATEGORY
		,src.PREDETERMINATION_CLAIM_ID
		,src.BILLING_PROVIDER_NPI
		,src.BILLING_PROVIDER_TAX_ID
		,src.NETWORK_ID
		,src.NETWORK_NAME
		,src.RECORD_SOURCE_ID
		,src.BILLING_PROVIDER_ID
		,src.PROVIDER_OFFICE_ID	
		,src.CLIENT_CLAIM_ID
		,src.ENCOUNTER_ID
		,src.COMPANY_CODE
		,src.CORP_ID
		,src.GROUP_NBR
		,src.SUB_GROUP_NBR
		,src.PLAN_TYPE_CODE
		,src.PLAN_CODE
		,src.RIDER_CODES	
		,src.ORIGINAL_ENCOUNTER_ID
    )

WHEN MATCHED
THEN UPDATE SET
		tgt.ADMIT_DATE = src.ADMIT_DATE
		,tgt.CLAIM_ENTRY_DATE = src.CLAIM_ENTRY_DATE
		,tgt.SKYGEN_CLAIM_TYPE_CODE = src.SKYGEN_CLAIM_TYPE_CODE
		,tgt.MEMBER_NBR = src.MEMBER_NBR
		,tgt.MEMBER_GENDER_CODE = src.MEMBER_GENDER_CODE
		,tgt.PARTICIPATING_PROVIDER_CODE = src.PARTICIPATING_PROVIDER_CODE
		,tgt.PLAN_CATEGORY = src.PLAN_CATEGORY
		,tgt.PREDETERMINATION_CLAIM_ID = src.PREDETERMINATION_CLAIM_ID
		,tgt.BILLING_PROVIDER_NPI = src.BILLING_PROVIDER_NPI
		,tgt.BILLING_PROVIDER_TAX_ID = src.BILLING_PROVIDER_TAX_ID
		,tgt.NETWORK_ID = src.NETWORK_ID
		,tgt.NETWORK_NAME = src.NETWORK_NAME
		,tgt.RECORD_SOURCE_ID = src.RECORD_SOURCE_ID
		,tgt.BILLING_PROVIDER_ID = src.BILLING_PROVIDER_ID
		,tgt.PROVIDER_OFFICE_ID = src.PROVIDER_OFFICE_ID
		,tgt.CLIENT_CLAIM_ID = src.CLIENT_CLAIM_ID
		,tgt.ENCOUNTER_ID = src.ENCOUNTER_ID
		,tgt.COMPANY_CODE = src.COMPANY_CODE
		,tgt.CORP_ID = src.CORP_ID
		,tgt.GROUP_NBR = src.GROUP_NBR
		,tgt.SUB_GROUP_NBR = src.SUB_GROUP_NBR
		,tgt.PLAN_TYPE_CODE = src.PLAN_TYPE_CODE
		,tgt.PLAN_CODE = src.PLAN_CODE
		,tgt.RIDER_CODES = src.RIDER_CODES
		,tgt.ORIGINAL_ENCOUNTER_ID = src.ORIGINAL_ENCOUNTER_ID
;`;

// set delete command which will update to is_logical_delete to true
var sqlDeleteCommand =
`
DELETE FROM RAWDATA.DWSKYGEN_CLAIM_HEADER 
WHERE DWSKYGEN_CLAIM_HEADER_KEY IN 
(
    SELECT DWSKYGEN_CLAIM_HEADER.DWSKYGEN_CLAIM_HEADER_KEY
    FROM RAWDATA.DWSKYGEN_CLAIM_HEADER
        LEFT OUTER JOIN  RAWDATA.DWSKYGEN_CLAIM_HEADER_TMP
            ON DWSKYGEN_CLAIM_HEADER.CLAIM_NBR = DWSKYGEN_CLAIM_HEADER_TMP.CLAIM_NBR
    WHERE DWSKYGEN_CLAIM_HEADER_TMP.CLAIM_NBR IS NULL
);`;

try 
{
	//Stage source data to temp table to be reused later.
    var sfStatement = snowflake.createStatement({sqlText: sqlTempTableCommand});
    sfStatement.execute();
    //Execute Merge Command
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), result, sfStatement.getSqlText()]
        }
    );

    //Execute DELETE Command
    startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand});
    sfStatement.execute();
    endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsUpdated(), result, sfStatement.getSqlText()]
        }
    );
}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (JOB_ID, NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[JOB_ID, targetTableName, "TABLE", startTime, endTime, "Failed", sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt]
        }
    );        
    throw result;
}

//Validate what just loaded
sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_DUPE_CHECK('${JOB_ID}','${targetTableName}');`;
resultSet = snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK('${JOB_ID}','${targetTableName}');`;
resultSet = snowflake.execute({sqlText});

return result;
$$
;