,COL4 VARCHAR
,COL5 VARCHAR
,COL6 VARCHAR
,COL7 VARCHAR
,COL8 VARIANT
,COL9 VARCHAR
)
AS
SELECT
NULL --Null at the front
,CURRENT_TIMESTAMP() --timestamp check
,.501 --number
,'text with a "double" quote and ''''single quote' --something with quotes
,'' --blank
,NULL --null next to blank
,NULL --side by side nulls
,['TEST1','TEST2','TEST3']
,NULL -- end null value
;

SELECT 
UTIL.FXN_ARRAY_HASH([COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9])
FROM UTIL.HASH_TEST;

DROP TABLE UTIL.HASH_TEST;

 */