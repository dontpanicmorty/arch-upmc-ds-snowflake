CREATE OR REPLACE PROCEDURE LOGDATA.SPU_VALIDATE_DATA_FOREIGN_KEY_CHECK_BULK(JOB_ID VARCHAR, SCHEMA VARCHAR)
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$

/*
Takes the input schema and generates a list of tables that need validated.
TODO: how do we exclude certain stuff (or things w/o any FK)
*/

// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var minusQuery = 'not set';
var fkName = 'not set';
var loadDatetime = null;

//JOB_ID must be generated first by the top level caller so we can tie together the outputs.
//Lookup Job
var sqlCommand = `SELECT START_TIME FROM LOGDATA.JOB_LOG WHERE JOB_ID = :1;`;
var sfStatement = snowflake.createStatement({sqlText: sqlCommand, binds: [JOB_ID]});     
var resultSet = sfStatement.execute();
while (resultSet.next())
{
    loadDatetime = resultSet.getColumnValue("START_TIME");
}

if (!loadDatetime)
    {
        var result = "Job Id:"+JOB_ID+" Not Found!";
        throw result;
    }


//get current database
sqlCommand = `SELECT current_database() AS DATABASE_NAME;`;
sfStatement = snowflake.createStatement({sqlText: sqlCommand});
resultSet = sfStatement.execute();
resultSet.next();
var databaseName = resultSet.getColumnValue("DATABASE_NAME");


//get the foreign keys we need to check first by using SHOW IMPORTED KEYS
sqlCommand = `SHOW IMPORTED KEYS IN SCHEMA `+databaseName+`.${SCHEMA};`;
sfStatement = snowflake.createStatement({sqlText: sqlCommand});
resultSet = sfStatement.execute();
var queryId = resultSet.getQueryId();

//grab what we need from the SHOW results and turn it into a query
sqlCommand = `SELECT "fk_name" as FK_NAME
, "fk_table_name" as FK_TABLE
,CASE
    WHEN NOT EXISTS (SELECT 1 FROM INFORMATION_SCHEMA.COLUMNS WHERE COLUMNS.TABLE_SCHEMA = FK_INFO."fk_schema_name" AND COLUMNS.TABLE_NAME = FK_INFO."fk_table_name" AND COLUMNS.COLUMN_NAME = 'IS_CURRENT_ROW_FLAG') THEN 'SELECT ' || "fk_table_name" ||'.' || "fk_column_name" || ' FROM ' || "fk_schema_name" ||'.' || "fk_table_name" || ' MINUS SELECT ' || "pk_table_name" || '.' || "pk_column_name" || ' FROM ' || "pk_schema_name" ||'.' || "pk_table_name"
    ELSE 'SELECT ' || "fk_table_name" ||'.' || "fk_column_name" || ' FROM ' || "fk_schema_name" ||'.' || "fk_table_name" || ' WHERE IS_CURRENT_ROW_FLAG = TRUE MINUS SELECT ' || "pk_table_name" || '.' || "pk_column_name" || ' FROM ' || "pk_schema_name" ||'.' || "pk_table_name" 
END as MINUS_QUERY
FROM TABLE(RESULT_SCAN('`+queryId+`')) AS FK_INFO`; //different logic for tables that do not have an IS_CURRENT_ROW_FLAG column (rare)
sfStatement = snowflake.createStatement({sqlText: sqlCommand});
resultSet = sfStatement.execute();

//need a loop here because some tables have multiple foreign keys
while(resultSet.next())
{
    minusQuery = resultSet.getColumnValue('MINUS_QUERY');
    fkName = resultSet.getColumnValue('FK_NAME');
    tableName = resultSet.getColumnValue('FK_TABLE');

    //build the query to check for orphan keys
    sqlCommand = `SELECT COUNT(*) AS RESULT_COUNT FROM (${minusQuery});`;

    sfStatement = snowflake.createStatement({sqlText: sqlCommand});
    var rsResultCount = sfStatement.execute();
    rsResultCount.next(); 
    var resultCount = rsResultCount.getColumnValue('RESULT_COUNT')
    
    //insert the results to the logdata table
    if(resultCount === 0)
    {
        var result = "Succeeded";
        var validationDescription = fkName+" passed foreign key check";
        var sqlLogCommand =
        `INSERT INTO LOGDATA.DATA_VALIDATION_RESULT 
            (JOB_ID, TABLE_NAME, VALIDATION_PROCEDURE_NAME, RESULT_TEXT, VALIDATION_RESULT_NBR, EXPECTED_RESULT_NBR, VALIDATION_DESC, SQL_STATEMENT) 
        VALUES 
            (:1, :2, :3, :4, :5, :6, :7, :8)
        ;`;

        snowflake.execute
        (
            {
            sqlText: sqlLogCommand,
            binds:[JOB_ID, tableName, procedureName, result, resultCount, 0, validationDescription, sfStatement.getSqlText()]
            }
        );
    }
    else
    {
        var result = "Failed";
        var validationDescription = fkName+" failed foreign key check";
        var sqlLogCommand =
        `INSERT INTO LOGDATA.DATA_VALIDATION_RESULT 
            (JOB_ID, TABLE_NAME, VALIDATION_PROCEDURE_NAME, RESULT_TEXT, VALIDATION_RESULT_NBR, EXPECTED_RESULT_NBR, VALIDATION_DESC, SQL_STATEMENT) 
        VALUES 
            (:1, :2, :3, :4, :5, :6, :7, :8)
        ;`;

        snowflake.execute
        (
            {
            sqlText: sqlLogCommand,
            binds:[JOB_ID, tableName, procedureName, result, resultCount, 0, validationDescription, sfStatement.getSqlText()]
            }
        );
    }
};

//Check to see if any of the FK checks failed
sqlCommand = 
`SELECT IFNULL(SUM(VALIDATION_RESULT_NBR) - SUM(EXPECTED_RESULT_NBR),0) AS ORPHAN_KEY_CNT 
FROM LOGDATA.DATA_VALIDATION_RESULT
WHERE JOB_ID = :1 AND VALIDATION_PROCEDURE_NAME = :2;`;
sfStatement = snowflake.createStatement({sqlText: sqlCommand, binds:[JOB_ID, procedureName]});
resultSet = sfStatement.execute();
resultSet.next();
var resultCount = resultSet.getColumnValue('ORPHAN_KEY_CNT');

if (resultCount === 0)
{
    var result = 'Succeeded';
}
else
{
    var result = 
    `Validation failed because of `+resultCount+` orphan keys for JobId: `+JOB_ID+`
    SELECT * FROM LOGDATA.DATA_VALIDATION_RESULT WHERE RESULT_TEXT = 'Failed' AND JOB_ID = '`+JOB_ID+`' AND VALIDATION_PROCEDURE_NAME = '`+procedureName+`';`;
    throw result;
};

return result;
$$
;