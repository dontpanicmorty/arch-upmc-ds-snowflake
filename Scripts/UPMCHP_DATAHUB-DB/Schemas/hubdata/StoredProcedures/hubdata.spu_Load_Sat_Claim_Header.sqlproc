CREATE OR REPLACE PROCEDURE HUBDATA.SPU_LOAD_SAT_CLAIM_HEADER(JOB_ID VARCHAR, SOURCE_VIEW_NAME VARCHAR) 
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var loadDatetime = null;
var procedureName = Object.keys(this)[0];
var targetTableName = `HUBDATA.SAT_CLAIM_HEADER`;

// Create temp table statement to be executed.
var sqlTempTableCommand =
`
CREATE OR REPLACE TEMPORARY TABLE STAGEDATA.SAT_CLAIM_HEADER_TMP
AS
SELECT * FROM ${SOURCE_VIEW_NAME}
;`;

// Create merge statement to be executed.
var sqlMergeCommand = 
`    
MERGE INTO HUBDATA.SAT_CLAIM_HEADER TGT
USING (
    SELECT     
        HUB_CLAIM_HKEY,
        HASH_DIFF,
        CLAIM_ENTRY_DATE,
        LINE_OF_BUSINESS_CODE,
        PLAN_CODE,
        PLAN_TYPE_CODE,
        BILLING_PROVIDER_PARTICIPATING_STATUS_CODE,
        ADMITTED_FLAG,
        ADMITTED_DATE,
        ADMITTED_HOUR,
        ADMISSION_SOURCE_CODE,
        ADMISSION_TYPE_CODE,
        DISCHARGE_DATE,
        DISCHARGE_HOUR,
        DISCHARGE_STATUS_CODE,
        BILLING_TYPE_CODE,
        CALCULATED_BILL_TOTAL_AMT,
        CARE_TYPE_NAME,
        DIVISION_NUMBER,
        ELECTRONIC_CLAIM_TYPE_CODE,
        ENCOUNTER_REASON_CODE,
        FORM_NUMBER,
        IS_PROCESSING_COMPLETE,
        MICROFILM_NBR,
        PLACE_OF_SERVICE_CODE,
        PRICING_ZIP_SOURCE,
        PATIENT_ACCOUNT_NUMBER,
        SHOCK_CLAIM_IND,
        SOURCE_LAST_UPDATED_DATETIME,
        IS_PREDETERMINATION_CLAIM_FLAG,
        ORIGINAL_CLAIM_ID,
        MULTISOURCE_CLAIM_IND,
        CLAIM_TYPE_CODE,
        IPA_CODE,
        BILLING_PROVIDER_VENDOR_NBR,
        SERVICE_ZIP_CODE,
        EDI_837_FACILITY_NPI_NBR,
        EDI_837_FACILITY_NAME,
        EDI_837_FACILITY_TELEPHONE_NBR,
        EDI_837_FACILITY_ADDRESS_LINE_1_TEXT,
        EDI_837_FACILITY_ADDRESS_LINE_2_TEXT,
        EDI_837_FACILITY_CITY_NAME,
        EDI_837_FACILITY_STATE_ABBREV_NAME,
        EDI_837_FACILITY_ZIP_CODE_NBR,
        EDI_837_FACILITY_OTHER_ID,
        SEVERITY_OF_ILLNESS,
        DIAGNOSIS_RELATED_GROUP_CODE,
        PROVIDER_SPECIALTY,
        PAID_STATUS_FOR_CMS
    FROM STAGEDATA.SAT_CLAIM_HEADER_TMP
) SRC  
ON (TGT.HUB_CLAIM_HKEY = SRC.HUB_CLAIM_HKEY
AND TGT.HASH_DIFF = SRC.HASH_DIFF
AND TGT.IS_CURRENT_ROW_FLAG = TRUE)  

WHEN NOT MATCHED 

THEN INSERT 
    (
        HUB_CLAIM_HKEY,
        ROW_EFFECTIVE_DATETIME,
        ROW_EXPIRATION_DATETIME,
        IS_CURRENT_ROW_FLAG,
        HASH_DIFF,
        CLAIM_ENTRY_DATE,
        LINE_OF_BUSINESS_CODE,
        PLAN_CODE,
        PLAN_TYPE_CODE,
        BILLING_PROVIDER_PARTICIPATING_STATUS_CODE,
        ADMITTED_FLAG,
        ADMITTED_DATE,
        ADMITTED_HOUR,
        ADMISSION_SOURCE_CODE,
        ADMISSION_TYPE_CODE,
        DISCHARGE_DATE,
        DISCHARGE_HOUR,
        DISCHARGE_STATUS_CODE,
        BILLING_TYPE_CODE,
        CALCULATED_BILL_TOTAL_AMT,
        CARE_TYPE_NAME,
        DIVISION_NUMBER,
        ELECTRONIC_CLAIM_TYPE_CODE,
        ENCOUNTER_REASON_CODE,
        FORM_NUMBER,
        IS_PROCESSING_COMPLETE,
        MICROFILM_NBR,
        PLACE_OF_SERVICE_CODE,
        PRICING_ZIP_SOURCE,
        PATIENT_ACCOUNT_NUMBER,
        SHOCK_CLAIM_IND,
        SOURCE_LAST_UPDATED_DATETIME,
        IS_PREDETERMINATION_CLAIM_FLAG,
        ORIGINAL_CLAIM_ID,
        MULTISOURCE_CLAIM_IND,
        CLAIM_TYPE_CODE,
        IPA_CODE,
        BILLING_PROVIDER_VENDOR_NBR,
        SERVICE_ZIP_CODE,
        EDI_837_FACILITY_NPI_NBR,
        EDI_837_FACILITY_NAME,
        EDI_837_FACILITY_TELEPHONE_NBR,
        EDI_837_FACILITY_ADDRESS_LINE_1_TEXT,
        EDI_837_FACILITY_ADDRESS_LINE_2_TEXT,
        EDI_837_FACILITY_CITY_NAME,
        EDI_837_FACILITY_STATE_ABBREV_NAME,
        EDI_837_FACILITY_ZIP_CODE_NBR,
        EDI_837_FACILITY_OTHER_ID,
        SEVERITY_OF_ILLNESS,
        DIAGNOSIS_RELATED_GROUP_CODE,
        PROVIDER_SPECIALTY,
        PAID_STATUS_FOR_CMS
    )
 VALUES 
    (
        SRC.HUB_CLAIM_HKEY,
        :1,
        TO_TIMESTAMP_TZ('9999-12-31'),
        TRUE,
        SRC.HASH_DIFF,
        SRC.CLAIM_ENTRY_DATE,
        SRC.LINE_OF_BUSINESS_CODE,
        SRC.PLAN_CODE,
        SRC.PLAN_TYPE_CODE,
        SRC.BILLING_PROVIDER_PARTICIPATING_STATUS_CODE,
        SRC.ADMITTED_FLAG,
        SRC.ADMITTED_DATE,
        SRC.ADMITTED_HOUR,
        SRC.ADMISSION_SOURCE_CODE,
        SRC.ADMISSION_TYPE_CODE,
        SRC.DISCHARGE_DATE,
        SRC.DISCHARGE_HOUR,
        SRC.DISCHARGE_STATUS_CODE,
        SRC.BILLING_TYPE_CODE,
        SRC.CALCULATED_BILL_TOTAL_AMT,
        SRC.CARE_TYPE_NAME,
        SRC.DIVISION_NUMBER,
        SRC.ELECTRONIC_CLAIM_TYPE_CODE,
        SRC.ENCOUNTER_REASON_CODE,
        SRC.FORM_NUMBER,
        SRC.IS_PROCESSING_COMPLETE,
        SRC.MICROFILM_NBR,
        SRC.PLACE_OF_SERVICE_CODE,
        SRC.PRICING_ZIP_SOURCE,
        SRC.PATIENT_ACCOUNT_NUMBER,
        SRC.SHOCK_CLAIM_IND,
        SRC.SOURCE_LAST_UPDATED_DATETIME,
        SRC.IS_PREDETERMINATION_CLAIM_FLAG,
        SRC.ORIGINAL_CLAIM_ID,
        SRC.MULTISOURCE_CLAIM_IND,
        SRC.CLAIM_TYPE_CODE,
        SRC.IPA_CODE,
        SRC.BILLING_PROVIDER_VENDOR_NBR,
        SRC.SERVICE_ZIP_CODE,
        SRC.EDI_837_FACILITY_NPI_NBR,
        SRC.EDI_837_FACILITY_NAME,
        SRC.EDI_837_FACILITY_TELEPHONE_NBR,
        SRC.EDI_837_FACILITY_ADDRESS_LINE_1_TEXT,
        SRC.EDI_837_FACILITY_ADDRESS_LINE_2_TEXT,
        SRC.EDI_837_FACILITY_CITY_NAME,
        SRC.EDI_837_FACILITY_STATE_ABBREV_NAME,
        SRC.EDI_837_FACILITY_ZIP_CODE_NBR,
        SRC.EDI_837_FACILITY_OTHER_ID,
        SRC.SEVERITY_OF_ILLNESS,
        SRC.DIAGNOSIS_RELATED_GROUP_CODE,
        SRC.PROVIDER_SPECIALTY,
        SRC.PAID_STATUS_FOR_CMS
    )
;`;
    
// Create update statement to be executed.
var sqlUpdateCommand=
`UPDATE HUBDATA.SAT_CLAIM_HEADER TGT
SET 
    ROW_EXPIRATION_DATETIME = DATEADD('millisecond', -1, :1)
    , IS_CURRENT_ROW_FLAG = FALSE
WHERE (HUB_CLAIM_HKEY, ROW_EFFECTIVE_DATETIME) IN
(
    SELECT HUB_CLAIM_HKEY, ROW_EFFECTIVE_DATETIME
    FROM (
        SELECT 
            SAT_CLAIM_HEADER.HUB_CLAIM_HKEY,
            SAT_CLAIM_HEADER.ROW_EFFECTIVE_DATETIME,
            ROW_NUMBER() OVER (PARTITION BY SAT_CLAIM_HEADER.HUB_CLAIM_HKEY ORDER BY SAT_CLAIM_HEADER.ROW_EFFECTIVE_DATETIME DESC) AS RNUM
        FROM HUBDATA.SAT_CLAIM_HEADER
            JOIN STAGEDATA.SAT_CLAIM_HEADER_TMP
                ON (SAT_CLAIM_HEADER_TMP.HUB_CLAIM_HKEY = SAT_CLAIM_HEADER.HUB_CLAIM_HKEY)
        WHERE SAT_CLAIM_HEADER.IS_CURRENT_ROW_FLAG = TRUE
        )
    WHERE RNUM >= 2
);`;

// Create delete statement to be executed.
var sqlDeleteCommand =
`UPDATE HUBDATA.SAT_CLAIM_HEADER
SET 
    ROW_EXPIRATION_DATETIME = :1
    ,IS_CURRENT_ROW_FLAG = FALSE
WHERE (HUB_CLAIM_HKEY, ROW_EFFECTIVE_DATETIME) IN
(
    SELECT
    SAT_CLAIM_HEADER.HUB_CLAIM_HKEY,
    SAT_CLAIM_HEADER.ROW_EFFECTIVE_DATETIME
    FROM HUBDATA.SAT_CLAIM_HEADER
        JOIN HUBDATA.HUB_CLAIM
            ON (HUB_CLAIM.HUB_CLAIM_HKEY = SAT_CLAIM_HEADER.HUB_CLAIM_HKEY)
        LEFT OUTER JOIN STAGEDATA.SAT_CLAIM_HEADER_TMP
            ON (SAT_CLAIM_HEADER_TMP.HUB_CLAIM_HKEY = SAT_CLAIM_HEADER.HUB_CLAIM_HKEY)
    WHERE HUB_CLAIM.DATA_SOURCE_NAME IN (SELECT DISTINCT DATA_SOURCE_NAME FROM STAGEDATA.SAT_CLAIM_HEADER_TMP)
    AND SAT_CLAIM_HEADER.IS_CURRENT_ROW_FLAG = TRUE
    AND SAT_CLAIM_HEADER_TMP.HUB_CLAIM_HKEY IS NULL
);`;

var sqlLogCommand = 
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11);`;

try 
{
     //Lookup Job
    var sqlCommand = `SELECT START_TIME FROM LOGDATA.JOB_LOG WHERE JOB_ID = :1;`;
    var sfStatement = snowflake.createStatement({sqlText: sqlCommand, binds: [JOB_ID]});     
    var rsJobLog = sfStatement.execute();
    while (rsJobLog.next())
    {
        loadDatetime = rsJobLog.getColumnValue("START_TIME")
    }
   
    if (!loadDatetime)
        {
            throw {
                code: "-1",
                message: "Job Id Not Found!",
                stackTraceTxt: new Error().stack,
                state: "00000"
            }
        }

    //Stage source data to temp table to be reused later.
    targetTableName = `STAGEDATA.SAT_CLAIM_HEADER_TMP`;
    startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlTempTableCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    //Execute Merge Command
    targetTableName = `HUBDATA.SAT_CLAIM_HEADER`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    // Execute the Update Command
    targetTableName = `HUBDATA.SAT_CLAIM_HEADER`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlUpdateCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    // Execute the Delete Command
    targetTableName = `HUBDATA.SAT_CLAIM_HEADER`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

}

catch (err)
{
    var endTime = new Date().toISOString();
    var result =  "Failed: Code: " + err.code + "\n  State: " + err.state;
    result += "\n  Message: " + err.message;
    result += "\nStack Trace:\n" + err.stackTraceTxt;

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (JOB_ID, NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
        VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11,:12);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[JOB_ID, targetTableName, "TABLE", startTime, endTime, "Failed", sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt, sfStatement.getQueryId()]
        }
    );        
    throw result;
}

//Validate what just loaded
sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_DUPE_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_ALLOWED_VALUE_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

return result;
$$
;
