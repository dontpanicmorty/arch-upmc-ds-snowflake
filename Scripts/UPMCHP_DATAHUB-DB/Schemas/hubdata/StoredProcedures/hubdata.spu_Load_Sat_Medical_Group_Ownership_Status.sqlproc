CREATE OR REPLACE PROCEDURE HUBDATA.SPU_LOAD_SAT_MEDICAL_GROUP_OWNERSHIP_STATUS(JOB_ID VARCHAR, SOURCE_VIEW_NAME VARCHAR) 
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var loadDatetime = null;
var procedureName = Object.keys(this)[0];
var targetTableName = `HUBDATA.SAT_MEDICAL_GROUP_OWNERSHIP_STATUS`; 

// Create temp table statement to be executed.
var sqlTempTableCommand =
`
CREATE OR REPLACE TEMPORARY TABLE STAGEDATA.SAT_MEDICAL_GROUP_OWNERSHIP_STATUS_TMP
AS
SELECT * FROM ${SOURCE_VIEW_NAME}
;`;

// Create merge statement to be executed.
var sqlMergeCommand =
`
MERGE INTO HUBDATA.SAT_MEDICAL_GROUP_OWNERSHIP_STATUS TGT
USING (
    SELECT
        HUB_MEDICAL_GROUP_HKEY,
        HASH_DIFF,        
        OWNERSHIP_NAME,
        UPMC_OWNERSHIP_IND,
        JOINT_OWNERSHIP_IND,
        NOT_OWNED_IND
    FROM STAGEDATA.SAT_MEDICAL_GROUP_OWNERSHIP_STATUS_TMP
) SRC 
ON (
    TGT.HUB_MEDICAL_GROUP_HKEY = SRC.HUB_MEDICAL_GROUP_HKEY
    AND TGT.HASH_DIFF = SRC.HASH_DIFF
    AND TGT.IS_CURRENT_ROW_FLAG = TRUE
)

WHEN NOT MATCHED 

THEN INSERT 
    (
        HUB_MEDICAL_GROUP_HKEY,
        HASH_DIFF,
        ROW_EFFECTIVE_DATETIME,
        ROW_EXPIRATION_DATETIME,
        IS_CURRENT_ROW_FLAG,        
        OWNERSHIP_NAME,
        UPMC_OWNERSHIP_IND,
        JOINT_OWNERSHIP_IND,
        NOT_OWNED_IND
    )
 VALUES 
    (
        SRC.HUB_MEDICAL_GROUP_HKEY,
        SRC.HASH_DIFF,
        :1,
        TO_TIMESTAMP_TZ('9999-12-31'),
        TRUE,        
        SRC.OWNERSHIP_NAME,
        SRC.UPMC_OWNERSHIP_IND,
        SRC.JOINT_OWNERSHIP_IND,
        SRC.NOT_OWNED_IND
    )
;`;
    
// Create update statement to be executed.
var sqlUpdateCommand =
`
UPDATE HUBDATA.SAT_MEDICAL_GROUP_OWNERSHIP_STATUS TGT
    SET ROW_EXPIRATION_DATETIME = DATEADD('millisecond', -1, CURRENT_TIMESTAMP()), IS_CURRENT_ROW_FLAG = FALSE
    WHERE (HUB_MEDICAL_GROUP_HKEY, ROW_EFFECTIVE_DATETIME) IN (
        SELECT
            HUB_MEDICAL_GROUP_HKEY,
            ROW_EFFECTIVE_DATETIME
        FROM (
            SELECT
                HUBDATA.HUB_MEDICAL_GROUP_HKEY,
                HUBDATA.ROW_EFFECTIVE_DATETIME,
                ROW_NUMBER() OVER (PARTITION BY HUBDATA.HUB_MEDICAL_GROUP_HKEY ORDER BY HUBDATA.ROW_EFFECTIVE_DATETIME DESC) AS RNUM
            FROM
                HUBDATA.SAT_MEDICAL_GROUP_OWNERSHIP_STATUS AS HUBDATA
            JOIN
                STAGEDATA.SAT_MEDICAL_GROUP_OWNERSHIP_STATUS_TMP AS STAGEDATA
                ON HUBDATA.HUB_MEDICAL_GROUP_HKEY = STAGEDATA.HUB_MEDICAL_GROUP_HKEY
            WHERE HUBDATA.IS_CURRENT_ROW_FLAG = TRUE
        )
        WHERE RNUM >= 2
    )
;`;

// Create delete statement to be executed.
var sqlDeleteCommand =
`
UPDATE HUBDATA.SAT_MEDICAL_GROUP_OWNERSHIP_STATUS
    SET ROW_EXPIRATION_DATETIME = :1, IS_CURRENT_ROW_FLAG = FALSE
    WHERE (HUB_MEDICAL_GROUP_HKEY, ROW_EFFECTIVE_DATETIME) IN (
        SELECT
            SAT_MEDICAL_GROUP_OWNERSHIP_STATUS.HUB_MEDICAL_GROUP_HKEY,
            SAT_MEDICAL_GROUP_OWNERSHIP_STATUS.ROW_EFFECTIVE_DATETIME
        FROM
            HUBDATA.SAT_MEDICAL_GROUP_OWNERSHIP_STATUS
        JOIN
            HUBDATA.HUB_MEDICAL_GROUP
            ON HUB_MEDICAL_GROUP.HUB_MEDICAL_GROUP_HKEY = SAT_MEDICAL_GROUP_OWNERSHIP_STATUS.HUB_MEDICAL_GROUP_HKEY
        LEFT OUTER JOIN
            STAGEDATA.SAT_MEDICAL_GROUP_OWNERSHIP_STATUS_TMP
            ON SAT_MEDICAL_GROUP_OWNERSHIP_STATUS.HUB_MEDICAL_GROUP_HKEY = SAT_MEDICAL_GROUP_OWNERSHIP_STATUS_TMP.HUB_MEDICAL_GROUP_HKEY
        WHERE
            SAT_MEDICAL_GROUP_OWNERSHIP_STATUS.IS_CURRENT_ROW_FLAG = TRUE
            AND HUB_MEDICAL_GROUP.DATA_SOURCE_NAME IN (SELECT DISTINCT DATA_SOURCE_NAME FROM STAGEDATA.SAT_MEDICAL_GROUP_OWNERSHIP_STATUS_TMP)
            AND SAT_MEDICAL_GROUP_OWNERSHIP_STATUS_TMP.HUB_MEDICAL_GROUP_HKEY IS NULL
    )
;`;

var sqlLogCommand = 
`
INSERT INTO LOGDATA.TABLE_LOAD_HISTORY (JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
    VALUES (:1, :2, :3, :4::timestamp_ltz, :5::timestamp_ltz, :6, :7, :8, :9, :10, :11)
;`;

try 
{
     //Lookup Job
    var sqlCommand = `SELECT START_TIME FROM LOGDATA.JOB_LOG WHERE JOB_ID = :1;`;
    var sfStatement = snowflake.createStatement({sqlText: sqlCommand, binds: [JOB_ID]});     
    var rsJobLog = sfStatement.execute();
    while (rsJobLog.next())
    {
        loadDatetime = rsJobLog.getColumnValue("START_TIME")
    }
   
    if (!loadDatetime)
        {
            throw {
                code: "-1",
                message: "Job Id Not Found!",
                stackTraceTxt: new Error().stack,
                state: "00000"
            }
        }

    //Stage source data to temp table to be reused later.
    targetTableName = `STAGEDATA.SAT_MEDICAL_GROUP_OWNERSHIP_STATUS_TMP`;
    startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlTempTableCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    //Execute Merge Command
    targetTableName = `HUBDATA.SAT_MEDICAL_GROUP_OWNERSHIP_STATUS`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    // Execute the Update Command
    targetTableName = `HUBDATA.SAT_MEDICAL_GROUP_OWNERSHIP_STATUS`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlUpdateCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    // Execute the Delete Command
    targetTableName = `HUBDATA.SAT_MEDICAL_GROUP_OWNERSHIP_STATUS`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

}

catch (err)
{
    var endTime = new Date().toISOString();
    var result =  "Failed: Code: " + err.code + "\n  State: " + err.state;
    result += "\n  Message: " + err.message;
    result += "\nStack Trace:\n" + err.stackTraceTxt;

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (JOB_ID, NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
        VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11,:12);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[JOB_ID, targetTableName, "TABLE", startTime, endTime, "Failed", sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt, sfStatement.getQueryId()]
        }
    );        
    throw result;
}

//Validate what just loaded
sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_DUPE_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_ALLOWED_VALUE_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

return result;
$$
;