CREATE OR REPLACE PROCEDURE HUBDATA.SPU_LOAD_SAT_OFFICE_HOURS_DETAIL(JOB_ID VARCHAR, SOURCE_VIEW_NAME VARCHAR) 
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var loadDatetime = null;
var procedureName = Object.keys(this)[0];
var targetTableName = `HUBDATA.SAT_OFFICE_HOURS_DETAIL`; 

// Create temp table statement to be executed.
var sqlTempTableCommand =
`
CREATE OR REPLACE TEMPORARY TABLE STAGEDATA.SAT_OFFICE_HOURS_DETAIL_TMP
AS
SELECT * FROM ${SOURCE_VIEW_NAME}
;`;

// Create merge statement to be executed.
var sqlMergeCommand = 
`
MERGE INTO HUBDATA.SAT_OFFICE_HOURS_DETAIL TGT
USING (
    SELECT
        HUB_OFFICE_HOURS_HKEY,
        HASH_DIFF,
        DAY_OF_WEEK,
        OPEN_TIME,
        CLOSE_TIME,
        OFFICE_HOURS_DESCRIPTION,
        IS_OPEN_IND
    FROM STAGEDATA.SAT_OFFICE_HOURS_DETAIL_TMP
) SRC
ON (
    TGT.HUB_OFFICE_HOURS_HKEY = SRC.HUB_OFFICE_HOURS_HKEY
    AND TGT.HASH_DIFF = SRC.HASH_DIFF
    AND TGT.IS_CURRENT_ROW_FLAG = TRUE
)

WHEN NOT MATCHED

THEN INSERT
    (
        HUB_OFFICE_HOURS_HKEY,
        HASH_DIFF,
        ROW_EFFECTIVE_DATETIME,
        ROW_EXPIRATION_DATETIME,
        IS_CURRENT_ROW_FLAG,
        DAY_OF_WEEK,
        OPEN_TIME,
        CLOSE_TIME,
        OFFICE_HOURS_DESCRIPTION,
        IS_OPEN_IND
    )
 VALUES 
    (
        SRC.HUB_OFFICE_HOURS_HKEY,
        HASH_DIFF,
        :1,
        TO_TIMESTAMP_TZ('9999-12-31'),
        TRUE,
        SRC.DAY_OF_WEEK,
        SRC.OPEN_TIME,
        SRC.CLOSE_TIME,
        SRC.OFFICE_HOURS_DESCRIPTION,
        SRC.IS_OPEN_IND
    )
;`;
    
// Create update statement to be executed.
var sqlUpdateCommand =
`
UPDATE HUBDATA.SAT_OFFICE_HOURS_DETAIL TGT
    SET ROW_EXPIRATION_DATETIME = DATEADD('millisecond', -1, :1), IS_CURRENT_ROW_FLAG = FALSE
    WHERE (HUB_OFFICE_HOURS_HKEY, ROW_EFFECTIVE_DATETIME) IN (
        SELECT HUB_OFFICE_HOURS_HKEY, ROW_EFFECTIVE_DATETIME
        FROM (
            SELECT
                HUBDATA.HUB_OFFICE_HOURS_HKEY,
                HUBDATA.ROW_EFFECTIVE_DATETIME,
                ROW_NUMBER() OVER (PARTITION BY HUBDATA.HUB_OFFICE_HOURS_HKEY ORDER BY HUBDATA.ROW_EFFECTIVE_DATETIME DESC) AS RNUM
            FROM
                HUBDATA.SAT_OFFICE_HOURS_DETAIL AS HUBDATA
            JOIN
                STAGEDATA.SAT_OFFICE_HOURS_DETAIL_CACTUS_SELECT_VW AS STAGEDATA
            ON (HUBDATA.HUB_OFFICE_HOURS_HKEY = STAGEDATA.HUB_OFFICE_HOURS_HKEY)
            WHERE HUBDATA.IS_CURRENT_ROW_FLAG = TRUE       

        )
        WHERE RNUM >= 2
    )
;`;

// Create delete statement to be executed.
var sqlDeleteCommand =
`
UPDATE HUBDATA.SAT_OFFICE_HOURS_DETAIL
    SET ROW_EXPIRATION_DATETIME = :1, IS_CURRENT_ROW_FLAG = FALSE
    WHERE (HUB_OFFICE_HOURS_HKEY, ROW_EFFECTIVE_DATETIME) IN (
        SELECT
            HUBDATA.HUB_OFFICE_HOURS_HKEY,
            HUBDATA.ROW_EFFECTIVE_DATETIME
        FROM
            HUBDATA.SAT_OFFICE_HOURS_DETAIL AS HUBDATA
        JOIN
            HUBDATA.HUB_OFFICE_HOURS
            ON HUBDATA.HUB_OFFICE_HOURS_HKEY = HUB_OFFICE_HOURS.HUB_OFFICE_HOURS_HKEY
        LEFT OUTER JOIN
            STAGEDATA.SAT_OFFICE_HOURS_DETAIL_TMP AS STAGEDATA
            ON HUBDATA.HUB_OFFICE_HOURS_HKEY = STAGEDATA.HUB_OFFICE_HOURS_HKEY
        WHERE
            HUBDATA.IS_CURRENT_ROW_FLAG = TRUE
            AND STAGEDATA.HUB_OFFICE_HOURS_HKEY IS NULL
            AND HUB_OFFICE_HOURS.DATA_SOURCE_NAME IN (SELECT DISTINCT DATA_SOURCE_NAME FROM STAGEDATA.SAT_OFFICE_HOURS_DETAIL_TMP)
    )
;`;

try 
{
     //Lookup Job
    var sqlLogCommand = `SELECT START_TIME FROM LOGDATA.JOB_LOG WHERE JOB_ID = :1;`;
    var sfStatement = snowflake.createStatement({sqlText: sqlLogCommand, binds: [JOB_ID]});     
    var rsJobLog = sfStatement.execute();
    while (rsJobLog.next())
    {
        loadDatetime = rsJobLog.getColumnValue("START_TIME")
    }
   
    if (!loadDatetime)
        {
            throw {
                code: "-1",
                message: "Job Id Not Found!",
                stackTraceTxt: new Error().stack,
                state: "00000"
            }
        }

    //Stage source data to temp table to be reused later.
    var sfStatement = snowflake.createStatement({sqlText: sqlTempTableCommand});
    sfStatement.execute();

    //Execute Merge Command
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand, binds:[loadDatetime]});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log MERGE results to table
    var sqlLogCommand =
    `
    INSERT INTO LOGDATA.TABLE_LOAD_HISTORY (JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES
            (:1, :2, :3, :4::timestamp_ltz, :5::timestamp_ltz, :6, :7, :8, :9)
    ;`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), result, sfStatement.getSqlText()]
        }
    );

    // Execute the Update Command
    var startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlUpdateCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    var sqlLogCommand =
    `
    INSERT INTO LOGDATA.TABLE_LOAD_HISTORY (JOB_ID, NAME, TYPE, START_TIME, END_TIME, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES
            (:1, :2, :3, :4::timestamp_ltz, :5::timestamp_ltz, :6, :7, :8)
    ;`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsUpdated(), result, sfStatement.getSqlText()]
        }
    );

    // Execute the Delete Command
    var startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    var sqlLogCommand =
    `
    INSERT INTO LOGDATA.TABLE_LOAD_HISTORY (JOB_ID, NAME, TYPE, START_TIME, END_TIME, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES
            (:1, :2, :3, :4::timestamp_ltz, :5::timestamp_ltz, :6, :7, :8)
    ;`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsUpdated(), result, sfStatement.getSqlText()]
        }
    );
}

catch (err)
{
    var endTime = new Date().toISOString();
    var result =  "Failed: Code: " + err.code + "\n  State: " + err.state;
    result += "\n  Message: " + err.message;
    result += "\nStack Trace:\n" + err.stackTraceTxt;

    //Log results to table
    var sqlLogCommand =
    `
    INSERT INTO LOGDATA.TABLE_LOAD_HISTORY (JOB_ID, NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
        VALUES
            (:1, :2, :3, :4::timestamp_ltz, :5::timestamp_ltz, :6, :7, :8, :9, :10, :11, :12)
    ;`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[JOB_ID, targetTableName, "TABLE", startTime, endTime, "Failed", sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt, sfStatement.getQueryId()]
        }
    );        
    throw result;
}

//Validate what just loaded
sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_DUPE_CHECK('${JOB_ID}','${targetTableName}');`;
resultSet = snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK('${JOB_ID}','${targetTableName}');`;
resultSet = snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_ALLOWED_VALUE_CHECK('${JOB_ID}','${targetTableName}');`;
resultSet = snowflake.execute({sqlText});

return result;
$$
;