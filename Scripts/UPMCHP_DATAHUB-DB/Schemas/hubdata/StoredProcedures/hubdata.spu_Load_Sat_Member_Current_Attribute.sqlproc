CREATE OR REPLACE PROCEDURE HUBDATA.SPU_LOAD_SAT_MEMBER_CURRENT_ATTRIBUTE(JOB_ID VARCHAR, SOURCE_VIEW_NAME VARCHAR) 
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var loadDatetime = null;
var procedureName = Object.keys(this)[0];
var targetTableName = `HUBDATA.SAT_MEMBER_CURRENT_ATTRIBUTE`; 

// Create temp table statement to be executed.
var sqlTempTableCommand =
`
CREATE OR REPLACE TEMPORARY TABLE STAGEDATA.SAT_MEMBER_CURRENT_ATTRIBUTE_TMP
AS
SELECT
*
,UTIL.FXN_ARRAY_HASH([
    ELIG_STATUS_CODE01
    ,ELIG_STATUS_DESC01
    ,ELIG_STATUS_CODE02
    ,ELIG_STATUS_DESC02
    ,PART_D_RISK_FACTOR
    ,CHRONIC_CONDITION_CNT
    ,PRIVACY_RESTRICTION_FLAG
    ,PRIVACY_ALERT_FLAG
    ,PREGNANCY_DUE_DATE
    ]) AS HASH_DIFF
FROM ${SOURCE_VIEW_NAME}
;`;

// Create merge statement to be executed.
var sqlMergeCommand = 
`    
MERGE INTO HUBDATA.SAT_MEMBER_CURRENT_ATTRIBUTE TGT
USING (
    SELECT    
        HUB_MEMBER_HKEY
        ,HASH_DIFF
        ,ELIG_STATUS_CODE01
        ,ELIG_STATUS_DESC01
        ,ELIG_STATUS_CODE02
        ,ELIG_STATUS_DESC02
        ,PART_D_RISK_FACTOR
        ,CHRONIC_CONDITION_CNT
        ,PRIVACY_RESTRICTION_FLAG
        ,PRIVACY_ALERT_FLAG
        ,PREGNANCY_DUE_DATE
    FROM STAGEDATA.SAT_MEMBER_CURRENT_ATTRIBUTE_TMP
) SRC  
ON (TGT.HUB_MEMBER_HKEY = SRC.HUB_MEMBER_HKEY 
AND TGT.HASH_DIFF = SRC.HASH_DIFF
AND TGT.IS_CURRENT_ROW_FLAG = TRUE) 

WHEN NOT MATCHED 

THEN INSERT 
    (
        HUB_MEMBER_HKEY,
        ROW_EFFECTIVE_DATETIME,
        ROW_EXPIRATION_DATETIME,
        IS_CURRENT_ROW_FLAG,
        HASH_DIFF,
        ELIG_STATUS_CODE01,
        ELIG_STATUS_DESC01,
        ELIG_STATUS_CODE02,
        ELIG_STATUS_DESC02,
        PART_D_RISK_FACTOR,
        CHRONIC_CONDITION_CNT,
        PRIVACY_RESTRICTION_FLAG,
        PRIVACY_ALERT_FLAG,
        PREGNANCY_DUE_DATE
    )
 VALUES 
    (
        SRC.HUB_MEMBER_HKEY,
        :1,
        TO_TIMESTAMP_TZ('9999-12-31'),
        TRUE,
        SRC.HASH_DIFF,
        SRC.ELIG_STATUS_CODE01,
        SRC.ELIG_STATUS_DESC01,
        SRC.ELIG_STATUS_CODE02,
        SRC.ELIG_STATUS_DESC02,
        SRC.PART_D_RISK_FACTOR,
        SRC.CHRONIC_CONDITION_CNT,
        SRC.PRIVACY_RESTRICTION_FLAG,
        SRC.PRIVACY_ALERT_FLAG,
        SRC.PREGNANCY_DUE_DATE
    )
;`;

// Create update statement to be executed.
var sqlUpdateCommand=

`
UPDATE HUBDATA.SAT_MEMBER_CURRENT_ATTRIBUTE TGT SET 
    ROW_EXPIRATION_DATETIME = DATEADD('millisecond', -1, :1)
    , IS_CURRENT_ROW_FLAG = FALSE
WHERE (HUB_MEMBER_HKEY, ROW_EFFECTIVE_DATETIME) IN (
    SELECT HUB_MEMBER_HKEY, ROW_EFFECTIVE_DATETIME
    FROM (
        SELECT 
            SAT_MEMBER_CURRENT_ATTRIBUTE.HUB_MEMBER_HKEY,
            SAT_MEMBER_CURRENT_ATTRIBUTE.ROW_EFFECTIVE_DATETIME,
            ROW_NUMBER() OVER (PARTITION BY SAT_MEMBER_CURRENT_ATTRIBUTE.HUB_MEMBER_HKEY ORDER BY SAT_MEMBER_CURRENT_ATTRIBUTE.ROW_EFFECTIVE_DATETIME DESC) AS RNUM
        FROM HUBDATA.SAT_MEMBER_CURRENT_ATTRIBUTE
            JOIN STAGEDATA.SAT_MEMBER_CURRENT_ATTRIBUTE_TMP
                ON (SAT_MEMBER_CURRENT_ATTRIBUTE_TMP.HUB_MEMBER_HKEY = SAT_MEMBER_CURRENT_ATTRIBUTE.HUB_MEMBER_HKEY)
        WHERE SAT_MEMBER_CURRENT_ATTRIBUTE.IS_CURRENT_ROW_FLAG = TRUE
    )
    WHERE RNUM >= 2
)
;`;

// Create delete statement to be executed.
var sqlDeleteCommand =
`
UPDATE HUBDATA.SAT_MEMBER_CURRENT_ATTRIBUTE
SET 
    ROW_EXPIRATION_DATETIME = :1
    ,IS_CURRENT_ROW_FLAG = FALSE
WHERE (HUB_MEMBER_HKEY, ROW_EFFECTIVE_DATETIME) IN
(
    SELECT
    SAT_MEMBER_CURRENT_ATTRIBUTE.HUB_MEMBER_HKEY,
    SAT_MEMBER_CURRENT_ATTRIBUTE.ROW_EFFECTIVE_DATETIME
    FROM HUBDATA.SAT_MEMBER_CURRENT_ATTRIBUTE
        JOIN HUBDATA.HUB_MEMBER
            ON (HUB_MEMBER.HUB_MEMBER_HKEY = SAT_MEMBER_CURRENT_ATTRIBUTE.HUB_MEMBER_HKEY)
        LEFT OUTER JOIN STAGEDATA.SAT_MEMBER_CURRENT_ATTRIBUTE_TMP
            ON (SAT_MEMBER_CURRENT_ATTRIBUTE_TMP.HUB_MEMBER_HKEY = SAT_MEMBER_CURRENT_ATTRIBUTE.HUB_MEMBER_HKEY)

    WHERE HUB_MEMBER.DATA_SOURCE_NAME IN (SELECT DISTINCT DATA_SOURCE_NAME FROM STAGEDATA.SAT_MEMBER_CURRENT_ATTRIBUTE_TMP)
    AND SAT_MEMBER_CURRENT_ATTRIBUTE.IS_CURRENT_ROW_FLAG = TRUE
    AND SAT_MEMBER_CURRENT_ATTRIBUTE_TMP.HUB_MEMBER_HKEY IS NULL
)
;`;

var sqlLogCommand = 
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11);`;

try 
{
     //Lookup Job
    var sqlCommand = `SELECT START_TIME FROM LOGDATA.JOB_LOG WHERE JOB_ID = :1;`;
    var sfStatement = snowflake.createStatement({sqlText: sqlCommand, binds: [JOB_ID]});     
    var rsJobLog = sfStatement.execute();
    while (rsJobLog.next())
    {
        loadDatetime = rsJobLog.getColumnValue("START_TIME")
    }
   
    if (!loadDatetime)
        {
            throw {
                code: "-1",
                message: "Job Id Not Found!",
                stackTraceTxt: new Error().stack,
                state: "00000"
            }
        }

    //Stage source data to temp table to be reused later.
    targetTableName = `STAGEDATA.SAT_MEMBER_CURRENT_ATTRIBUTE_TMP`;
    startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlTempTableCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    //Execute Merge Command
    targetTableName = `HUBDATA.SAT_MEMBER_CURRENT_ATTRIBUTE`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    // Execute the Update Command
    targetTableName = `HUBDATA.SAT_MEMBER_CURRENT_ATTRIBUTE`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlUpdateCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    // Execute the Delete Command
    targetTableName = `HUBDATA.SAT_MEMBER_CURRENT_ATTRIBUTE`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

}

catch (err)
{
    var endTime = new Date().toISOString();
    var result =  "Failed: Code: " + err.code + "\n  State: " + err.state;
    result += "\n  Message: " + err.message;
    result += "\nStack Trace:\n" + err.stackTraceTxt;

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (JOB_ID, NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
        VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11,:12);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[JOB_ID, targetTableName, "TABLE", startTime, endTime, "Failed", sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt, sfStatement.getQueryId()]
        }
    );        
    throw result;
}

//Validate what just loaded
sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_DUPE_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_ALLOWED_VALUE_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

return result;
$$
;
