CREATE OR REPLACE PROCEDURE HUBDATA.SPU_LOAD_SAT_DRUG_DETAIL(JOB_ID VARCHAR, SOURCE_VIEW_NAME VARCHAR) 
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var loadDatetime = null;
var procedureName = Object.keys(this)[0];
var targetTableName = `HUBDATA.SAT_DRUG_DETAIL`; 

// Create temp table statement to be executed.
var sqlTempTableCommand =
`
CREATE OR REPLACE TEMPORARY TABLE STAGEDATA.SAT_DRUG_DETAIL_TMP
AS
SELECT * FROM ${SOURCE_VIEW_NAME}
;`;

// Create merge statement to be executed.
    var sqlMergeCommand = 
`    
MERGE INTO HUBDATA.SAT_DRUG_DETAIL TGT
USING (
    SELECT     
        HUB_DRUG_HKEY,
        HASH_DIFF,
        DOSAGE_METHOD_CODE,
        BRAND_DRUG_NAME,
        DOSAGE_METHOD_DESC,
        GENERIC_DRUG_NAME,
        DRUG_STRENGTH_DESC,
        THER_CLASS_AHFS_CODE,
        THER_CLASS_AHFS_DESC,
        THER_CLASS_GEN_CODE,
        THER_CLASS_GEN_DESC,
        DRUG_CLASS_CODE,
        DRUG_CLASS_DESC,
        ABUSE_RATING_CODE,
        ABUSE_RATING_DESC,
        DRUG_FORM_CODE,
        DRUG_FORM_DESC,
        ROUTE_CODE,
        ROUTE_DESC,
        GCN_CODE,
        DRUG_LABEL_NAME,
        GENERIC_PRICE_CODE,
        GENERIC_PRICE_DESC,
        HIC3_CODE,
        HIC3_DESC,
        GENERIC_SOURCE_CODE,
        GENERIC_SOURCE_DESC,
        INNOVATOR_FLAG,
        NEW_DRUG_APPLICATOR_FLAG,
        GENERIC_THERAPEUTIC_FLAG,
        GENERIC_MANUFACTURER_FLAG,
        MAINTENANCE_DRUG_FLAG,
        MED_ID,
        MED_DESC,
        MED_NAME_ID,
        MED_NAME,
        WHOLESALE_ACQUISIT_COST_DATE,
        WHOLESALE_ACQUISITION_COST_AMT,
        GSN_CODE,
        SPECIALTY_DRUG_IND,
        MEDISPAN_GPI_CODE,
        MEDISPAN_GPI_DESC,
        MANUFACTURER_NAME
        FROM STAGEDATA.SAT_DRUG_DETAIL_TMP
) SRC  
ON (TGT.HUB_DRUG_HKEY = SRC.HUB_DRUG_HKEY 
AND TGT.HASH_DIFF=SRC.HASH_DIFF
AND TGT.IS_CURRENT_ROW_FLAG = TRUE) 

WHEN NOT MATCHED 

THEN INSERT 
    (
        HUB_DRUG_HKEY,
        ROW_EFFECTIVE_DATETIME,
        ROW_EXPIRATION_DATETIME,
        IS_CURRENT_ROW_FLAG,
        HASH_DIFF,
        DOSAGE_METHOD_CODE,
        BRAND_DRUG_NAME,
        DOSAGE_METHOD_DESC,
        GENERIC_DRUG_NAME,
        DRUG_STRENGTH_DESC,
        THER_CLASS_AHFS_CODE,
        THER_CLASS_AHFS_DESC,
        THER_CLASS_GEN_CODE,
        THER_CLASS_GEN_DESC,
        DRUG_CLASS_CODE,
        DRUG_CLASS_DESC,
        ABUSE_RATING_CODE,
        ABUSE_RATING_DESC,
        DRUG_FORM_CODE,
        DRUG_FORM_DESC,
        ROUTE_CODE,
        ROUTE_DESC,
        GCN_CODE,
        DRUG_LABEL_NAME,
        GENERIC_PRICE_CODE,
        GENERIC_PRICE_DESC,
        HIC3_CODE,
        HIC3_DESC,
        GENERIC_SOURCE_CODE,
        GENERIC_SOURCE_DESC,
        INNOVATOR_FLAG,
        NEW_DRUG_APPLICATOR_FLAG,
        GENERIC_THERAPEUTIC_FLAG,
        GENERIC_MANUFACTURER_FLAG,
        MAINTENANCE_DRUG_FLAG,
        MED_ID,
        MED_DESC,
        MED_NAME_ID,
        MED_NAME,
        WHOLESALE_ACQUISIT_COST_DATE,
        WHOLESALE_ACQUISITION_COST_AMT,
        GSN_CODE,
        SPECIALTY_DRUG_IND,
        MEDISPAN_GPI_CODE,
        MEDISPAN_GPI_DESC,
        MANUFACTURER_NAME
        )
 VALUES 
    (
        SRC.HUB_DRUG_HKEY,
        :1,
        TO_TIMESTAMP_TZ('9999-12-31'),
        TRUE,
        SRC.HASH_DIFF,
        SRC.DOSAGE_METHOD_CODE,
        SRC.BRAND_DRUG_NAME,
        SRC.DOSAGE_METHOD_DESC,
        SRC.GENERIC_DRUG_NAME,
        SRC.DRUG_STRENGTH_DESC,
        SRC.THER_CLASS_AHFS_CODE,
        SRC.THER_CLASS_AHFS_DESC,
        SRC.THER_CLASS_GEN_CODE,
        SRC.THER_CLASS_GEN_DESC,
        SRC.DRUG_CLASS_CODE,
        SRC.DRUG_CLASS_DESC,
        SRC.ABUSE_RATING_CODE,
        SRC.ABUSE_RATING_DESC,
        SRC.DRUG_FORM_CODE,
        SRC.DRUG_FORM_DESC,
        SRC.ROUTE_CODE,
        SRC.ROUTE_DESC,
        SRC.GCN_CODE,
        SRC.DRUG_LABEL_NAME,
        SRC.GENERIC_PRICE_CODE,
        SRC.GENERIC_PRICE_DESC,
        SRC.HIC3_CODE,
        SRC.HIC3_DESC,
        SRC.GENERIC_SOURCE_CODE,
        SRC.GENERIC_SOURCE_DESC,
        SRC.INNOVATOR_FLAG,
        SRC.NEW_DRUG_APPLICATOR_FLAG,
        SRC.GENERIC_THERAPEUTIC_FLAG,
        SRC.GENERIC_MANUFACTURER_FLAG,
        SRC.MAINTENANCE_DRUG_FLAG,
        SRC.MED_ID,
        SRC.MED_DESC,
        SRC.MED_NAME_ID,
        SRC.MED_NAME,
        SRC.WHOLESALE_ACQUISIT_COST_DATE,
        SRC.WHOLESALE_ACQUISITION_COST_AMT,
        SRC.GSN_CODE,
        SRC.SPECIALTY_DRUG_IND,
        SRC.MEDISPAN_GPI_CODE,
        SRC.MEDISPAN_GPI_DESC,
        SRC.MANUFACTURER_NAME
    )
;`;

// Create update statement to be executed.
var sqlUpdateCommand=
`UPDATE HUBDATA.SAT_DRUG_DETAIL TGT
SET 
    ROW_EXPIRATION_DATETIME = DATEADD('millisecond', -1, :1)
    ,IS_CURRENT_ROW_FLAG = FALSE
WHERE (HUB_DRUG_HKEY, ROW_EFFECTIVE_DATETIME) IN 
(
    SELECT HUB_DRUG_HKEY, ROW_EFFECTIVE_DATETIME
    FROM (
        SELECT 
            SAT_DRUG_DETAIL.HUB_DRUG_HKEY,
            SAT_DRUG_DETAIL.ROW_EFFECTIVE_DATETIME,
            ROW_NUMBER() OVER (PARTITION BY SAT_DRUG_DETAIL.HUB_DRUG_HKEY ORDER BY SAT_DRUG_DETAIL.ROW_EFFECTIVE_DATETIME DESC) AS RNUM
        FROM HUBDATA.SAT_DRUG_DETAIL
            JOIN STAGEDATA.SAT_DRUG_DETAIL_TMP
                ON (SAT_DRUG_DETAIL_TMP.HUB_DRUG_HKEY = SAT_DRUG_DETAIL.HUB_DRUG_HKEY)
        WHERE SAT_DRUG_DETAIL.IS_CURRENT_ROW_FLAG = TRUE
    )
    WHERE RNUM >= 2
);`;

// Create delete statement to be executed.
var sqlDeleteCommand =
`UPDATE HUBDATA.SAT_DRUG_DETAIL TGT
SET 
    ROW_EXPIRATION_DATETIME = :1
    ,IS_CURRENT_ROW_FLAG = FALSE
WHERE (HUB_DRUG_HKEY, ROW_EFFECTIVE_DATETIME) IN
(
    SELECT
    SAT_DRUG_DETAIL.HUB_DRUG_HKEY,
    SAT_DRUG_DETAIL.ROW_EFFECTIVE_DATETIME
    FROM HUBDATA.SAT_DRUG_DETAIL
        JOIN HUBDATA.HUB_DRUG
            ON (HUB_DRUG.HUB_DRUG_HKEY = SAT_DRUG_DETAIL.HUB_DRUG_HKEY)
        LEFT OUTER JOIN STAGEDATA.SAT_DRUG_DETAIL_TMP
            ON (SAT_DRUG_DETAIL_TMP.HUB_DRUG_HKEY = SAT_DRUG_DETAIL.HUB_DRUG_HKEY)
    WHERE HUB_DRUG.DATA_SOURCE_NAME IN (SELECT DISTINCT DATA_SOURCE_NAME FROM STAGEDATA.SAT_DRUG_DETAIL_TMP)
    AND SAT_DRUG_DETAIL.IS_CURRENT_ROW_FLAG = TRUE
    AND SAT_DRUG_DETAIL_TMP.HUB_DRUG_HKEY IS NULL
);`;

var sqlLogCommand = 
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11);`;

try 
{
     //Lookup Job
    var sqlCommand = `SELECT START_TIME FROM LOGDATA.JOB_LOG WHERE JOB_ID = :1;`;
    var sfStatement = snowflake.createStatement({sqlText: sqlCommand, binds: [JOB_ID]});     
    var rsJobLog = sfStatement.execute();
    while (rsJobLog.next())
    {
        loadDatetime = rsJobLog.getColumnValue("START_TIME")
    }
   
    if (!loadDatetime)
        {
            throw {
                code: "-1",
                message: "Job Id Not Found!",
                stackTraceTxt: new Error().stack,
                state: "00000"
            }
        }

    //Stage source data to temp table to be reused later.
    targetTableName = `STAGEDATA.SAT_DRUG_DETAIL_TMP`;
    startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlTempTableCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    //Execute Merge Command
    targetTableName = `HUBDATA.SAT_DRUG_DETAIL`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    // Execute the Update Command
    targetTableName = `HUBDATA.SAT_DRUG_DETAIL`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlUpdateCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    // Execute the Delete Command
    targetTableName = `HUBDATA.SAT_DRUG_DETAIL`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

}

catch (err)
{
    var endTime = new Date().toISOString();
    var result =  "Failed: Code: " + err.code + "\n  State: " + err.state;
    result += "\n  Message: " + err.message;
    result += "\nStack Trace:\n" + err.stackTraceTxt;

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (JOB_ID, NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
        VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11,:12);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[JOB_ID, targetTableName, "TABLE", startTime, endTime, "Failed", sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt, sfStatement.getQueryId()]
        }
    );        
    throw result;
}

//Validate what just loaded
sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_DUPE_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_ALLOWED_VALUE_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

return result;
$$
;
