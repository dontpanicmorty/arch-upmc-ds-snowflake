CREATE OR REPLACE PROCEDURE HUBDATA.SPU_LOAD_LNK_PLAN_ACCUMULATOR_PLAN(JOB_ID VARCHAR, SOURCE_VIEW_NAME VARCHAR) 
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var loadDatetime = null;
var procedureName = Object.keys(this)[0];
var targetTableName = `HUBDATA.LNK_PLAN_ACCUMULATOR_PLAN`; 

// Create temp table statement to be executed.
var sqlTempTableCommand =
`
CREATE OR REPLACE TEMPORARY TABLE STAGEDATA.LNK_PLAN_ACCUMULATOR_PLAN_TMP
AS
SELECT * FROM ${SOURCE_VIEW_NAME}
;`;

// Create merge statement to be executed.
var sqlMergeCommand = 
`    
MERGE INTO HUBDATA.LNK_PLAN_ACCUMULATOR_PLAN TGT
USING (
    SELECT 
        LNK_PLAN_ACCUMULATOR_PLAN_HKEY,
        HUB_PLAN_ACCUMULATOR_HKEY,
        HUB_PLAN_HKEY,
        PA_TPA_CLIENT_ID,
        PA_TPA_ID,
        PA_TPA_DIV_ID,
        PA_DATA_SOURCE_NAME,
        PA_CARE_TYPE_NAME,
        PA_PLAN_CODE,
        PA_GROUP_NBR,
        PA_SUB_GROUP_NBR,
        PA_ACCUMULATOR_TYPE_CODE,
        PA_ACCUMULATOR_PERIOD_BENEFIT_LEVEL_CODE,
        PA_SUBSCRIBER_TYPE_CODE,
        PA_CODESET_CODE,
        PA_IN_NETWORK_FLAG,
        P_TPA_CLIENT_ID,
        P_TPA_ID,
        P_TPA_DIV_ID,
        P_DATA_SOURCE_NAME,
        P_PLAN_CODE
    FROM STAGEDATA.LNK_PLAN_ACCUMULATOR_PLAN_TMP
) SRC
ON (TGT.LNK_PLAN_ACCUMULATOR_PLAN_HKEY = SRC.LNK_PLAN_ACCUMULATOR_PLAN_HKEY
AND TGT.IS_CURRENT_ROW_FLAG = TRUE)  

WHEN NOT MATCHED 

THEN INSERT 
    (
        LNK_PLAN_ACCUMULATOR_PLAN_HKEY,
        ROW_EFFECTIVE_DATETIME,
        ROW_EXPIRATION_DATETIME,
        IS_CURRENT_ROW_FLAG,
        HUB_PLAN_ACCUMULATOR_HKEY,
        HUB_PLAN_HKEY,
        PA_TPA_CLIENT_ID,
        PA_TPA_ID,
        PA_TPA_DIV_ID,
        PA_DATA_SOURCE_NAME,
        PA_CARE_TYPE_NAME,
        PA_PLAN_CODE,
        PA_GROUP_NBR,
        PA_SUB_GROUP_NBR,
        PA_ACCUMULATOR_TYPE_CODE,
        PA_ACCUMULATOR_PERIOD_BENEFIT_LEVEL_CODE,
        PA_SUBSCRIBER_TYPE_CODE,
        PA_CODESET_CODE,
        PA_IN_NETWORK_FLAG,
        P_TPA_CLIENT_ID,
        P_TPA_ID,
        P_TPA_DIV_ID,
        P_DATA_SOURCE_NAME,
        P_PLAN_CODE
    )
 VALUES 
    (
        SRC.LNK_PLAN_ACCUMULATOR_PLAN_HKEY,
        :1,
        TO_TIMESTAMP_TZ('9999-12-31'),
        TRUE,
        SRC.HUB_PLAN_ACCUMULATOR_HKEY,
        SRC.HUB_PLAN_HKEY,
        SRC.PA_TPA_CLIENT_ID,
        SRC.PA_TPA_ID,
        SRC.PA_TPA_DIV_ID,
        SRC.PA_DATA_SOURCE_NAME,
        SRC.PA_CARE_TYPE_NAME,
        SRC.PA_PLAN_CODE,
        SRC.PA_GROUP_NBR,
        SRC.PA_SUB_GROUP_NBR,
        SRC.PA_ACCUMULATOR_TYPE_CODE,
        SRC.PA_ACCUMULATOR_PERIOD_BENEFIT_LEVEL_CODE,
        SRC.PA_SUBSCRIBER_TYPE_CODE,
        SRC.PA_CODESET_CODE,
        SRC.PA_IN_NETWORK_FLAG,
        SRC.P_TPA_CLIENT_ID,
        SRC.P_TPA_ID,
        SRC.P_TPA_DIV_ID,
        SRC.P_DATA_SOURCE_NAME,
        SRC.P_PLAN_CODE         
    )
;`;

// Create update statement to be executed.
var sqlUpdateCommand=
`
UPDATE HUBDATA.LNK_PLAN_ACCUMULATOR_PLAN TGT SET 
    ROW_EXPIRATION_DATETIME = DATEADD('millisecond', -1, :1)
    , IS_CURRENT_ROW_FLAG = FALSE
WHERE (HUB_PLAN_ACCUMULATOR_HKEY, ROW_EFFECTIVE_DATETIME) IN (
    SELECT HUB_PLAN_ACCUMULATOR_HKEY, ROW_EFFECTIVE_DATETIME
    FROM (
        SELECT 
            LNK_PLAN_ACCUMULATOR_PLAN.HUB_PLAN_ACCUMULATOR_HKEY,
            LNK_PLAN_ACCUMULATOR_PLAN.ROW_EFFECTIVE_DATETIME,
            ROW_NUMBER() OVER (PARTITION BY LNK_PLAN_ACCUMULATOR_PLAN.HUB_PLAN_ACCUMULATOR_HKEY ORDER BY LNK_PLAN_ACCUMULATOR_PLAN.ROW_EFFECTIVE_DATETIME DESC) AS RNUM
        FROM HUBDATA.LNK_PLAN_ACCUMULATOR_PLAN
            JOIN STAGEDATA.LNK_PLAN_ACCUMULATOR_PLAN_TMP
                ON (LNK_PLAN_ACCUMULATOR_PLAN_TMP.LNK_PLAN_ACCUMULATOR_PLAN_HKEY = LNK_PLAN_ACCUMULATOR_PLAN.LNK_PLAN_ACCUMULATOR_PLAN_HKEY)
        WHERE LNK_PLAN_ACCUMULATOR_PLAN.IS_CURRENT_ROW_FLAG = TRUE
    )
    WHERE RNUM >= 2
)
;`;

// Create delete statement to be executed.
var sqlDeleteCommand =
`
UPDATE HUBDATA.LNK_PLAN_ACCUMULATOR_PLAN
SET 
    ROW_EXPIRATION_DATETIME = :1
    ,IS_CURRENT_ROW_FLAG = FALSE
WHERE (LNK_PLAN_ACCUMULATOR_PLAN_HKEY, ROW_EFFECTIVE_DATETIME) IN
(
    SELECT
    LNK_PLAN_ACCUMULATOR_PLAN.LNK_PLAN_ACCUMULATOR_PLAN_HKEY,
    LNK_PLAN_ACCUMULATOR_PLAN.ROW_EFFECTIVE_DATETIME
    FROM HUBDATA.LNK_PLAN_ACCUMULATOR_PLAN
        LEFT OUTER JOIN STAGEDATA.LNK_PLAN_ACCUMULATOR_PLAN_TMP
            ON (LNK_PLAN_ACCUMULATOR_PLAN_TMP.LNK_PLAN_ACCUMULATOR_PLAN_HKEY = LNK_PLAN_ACCUMULATOR_PLAN.LNK_PLAN_ACCUMULATOR_PLAN_HKEY)
    WHERE LNK_PLAN_ACCUMULATOR_PLAN.IS_CURRENT_ROW_FLAG = TRUE
    AND LNK_PLAN_ACCUMULATOR_PLAN_TMP.LNK_PLAN_ACCUMULATOR_PLAN_HKEY IS NULL
    AND LNK_PLAN_ACCUMULATOR_PLAN.PA_DATA_SOURCE_NAME IN (SELECT DISTINCT PA_DATA_SOURCE_NAME FROM STAGEDATA.LNK_PLAN_ACCUMULATOR_PLAN_TMP)

)
;`;

var sqlLogCommand = 
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11);`;

try 
{
     //Lookup Job
    var sqlCommand = `SELECT START_TIME FROM LOGDATA.JOB_LOG WHERE JOB_ID = :1;`;
    var sfStatement = snowflake.createStatement({sqlText: sqlCommand, binds: [JOB_ID]});     
    var rsJobLog = sfStatement.execute();
    while (rsJobLog.next())
    {
        loadDatetime = rsJobLog.getColumnValue("START_TIME")
    }
   
    if (!loadDatetime)
        {
            throw {
                code: "-1",
                message: "Job Id Not Found!",
                stackTraceTxt: new Error().stack,
                state: "00000"
            }
        }

    //Stage source data to temp table to be reused later.
    targetTableName = `STAGEDATA.LNK_PLAN_ACCUMULATOR_PLAN_TMP`;
    startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlTempTableCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );    

    //Execute Merge Command
    targetTableName = `HUBDATA.LNK_PLAN_ACCUMULATOR_PLAN`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    // Execute the Update Command
    targetTableName = `HUBDATA.LNK_PLAN_ACCUMULATOR_PLAN`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlUpdateCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    // Execute the Delete Command
    targetTableName = `HUBDATA.LNK_PLAN_ACCUMULATOR_PLAN`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

}

catch (err)
{
    var endTime = new Date().toISOString();
    var result =  "Failed: Code: " + err.code + "\n  State: " + err.state;
    result += "\n  Message: " + err.message;
    result += "\nStack Trace:\n" + err.stackTraceTxt;

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (JOB_ID, NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
        VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11,:12);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[JOB_ID, targetTableName, "TABLE", startTime, endTime, "Failed", sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt, sfStatement.getQueryId()]
        }
    );        
    throw result;
}

//Validate what just loaded
sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_DUPE_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_ALLOWED_VALUE_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

return result;
$$
;
