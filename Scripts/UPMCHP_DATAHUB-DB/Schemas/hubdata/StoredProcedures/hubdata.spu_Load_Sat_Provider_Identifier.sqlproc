CREATE OR REPLACE PROCEDURE HUBDATA.SPU_LOAD_SAT_PROVIDER_IDENTIFIER(JOB_ID VARCHAR, SOURCE_VIEW_NAME VARCHAR) 
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var loadDatetime = null;
var procedureName = Object.keys(this)[0];
var targetTableName = `HUBDATA.SAT_PROVIDER_IDENTIFIER`;

// Create temp table statement
var sqlTempTableCommand = 
`
CREATE OR REPLACE TEMPORARY TABLE STAGEDATA.SAT_PROVIDER_IDENTIFIER_TMP
AS SELECT * FROM ${SOURCE_VIEW_NAME}
;`;

// Create merge statement to be executed.
var sqlMergeCommand = 
`    
MERGE INTO HUBDATA.SAT_PROVIDER_IDENTIFIER TGT
USING (
    SELECT
        HUB_PROVIDER_HKEY,
        HASH_DIFF,
        IDENTIFIER_NAME,
        IDENTIFIER_NBR,
        IDENTIFIER_SUBTYPE
    FROM ${SOURCE_VIEW_NAME}
) SRC
ON (
    TGT.HUB_PROVIDER_HKEY = SRC.HUB_PROVIDER_HKEY
    AND TGT.HASH_DIFF = SRC.HASH_DIFF
    AND TGT.IS_CURRENT_ROW_FLAG = TRUE
)  

WHEN NOT MATCHED 

THEN INSERT 
    (
        HUB_PROVIDER_HKEY,
        ROW_EFFECTIVE_DATETIME,
        ROW_EXPIRATION_DATETIME,
        IS_CURRENT_ROW_FLAG,
        HASH_DIFF,
        IDENTIFIER_NAME,
        IDENTIFIER_NBR,
        IDENTIFIER_SUBTYPE
    )
 VALUES 
    (
        SRC.HUB_PROVIDER_HKEY,
        :1,
        TO_TIMESTAMP_TZ('9999-12-31'),
        TRUE, 
        SRC.HASH_DIFF,  
        SRC.IDENTIFIER_NAME,
        SRC.IDENTIFIER_NBR,
        SRC.IDENTIFIER_SUBTYPE               
    )
;`;

// Create update statement for SCD processing
var sqlUpdateCommand = 
`UPDATE HUBDATA.SAT_PROVIDER_IDENTIFIER TGT SET
    ROW_EXPIRATION_DATETIME = DATEADD('millisecond', -1, :1)
    ,IS_CURRENT_ROW_FLAG = FALSE
WHERE (HUB_PROVIDER_HKEY, ROW_EFFECTIVE_DATETIME, IDENTIFIER_NAME, IDENTIFIER_NBR, IDENTIFIER_SUBTYPE) IN (
    SELECT
        HUB_PROVIDER_HKEY, ROW_EFFECTIVE_DATETIME, IDENTIFIER_NAME, IDENTIFIER_NBR, IDENTIFIER_SUBTYPE
    FROM (
        SELECT
            SAT_PROVIDER_IDENTIFIER.HUB_PROVIDER_HKEY,
            SAT_PROVIDER_IDENTIFIER.ROW_EFFECTIVE_DATETIME, 
            SAT_PROVIDER_IDENTIFIER.IDENTIFIER_NAME, 
            SAT_PROVIDER_IDENTIFIER.IDENTIFIER_NBR, 
            SAT_PROVIDER_IDENTIFIER.IDENTIFIER_SUBTYPE
            ,ROW_NUMBER() OVER (PARTITION BY SAT_PROVIDER_IDENTIFIER.HUB_PROVIDER_HKEY, SAT_PROVIDER_IDENTIFIER.HASH_DIFF  ORDER BY SAT_PROVIDER_IDENTIFIER.ROW_EFFECTIVE_DATETIME DESC) as RNUM
        FROM HUBDATA.SAT_PROVIDER_IDENTIFIER
            JOIN STAGEDATA.SAT_PROVIDER_IDENTIFIER_TMP
            ON (
                SAT_PROVIDER_IDENTIFIER_TMP.HUB_PROVIDER_HKEY = SAT_PROVIDER_IDENTIFIER.HUB_PROVIDER_HKEY
                AND SAT_PROVIDER_IDENTIFIER_TMP.IDENTIFIER_NAME = SAT_PROVIDER_IDENTIFIER.IDENTIFIER_NAME
                AND SAT_PROVIDER_IDENTIFIER_TMP.IDENTIFIER_NBR = SAT_PROVIDER_IDENTIFIER.IDENTIFIER_NBR
                AND SAT_PROVIDER_IDENTIFIER_TMP.IDENTIFIER_SUBTYPE = SAT_PROVIDER_IDENTIFIER.IDENTIFIER_SUBTYPE
            )
        WHERE SAT_PROVIDER_IDENTIFIER.IS_CURRENT_ROW_FLAG = TRUE
    )
    WHERE RNUM >= 2
)
;`;

// Create delete statement for SCD processing
var sqlDeleteCommand = 
`UPDATE HUBDATA.SAT_PROVIDER_IDENTIFIER SET
    ROW_EXPIRATION_DATETIME = :1
    ,IS_CURRENT_ROW_FLAG = FALSE
WHERE (HUB_PROVIDER_HKEY, ROW_EFFECTIVE_DATETIME, IDENTIFIER_NAME, IDENTIFIER_NBR, IDENTIFIER_SUBTYPE) IN (
    SELECT
        SAT_PROVIDER_IDENTIFIER.HUB_PROVIDER_HKEY,
            SAT_PROVIDER_IDENTIFIER.ROW_EFFECTIVE_DATETIME, 
            SAT_PROVIDER_IDENTIFIER.IDENTIFIER_NAME, 
            SAT_PROVIDER_IDENTIFIER.IDENTIFIER_NBR, 
            SAT_PROVIDER_IDENTIFIER.IDENTIFIER_SUBTYPE
        FROM HUBDATA.SAT_PROVIDER_IDENTIFIER
        JOIN HUBDATA.HUB_PROVIDER
            ON (HUB_PROVIDER.HUB_PROVIDER_HKEY = SAT_PROVIDER_IDENTIFIER.HUB_PROVIDER_HKEY)
        LEFT OUTER JOIN STAGEDATA.SAT_PROVIDER_IDENTIFIER_TMP
            ON (
                SAT_PROVIDER_IDENTIFIER_TMP.HUB_PROVIDER_HKEY = SAT_PROVIDER_IDENTIFIER.HUB_PROVIDER_HKEY
                AND SAT_PROVIDER_IDENTIFIER_TMP.IDENTIFIER_NAME = SAT_PROVIDER_IDENTIFIER.IDENTIFIER_NAME
                AND SAT_PROVIDER_IDENTIFIER_TMP.IDENTIFIER_NBR = SAT_PROVIDER_IDENTIFIER.IDENTIFIER_NBR
                AND SAT_PROVIDER_IDENTIFIER_TMP.IDENTIFIER_SUBTYPE = SAT_PROVIDER_IDENTIFIER.IDENTIFIER_SUBTYPE
            )
    WHERE HUB_PROVIDER.DATA_SOURCE_NAME IN (SELECT DISTINCT DATA_SOURCE_NAME FROM STAGEDATA.SAT_PROVIDER_IDENTIFIER_TMP)
        AND SAT_PROVIDER_IDENTIFIER.IS_CURRENT_ROW_FLAG = TRUE
        AND SAT_PROVIDER_IDENTIFIER_TMP.HUB_PROVIDER_HKEY IS NULL
)
;`;

var sqlLogCommand = 
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11);`;

try 
{
     //Lookup Job
    var sqlCommand = `SELECT START_TIME FROM LOGDATA.JOB_LOG WHERE JOB_ID = :1;`;
    var sfStatement = snowflake.createStatement({sqlText: sqlCommand, binds: [JOB_ID]});     
    var rsJobLog = sfStatement.execute();
    while (rsJobLog.next())
    {
        loadDatetime = rsJobLog.getColumnValue("START_TIME")
    }
   
    if (!loadDatetime)
        {
            throw {
                code: "-1",
                message: "Job Id Not Found!",
                stackTraceTxt: new Error().stack,
                state: "00000"
            }
        }
    
    //Stage source data to temp table
    targetTableName = `STAGEDATA.SAT_PROVIDER_IDENTIFIER_TMP`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlTempTableCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
    
    //Log re sults to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );
    

    //Execute Merge Command
    targetTableName = `HUBDATA.SAT_PROVIDER_IDENTIFIER`
    startTime = new Date().toISOString();    
    sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );
    
    // Execute the Update Command
    targetTableName = `HUBDATA.SAT_PROVIDER_IDENTIFIER`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlUpdateCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    // Execute the Delete Command
    targetTableName = `HUBDATA.SAT_PROVIDER_IDENTIFIER`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

}

catch (err)
{
    var endTime = new Date().toISOString();
    var result =  "Failed: Code: " + err.code + "\n  State: " + err.state;
    result += "\n  Message: " + err.message;
    result += "\nStack Trace:\n" + err.stackTraceTxt;

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (JOB_ID, NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
        VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11,:12);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[JOB_ID, targetTableName, "TABLE", startTime, endTime, "Failed", sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt, sfStatement.getQueryId()]
        }
    );        
    throw result;
}

//Validate what just loaded
sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_DUPE_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_ALLOWED_VALUE_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

return result;
$$
;