CREATE OR REPLACE PROCEDURE HUBDATA.SPU_LOAD_SAT_CLAIM_LINE(JOB_ID VARCHAR, SOURCE_VIEW_NAME VARCHAR) 
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var loadDatetime = null;
var procedureName = Object.keys(this)[0];
var targetTableName = `HUBDATA.SAT_CLAIM_LINE`; 

// Create temp table statement to be executed.
var sqlTempTableCommand =
`
CREATE OR REPLACE TEMPORARY TABLE STAGEDATA.SAT_CLAIM_LINE_TMP
AS
SELECT * FROM ${SOURCE_VIEW_NAME}
;`;

// Create merge statement to be executed.
    var sqlMergeCommand = 
`    
MERGE INTO HUBDATA.SAT_CLAIM_LINE TGT
USING (
    SELECT     
        HUB_CLAIM_DETAIL_HKEY,
        HASH_DIFF,
        CLAIM_TYPE_CODE,
        CLAIM_RECEIVED_DATE,
        PROCEDURE_CODE,
        PROCEDURE_QUANTITY,
        SERVICE_BEGIN_DATE,
        SERVICE_END_DATE,
        ADD_DATE,
        ACCOUNTS_PAYABLE_PAY_STATUS_CODE,
        ADJUDICATION_STATUS,
        AP_POSTING_DATE,
        BENEFIT_CATEGORY_CODE,
        BENEFIT_LEVEL_CODE,
        BUCKET_STATUS_FLAG,
        CHECK_DATE,
        CHECK_NUMBER,
        CLAIM_DAY_CNT,
        CLEAN_CLAIM_IND,
        COMPANY_CODE,
        DENIED_DAY_CNT,
        ELIGIBILITY_MISC_STATUS_CODE,
        FORM_NUMBER,
        GL_DISTRIBUTION_CODE,
        IS_PROCESSING_COMPLETE,
        KEY_TO_SOURCE_FILE,
        LOCATION_CODE,
        PAY_STATUS_CODE,
        PAYMENT_DATE,
        TOOTH_QUADRANT,
        REVENUE_CODE,
        SERVICE_CNT,
        SERVICE_REASON_CODE,
        SERVICE_STATUS_CODE,
        SERVICE_STATUS_DESC,
        SERVICE_TYPE_CODE,
        TRANSACTION_TYPE_CODE,
        TRANSACTION_TYPE_DESC,
        SOURCE_LAST_UPDATED_DATETIME,
        TOOTH_ID,
        TOOTH_ARCH,
        MEMBER_AGE_NBR,
        AUTHORIZATION_NBR,
        TOOTH_SURFACE_ARRAY,
        HCPCS_CODE,
        CMS_CURRENT_ITERATION_FLAG
    FROM STAGEDATA.SAT_CLAIM_LINE_TMP
) SRC  
ON (TGT.HUB_CLAIM_DETAIL_HKEY = SRC.HUB_CLAIM_DETAIL_HKEY 
AND TGT.HASH_DIFF=SRC.HASH_DIFF
AND TGT.IS_CURRENT_ROW_FLAG = TRUE) 

WHEN NOT MATCHED 

THEN INSERT 
    (
        HUB_CLAIM_DETAIL_HKEY,
        ROW_EFFECTIVE_DATETIME,
        ROW_EXPIRATION_DATETIME,
        IS_CURRENT_ROW_FLAG,
        HASH_DIFF,
        CLAIM_TYPE_CODE,
        CLAIM_RECEIVED_DATE,
        PROCEDURE_CODE,
        PROCEDURE_QUANTITY,
        SERVICE_BEGIN_DATE,
        SERVICE_END_DATE,
        ADD_DATE,
        ACCOUNTS_PAYABLE_PAY_STATUS_CODE,
        ADJUDICATION_STATUS,
        AP_POSTING_DATE,
        BENEFIT_CATEGORY_CODE,
        BENEFIT_LEVEL_CODE,
        BUCKET_STATUS_FLAG,
        CHECK_DATE,
        CHECK_NUMBER,
        CLAIM_DAY_CNT,
        CLEAN_CLAIM_IND,
        COMPANY_CODE,
        DENIED_DAY_CNT,
        ELIGIBILITY_MISC_STATUS_CODE,
        FORM_NUMBER,
        GL_DISTRIBUTION_CODE,
        IS_PROCESSING_COMPLETE,
        KEY_TO_SOURCE_FILE,
        LOCATION_CODE,
        PAY_STATUS_CODE,
        PAYMENT_DATE,
        TOOTH_QUADRANT,
        REVENUE_CODE,
        SERVICE_CNT,
        SERVICE_REASON_CODE,
        SERVICE_STATUS_CODE,
        SERVICE_STATUS_DESC,
        SERVICE_TYPE_CODE,
        TRANSACTION_TYPE_CODE,
        TRANSACTION_TYPE_DESC,
        SOURCE_LAST_UPDATED_DATETIME,
        TOOTH_ID,
        TOOTH_ARCH,
        MEMBER_AGE_NBR,
        AUTHORIZATION_NBR,
        TOOTH_SURFACE_ARRAY,
        HCPCS_CODE,
        CMS_CURRENT_ITERATION_FLAG
    )
 VALUES 
    (
        SRC.HUB_CLAIM_DETAIL_HKEY,
        :1,
        TO_TIMESTAMP_TZ('9999-12-31'),
        TRUE,
        SRC.HASH_DIFF,
        SRC.CLAIM_TYPE_CODE,
        SRC.CLAIM_RECEIVED_DATE,
        SRC.PROCEDURE_CODE,
        SRC.PROCEDURE_QUANTITY,
        SRC.SERVICE_BEGIN_DATE,
        SRC.SERVICE_END_DATE,
        SRC.ADD_DATE,
        SRC.ACCOUNTS_PAYABLE_PAY_STATUS_CODE,
        SRC.ADJUDICATION_STATUS,
        SRC.AP_POSTING_DATE,
        SRC.BENEFIT_CATEGORY_CODE,
        SRC.BENEFIT_LEVEL_CODE,
        SRC.BUCKET_STATUS_FLAG,
        SRC.CHECK_DATE,
        SRC.CHECK_NUMBER,
        SRC.CLAIM_DAY_CNT,
        SRC.CLEAN_CLAIM_IND,
        SRC.COMPANY_CODE,
        SRC.DENIED_DAY_CNT,
        SRC.ELIGIBILITY_MISC_STATUS_CODE,
        SRC.FORM_NUMBER,
        SRC.GL_DISTRIBUTION_CODE,
        SRC.IS_PROCESSING_COMPLETE,
        SRC.KEY_TO_SOURCE_FILE,
        SRC.LOCATION_CODE,
        SRC.PAY_STATUS_CODE,
        SRC.PAYMENT_DATE,
        SRC.TOOTH_QUADRANT,
        SRC.REVENUE_CODE,
        SRC.SERVICE_CNT,
        SRC.SERVICE_REASON_CODE,
        SRC.SERVICE_STATUS_CODE,
        SRC.SERVICE_STATUS_DESC,
        SRC.SERVICE_TYPE_CODE,
        SRC.TRANSACTION_TYPE_CODE,
        SRC.TRANSACTION_TYPE_DESC,
        SRC.SOURCE_LAST_UPDATED_DATETIME,
        SRC.TOOTH_ID,
        SRC.TOOTH_ARCH,
        SRC.MEMBER_AGE_NBR,
        SRC.AUTHORIZATION_NBR,
        SRC.TOOTH_SURFACE_ARRAY,
        SRC.HCPCS_CODE,
        SRC.CMS_CURRENT_ITERATION_FLAG
    )
;`;

// Create update statement to be executed.
var sqlUpdateCommand=
`UPDATE HUBDATA.SAT_CLAIM_LINE TGT
SET 
    ROW_EXPIRATION_DATETIME = DATEADD('millisecond', -1, :1)
    ,IS_CURRENT_ROW_FLAG = FALSE
WHERE (HUB_CLAIM_DETAIL_HKEY, ROW_EFFECTIVE_DATETIME) IN 
(
    SELECT HUB_CLAIM_DETAIL_HKEY, ROW_EFFECTIVE_DATETIME
    FROM (
        SELECT 
            SAT_CLAIM_LINE.HUB_CLAIM_DETAIL_HKEY,
            SAT_CLAIM_LINE.ROW_EFFECTIVE_DATETIME,
            ROW_NUMBER() OVER (PARTITION BY SAT_CLAIM_LINE.HUB_CLAIM_DETAIL_HKEY ORDER BY SAT_CLAIM_LINE.ROW_EFFECTIVE_DATETIME DESC) AS RNUM
        FROM HUBDATA.SAT_CLAIM_LINE
            JOIN STAGEDATA.SAT_CLAIM_LINE_TMP
                ON (SAT_CLAIM_LINE_TMP.HUB_CLAIM_DETAIL_HKEY = SAT_CLAIM_LINE.HUB_CLAIM_DETAIL_HKEY)
        WHERE SAT_CLAIM_LINE.IS_CURRENT_ROW_FLAG = TRUE
    )
    WHERE RNUM >= 2
);`;

// Create delete statement to be executed.
var sqlDeleteCommand =
`UPDATE HUBDATA.SAT_CLAIM_LINE TGT
SET 
    ROW_EXPIRATION_DATETIME = :1
    ,IS_CURRENT_ROW_FLAG = FALSE
WHERE (HUB_CLAIM_DETAIL_HKEY, ROW_EFFECTIVE_DATETIME) IN
(
    SELECT
    SAT_CLAIM_LINE.HUB_CLAIM_DETAIL_HKEY,
    SAT_CLAIM_LINE.ROW_EFFECTIVE_DATETIME
    FROM HUBDATA.SAT_CLAIM_LINE
        JOIN HUBDATA.HUB_CLAIM_DETAIL
            ON (HUB_CLAIM_DETAIL.HUB_CLAIM_DETAIL_HKEY = SAT_CLAIM_LINE.HUB_CLAIM_DETAIL_HKEY)
        LEFT OUTER JOIN STAGEDATA.SAT_CLAIM_LINE_TMP
            ON (SAT_CLAIM_LINE_TMP.HUB_CLAIM_DETAIL_HKEY = SAT_CLAIM_LINE.HUB_CLAIM_DETAIL_HKEY)
    WHERE HUB_CLAIM_DETAIL.DATA_SOURCE_NAME IN (SELECT DISTINCT DATA_SOURCE_NAME FROM STAGEDATA.SAT_CLAIM_LINE_TMP)
    AND SAT_CLAIM_LINE.IS_CURRENT_ROW_FLAG = TRUE
    AND SAT_CLAIM_LINE_TMP.HUB_CLAIM_DETAIL_HKEY IS NULL
);`;

var sqlLogCommand = 
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11);`;

try 
{
     //Lookup Job
    var sqlCommand = `SELECT START_TIME FROM LOGDATA.JOB_LOG WHERE JOB_ID = :1;`;
    var sfStatement = snowflake.createStatement({sqlText: sqlCommand, binds: [JOB_ID]});     
    var rsJobLog = sfStatement.execute();
    while (rsJobLog.next())
    {
        loadDatetime = rsJobLog.getColumnValue("START_TIME")
    }
   
    if (!loadDatetime)
        {
            throw {
                code: "-1",
                message: "Job Id Not Found!",
                stackTraceTxt: new Error().stack,
                state: "00000"
            }
        }

    //Stage source data to temp table to be reused later.
    targetTableName = `STAGEDATA.SAT_CLAIM_LINE_TMP`;
    startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlTempTableCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    //Execute Merge Command
    targetTableName = `HUBDATA.SAT_CLAIM_LINE`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    // Execute the Update Command
    targetTableName = `HUBDATA.SAT_CLAIM_LINE`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlUpdateCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    // Execute the Delete Command
    targetTableName = `HUBDATA.SAT_CLAIM_LINE`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

}

catch (err)
{
    var endTime = new Date().toISOString();
    var result =  "Failed: Code: " + err.code + "\n  State: " + err.state;
    result += "\n  Message: " + err.message;
    result += "\nStack Trace:\n" + err.stackTraceTxt;

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (JOB_ID, NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
        VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11,:12);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[JOB_ID, targetTableName, "TABLE", startTime, endTime, "Failed", sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt, sfStatement.getQueryId()]
        }
    );        
    throw result;
}

//Validate what just loaded
sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_DUPE_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_ALLOWED_VALUE_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

return result;
$$
;
