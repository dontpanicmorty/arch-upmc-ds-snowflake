CREATE OR REPLACE PROCEDURE HUBDATA.SPU_LOAD_LNK_MEMBERSHIP_GROUP_RIDER(JOB_ID VARCHAR, SOURCE_VIEW_NAME VARCHAR)
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var loadDatetime = null;
var procedureName = Object.keys(this)[0];
var targetTableName = `HUBDATA.LNK_MEMBERSHIP_GROUP_RIDER`; 

// Create temp table statement to be executed.
var sqlTempTableCommand =
`
CREATE OR REPLACE TEMPORARY TABLE STAGEDATA.LNK_MEMBERSHIP_GROUP_RIDER_TMP
AS
SELECT * FROM ${SOURCE_VIEW_NAME}
;`;

// Create merge statement to be executed.
var sqlMergeCommand = 
`    
MERGE INTO HUBDATA.LNK_MEMBERSHIP_GROUP_RIDER TGT
USING (
    SELECT 
        LNK_MEMBERSHIP_GROUP_RIDER_HKEY,
        HUB_MEMBERSHIP_GROUP_HKEY,
        HUB_RIDER_HKEY,
        MG_TPA_CLIENT_ID,
        MG_TPA_ID,
        MG_TPA_DIV_ID,
        MG_GROUP_NBR,
        MG_SUB_GROUP_NBR,
        R_TPA_CLIENT_ID,
        R_TPA_ID,
        R_TPA_DIV_ID,
        R_DATA_SOURCE_NAME,
        R_RIDER_CODE
    FROM STAGEDATA.LNK_MEMBERSHIP_GROUP_RIDER_TMP
) SRC  
ON (TGT.LNK_MEMBERSHIP_GROUP_RIDER_HKEY = SRC.LNK_MEMBERSHIP_GROUP_RIDER_HKEY
AND TGT.IS_CURRENT_ROW_FLAG = TRUE)  

WHEN NOT MATCHED 

THEN INSERT 
    (
        LNK_MEMBERSHIP_GROUP_RIDER_HKEY,
        HUB_MEMBERSHIP_GROUP_HKEY,
        HUB_RIDER_HKEY,
        ROW_EFFECTIVE_DATETIME,
        ROW_EXPIRATION_DATETIME,
        IS_CURRENT_ROW_FLAG,
        MG_TPA_CLIENT_ID,
        MG_TPA_ID,
        MG_TPA_DIV_ID,
        MG_GROUP_NBR,
        MG_SUB_GROUP_NBR,
        R_TPA_CLIENT_ID,
        R_TPA_ID,
        R_TPA_DIV_ID,
        R_DATA_SOURCE_NAME,
        R_RIDER_CODE
    )
 VALUES 
    (
        src.LNK_MEMBERSHIP_GROUP_RIDER_HKEY,
        src.HUB_MEMBERSHIP_GROUP_HKEY,
        src.HUB_RIDER_HKEY,
        :1,
        TO_TIMESTAMP_TZ('9999-12-31'),
        TRUE,
        src.MG_TPA_CLIENT_ID,
        src.MG_TPA_ID,
        src.MG_TPA_DIV_ID,
        src.MG_GROUP_NBR,
        src.MG_SUB_GROUP_NBR,
        src.R_TPA_CLIENT_ID,
        src.R_TPA_ID,
        src.R_TPA_DIV_ID,
        src.R_DATA_SOURCE_NAME,
        src.R_RIDER_CODE
    )
;`;

// Create update statement to be executed.
var sqlUpdateCommand=
`
UPDATE HUBDATA.LNK_MEMBERSHIP_GROUP_RIDER TGT SET 
    ROW_EXPIRATION_DATETIME = DATEADD('millisecond', -1, :1)
    ,IS_CURRENT_ROW_FLAG = FALSE
WHERE (HUB_MEMBERSHIP_GROUP_HKEY, HUB_RIDER_HKEY, ROW_EFFECTIVE_DATETIME) IN (
    SELECT HUB_MEMBERSHIP_GROUP_HKEY, HUB_RIDER_HKEY, ROW_EFFECTIVE_DATETIME
    FROM (
        SELECT 
            LNK_MEMBERSHIP_GROUP_RIDER.HUB_MEMBERSHIP_GROUP_HKEY,
            LNK_MEMBERSHIP_GROUP_RIDER.HUB_RIDER_HKEY,
            LNK_MEMBERSHIP_GROUP_RIDER.ROW_EFFECTIVE_DATETIME,
            ROW_NUMBER() OVER (PARTITION BY LNK_MEMBERSHIP_GROUP_RIDER.HUB_MEMBERSHIP_GROUP_HKEY, LNK_MEMBERSHIP_GROUP_RIDER.HUB_RIDER_HKEY ORDER BY LNK_MEMBERSHIP_GROUP_RIDER.ROW_EFFECTIVE_DATETIME DESC) AS RNUM
        FROM HUBDATA.LNK_MEMBERSHIP_GROUP_RIDER
            JOIN STAGEDATA.LNK_MEMBERSHIP_GROUP_RIDER_TMP
                ON (LNK_MEMBERSHIP_GROUP_RIDER_TMP.HUB_MEMBERSHIP_GROUP_HKEY = LNK_MEMBERSHIP_GROUP_RIDER.HUB_MEMBERSHIP_GROUP_HKEY
                AND LNK_MEMBERSHIP_GROUP_RIDER_TMP.HUB_RIDER_HKEY = LNK_MEMBERSHIP_GROUP_RIDER.HUB_RIDER_HKEY)
        WHERE LNK_MEMBERSHIP_GROUP_RIDER.IS_CURRENT_ROW_FLAG = TRUE
    )
    WHERE RNUM >= 2
)
;`;

// Create delete statement to be executed.
var sqlDeleteCommand =
`
UPDATE HUBDATA.LNK_MEMBERSHIP_GROUP_RIDER
SET 
    ROW_EXPIRATION_DATETIME = :1
    ,IS_CURRENT_ROW_FLAG = FALSE
WHERE (LNK_MEMBERSHIP_GROUP_RIDER_HKEY, ROW_EFFECTIVE_DATETIME) IN
(
    SELECT
    LNK_MEMBERSHIP_GROUP_RIDER.LNK_MEMBERSHIP_GROUP_RIDER_HKEY,
    LNK_MEMBERSHIP_GROUP_RIDER.ROW_EFFECTIVE_DATETIME
    FROM HUBDATA.LNK_MEMBERSHIP_GROUP_RIDER
        LEFT OUTER JOIN STAGEDATA.LNK_MEMBERSHIP_GROUP_RIDER_TMP
            ON (LNK_MEMBERSHIP_GROUP_RIDER_TMP.LNK_MEMBERSHIP_GROUP_RIDER_HKEY = LNK_MEMBERSHIP_GROUP_RIDER.LNK_MEMBERSHIP_GROUP_RIDER_HKEY)
    WHERE LNK_MEMBERSHIP_GROUP_RIDER.IS_CURRENT_ROW_FLAG = TRUE
    AND LNK_MEMBERSHIP_GROUP_RIDER_TMP.LNK_MEMBERSHIP_GROUP_RIDER_HKEY IS NULL
    AND LNK_MEMBERSHIP_GROUP_RIDER.R_DATA_SOURCE_NAME IN (SELECT DISTINCT R_DATA_SOURCE_NAME FROM STAGEDATA.LNK_MEMBERSHIP_GROUP_RIDER_TMP)
)
;`;

var sqlLogCommand = 
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11);`;

try 
{
     //Lookup Job
    var sqlCommand = `SELECT START_TIME FROM LOGDATA.JOB_LOG WHERE JOB_ID = :1;`;
    var sfStatement = snowflake.createStatement({sqlText: sqlCommand, binds: [JOB_ID]});     
    var rsJobLog = sfStatement.execute();
    while (rsJobLog.next())
    {
        loadDatetime = rsJobLog.getColumnValue("START_TIME")
    }
   
    if (!loadDatetime)
        {
            throw {
                code: "-1",
                message: "Job Id Not Found!",
                stackTraceTxt: new Error().stack,
                state: "00000"
            }
        }

    //Stage source data to temp table to be reused later.
    targetTableName = `STAGEDATA.LNK_MEMBERSHIP_GROUP_RIDER_TMP`;
    startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlTempTableCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );    

    //Execute Merge Command
    targetTableName = `HUBDATA.LNK_MEMBERSHIP_GROUP_RIDER`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    // Execute the Update Command
    targetTableName = `HUBDATA.LNK_MEMBERSHIP_GROUP_RIDER`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlUpdateCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    // Execute the Delete Command
    targetTableName = `HUBDATA.LNK_MEMBERSHIP_GROUP_RIDER`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

}

catch (err)
{
    var endTime = new Date().toISOString();
    var result =  "Failed: Code: " + err.code + "\n  State: " + err.state;
    result += "\n  Message: " + err.message;
    result += "\nStack Trace:\n" + err.stackTraceTxt;

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (JOB_ID, NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
        VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11,:12);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[JOB_ID, targetTableName, "TABLE", startTime, endTime, "Failed", sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt, sfStatement.getQueryId()]
        }
    );        
    throw result;
}

//Validate what just loaded
sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_DUPE_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_ALLOWED_VALUE_CHECK('${JOB_ID}','${targetTableName}');`;
snowflake.execute({sqlText});

return result;
$$
;
