CREATE OR REPLACE PROCEDURE HUBDATA.SPU_LOAD_SAT_CLAIM_AUTHORIZATION_DETAIL(JOB_ID VARCHAR, SOURCE_VIEW_NAME VARCHAR) 
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var loadDatetime = null;
var procedureName = Object.keys(this)[0];
var targetTableName = `HUBDATA.SAT_CLAIM_AUTHORIZATION_DETAIL`; 

// Create temp table statement to be executed.
var sqlTempTableCommand =
`
CREATE OR REPLACE TEMPORARY TABLE STAGEDATA.SAT_CLAIM_AUTHORIZATION_DETAIL_TMP
AS
SELECT * FROM ${SOURCE_VIEW_NAME}
;`;

// Create merge statement to be executed.
var sqlMergeCommand = 
`    
MERGE INTO HUBDATA.SAT_CLAIM_AUTHORIZATION_DETAIL TGT
USING (
    SELECT     
        HUB_CLAIM_AUTHORIZATION_DETAIL_HKEY,
        HASH_DIFF,
        PROCEDURE_CODE,
        DETERMINATION_STATUS_DESC,
        DETERMINATION_DATE,
        SERVICE_BEGIN_DATE,
        SERVICE_END_DATE,
        AUTHORIZED_QTY,
        CONSUMED_QTY,
        DENIED_QTY,
        REQUESTED_QTY,
        TOOTH_ID,
        TOOTH_ARCH,
        TOOTH_QUADRANT
    FROM STAGEDATA.SAT_CLAIM_AUTHORIZATION_DETAIL_TMP
) SRC  
ON (TGT.HUB_CLAIM_AUTHORIZATION_DETAIL_HKEY = SRC.HUB_CLAIM_AUTHORIZATION_DETAIL_HKEY
AND TGT.HASH_DIFF = SRC.HASH_DIFF
AND TGT.IS_CURRENT_ROW_FLAG = TRUE)  

WHEN NOT MATCHED 

THEN INSERT 
    (
        HUB_CLAIM_AUTHORIZATION_DETAIL_HKEY,
        ROW_EFFECTIVE_DATETIME,
        ROW_EXPIRATION_DATETIME,
        IS_CURRENT_ROW_FLAG,
        HASH_DIFF,
        PROCEDURE_CODE,
        DETERMINATION_STATUS_DESC,
        DETERMINATION_DATE,
        SERVICE_BEGIN_DATE,
        SERVICE_END_DATE,
        AUTHORIZED_QTY,
        CONSUMED_QTY,
        DENIED_QTY,
        REQUESTED_QTY,
        TOOTH_ID,
        TOOTH_ARCH,
        TOOTH_QUADRANT
    )
 VALUES 
    (
        SRC.HUB_CLAIM_AUTHORIZATION_DETAIL_HKEY,
        :1,
        TO_TIMESTAMP_TZ('9999-12-31'),
        TRUE,
        SRC.HASH_DIFF,
        SRC.PROCEDURE_CODE,
        SRC.DETERMINATION_STATUS_DESC,
        SRC.DETERMINATION_DATE,
        SRC.SERVICE_BEGIN_DATE,
        SRC.SERVICE_END_DATE,
        SRC.AUTHORIZED_QTY,
        SRC.CONSUMED_QTY,
        SRC.DENIED_QTY,
        SRC.REQUESTED_QTY,
        SRC.TOOTH_ID,
        SRC.TOOTH_ARCH,
        SRC.TOOTH_QUADRANT
    )
;`;
    
// Create update statement to be executed.
var sqlUpdateCommand=
`
UPDATE HUBDATA.SAT_CLAIM_AUTHORIZATION_DETAIL TGT SET 
    ROW_EXPIRATION_DATETIME = DATEADD('millisecond', -1, :1)
    , IS_CURRENT_ROW_FLAG = FALSE
WHERE (HUB_CLAIM_AUTHORIZATION_DETAIL_HKEY, ROW_EFFECTIVE_DATETIME) IN (
    SELECT HUB_CLAIM_AUTHORIZATION_DETAIL_HKEY, ROW_EFFECTIVE_DATETIME
    FROM (
        SELECT 
            SAT_CLAIM_AUTHORIZATION_DETAIL.HUB_CLAIM_AUTHORIZATION_DETAIL_HKEY,
            SAT_CLAIM_AUTHORIZATION_DETAIL.ROW_EFFECTIVE_DATETIME,
            ROW_NUMBER() OVER (PARTITION BY SAT_CLAIM_AUTHORIZATION_DETAIL.HUB_CLAIM_AUTHORIZATION_DETAIL_HKEY ORDER BY SAT_CLAIM_AUTHORIZATION_DETAIL.ROW_EFFECTIVE_DATETIME DESC) AS RNUM
        FROM HUBDATA.SAT_CLAIM_AUTHORIZATION_DETAIL
            JOIN STAGEDATA.SAT_CLAIM_AUTHORIZATION_DETAIL_TMP
                ON (SAT_CLAIM_AUTHORIZATION_DETAIL_TMP.HUB_CLAIM_AUTHORIZATION_DETAIL_HKEY = SAT_CLAIM_AUTHORIZATION_DETAIL.HUB_CLAIM_AUTHORIZATION_DETAIL_HKEY)
        WHERE SAT_CLAIM_AUTHORIZATION_DETAIL.IS_CURRENT_ROW_FLAG = TRUE
    )
    WHERE RNUM >= 2
)
;`;

// Create delete statement to be executed.
var sqlDeleteCommand =
`
UPDATE HUBDATA.SAT_CLAIM_AUTHORIZATION_DETAIL
SET 
    ROW_EXPIRATION_DATETIME = :1
    ,IS_CURRENT_ROW_FLAG = FALSE
WHERE (HUB_CLAIM_AUTHORIZATION_DETAIL_HKEY, ROW_EFFECTIVE_DATETIME) IN
(
    SELECT
    SAT_CLAIM_AUTHORIZATION_DETAIL.HUB_CLAIM_AUTHORIZATION_DETAIL_HKEY,
    SAT_CLAIM_AUTHORIZATION_DETAIL.ROW_EFFECTIVE_DATETIME
    FROM HUBDATA.SAT_CLAIM_AUTHORIZATION_DETAIL
        JOIN HUBDATA.HUB_CLAIM_AUTHORIZATION_DETAIL
            ON (HUB_CLAIM_AUTHORIZATION_DETAIL.HUB_CLAIM_AUTHORIZATION_DETAIL_HKEY = SAT_CLAIM_AUTHORIZATION_DETAIL.HUB_CLAIM_AUTHORIZATION_DETAIL_HKEY)
        LEFT OUTER JOIN STAGEDATA.SAT_CLAIM_AUTHORIZATION_DETAIL_TMP
            ON (SAT_CLAIM_AUTHORIZATION_DETAIL_TMP.HUB_CLAIM_AUTHORIZATION_DETAIL_HKEY = SAT_CLAIM_AUTHORIZATION_DETAIL.HUB_CLAIM_AUTHORIZATION_DETAIL_HKEY)

    WHERE HUB_CLAIM_AUTHORIZATION_DETAIL.DATA_SOURCE_NAME IN (SELECT DISTINCT DATA_SOURCE_NAME FROM STAGEDATA.SAT_CLAIM_AUTHORIZATION_DETAIL_TMP)
    AND SAT_CLAIM_AUTHORIZATION_DETAIL.IS_CURRENT_ROW_FLAG = TRUE
    AND SAT_CLAIM_AUTHORIZATION_DETAIL_TMP.HUB_CLAIM_AUTHORIZATION_DETAIL_HKEY IS NULL
)
;`;

var sqlLogCommand = 
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11);`;

try 
{
     //Lookup Job
    var sqlCommand = `SELECT START_TIME FROM LOGDATA.JOB_LOG WHERE JOB_ID = :1;`;
    var sfStatement = snowflake.createStatement({sqlText: sqlCommand, binds: [JOB_ID]});     
    var rsJobLog = sfStatement.execute();
    while (rsJobLog.next())
    {
        loadDatetime = rsJobLog.getColumnValue("START_TIME")
    }
   
    if (!loadDatetime)
        {
            throw {
                code: "-1",
                message: "Job Id Not Found!",
                stackTraceTxt: new Error().stack,
                state: "00000"
            }
        }

    //Stage source data to temp table to be reused later.
    targetTableName = `STAGEDATA.SAT_CLAIM_AUTHORIZATION_DETAIL_TMP`;
    startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlTempTableCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    //Execute Merge Command
    targetTableName = `HUBDATA.SAT_CLAIM_AUTHORIZATION_DETAIL`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    // Execute the Update Command
    targetTableName = `HUBDATA.SAT_CLAIM_AUTHORIZATION_DETAIL`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlUpdateCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

    // Execute the Delete Command
    targetTableName = `HUBDATA.SAT_CLAIM_AUTHORIZATION_DETAIL`;
    startTime = new Date().toISOString();
    sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand, binds:[loadDatetime]});
    sfStatement.execute();
    endTime = new Date().toISOString();
    result = "Succeeded";

    //Log results to table
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [JOB_ID, targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        }
    );

}

catch (err)
{
    var endTime = new Date().toISOString();
    var result =  "Failed: Code: " + err.code + "\n  State: " + err.state;
    result += "\n  Message: " + err.message;
    result += "\nStack Trace:\n" + err.stackTraceTxt;

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (JOB_ID, NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
        VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11,:12);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[JOB_ID, targetTableName, "TABLE", startTime, endTime, "Failed", sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt, sfStatement.getQueryId()]
        }
    );        
    throw result;
}

//Validate what just loaded
sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_DUPE_CHECK('${JOB_ID}','${targetTableName}');`;
resultSet = snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK('${JOB_ID}','${targetTableName}');`;
resultSet = snowflake.execute({sqlText});

sqlText = `CALL LOGDATA.SPU_VALIDATE_DATA_ALLOWED_VALUE_CHECK('${JOB_ID}','${targetTableName}');`;
resultSet = snowflake.execute({sqlText});

return result;
$$
;
