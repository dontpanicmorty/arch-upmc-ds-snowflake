CREATE OR REPLACE FUNCTION STAGEDATA.FXN_GET_LOCATION_CODE_MC400(DATA_SOURCE_NAME VARCHAR, SERVICE_TYPE_CODE VARCHAR, SERVICE_REASON_CODE VARCHAR, LOCATION_TYPE_CODE VARCHAR)
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
COMMENT ='Returns the location_code for a claim line in MC400'
AS
$$

const validDataSources = ['MC400Dnt','MC400Upm'];

// Validate the data source

if (!validDataSources.includes(DATA_SOURCE_NAME))
{
    throw 'Invalid DATA_SOURCE_NAME: '+DATA_SOURCE_NAME;
}

switch (SERVICE_TYPE_CODE)
{
  case 'F':
    if (SERVICE_REASON_CODE == 'LL') 
      {
        return 'O';
      } 
    else 
      {
        return 'I';
      }
    break;
  case 'P':
    if (LOCATION_TYPE_CODE)
      {
        return LOCATION_TYPE_CODE
      }
    else
      {
        return 'U';
      }
    break;
  case 'SM':
    return 'O';
    break;
}

return 'U';
$$
;
