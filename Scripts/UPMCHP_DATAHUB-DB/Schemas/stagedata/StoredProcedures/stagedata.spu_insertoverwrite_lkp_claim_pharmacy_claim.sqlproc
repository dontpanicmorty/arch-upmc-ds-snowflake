CREATE OR REPLACE PROCEDURE STAGEDATA.SPU_INSERTOVERWRITE_LKP_CLAIM_PHARMACY_CLAIM(JOB_ID VARCHAR, SOURCE_VIEW_NAME VARCHAR)
