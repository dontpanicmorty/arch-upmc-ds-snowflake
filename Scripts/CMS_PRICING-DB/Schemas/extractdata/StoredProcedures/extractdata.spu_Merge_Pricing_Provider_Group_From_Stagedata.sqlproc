CREATE OR REPLACE PROCEDURE EXTRACTDATA.SPU_MERGE_PRICING_PROVIDER_GROUP_FROM_STAGEDATA ()
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$

let procName = Object.keys(this).find(a => a.startsWith('SPU'));
let startTime = new Date();
let resultSet, result;

/* Create MERGE statement to be run */
let sqlText = `MERGE INTO EXTRACTDATA.PRICING_PROVIDER_GROUP AS tgt
USING (
  SELECT PRICING_PROVIDER_SET_KEYS
  FROM STAGEDATA.PRICING_PROVIDER_GROUP_SELECT_VW
) AS src
ON (
  tgt.PRICING_PROVIDER_SET_KEYS = src.PRICING_PROVIDER_SET_KEYS
)

WHEN NOT MATCHED THEN
INSERT 
    (PRICING_PROVIDER_SET_KEYS)
VALUES
    (src.PRICING_PROVIDER_SET_KEYS);`;

try 
{
    /*Execute INSERT OVERRIDE Command */
    const sfStatement = snowflake.createStatement({sqlText});
    resultSet = sfStatement.execute();    
    resultSet.next();

    result = 'Successful';
    
    const endTime = new Date();
    sqlText = `INSERT INTO LOGDATA.EXTRACT_HISTORY (
        NAME
        ,TYPE
        ,START_TIME
        ,END_TIME
        ,INSERT_COUNT
        ,RESULT_TEXT
        ,SQL_STATEMENT
    ) VALUES (
      '${procName}',
      'PROCEDURE',
      '${startTime.toISOString()}',
      '${endTime.toISOString()}',
      '${resultSet.getColumnValueAsString("number of rows inserted")}',
      '${result}',
      '${sqlText}'
    )`;
    snowflake.execute({sqlText});
}
catch (err)
{
    sqlText = (sqlText || '(no SQL run yet)').replace(/'/g, "''");
    let code = err.code || err.name;
    let state = err.state || '(JavaScript error, not provided)'
    let message = (err.message || '(JavaScript error, not provided)').replace(/'/g, "''")
    let stack = (err.stackTraceTxt || err.stack).replace(/'/g, "''");
    
    result = 'Failed';
    let endTime = new Date();
    sqlText = `INSERT INTO LOGDATA.EXTRACT_HISTORY (
        NAME
        ,TYPE
        ,START_TIME
        ,END_TIME
        ,RESULT_TEXT
        ,SQL_STATEMENT
        ,ERROR_CODE
        ,ERROR_STATE
        ,ERROR_MESSAGE
        ,ERROR_STACK_TRACE_TEXT
    ) VALUES (
      '${procName}',
      'PROCEDURE',
      '${startTime.toISOString()}',
      '${endTime.toISOString()}',
      '${result}',
      '${sqlText}',
      '${code}',
      '${state}',
      '${message}',
      '${stack}'
    )`;
    snowflake.execute({sqlText});
    throw err;
}
return result;

$$;


