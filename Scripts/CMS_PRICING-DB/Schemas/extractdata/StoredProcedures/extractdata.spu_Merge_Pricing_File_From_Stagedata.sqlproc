CREATE OR REPLACE PROCEDURE EXTRACTDATA.SPU_MERGE_PRICING_FILE_FROM_STAGEDATA ()
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$

// PRICING_FILE has update based off last_updated_on_date
let procName = Object.keys(this).find(a => a.startsWith('SPU'));
let startTime = new Date();
let resultSet, result;

/* Create MERGE statement to be run */
let sqlText = `MERGE INTO EXTRACTDATA.PRICING_FILE AS tgt
USING (
  SELECT DISTINCT REPORTING_ENTITY_KEY, FILE_TYPE_NAME, FILE_DESC, FILE_LOCATION_URL, LAST_UPDATED_ON_DATE
  FROM STAGEDATA.PRICING_FILE_SELECT_VW
) AS src
ON (
  tgt.REPORTING_ENTITY_KEY = src.REPORTING_ENTITY_KEY
  AND tgt.FILE_TYPE_NAME = src.FILE_TYPE_NAME
  AND tgt.FILE_DESC = src.FILE_DESC
  AND ((tgt.FILE_LOCATION_URL = src.FILE_LOCATION_URL) OR
    (tgt.FILE_LOCATION_URL IS NULL AND src.FILE_LOCATION_URL IS NULL))
)

WHEN MATCHED THEN UPDATE SET LAST_UPDATED_ON_DATE = src.LAST_UPDATED_ON_DATE
WHEN NOT MATCHED THEN
INSERT 
    (REPORTING_ENTITY_KEY, FILE_TYPE_NAME, FILE_DESC, FILE_LOCATION_URL, LAST_UPDATED_ON_DATE)
VALUES
    (src.REPORTING_ENTITY_KEY, src.FILE_TYPE_NAME, src.FILE_DESC, src.FILE_LOCATION_URL, src.LAST_UPDATED_ON_DATE)
;`;

try 
{
    /*Execute INSERT OVERRIDE Command */
    const sfStatement = snowflake.createStatement({sqlText});
    resultSet = sfStatement.execute();    
    resultSet.next();

    result = 'Successful';
    
    const endTime = new Date();
    sqlText = `INSERT INTO LOGDATA.EXTRACT_HISTORY (
        NAME
        ,TYPE
        ,START_TIME
        ,END_TIME
        ,INSERT_COUNT
        ,UPDATE_COUNT
        ,RESULT_TEXT
        ,SQL_STATEMENT
    ) VALUES (
      '${procName}',
      'PROCEDURE',
      '${startTime.toISOString()}',
      '${endTime.toISOString()}',
      '${resultSet.getColumnValueAsString("number of rows inserted")}',
      '${resultSet.getColumnValueAsString("number of rows updated")}',
      '${result}',
      '${sqlText}'
    )`;
    snowflake.execute({sqlText});
}
catch (err)
{
    sqlText = (sqlText || '(no SQL run yet)').replace(/'/g, "''");
    let code = err.code || err.name;
    let state = err.state || '(JavaScript error, not provided)'
    let message = (err.message || '(JavaScript error, not provided)').replace(/'/g, "''")
    let stack = (err.stackTraceTxt || err.stack).replace(/'/g, "''");
    
    result = 'Failed';
    let endTime = new Date();
    sqlText = `INSERT INTO LOGDATA.EXTRACT_HISTORY (
        NAME
        ,TYPE
        ,START_TIME
        ,END_TIME
        ,RESULT_TEXT
        ,SQL_STATEMENT
        ,ERROR_CODE
        ,ERROR_STATE
        ,ERROR_MESSAGE
        ,ERROR_STACK_TRACE_TEXT
    ) VALUES (
      '${procName}',
      'PROCEDURE',
      '${startTime.toISOString()}',
      '${endTime.toISOString()}',
      '${result}',
      '${sqlText}',
      '${code}',
      '${state}',
      '${message}',
      '${stack}'
    )`;
    snowflake.execute({sqlText});
    throw err;
}
return result;

$$;
