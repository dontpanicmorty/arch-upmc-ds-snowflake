/**
Creates the PRICE_CATEGORY table from all component tables. Needs to be run
before anything else; grabs all the possible priceCategiries and inserts them 
into the table with an integer key.
*/
!set variable_substitution=true;

CREATE OR REPLACE PROCEDURE STAGEDATA.SPU_INSERT_OVERWRITE_NEGOTIATED_PRICE_INTERNAL ()
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$

let procName = Object.keys(this).find(a => a.startsWith('SPU'));
let startTime = new Date();
let sqlText, resultSet;

try {
  sqlText = `INSERT OVERWRITE INTO STAGEDATA.NEGOTIATED_PRICE_INTERNAL_HOLD (
  SOURCE_TYPE,
  SCHEDULE_TYPE,
  SEGMENT,
  SCHEDULE_DETAIL,
  MATCH_STATE,
  STATE,
  VENDOR,
	PROV_SET,
	PROVIDER_TYPE,
	BILLING_CODE,
	NEGOTIATED_TYPE_NAME,
	EXPIRATION_DATE,
	NEGOTIATED_RATE_AMT,
	PLACE_OF_SERVICE_CODES,
	BILLING_CODE_MODIFIERS,
	BILLING_CLASS_NAME
)

-- from PRACTITIONER_FEE_SCHEDULE
SELECT 
    'practitioner' AS SOURCE_TYPE,
    PRACTITIONER_FEE_SCHEDULE.SCHEDULE_TYPE,
    PRACTITIONER_FEE_SCHEDULE.SEGMENT,
    PRACTITIONER_FEE_SCHEDULE.SCHEDULE_DETAIL,
    PRACTITIONER_FEE_SCHEDULE.MATCH_STATE,
    PRACTITIONER_FEE_SCHEDULE.STATE,
    'NONE' AS VENDOR, -- inpatient-only
    PROV_SET, 
    PROVIDER_TYPE,
    PRACTITIONER_FEE_SCHEDULE.BILLING_CODE,
    PRACTITIONER_FEE_SCHEDULE.NEGOTIATED_TYPE_NAME,
    PRACTITIONER_FEE_SCHEDULE.EXPIRATION_DATE,
    CASE
      WHEN NEGOTIATED_TYPE_NAME = 'percentage' 
      THEN CAST(PRACTITIONER_FEE_SCHEDULE.NEGOTIATED_RATE_AMT AS decimal(20,4)) 
      ELSE CAST(PRACTITIONER_FEE_SCHEDULE.NEGOTIATED_RATE_AMT AS decimal(20,2)) 
      END AS NEGOTIATED_RATE_AMT,
    PLACE_OF_SERVICE_CODES,
    PRACTITIONER_FEE_SCHEDULE.BILLING_CODE_MODIFIERS,
    BILLING_CLASS AS BILLING_CLASS_NAME
    
FROM STAGEDATA.PRACTITIONER_FEE_SCHEDULE_SELECT_HOLD PRACTITIONER_FEE_SCHEDULE
   
INNER JOIN STAGEDATA.FEE_SCHEDULE_PROVIDER_NETWORK_XWALK_VW ON
  PRACTITIONER_FEE_SCHEDULE.SCHEDULE_TYPE = FEE_SCHEDULE_PROVIDER_NETWORK_XWALK_VW.SCHEDULE_TYPE AND
  PRACTITIONER_FEE_SCHEDULE.SEGMENT = FEE_SCHEDULE_PROVIDER_NETWORK_XWALK_VW.SEGMENT AND
  PRACTITIONER_FEE_SCHEDULE.SCHEDULE_DETAIL = FEE_SCHEDULE_PROVIDER_NETWORK_XWALK_VW.SCHEDULE_DETAIL

UNION 

-- from INPATIENT_FEE_SCHEDULE_SELECT_HOLD
SELECT DISTINCT
    'inpatient' AS SOURCE_TYPE,
    INPATIENT_FEE_SCHEDULE_SELECT_HOLD.SCHEDULE_TYPE,
    INPATIENT_FEE_SCHEDULE_SELECT_HOLD.SEGMENT,
    'NONE' AS SCHEDULE_DETAIL,
    NULL AS MATCH_STATE, -- practitioner-only
    NULL AS STATE, -- practitioner-only
    VENDOR,
    PROV_SET, 
    FEE_SCHEDULE_PROVIDER_NETWORK_XWALK_VW.PROVIDER_TYPE,
    BILLING_CODE,
    NEGOTIATION_TYPE_NAME AS NEGOTIATED_TYPE_NAME, 
    '12/31/9999' AS EXPIRATION_DATE,
    CASE 
       WHEN NEGOTIATED_TYPE_NAME = 'percentage' 
       THEN CAST(REPLACE(RATE,',') AS decimal(20,4)) * 100 
       ELSE CAST(REPLACE(RATE,',') AS decimal(20,2)) 
       END AS NEGOTIATED_RATE_AMT,
    ARRAY_CONSTRUCT() AS PLACE_OF_SERVICE_CODES, -- not relevant
    BILLING_CODE_MODIFIERS AS BILLING_CODE_MODIFIERS,
    BILLING_CLASS AS BILLING_CLASS_NAME
    
FROM STAGEDATA.INPATIENT_FEE_SCHEDULE_SELECT_HOLD

INNER JOIN STAGEDATA.FEE_SCHEDULE_PROVIDER_NETWORK_XWALK_VW ON
  INPATIENT_FEE_SCHEDULE_SELECT_HOLD.SCHEDULE_TYPE = FEE_SCHEDULE_PROVIDER_NETWORK_XWALK_VW.SCHEDULE_TYPE AND
  INPATIENT_FEE_SCHEDULE_SELECT_HOLD.SEGMENT = FEE_SCHEDULE_PROVIDER_NETWORK_XWALK_VW.SEGMENT

INNER JOIN STAGEDATA.PROVIDER_NETWORKS_VW ON 
    PROVIDER_NETWORKS_VW.VENDOR_ID = INPATIENT_FEE_SCHEDULE_SELECT_HOLD.VENDOR AND
    FEE_SCHEDULE_PROVIDER_NETWORK_XWALK_VW.PROV_SET = PROVIDER_NETWORKS_VW.PRICING_NETWORK_NAME AND 
    FEE_SCHEDULE_PROVIDER_NETWORK_XWALK_VW.PROVIDER_TYPE = PROVIDER_NETWORKS_VW.PROVIDER_TYPE`;

  resultSet = snowflake.execute({sqlText});
  var result = "Succeeded";

  // Logging success
  let endTime = new Date();
  sqlText = `INSERT INTO LOGDATA.EXTRACT_HISTORY (
      NAME
      ,TYPE
      ,START_TIME
      ,END_TIME
      ,RESULT_TEXT
      ,SQL_STATEMENT
  ) VALUES (
    '${procName}',
    'PROCEDURE',
    '${startTime.toISOString()}',
    '${endTime.toISOString()}',
    'Complete',
    '${sqlText.replace(/'/g, "''")}'
  )`;
  snowflake.execute({sqlText});
}
// Error logging
catch (err) {
  sqlText = (sqlText || '(no SQL run yet)').replace(/'/g, "''");
  let code = err.code || err.name;
  let state = err.state || '(JavaScript error, not provided)'
  let message = (err.message || '(JavaScript error, not provided)').replace(/'/g, "''")
  let stack = (err.stackTraceTxt || err.stack).replace(/'/g, "''");
  var result = "Failure";
  let endTime = new Date();
  sqlText = `INSERT INTO LOGDATA.EXTRACT_HISTORY (
      NAME
      ,TYPE
      ,START_TIME
      ,END_TIME
      ,SQL_STATEMENT
      ,ERROR_CODE
      ,ERROR_STATE
      ,ERROR_MESSAGE
      ,ERROR_STACK_TRACE_TEXT
  ) VALUES (
    '${procName}',
    'PROCEDURE',
    '${startTime.toISOString()}',
    '${endTime.toISOString()}',
    '${sqlText}',
    '${code}',
    '${state}',
    '${message}',
    '${stack}'
  )`;
  snowflake.execute({sqlText});
  return result;
}
return result;
$$;

!set variable_substitution=false;