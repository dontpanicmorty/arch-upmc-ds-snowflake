CREATE OR REPLACE FUNCTION STAGEDATA.FXN_MAKE_ALLOWED_AMOUNTS_FILE_DESC(PLAN_CODE VARCHAR, THRESHOLD_GROUPING VARCHAR, EIN VARCHAR)
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
AS
$$
let planName = PLAN_CODE;
if (THRESHOLD_GROUPING && THRESHOLD_GROUPING === 'CLIENT_GROUP')
  planName += ': ' + EIN;

return `Allowed amounts for plan ${planName}`;
$$
;