/**
Truncates and loads the RAWDATA.DWOAO_PRICINGHISTPRICECATG table from MC400 Database. 
*/
!set variable_substitution=true;

CREATE OR REPLACE PROCEDURE RAWDATA.SPU_LOAD_CMS_RAWDATA_DWOAO_PRICINGHISTPRICECATG()
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$

let procName = Object.keys(this).find(a => a.startsWith('SPU'));
let startTime = new Date();
let sqlText, resultSet;



try {
  sqlText =  `INSERT OVERWRITE INTO RAWDATA.DWOAO_PRICINGHISTPRICECATG (ENTITY,GROUPCARRIERPRICEGROUP,IPAPRICEGROUP,PLACEOFSERVICE,PLANTYPE,PROVIDERNO,EFFECTIVEDATE,POSUSERDEFINEDFIELD,PRICECATEGORY,PRICECATSEQUENCE,
REIMBURSEMENTFLAG,TERMDATE,CHGLAST,CHGORIG,CHGUSER,TPACLIENT,TPADIVISION,TPAIDOFCLIENT)

SELECT ENTITY,NULLIF(GROUPCARRIERPRICEGROUP, ''),NULLIF(IPAPRICEGROUP, ''),NULLIF(PLACEOFSERVICE, ''),NULLIF(PLANTYPE, ''),PROVIDERNO,EFFECTIVEDATE,NULLIF(POSUSERDEFINEDFIELD, ''),PRICECATEGORY,PRICECATSEQUENCE,
NULLIF(REIMBURSEMENTFLAG, ''),TERMDATE,CHGLAST,CHGORIG,CHGUSER,TPACLIENT,TPADIVISION,TPAIDOFCLIENT
FROM &{MC400}.DWOAO.PRICINGHISTPRICECATG
WHERE EffectiveDate <= TO_NUMBER(TO_CHAR(CURRENT_DATE(), 'yyyyMMdd'), '99999999') And (TermDate = '0' Or (TermDate  > TO_NUMBER(TO_CHAR(CURRENT_DATE(), 'yyyyMMdd'), '99999999')))`;

  resultSet = snowflake.execute({sqlText});
  var result = "Succeeded";

  // Logging success
  let endTime = new Date();
  sqlText = `INSERT INTO LOGDATA.EXTRACT_HISTORY (
      NAME
      ,TYPE
      ,START_TIME
      ,END_TIME
      ,RESULT_TEXT
      ,SQL_STATEMENT
  ) VALUES (
    '${procName}',
    'PROCEDURE',
    '${startTime.toISOString()}',
    '${endTime.toISOString()}',
    'Complete',
    '${sqlText.replace(/'/g, "''")}'
  )`;
  snowflake.execute({sqlText});
}
// Error logging
catch (err) {
  sqlText = (sqlText || '(no SQL run yet)').replace(/'/g, "''");
  let code = err.code || err.name;
  let state = err.state || '(JavaScript error, not provided)'
  let message = (err.message || '(JavaScript error, not provided)').replace(/'/g, "''")
  let stack = (err.stackTraceTxt || err.stack).replace(/'/g, "''");
  var result = "Failure";
  let endTime = new Date();
  sqlText = `INSERT INTO LOGDATA.EXTRACT_HISTORY (
      NAME
      ,TYPE
      ,START_TIME
      ,END_TIME
      ,SQL_STATEMENT
      ,ERROR_CODE
      ,ERROR_STATE
      ,ERROR_MESSAGE
      ,ERROR_STACK_TRACE_TEXT
  ) VALUES (
    '${procName}',
    'PROCEDURE',
    '${startTime.toISOString()}',
    '${endTime.toISOString()}',
    '${sqlText}',
    '${code}',
    '${state}',
    '${message}',
    '${stack}'
  )`;
  snowflake.execute({sqlText});
  return result;
}
return result;
$$;

!set variable_substitution=false;