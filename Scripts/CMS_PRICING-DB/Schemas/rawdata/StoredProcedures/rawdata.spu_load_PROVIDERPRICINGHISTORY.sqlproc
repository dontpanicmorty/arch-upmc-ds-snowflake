/**
Truncates and loads the RAWDATA.DWOAO_PROVIDERPRICINGHISTORY table from MC400 Database. 
*/
!set variable_substitution=true;

CREATE OR REPLACE PROCEDURE RAWDATA.SPU_LOAD_CMS_RAWDATA_DWOAO_PROVIDERPRICINGHISTORY()
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$

let procName = Object.keys(this).find(a => a.startsWith('SPU'));
let startTime = new Date();
let sqlText, resultSet;



try {
  sqlText = `INSERT OVERWRITE INTO RAWDATA.DWOAO_PROVIDERPRICINGHISTORY (AMBULATORYSURGERYFEESCH,ASACONVERSIONFACTORSET,AVERAGEWHOLESALEPRICE,CASERATESCHEDULE,CONTRACTSTATUS,CRVSCONVERSIONFACTORSET,DISPENSINGFEE,EFFECTIVEDATE,ENTITY,FACTOR1,FACTOR2,
FIFTHLEVELPRICECATEGORY,FOURTHLEVELPRICECATEGORY,GROUPCARRIERPRICEGROUP,IPAPRICEGROUP,MODIFIERSCHEDULE,PERCENTAGE,PERCENTAGERULE,PHARMACYPRICECATEGORY,PLACEOFSERVICE,PLANTYPE,
POSUSERDEFINEDFIELD,PRICECATEGORY,PRICINGRULE,PROVIDERNBR,RBRVSCARRIER,RBRVSCONVERSIONFACTORSET,RBRVSLOCALITY,RBRVSVERSION,REIMBURSEMENTFLAG,SECONDLEVELPRICECATEGORY,
TERMDATE,THIRDLEVELPRICECATEGORY,WITHHOLD1,WITHHOLD2,AGESCHEDULECODE,CUSTOMPRICINGRULESET,MODIFIER59PRICINGFLAG,MULTIPLESURGERYMETHOD,PROVIDERTYPESCHEDULE,
RBRVSPERCENTACE,SERVICEREASONSCHEDULE,USEMPFSDBPRICING,CHGLAST,CHGORIG,CHGUSER,TPACLIENT,TPADIVISION,TPAIDOFCLIENT,TOTALLOWTOTCHRGEYORN)

SELECT AMBULATORYSURGERYFEESCH,NULLIF(ASACONVERSIONFACTORSET, ''),AVERAGEWHOLESALEPRICE, NULLIF(CASERATESCHEDULE, ''),CONTRACTSTATUS, NULLIF(CRVSCONVERSIONFACTORSET, ''),DISPENSINGFEE,
EFFECTIVEDATE, NULLIF(TRIM(ENTITY), ''),FACTOR1,FACTOR2,NULLIF(FIFTHLEVELPRICECATEGORY, ''), NULLIF(FOURTHLEVELPRICECATEGORY, ''), NULLIF(GROUPCARRIERPRICEGROUP, ''),NULLIF(IPAPRICEGROUP, ''),
MODIFIERSCHEDULE,PERCENTAGE,NULLIF(PERCENTAGERULE, ''), NULLIF(PHARMACYPRICECATEGORY, ''), NULLIF(PLACEOFSERVICE, ''),NULLIF(PLANTYPE, ''),NULLIF(POSUSERDEFINEDFIELD, ''),
NULLIF(PRICECATEGORY, ''),PRICINGRULE,PROVIDERNBR, NULLIF(RBRVSCARRIER, ''), NULLIF(RBRVSCONVERSIONFACTORSET, ''), NULLIF(RBRVSLOCALITY, ''), NULLIF(RBRVSVERSION, ''),
NULLIF(REIMBURSEMENTFLAG, ''), NULLIF(SECONDLEVELPRICECATEGORY, ''),TERMDATE, NULLIF(THIRDLEVELPRICECATEGORY, ''),WITHHOLD1,WITHHOLD2, NULLIF(AGESCHEDULECODE, ''),
NULLIF(CUSTOMPRICINGRULESET, ''),MODIFIER59PRICINGFLAG,MULTIPLESURGERYMETHOD, NULLIF(PROVIDERTYPESCHEDULE, ''),RBRVSPERCENTACE, NULLIF(SERVICEREASONSCHEDULE, ''),
NULLIF(USEMPFSDBPRICING, ''),CHGLAST,CHGORIG,NULLIF(CHGUSER, ''),TPACLIENT,TPADIVISION,TPAIDOFCLIENT, NULLIF(TOTALLOWTOTCHRGEYORN, '')
FROM &{MC400}.DWOAO.PROVIDERPRICINGHISTORY
WHERE EffectiveDate <= TO_NUMBER(TO_CHAR(CURRENT_DATE(), 'yyyyMMdd'), '99999999') And (TermDate = '0' Or (TermDate  > TO_NUMBER(TO_CHAR(CURRENT_DATE(), 'yyyyMMdd'), '99999999')))`;

  resultSet = snowflake.execute({sqlText});
  var result = "Succeeded";

  // Logging success
  let endTime = new Date();
  sqlText = `INSERT INTO LOGDATA.EXTRACT_HISTORY (
      NAME
      ,TYPE
      ,START_TIME
      ,END_TIME
      ,RESULT_TEXT
      ,SQL_STATEMENT
  ) VALUES (
    '${procName}',
    'PROCEDURE',
    '${startTime.toISOString()}',
    '${endTime.toISOString()}',
    'Complete',
    '${sqlText.replace(/'/g, "''")}'
  )`;
  snowflake.execute({sqlText});
}
// Error logging
catch (err) {
  sqlText = (sqlText || '(no SQL run yet)').replace(/'/g, "''");
  let code = err.code || err.name;
  let state = err.state || '(JavaScript error, not provided)'
  let message = (err.message || '(JavaScript error, not provided)').replace(/'/g, "''")
  let stack = (err.stackTraceTxt || err.stack).replace(/'/g, "''");
  var result = "Failure";
  let endTime = new Date();
  sqlText = `INSERT INTO LOGDATA.EXTRACT_HISTORY (
      NAME
      ,TYPE
      ,START_TIME
      ,END_TIME
      ,SQL_STATEMENT
      ,ERROR_CODE
      ,ERROR_STATE
      ,ERROR_MESSAGE
      ,ERROR_STACK_TRACE_TEXT
  ) VALUES (
    '${procName}',
    'PROCEDURE',
    '${startTime.toISOString()}',
    '${endTime.toISOString()}',
    '${sqlText}',
    '${code}',
    '${state}',
    '${message}',
    '${stack}'
  )`;
  snowflake.execute({sqlText});
  return result;
}
return result;
$$;

!set variable_substitution=false;