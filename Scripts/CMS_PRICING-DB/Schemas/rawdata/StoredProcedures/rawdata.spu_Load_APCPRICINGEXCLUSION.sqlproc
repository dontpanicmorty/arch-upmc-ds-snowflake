/**
Truncates and loads the RAWDATA.APCPRICINGEXCLUSION table from MC400 Database. 
*/
!set variable_substitution=true;

CREATE OR REPLACE PROCEDURE RAWDATA.SPU_LOAD_CMS_RAWDATA_DWOAO_APCPRICINGEXCLUSION()
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$

let procName = Object.keys(this).find(a => a.startsWith('SPU'));
let startTime = new Date();
let sqlText, resultSet;



try {
  sqlText = `INSERT OVERWRITE INTO RAWDATA.DWOAO_APCPRICINGEXCLUSION 
    (PRIORITY,CONTRACTEFFECTIVEDATE,CONTRACTTERMDATE,PROVIDERPARSTATUS,PARSELEXCLFLAG,PROVIDERNO,APPLYRULETODETAIL,
    PROVIDERSELEXCLFLAG,PROCEDURETYPE1,PROCTYPESELEXCLFLAG,DIAGNOSISTYPE1,DIAGNOSISTYPESELEXCLFLAG,MEMBERFROMAGE,
    MEMBERTOAGE,AGERANGESELEXCLFLAG,MEMBERSEX,GENDERSELEXCLFLAG,PROVIDERTYPE,PRVTYPESELEXCLFLAG,DESCRIPTION,
    SURGICALTYPE,SURGICALTYPESELEXCLFLAG,PLACEOFSERVICE,PLACESERVSELEXCLFLAG,BILLTYPE,BILLTYPESELEXLFLAG,
    ENCOUNTERREASON,ENCREASONSELEXCLFLAG,IPACODE,IPACODESELEXCLFLAG,PLANTYPE,PLANTYPESELEXCLFLAG,SERVICETYPE,
    SVCTYPESELEXCLFLAG,HCPCSPROCEDURETYPE,HCPCSPROCTYPSELEXCLFLAG,REVENUEPROCTYPE,REVENUEPRCTYPSELEXCLFLAG,TPACLIENT,
    TPAIDOFCLIENT,TPADIVISION,IPG_CODE,IPG_CODE_SELECT_FLAG,GPG_CODE,GPG_CODE_SELECT_FLAG,CHGUSER,CHGORIG,CHGLAST)
SELECT 
    PRIORITY,CONTRACTEFFECTIVEDATE,CONTRACTTERMDATE, NULLIF(PROVIDERPARSTATUS,''),NULLIF(PARSELEXCLFLAG,''),NULLIF(PROVIDERNO,''),APPLYRULETODETAIL,NULLIF(PROVIDERSELEXCLFLAG,''),
    NULLIF(PROCEDURETYPE1,''),NULLIF(PROCTYPESELEXCLFLAG,''),NULLIF(DIAGNOSISTYPE1,''),NULLIF(DIAGNOSISTYPESELEXCLFLAG,''),
	MEMBERFROMAGE,MEMBERTOAGE,NULLIF(AGERANGESELEXCLFLAG, ''),NULLIF(MEMBERSEX, ''),NULLIF(GENDERSELEXCLFLAG, ''),NULLIF(PROVIDERTYPE, ''),NULLIF(PRVTYPESELEXCLFLAG, ''),
    NULLIF(TRIM(DESCRIPTION), ''),NULLIF(SURGICALTYPE, ''),NULLIF(SURGICALTYPESELEXCLFLAG, ''),NULLIF(PLACEOFSERVICE, ''),NULLIF(PLACESERVSELEXCLFLAG, ''),NULLIF(BILLTYPE, ''),NULLIF(BILLTYPESELEXLFLAG, ''),NULLIF(ENCOUNTERREASON, ''),NULLIF(ENCREASONSELEXCLFLAG, ''),NULLIF(IPACODE, ''),
	NULLIF(IPACODESELEXCLFLAG,''),NULLIF(PLANTYPE, ''),NULLIF(PLANTYPESELEXCLFLAG, ''),NULLIF(SERVICETYPE, ''),NULLIF(SVCTYPESELEXCLFLAG, ''),NULLIF(HCPCSPROCEDURETYPE, ''),NULLIF(HCPCSPROCTYPSELEXCLFLAG, ''),NULLIF(REVENUEPROCTYPE,''),
	NULLIF(REVENUEPRCTYPSELEXCLFLAG,''),TPACLIENT,TPAIDOFCLIENT,TPADIVISION,NULLIF(IPG_CODE,''),NULLIF(IPG_CODE_SELECT_FLAG,''),NULLIF(GPG_CODE,''),NULLIF(GPG_CODE_SELECT_FLAG,''),NULLIF(CHGUSER, ''),CHGORIG,CHGLAST
from &{MC400}.DWOAO.APCPRICINGEXCLUSION`;

  resultSet = snowflake.execute({sqlText});
  var result = "Succeeded";

  // Logging success
  let endTime = new Date();
  sqlText = `INSERT INTO LOGDATA.EXTRACT_HISTORY (
      NAME
      ,TYPE
      ,START_TIME
      ,END_TIME
      ,RESULT_TEXT
      ,SQL_STATEMENT
  ) VALUES (
    '${procName}',
    'PROCEDURE',
    '${startTime.toISOString()}',
    '${endTime.toISOString()}',
    'Complete',
    '${sqlText.replace(/'/g, "''")}'
  )`;
  snowflake.execute({sqlText});
}
// Error logging
catch (err) {
  sqlText = (sqlText || '(no SQL run yet)').replace(/'/g, "''");
  let code = err.code || err.name;
  let state = err.state || '(JavaScript error, not provided)'
  let message = (err.message || '(JavaScript error, not provided)').replace(/'/g, "''")
  let stack = (err.stackTraceTxt || err.stack).replace(/'/g, "''");
  var result = "Failure";
  let endTime = new Date();
  sqlText = `INSERT INTO LOGDATA.EXTRACT_HISTORY (
      NAME
      ,TYPE
      ,START_TIME
      ,END_TIME
      ,SQL_STATEMENT
      ,ERROR_CODE
      ,ERROR_STATE
      ,ERROR_MESSAGE
      ,ERROR_STACK_TRACE_TEXT
  ) VALUES (
    '${procName}',
    'PROCEDURE',
    '${startTime.toISOString()}',
    '${endTime.toISOString()}',
    '${sqlText}',
    '${code}',
    '${state}',
    '${message}',
    '${stack}'
  )`;
  snowflake.execute({sqlText});
  return result;
}
return result;
$$;

!set variable_substitution=false;