CREATE OR REPLACE FUNCTION CLAIM.FXN_SQLLDR_ZONED_TO_NUMBER(P_RAW VARCHAR, P_SCALE NUMBER)
RETURNS NUMBER(38,10)
LANGUAGE SQL
AS
$$
CAST(
    CASE
        WHEN P_RAW IS NULL OR TRIM(P_RAW) = '' THEN NULL
        WHEN REGEXP_LIKE(TRIM(P_RAW),'^[0-9]+$') THEN TRY_TO_NUMBER(TRIM(P_RAW)) / TO_NUMBER('1' || REPEAT('0', COALESCE(P_SCALE,0)::INTEGER))
        WHEN RIGHT(TRIM(P_RAW),1) IN ('{','A','B','C','D','E','F','G','H','I') THEN TRY_TO_NUMBER(LEFT(TRIM(P_RAW),LENGTH(TRIM(P_RAW))-1) || DECODE(RIGHT(TRIM(P_RAW),1),'{','0','A','1','B','2','C','3','D','4','E','5','F','6','G','7','H','8','I','9')) / TO_NUMBER('1' || REPEAT('0', COALESCE(P_SCALE,0)::INTEGER))
        WHEN RIGHT(TRIM(P_RAW),1) IN ('}','J','K','L','M','N','O','P','Q','R') THEN -1 * TRY_TO_NUMBER(LEFT(TRIM(P_RAW),LENGTH(TRIM(P_RAW))-1) || DECODE(RIGHT(TRIM(P_RAW),1),'}','0','J','1','K','2','L','3','M','4','N','5','O','6','P','7','Q','8','R','9')) / TO_NUMBER('1' || REPEAT('0', COALESCE(P_SCALE,0)::INTEGER))
        ELSE NULL
    END AS NUMBER(38,10)
)
$$;