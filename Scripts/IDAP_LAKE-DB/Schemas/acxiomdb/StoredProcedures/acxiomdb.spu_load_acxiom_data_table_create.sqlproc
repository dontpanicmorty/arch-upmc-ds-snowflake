!set variable_substitution=true;
CREATE OR REPLACE PROCEDURE ACXIOMDB.SPU_ACXIOM_TABLE_CREATE_FROM_SHARE_INBOUND_ACXIOM_PROSPECTS(
    YEAR_IN VARCHAR,
    MONTH_IN VARCHAR,
    DAY_IN VARCHAR
)
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
COMMENT = 'Stored procedure for creating tables with a given date suffix, dropping any tables older than 36 months.'
EXECUTE AS OWNER
AS
$$
try {
    // --- Define Target (output) database and schema ---
    var target_database = '&{IDAP_LAKE}';//replace with ${IDAP_LAKE} in SQL FILE when deployment 
    var target_schema = 'ACXIOMDB';

    // --- Define Source (input) database and schema ---
    var source_database = 'SHARE_INBOUND_ACXIOM_PROSPECTS';
    var source_schema = 'UNIVERSITYOFPITTSBURGHMEDICALCENTER_F37C522A_SCHEMA';
    
    // Define the static source table names
    var source_table_18_65 = 'UPMC_PROD_FILE_18_65_OUT_SVW';
    var source_table_18_66PLUS = 'UPMC_PROD_FILE_66PLUS_OUT_SVW';

    var result_messages = [];

    // Construct the timestamp suffix from the input parameters
    // Pad single-digit months and days with a leading zero
    var formatted_month = MONTH_IN.length === 1 ? '0' + MONTH_IN : MONTH_IN;
    var formatted_day = DAY_IN.length === 1 ? '0' + DAY_IN : DAY_IN;
    var timestamp_suffix = YEAR_IN + formatted_month + formatted_day;

    var full_target_table_name_18_65 = source_table_18_65 + '_' + timestamp_suffix;
    var full_target_table_name_18_66PLUS = source_table_18_66PLUS + '_' + timestamp_suffix;
    
    // --- Create UPMC_PROD_FILE_18_65_OUT_SVW table ---
    var create_18_65_sql = `CREATE TABLE IF NOT EXISTS ${target_database}.${target_schema}.${full_target_table_name_18_65} AS
                            SELECT * FROM ${source_database}.${source_schema}.${source_table_18_65}`;
    snowflake.execute({sqlText: create_18_65_sql});
    result_messages.push(`Table ${full_target_table_name_18_65} created successfully from source ${source_database}.${source_schema}.${source_table_18_65}.`);

    // --- Create UPMC_PROD_FILE_18_66PLUS_OUT table ---
    var create_18_66PLUS_sql = `CREATE TABLE IF NOT EXISTS ${target_database}.${target_schema}.${full_target_table_name_18_66PLUS} AS
                                 SELECT * FROM ${source_database}.${source_schema}.${source_table_18_66PLUS}`;
    snowflake.execute({sqlText: create_18_66PLUS_sql});
    result_messages.push(`Table ${full_target_table_name_18_66PLUS} created successfully from source ${source_database}.${source_schema}.${source_table_18_66PLUS}.`);

    // --- Drop old tables older than 36 months ---
    // The query now checks for both naming conventions in the target schema.
    var get_tables_to_drop_sql = `
        SELECT table_name
        FROM information_schema.tables
        WHERE table_schema = '${target_schema}'
          AND table_catalog = '${target_database}'
          AND (
                (table_name LIKE '${source_table_18_65}_%' AND TRY_TO_DATE(SUBSTRING(table_name, LENGTH('${source_table_18_65}_') + 1), 'YYYYMMDD') < DATEADD(MONTH, -36, CURRENT_DATE()))
                OR
                (table_name LIKE '${source_table_18_66PLUS}_%' AND TRY_TO_DATE(SUBSTRING(table_name, LENGTH('${source_table_18_66PLUS}_') + 1), 'YYYYMMDD') < DATEADD(MONTH, -36, CURRENT_DATE()))
              )
    `;

    var stmt = snowflake.execute({sqlText: get_tables_to_drop_sql});
    var tables_to_drop = [];
    while (stmt.next()) {
        tables_to_drop.push(stmt.getColumnValue(1));
    }

    if (tables_to_drop.length > 0) {
        for (var i = 0; i < tables_to_drop.length; i++) {
            var table_to_drop = tables_to_drop[i];
            var drop_single_table_sql = `DROP TABLE IF EXISTS ${target_database}.${target_schema}.${table_to_drop}`;
            snowflake.execute({sqlText: drop_single_table_sql});
        }
        result_messages.push(`Successfully dropped ${tables_to_drop.length} old tables.`);
    } else {
        result_messages.push("No old tables found to drop.");
    }

    return result_messages.join('\n');
} catch(err) {
    return 'Error: ' + err.message;
}
$$;
!set variable_substitution=false;