    ,"AP001112"
    ,"Obtain Disability Insurance Due to Loss of Income Through Medical Causes"
    ,"Obtain Long Term Care Insurance"
    ,"Geo Latitude"
    ,"Geo Longitude"
    ,"Caretaker of patient aged 65 or older (Financial)"
    ,"Diet Lifestyle"
    ,"Diet Lifestyle - Precision Level"
    ,"HP000205 Geo Aggregated Data-Geo Census Data-Demographics-Age-Buying Activity"
    ,"HP000212 Geo Aggregated Data-Financial-Real Property-Age-Demographics"
    ,"HP000216 Geo Aggregated Data-Consumer Traits-Age-Real Property-Geo Census Data"
    ,"HP001066 - Promoting Awareness of Living in a Food Desert or Being Food Insecure"
    ,"Exercise Frequency (B)"
    ,"Exercise Frequency (B) - Precision Level"
    ,"Alcohol Consumption"
    ,"Alcohol Consumption - Precision Level"
    ,"Extreme Sports Enthusiasts"
    ,"Extreme Sports Enthusiasts - Precision Level"
    ,"Fast Food/Snack Food Consumption"
    ,"Fast Food/Snack Food Consumption - Precision Level"
    ,"Healthy Lifestyle"
    ,"Healthy Lifestyle - Precision Level"
    ,"Overall Wellness"
    ,"Overall Wellness - Precision Level"
    ,"Safety Compliance"
    ,"Safety Compliance - Precision Level"
    ,"Sleep Quality"
    ,"Sleep Quality - Precision Level"
    ,"Social Setting Behavior"
    ,"Social Setting Behavior - Precision Level"
    ,"Stress Levels"
    ,"Stress Levels - Precision Level"
    ,"Body Mass Index"
    ,"Body Mass Index - Precision Level"
    ,"Smoking Frequency"
    ,"Smoking Frequency - Precision Level"
) AS
SELECT
INPUT_PREFIX_TITLE_8093 AS INPUT_PREFIX_TITLE_8093
,NULLIF(CONCAT_NAME,'') AS CONCAT_NAME
,NULLIF(INPUT_FIRST_NAME_3131,'') AS INPUT_FIRST_NAME_3131
,NULLIF(INPUT_MIDDLE_INITIAL_3131,'') AS INPUT_INPUT_MIDDLE_INITIAL_3131
,NULLIF(INPUT_LAST_NAME_3131,'') AS INPUT_LAST_NAME_3131
,NULLIF(CONCAT_ADDRESS,'') AS CONCAT_ADDRESS
