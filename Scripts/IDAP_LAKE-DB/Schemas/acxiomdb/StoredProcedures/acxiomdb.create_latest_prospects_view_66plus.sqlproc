    ,"Education - 1st Person in Household - Plus"
    ,"Education - 2nd Person in Household"
    ,"Number of Adults"
    ,"Occupation - 1st Person in Household"
    ,"Geo Block Code"
    ,"Geo Block Group Code"
    ,"Geo Core Based Statistical Area (CBSA) Code"
    ,"Geo Core Base Statistical Area (CBSA) Name"
    ,"Geo Country Code"
    ,"Geo Country Name"
    ,"Geo Designated Marketing Area (DMA) Code"
    ,"Geo Designated Marketing Area (DMA) Name"
