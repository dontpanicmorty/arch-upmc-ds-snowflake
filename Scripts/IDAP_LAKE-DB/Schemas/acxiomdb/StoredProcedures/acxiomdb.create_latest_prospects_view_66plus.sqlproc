,DECODE(AP006258_02,'3','Household'
,'5','Address'
,'A','Zip+4'
,'G','Zip','--') AS "Smoking Frequency - Precision Level"
FROM ${full_schema}."${latest_table_name}"
`;
snowflake.createStatement({ sqlText: create_view_ddl }).execute();

// --------------------
// Step 6: Log updates (self-healing)
// --------------------
snowflake.createStatement({
    sqlText: `
        CREATE TABLE IF NOT EXISTS ${full_schema}.View_Update_Log (
            run_timestamp TIMESTAMP_LTZ,
            old_table STRING,
            new_table STRING,
            new_table_created_on DATE
        )
    `
}).execute();

// Check for missing columns
var check_cols = snowflake.createStatement({
    sqlText: `
        SELECT COLUMN_NAME
        FROM ${db_name}.INFORMATION_SCHEMA.COLUMNS
        WHERE TABLE_SCHEMA = '${schema_name}'
          AND TABLE_NAME = 'VIEW_UPDATE_LOG'
          AND COLUMN_NAME IN ('OLD_COUNT','NEW_COUNT')
    `
}).execute();

var existing_cols = [];
while (check_cols.next()) {
    existing_cols.push(check_cols.getColumnValue(1).toUpperCase());
}

// Add columns only if they are missing
if (existing_cols.indexOf('OLD_COUNT') === -1) {
    snowflake.createStatement({
        sqlText: `ALTER TABLE ${full_schema}.View_Update_Log ADD COLUMN old_count NUMBER`
    }).execute();
}
if (existing_cols.indexOf('NEW_COUNT') === -1) {
    snowflake.createStatement({
        sqlText: `ALTER TABLE ${full_schema}.View_Update_Log ADD COLUMN new_count NUMBER`
    }).execute();
}

// Insert log row
snowflake.createStatement({
    sqlText: `
        INSERT INTO ${full_schema}.View_Update_Log
        (run_timestamp, old_table, new_table, new_table_created_on, old_count, new_count)
        VALUES (CURRENT_TIMESTAMP, ?, ?, TO_DATE(?, 'YYYYMMDD'), ?, ?)
    `,
    binds: [old_table_name, latest_table_name, latest_date, old_count, new_count]
}).execute();

// --------------------
// Step 7: Return summary
// --------------------
var pct_change_msg = '';
if (old_count !== null && new_count !== null && old_count > 0) {
    var pct_change = ((new_count - old_count) / old_count * 100).toFixed(2);
    pct_change_msg = ` | % Change: ${pct_change}%`;
} else if (old_count === null && new_count !== null) {
    pct_change_msg = ' | % Change: N/A (no old data)';
}

return `View updated from: ${old_table_name || 'None'} [${old_count || 'N/A'} rows] → ${latest_table_name} [${new_count || 'N/A'} rows]` + pct_change_msg;
$$;
!set variable_substitution=false;

