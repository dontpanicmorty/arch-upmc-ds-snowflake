!set variable_substitution=true;
CREATE OR REPLACE PROCEDURE ACXIOMDB.CREATE_LATEST_PROSPECTS_VIEW_66PLUS()
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
var db_name = '&{IDAP_LAKE}';
var schema_name = 'ACXIOMDB';
var full_schema = db_name + '.' + schema_name;
var view_name = 'FORMATTED_PROSPECTS_66_PLUS';
var table_pattern = '%66PLUS_OUT_SVW_%';

// --------------------
// Step 1: Get old table name backing the view
// --------------------
var old_table_name = null;
try {
    var get_view_stmt = snowflake.createStatement({
        sqlText: `
            SELECT t.TABLE_NAME
            FROM ${db_name}.INFORMATION_SCHEMA.VIEW_TABLE_USAGE t
            WHERE t.VIEW_SCHEMA = '${schema_name}'
              AND t.VIEW_NAME = '${view_name}'
        `
    });
    var rs_old = get_view_stmt.execute();
    if (rs_old.next()) {
        old_table_name = rs_old.getColumnValue(1);
    }
} catch (err) {
    old_table_name = null;
}

// Fallback to GET_DDL if old_table_name is still null
if (old_table_name === null) {
    try {
        var def_stmt = snowflake.createStatement({
            sqlText: `SELECT GET_DDL('VIEW', '${full_schema}.${view_name}')`
        });
        var rs_def = def_stmt.execute();
        if (rs_def.next()) {
            var ddl = rs_def.getColumnValue(1);
            var match = ddl.match(/FROM\s+["\w\.]+\."(.*?)"/i);
            if (match) {
                old_table_name = match[1];
            }
        }
    } catch (err) {
        old_table_name = null;
    }
}



// --------------------
// Step 2: Find newest table using INFORMATION_SCHEMA
// --------------------
var get_latest_stmt = snowflake.createStatement({
    sqlText: `
        SELECT TABLE_NAME
        FROM ${db_name}.INFORMATION_SCHEMA.TABLES
        WHERE TABLE_SCHEMA = '${schema_name}'
          AND TABLE_NAME ILIKE '${table_pattern}'
        ORDER BY TABLE_NAME DESC
        LIMIT 1
    `
});
var rs = get_latest_stmt.execute();

var latest_table_name = null;
var latest_date = null;

if (rs.next()) {
    latest_table_name = rs.getColumnValue(1);
    var match = latest_table_name.match(/(\\d{8})/);
    if (match) {
        latest_date = match[1];
    }
}

if (!latest_table_name) {
    return 'No matching tables found in ' + full_schema;
}

// --------------------
// Step 3: Row counts
// --------------------
function getRowCount(table_name) {
    try {
        var rs_cnt = snowflake.createStatement({
            sqlText: `SELECT COUNT(*) FROM ${full_schema}."${table_name}"`
        }).execute();
        return rs_cnt.next() ? rs_cnt.getColumnValue(1) : null;
    } catch (err) {
        return null;
    }
}

var old_count = old_table_name ? getRowCount(old_table_name) : null;
var new_count = getRowCount(latest_table_name);

// --------------------
// Step 4: Skip if already latest
// --------------------
if (old_table_name && old_table_name.toUpperCase() === latest_table_name.toUpperCase()) {
    return 'View already points to latest table: ' + latest_table_name;
}

// --------------------
// Step 5: Recreate the view (full DECODE body inline)
// --------------------
var create_view_ddl = `
CREATE OR REPLACE VIEW ${full_schema}.${view_name}(
    INPUT_PREFIX_TITLE_8093
    ,CONCAT_NAME
    ,INPUT_FIRST_NAME_3131
    ,INPUT_MIDDLE_INITIAL_3131
    ,INPUT_LAST_NAME_3131
    ,CONCAT_ADDRESS
    ,INPUT_ADDRESS_LINE2_4111
    ,INPUT_CITY_3040
    ,INPUT_STATE_3038
    ,INPUT_ZIP_CODE_3043
    ,INPUT_ZIP4_CODE_3044
    ,INPUT_DELIVERY_POINT_BAR_CODE_3046
    ,INPUT_USE_CODE_3048
    ,AGEOFINDIVIDUAL
    ,ENTITY_REALID_HOUSEHOLD_ID
    ,ENTITY_REALID_PERSON_ID
    ,ENTITY_REALID_PLACE_ID
    ,"Causes Supported Financially - Charitable"
    ,"Causes Supported Financially - Animal Welfare"
    ,"Causes Supported Financially - Arts or Cultural"
    ,"Causes Supported Financially - Childrens"
    ,"Causes Supported Financially - Environment or Wildlife"
    ,"Causes Supported Financially - Health"
    ,"Causes Supported Financially - International Aid"
    ,"Causes Supported Financially - Political"
    ,"Causes Supported Financially - Politically Conservative"
    ,"Causes Supported Financially - Politically Liberal"
    ,"Causes Supported Financially - Religious"
    ,"Causes Supported Financially - Veterans"
    ,"Causes Supported Financially - Other"
    ,"Age in One-Year Increments - Person"
    ,"Gender - Person"
    ,"Marital Status - Person"
    ,"Presence of Children - 100%"
    ,"Presence of Children - 100% - Precision Level"
    ,"Number of Children - 100%"
    ,"Number of Children - 100% - Precision Level"
    ,"Home Owner / Renter - 100%"
