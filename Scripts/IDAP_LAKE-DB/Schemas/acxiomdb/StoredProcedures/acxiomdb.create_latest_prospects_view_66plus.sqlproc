,NULLIF(INPUT_CITY_3040,'') AS INPUT_CITY_3040
,NULLIF(INPUT_STATE_3038,'') AS INPUT_STATE_3038
,NULLIF(INPUT_ZIP_CODE_3043,'') AS INPUT_ZIP_CODE_3043
,NULLIF(INPUT_ZIP4_CODE_3044,'') AS INPUT_ZIP4_CODE_3044
,NULLIF(INPUT_DELIVERY_POINT_BAR_CODE_3046,'') AS INPUT_DELIVERY_POINT_BAR_CODE_3046
,NULLIF(INPUT_USE_CODE_3048,'') AS INPUT_USE_CODE_3048
,NULLIF(AGEOFINDIVIDUAL,'') AS AGEOFINDIVIDUAL
,ENTITY_REALID_HOUSEHOLD_ID AS ENTITY_REALID_HOUSEHOLD_ID
,ENTITY_REALID_PERSON_ID AS ENTITY_REALID_PERSON_ID
