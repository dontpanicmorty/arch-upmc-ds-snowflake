CREATE OR REPLACE PROCEDURE PROVIDER.SPU_LOAD_COSMOS_SYNC_JSON()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
 /*
  USAGE: run to load PROVIDER_ONLINE_COSMOS_SYNC Table
  */
  // get procedure start time and set variables
var startTime = new Date().toISOString();
var startDate = new Date().toJSON().slice(0,10).replace(/-/g,'/');
var procedureName = Object.keys(this)[0];
var targetTableName = "PROVIDER.PROVIDER_ONLINE_COSMOS_SYNC";
const STAGE = '@UTIL.HPDSDATALAKE_DBEXTRACT_IDAP_LAKE/provideronlinecosmos/' + startDate + '/';

// Create Insert Overwrite command
var sqlCommand = `
INSERT OVERWRITE INTO
    PROVIDER.PROVIDER_ONLINE_COSMOS_SYNC (FILENAME, LOAD_DATE, ID, NETWORK_ID, PROVIDER_KEY)
SELECT
    METADATA$FILENAME AS FILENAME,
    METADATA$FILE_LAST_MODIFIED AS LOAD_TIME,
    PARSE_JSON($1):id::VARCHAR AS ID,
    PARSE_JSON($1):networkId::VARCHAR AS NETWORK_ID,
    PARSE_JSON($1):providerKey::VARCHAR AS PROVIDER_KEY
FROM
    ${STAGE}
    (FILE_FORMAT => PROVIDER.PROVIDER_ONLINE_COSMOS_SYNC_FILE_FORMAT, 
    PATTERN => '.*data.*[.]json');`;

//vars for try catch
var sqlLogCommand = "";
var result = "";
var statement = "";

try
{
    //Execute SQL Command
    statement = snowflake.createStatement({ sqlText: sqlCommand });
    let sqlResult = statement.execute();
    sqlResult.next();
    let affectedNum = sqlResult.getNumRowsAffected();
    result += targetTableName + ' succeeded and affected ' + affectedNum + ' rows ' + '\n';
    let endTime = new Date().toISOString();

    //Log results to table
      sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
          (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT)
          VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9);`;

      snowflake.execute
      (
          {sqlText: sqlLogCommand,
          binds: [targetTableName, "TABLE", startTime, endTime, statement.getNumRowsInserted(), statement.getNumRowsUpdated(), statement.getNumRowsDeleted(), result, statement.getSqlText()]
          }
      );
    

}
catch (err)
{
    let code = err.code || err.name;
    let state = err.state || '(JavaScript error, not provided)'
    let message = (err.message || '(JavaScript error, not provided)').replace(/'/g, "''")
    let stack = (err.stackTraceTxt || err.stack).replace(/'/g, "''");
    let endTime = new Date().toISOString();
    result = procedureName + ' Failed'

    //Log results to table
    sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;
        
    snowflake.execute
    (
        {sqlText: sqlLogCommand,
        binds:[procedureName, "STORED_PROCEDURE", startTime, endTime, result, statement.getSqlText(), code, state, message, stack]
        }
    );
    throw message;
}
return result;
$$
;