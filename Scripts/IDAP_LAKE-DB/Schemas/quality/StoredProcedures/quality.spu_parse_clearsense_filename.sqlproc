
CREATE OR REPLACE PROCEDURE QUALITY.SPU_PARSE_CLEARSENSE_FILENAME(CCD_FILE_NAME VARCHAR)
RETURNS VARIANT
LANGUAGE JAVASCRIPT
AS
$$
  var filename = CCD_FILE_NAME;

  var numbers = filename.replace(/\D/g, '');
  
  if (numbers)
  {
    if (numbers.length < 8)
    {
        throw "Filename does not match expected pattern.  Not enough numbers found to build a date.";
    } else
    {
        var date8 = numbers.slice(-8);
        var date_year = date8.substring(0,4);
        var date_month = date8.substring(4,6);
        var date_day = date8.substring(6,8);

        var result_json = {
            "filename":filename,
            "date_extract":date8,
            "file_year":date_year,
            "file_month":date_month,
            "file_day":date_day
        };
        
        return result_json;        
    }    
  } else
  {
    throw "Filename does not match expected pattern.  No numbers found.";
  }
$$
;


