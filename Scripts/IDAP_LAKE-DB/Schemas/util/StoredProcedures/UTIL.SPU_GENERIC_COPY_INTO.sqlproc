CREATE OR REPLACE PROCEDURE UTIL.SPU_GENERIC_COPY_INTO(ADF_FILE_COPY_CONTROL_KEY VARCHAR)
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS '
// Taking passed adf_control_key and loading it into variable adf_control_key
var adf_control_key = parseInt(ADF_FILE_COPY_CONTROL_KEY);

// Getting results from control file table for specified control file key
var control_table_data = "select TARGET_DATA_LAKE_PATH, IS_ACTIVE, TARGET_TABLE_NAME, TRUNCATE_TABLE_FLAG, IS_COPY_INTO_FLAG, COPY_INTO_QUERY, QUERY_FILE_FORMAT, SOURCE_FILENAME_PATTERN from UTIL.ADF_FILE_COPY_CONTROL WHERE ADF_FILE_COPY_CONTROL_KEY = "+adf_control_key+";" ;
var control_table_data_snowflake = snowflake.createStatement(
           {
           sqlText: control_table_data
           }
        );
                var res_control_table_data = control_table_data_snowflake.execute();
    res_control_table_data.next();

//COLLECTING VARIABLES FROM CONTROL TABLE    
var target_data_lake_path = res_control_table_data.getColumnValue(1);
var is_active = res_control_table_data.getColumnValue(2);
var target_table_name = res_control_table_data.getColumnValue(3);
var truncate_table_flag = res_control_table_data.getColumnValue(4);
var is_copy_into_flag = res_control_table_data.getColumnValue(5);
var copy_into_query = res_control_table_data.getColumnValue(6);
var query_file_format = res_control_table_data.getColumnValue(7);
var source_filename_pattern = res_control_table_data.getColumnValue(8);

//IF FILE IS INACTIVE LET USER KNOW
 if(is_active === false){
     return "THIS FILE IS INACTIVE";
    }
//IF COPY INTO FLAG IS FALSE LET USER KNOW
 if(is_copy_into_flag === false){
     return "COPY INTO FLAG IS SET TO FALSE";
    }

//BREAKING TARGET_TABLE_NAME INTO SCHEMA AND TABLENAME FOR LATER USE
var target_table_name_parsed = target_table_name.split(''.'');
var schema_name = target_table_name_parsed[0];
var table_name = target_table_name_parsed[1];


var truncate_table_sql;
//DOES TABLE NEED TO BE TRUNCATED, TRIPLE EQUALS BECAUSE FLAG IS A BOOLEAN
 if(truncate_table_flag === true){
     truncate_table_sql = "TRUNCATE TABLE "+target_table_name+";";
     snowflake.execute ({sqlText: truncate_table_sql});
    }


//TIME TO BUILD COPY INTO
var final_copy_query = "COPY INTO " +target_table_name+" (";


//COLLECTING COLUMN_NAMES and IS_IDENTITY results
var column_data_sql = "select column_name, is_identity from information_schema.columns where table_schema = ''"+schema_name+"'' AND TABLE_NAME = ''"+table_name+"'' ORDER BY ORDINAL_POSITION ASC";
var column_data_sql_snowflake = snowflake.createStatement(
           {
           sqlText: column_data_sql
           }
        );
                var res_column_data = column_data_sql_snowflake.execute();

var column_name;
var identity_col;

//WHILE LOOP TO BUILD COPY INTO STRING AND AVOID IDENTITY COLS
while (res_column_data.next())  {
    identity_col = res_column_data.getColumnValue(2);

    if(identity_col == ''NO''){
        column_name = res_column_data.getColumnValue(1);
        final_copy_query += column_name;
        final_copy_query += ", ";
    }//END IF
    
    }//END WHILE
    
//Removing the final comma and space from last column
final_copy_query = final_copy_query.substring(0,final_copy_query.length-2);

//ADDING HARDCODED STRINGS TO COPY INTO
final_copy_query += ") FROM (";
final_copy_query += copy_into_query;
final_copy_query += target_data_lake_path;


//GETTING DATE PARTS FOR PATH
var now = new Date();
var month = now.getMonth()+1;
if(month <10){
    month = "0"+ month;
} //END IF
var day = now.getDate();
if(day <10){
    day = "0"+ day;
} //END IF
var year = now.getFullYear();


//ADDING DATE TO COPY INTO FILE PATH
final_copy_query += year;
final_copy_query += "/";
final_copy_query += month;
final_copy_query += "/";
final_copy_query += day;
final_copy_query += "/";


//ADDING FILENAME PATTERN AND FILE FORMAT TO COMPLETE COPY INTO QUERY
final_copy_query +=" (FILE_FORMAT => ''"+query_file_format+"'', PATTERN => ''.*"+source_filename_pattern+".*''));";

try{
//EXECUTING COPY INTO AND RETURNING RESULTS OF QUERY
var sql_statement = snowflake.createStatement({
    sqlText: final_copy_query
});
var sql_results = sql_statement.execute();
var result_array = [];

while (sql_results.next()) {
    result_array.push(sql_results.getColumnValue(1));
}

//the return that provides the result set
return result_array.toString();

//the return that gives you 0 or 1
//var test = result_array[0];
//var test2 = "Copy executed with 0 files processed."
//if(test == test2){
//return "0";
//}
//return "1";


}
catch(error)
{
//RETURNING QUERY FOR POSSIBLE TROUBLESHOOTING
var query_failed = "QUERY FAILED, COPY INTO STATEMENT: ";
query_failed += final_copy_query;
return query_failed;
}


';