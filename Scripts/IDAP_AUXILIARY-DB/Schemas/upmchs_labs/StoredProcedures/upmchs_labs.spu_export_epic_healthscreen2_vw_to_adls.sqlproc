CREATE OR REPLACE PROCEDURE UPMCHS_LABS.SPU_EXPORT_EPIC_HEALTHSCREEN2_VW_TO_ADLS()
RETURNS STRING
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
    function formatDate(d) {
        let yyyy = d.getFullYear();
        let mm = String(d.getMonth() + 1).padStart(2, '0');
        let dd = String(d.getDate()).padStart(2, '0');
        return yyyy + mm + dd;
    }

    var runDate = formatDate(new Date());
    var fileName = "epic_healthscreen2_" + runDate + ".txt";

    var copySql = `
        COPY INTO @util.snowflakedata_ae2_outgoing/upmchs_labs/${fileName}
        FROM (
            SELECT 
                ACCT_NBR, 
                FULL_NAME, 
                MRN, 
                HOSP, 
                ACC_NBR, 
                TO_VARCHAR(EVENT_DATE, 'MM/DD/YYYY') AS EVENT_DATE, 
                EVENT_TIME, 
                BAT_CODE, 
                LAB_CODE, 
                FACILITY, 
                LAB_UNITS, 
                LAB_RANGE, 
                NULLIF(RESULT_FLAG, '') AS RESULT_FLAG, 
                STATUS, 
                LAB_RESULT
            FROM UPMCHS_LABS.EPIC_HEALTHSCREEN2_VW
            ORDER BY FULL_NAME
        )
        FILE_FORMAT = UPMCHS_LABS.EPIC_HEALTHSCREEN2_VW_ADLS_FILE_FORMAT
        SINGLE = TRUE
        MAX_FILE_SIZE = 5368709120
        OVERWRITE = TRUE
    `;

    snowflake.execute({ sqlText: copySql });

    return "Export completed: " + fileName;
$$;