CREATE OR REPLACE PROCEDURE WELLBE.GENERATE_WELLBE_MAO_004_HISTORICAL_EXTRACT()
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS '
    var lookupSQL = `SELECT DISTINCT FILE_PREFIX, FILE_TYPE, FILE_DATE, FILE_TIME , CONCAT(
        ''UPMC_WellBe_MAO_004.''
        ,FILE_PREFIX
        ,''.''
        ,FILE_TYPE
        ,''.''
        ,FILE_DATE
        ,''.''
        ,FILE_TIME
        ,''.csv''
    ) as EXTRACT_FILE_NAME
    FROM WELLBE.MAO_004_HISTORICAL_EXTRACT_VW
    WHERE FILE_DATE >= ''D240800''
    ORDER BY FILE_PREFIX, FILE_TYPE, FILE_DATE, FILE_TIME
    ;`;

    var lookupStmt = snowflake.createStatement({
        sqlText: lookupSQL
    });

try
{
    var filesProcessed = 0;
    var filesToCreate = lookupStmt.execute();
    
    while (filesToCreate.next()) 
    {   
        var filePrefix = filesToCreate.getColumnValueAsString(''FILE_PREFIX'');
        var fileTypeName = filesToCreate.getColumnValueAsString(''FILE_TYPE'');
        var fileDateName = filesToCreate.getColumnValueAsString(''FILE_DATE'');
        var fileTimeName = filesToCreate.getColumnValueAsString(''FILE_TIME'');
        var fileName = filesToCreate.getColumnValueAsString(''EXTRACT_FILE_NAME'');        

        var unloadSQL = `COPY INTO @UTIL.SNOWFLAKEDATA_OUTGOING/wellbe/mao-004/historical/${fileName}
FROM
(
SELECT
*
FROM WELLBE.MAO_004_HISTORICAL_EXTRACT_VW
WHERE FILE_PREFIX = :1
    AND FILE_TYPE = :2
    AND FILE_DATE = :3
    AND FILE_TIME = :4
)
FILE_FORMAT = (FORMAT_NAME = WELLBE.WELLBE_EXTRACT_CSV)
SINGLE = TRUE
OVERWRITE = TRUE
MAX_FILE_SIZE = 128000000
HEADER = TRUE;
;`;

        var extractStmt = snowflake.createStatement({
            sqlText: unloadSQL,
            binds: [filePrefix,fileTypeName,fileDateName,fileTimeName]
        });
       
        var extractResult = extractStmt.execute();
                
        filesProcessed += 1;
    }

    var retVal = "SUCCEEDED: Processed " + filesProcessed + " files";

    return retVal;
}
catch (err)
{
    //log code goes here
    throw err;
}
    
';