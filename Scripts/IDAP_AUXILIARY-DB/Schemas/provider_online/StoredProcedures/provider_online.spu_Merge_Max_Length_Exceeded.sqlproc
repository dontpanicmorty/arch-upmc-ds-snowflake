CREATE OR REPLACE PROCEDURE PROVIDER_ONLINE.SPU_MERGE_MAX_LENGTH_EXCEEDED(LENGTH_NUM STRING)
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = "PROVIDER_ONLINE.RECORD_MAX_LENGTH_EXCEEDED";
const sqlCommandArray = [];
var sqlLogCommand = "", result = "";
var lengthNum = (Number(LENGTH_NUM)) ? Number(LENGTH_NUM) : 150000;

//Log Records that are too large to a table
sqlCommand = `
MERGE INTO
    ${targetTableName} TGT USING (
        SELECT
            ID,
            NETWORK_ID,
            PROVIDER_KEY,
            PROVDIRJSONTXT
        FROM
            PROVIDER_ONLINE.COMPILED_DELTA_UPLOAD_VW
        WHERE
            LENGTH(PROVDIRJSONTXT::VARCHAR) >= ${lengthNum}
    ) SRC ON TGT.ID = SRC.ID
    AND TGT.NETWORK_ID = SRC.NETWORK_ID
    AND TGT.PROVIDER_KEY = SRC.PROVIDER_KEY
WHEN MATCHED
THEN UPDATE SET
    SET_RECORD_LIMIT = ${lengthNum},
    JSON_LENGTH = LENGTH(SRC.PROVDIRJSONTXT::VARCHAR),
    LAST_UPDATED_DATETIME = CURRENT_TIMESTAMP()
WHEN NOT MATCHED THEN INSERT
    (
        PROVIDER_KEY,
	    NETWORK_ID,
	    ID,
	    SET_RECORD_LIMIT,
	    JSON_LENGTH,
	    PROVDIRJSONTXT,
        INSERT_DATETIME,
        LAST_UPDATED_DATETIME
    )
VALUES
    (
        SRC.PROVIDER_KEY,
        SRC.NETWORK_ID,
        SRC.ID,
        ${lengthNum},
        LENGTH(SRC.PROVDIRJSONTXT::VARCHAR),
        SRC.PROVDIRJSONTXT,
        CURRENT_TIMESTAMP(),
        CURRENT_TIMESTAMP()
    );`;
sqlCommandArray.push(sqlCommand);

//Update To Set Last Audit Action to Show that Record Exceeded Max Length
sqlCommand = `
UPDATE PROVIDER_ONLINE.DIRECTORY_NON_PARTICIPANT_PREVIOUS
SET
    DIRECTORY_NON_PARTICIPANT_PREVIOUS.LAST_AUDIT_ACTION = 'MAX_LENGTH_EXCEEDED'
FROM
    (
        SELECT DISTINCT
            MLE.ID,
            MLE.NETWORK_ID,
            MLE.PROVIDER_KEY,
            MLE.LAST_UPDATED_DATETIME
        FROM
            ${targetTableName} MLE
            INNER JOIN PROVIDER_ONLINE.DIRECTORY_NON_PARTICIPANT_PREVIOUS PREV 
                ON MLE.ID = PREV.ID
                AND MLE.NETWORK_ID = PREV.NETWORK_ID
                AND MLE.PROVIDER_KEY = PREV.PROVIDER_KEY
    ) SUBQUERY
WHERE
    DIRECTORY_NON_PARTICIPANT_PREVIOUS.ID = SUBQUERY.ID
    AND DIRECTORY_NON_PARTICIPANT_PREVIOUS.NETWORK_ID = SUBQUERY.NETWORK_ID
    AND DIRECTORY_NON_PARTICIPANT_PREVIOUS.PROVIDER_KEY = SUBQUERY.PROVIDER_KEY
    AND DIRECTORY_NON_PARTICIPANT_PREVIOUS.LAST_UPDATED_DATETIME < SUBQUERY.LAST_UPDATED_DATETIME;`;
sqlCommandArray.push(sqlCommand);

try
{
    //Execute SQL Command
    for (let i = 0; i < sqlCommandArray.length; i++) {

      //Run SQL
      statement = snowflake.createStatement({ sqlText: sqlCommandArray[i] });
      let sqlResult = statement.execute();
      sqlResult.next();
      let affectedNum = sqlResult.getNumRowsAffected();
      result += targetTableName + " succeeded and affected " + affectedNum + " rows " + "\n";
      let endTime = new Date().toISOString();

      //Log results to table
      sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
          (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT)
          VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9);`;

      snowflake.execute
      (
          {sqlText: sqlLogCommand,
          binds: [targetTableName, "TABLE", startTime, endTime, statement.getNumRowsInserted(), statement.getNumRowsUpdated(), statement.getNumRowsDeleted(), result, statement.getSqlText()]
          }
      );
    }

}
catch (err)
{
    let code = err.code || err.name;
    let state = err.state || '(JavaScript error, not provided)'
    let message = (err.message || '(JavaScript error, not provided)').replace(/'/g, "''")
    let stack = (err.stackTraceTxt || err.stack).replace(/'/g, "''");
    let endTime = new Date().toISOString();
    result = procedureName + ' Failed'

    //Log results to table
    sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;
        
    snowflake.execute
    (
        {sqlText: sqlLogCommand,
        binds:[procedureName, "STORED_PROCEDURE", startTime, endTime, result, statement.getSqlText(), code, state, message, stack]
        }
    );
    throw message;
}
return result;
$$
;