!set variable_substitution=true;
CREATE OR REPLACE PROCEDURE PROVIDER_ONLINE.SPU_TRUNCATE_INSERT_PROVIDER_ONLINE_TABLES()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
const tableArray = ["PROVIDER_ONLINE.AFFILIATIONS_NON_PARTICIPANT", 
                    "PROVIDER_ONLINE.CONTRACT_NON_PARTICIPANT", 
                    "PROVIDER_ONLINE.DIRECTORY_NON_PARTICIPANT",
                    "PROVIDER_ONLINE.LEGAL_ADDRESS_RELATIONSHIP"]
const sqlCommandArray = [];
var sqlLogCommand = "", result = "", targetTableName = "";

// Create Insert Overwrite command
//TRUNCATE INSERT AFFILIATIONS TABLE
sqlCommand = `
INSERT OVERWRITE INTO PROVIDER_ONLINE.AFFILIATIONS_NON_PARTICIPANT
    (
        PROVIDER_KEY,
        FACILITY_NAME,
        ADMIT_HOSP_OWNED_STATUS,
        FACILITY_PROVIDER_KEY,
        PROVIDER_ADDRESS_RELATIONSHIP_KEY,
        PROVIDER_DIRECTORY_H2_PRODUCT_NAME,
        PROVIDER_DIRECTORY_H2_SUB_PRODUCT_NAME,
        PROVIDER_DIRECTORY_H2_SUB_PRODUCT_KEY,
        H2_ENTITY_NAME,
        PRODUCT_KEY,
        PRODUCT_TYPE_KEY,
        PROVIDER_DIRECTORY_NETWORK_ID,
        LEVELED_SUB_PRODUCT_INDICATOR,
        CONTRACT_LEVEL_CODE
    )
SELECT
    TRY_TO_NUMBER(IFF(PROVIDER_KEY = 'NULL', NULL, PROVIDER_KEY)),
    IFF(FACILITY_NAME = 'NULL', NULL, FACILITY_NAME),
    IFF(ADMIT_HOSP_OWNED_STATUS = 'NULL', NULL, ADMIT_HOSP_OWNED_STATUS),
    TRY_TO_NUMBER(IFF(FACILITY_PROVIDER_KEY = 'NULL', NULL, FACILITY_PROVIDER_KEY)),
    TRY_TO_NUMBER(IFF(PROVIDER_ADDRESS_RELATIONSHIP_KEY = 'NULL', NULL, PROVIDER_ADDRESS_RELATIONSHIP_KEY)),
    IFF(PROVIDER_DIRECTORY_H2_PRODUCT_NAME = 'NULL', NULL, PROVIDER_DIRECTORY_H2_PRODUCT_NAME),
    IFF(PROVIDER_DIRECTORY_H2_SUB_PRODUCT_NAME = 'NULL', NULL, PROVIDER_DIRECTORY_H2_SUB_PRODUCT_NAME),
    IFF(PROVIDER_DIRECTORY_H2_SUB_PRODUCT_KEY = 'NULL', NULL, PROVIDER_DIRECTORY_H2_SUB_PRODUCT_KEY),
    IFF(H2_ENTITY_NAME = 'NULL', NULL, H2_ENTITY_NAME),
    TRY_TO_NUMBER(IFF(PRODUCT_KEY = 'NULL', NULL, PRODUCT_KEY)),
    TRY_TO_NUMBER(IFF(PRODUCT_TYPE_KEY = 'NULL', NULL, PRODUCT_TYPE_KEY)),
    IFF(PROVIDER_DIRECTORY_NETWORK_ID = 'NULL', NULL, PROVIDER_DIRECTORY_NETWORK_ID),
    IFF(LEVELED_SUB_PRODUCT_INDICATOR = 'NULL', NULL, LEVELED_SUB_PRODUCT_INDICATOR),
    TRY_TO_NUMBER(IFF(PROVIDER_KEY = 'NULL', NULL, PROVIDER_KEY))
FROM
    &{IDAP_LAKE}.PROVIDER.AFFILIATIONS_NON_PARTICIPANT_VW;`;
sqlCommandArray.push(sqlCommand);


//TRUNCATE INSERT CONTRACTS TABLE
sqlCommand = `
INSERT OVERWRITE INTO PROVIDER_ONLINE.CONTRACT_NON_PARTICIPANT
    (
        PROVIDER_ADDRESS_RELATIONSHIP_KEY,
        PRODUCT_KEY,
        PRODUCT_NAME,
        PRODUCT_TYPE_KEY,
        PRODUCT_TYPE_NAME,
        CONTRACT_LEVEL_CODE,
        ACTIVE_INDICATOR,
        PROVIDER_CONTRACT_ROLE_TYPE,
        ACCEPTING_NEW_PATIENTS_INDICATOR,
        PROVIDER_DIRECTORY_RESTRICTION_DESCRIPTION,
        RESTRICTION_RANK_NUMBER,
        H2_ENTITY_NAME,
        CARE_TYPE_NAME,
        COVERAGE_TYPE_NAME,
        LEVELED_SUB_PRODUCT_INDICATOR,
        CONTRACT_MODEL_NAME,
        ALTERNATE_NETWORK_NAME,
        PROVIDER_DIRECTORY_H2_PRODUCT_NAME,
        PROVIDER_DIRECTORY_H2_PRODUCT_KEY,
        PROVIDER_DIRECTORY_H2_SUB_PRODUCT_NAME,
        PROVIDER_DIRECTORY_H2_SUB_PRODUCT_KEY,
        PROVIDER_DIRECTORY_NETWORK_ID
    )
SELECT
    TRY_TO_NUMBER(IFF(PROVIDER_ADDRESS_RELATIONSHIP_KEY = 'NULL', NULL, PROVIDER_ADDRESS_RELATIONSHIP_KEY)),
    TRY_TO_NUMBER(IFF(PRODUCT_KEY = 'NULL', NULL, PRODUCT_KEY)),
    IFF(PRODUCT_NAME = 'NULL', NULL, PRODUCT_NAME),
    TRY_TO_NUMBER(IFF(PRODUCT_TYPE_KEY = 'NULL', NULL, PRODUCT_TYPE_KEY)),
    IFF(PRODUCT_TYPE_NAME = 'NULL', NULL, PRODUCT_TYPE_NAME),
    IFF(CONTRACT_LEVEL_CODE = 'NULL', NULL, CONTRACT_LEVEL_CODE),
    IFF(ACTIVE_INDICATOR = 'NULL', NULL, ACTIVE_INDICATOR),
    IFF(PROVIDER_CONTRACT_ROLE_TYPE = 'NULL', NULL, PROVIDER_CONTRACT_ROLE_TYPE),
    IFF(ACCEPTING_NEW_PATIENTS_INDICATOR = 'NULL', NULL, ACCEPTING_NEW_PATIENTS_INDICATOR),
    IFF(PROVIDER_DIRECTORY_RESTRICTION_DESCRIPTION = 'NULL', NULL, PROVIDER_DIRECTORY_RESTRICTION_DESCRIPTION),
    TRY_TO_NUMBER(IFF(RESTRICTION_RANK_NUMBER = 'NULL', NULL, RESTRICTION_RANK_NUMBER)),
    IFF(H2_ENTITY_NAME = 'NULL', NULL, H2_ENTITY_NAME),
    IFF(CARE_TYPE_NAME = 'NULL', NULL, CARE_TYPE_NAME),
    IFF(COVERAGE_TYPE_NAME = 'NULL', NULL, COVERAGE_TYPE_NAME),
    IFF(LEVELED_SUB_PRODUCT_INDICATOR = 'NULL', NULL, LEVELED_SUB_PRODUCT_INDICATOR),
    IFF(CONTRACT_MODEL_NAME = 'NULL', NULL, CONTRACT_MODEL_NAME),
    IFF(ALTERNATE_NETWORK_NAME = 'NULL', NULL, ALTERNATE_NETWORK_NAME),
    IFF(PROVIDER_DIRECTORY_H2_PRODUCT_NAME = 'NULL', NULL, PROVIDER_DIRECTORY_H2_PRODUCT_NAME),
    IFF(PROVIDER_DIRECTORY_H2_PRODUCT_KEY = 'NULL', NULL, PROVIDER_DIRECTORY_H2_PRODUCT_KEY),
    IFF(PROVIDER_DIRECTORY_H2_SUB_PRODUCT_NAME = 'NULL', NULL, PROVIDER_DIRECTORY_H2_SUB_PRODUCT_NAME),
    IFF(PROVIDER_DIRECTORY_H2_SUB_PRODUCT_KEY = 'NULL', NULL, PROVIDER_DIRECTORY_H2_SUB_PRODUCT_KEY),
    IFF(PROVIDER_DIRECTORY_NETWORK_ID = 'NULL', NULL, PROVIDER_DIRECTORY_NETWORK_ID)
FROM
    &{IDAP_LAKE}.PROVIDER.CONTRACT_NON_PARTICIPANT_VW;`;
sqlCommandArray.push(sqlCommand);
	
//TRUNCATE INSERT DIRECTORY TABLE
sqlCommand = `
INSERT OVERWRITE INTO PROVIDER_ONLINE.DIRECTORY_NON_PARTICIPANT
    (
        ID,
        CLIENT_ID,
        TPA_ID,
        TPA_DIV_ID,
        DATA_SOURCE_NAME,
        PROVIDER_KEY,
        NETWORK_ID,
        ODS_PROVIDER_KEY,
        PROVIDER_NUMBER,
        PROVIDER_FULL_NAME,
        PROVIDER_NAME_PARTITION,
        PROVIDER_SUB_TYPE_DESCRIPTION,
        PROVIDER_ROLE_TYPE_DESCRIPTION,
        MEDICAID_INDICATOR,
        EMAIL_ADDRESS_TEXT,
        PRACTITIONER_GENDER_NAME,
        PRACTITIONER_BIRTH_DATE,
        PROVIDER_CONTRACT_ID,
        VCODE,
        FACILITY_TYPE,
        OFFICE_ID,
        OFFICE_NAME,
        SERVICE_AREA_STATE_ABBREVIATION_NAME,
        SERVICE_AREA_COUNTY_NAME,
        ADDRESSLINE1_TEXT,
        ADDRESSLINE2_TEXT,
        CITY_NAME,
        STATE_ABBREVIATION_NAME,
        COUNTRY_NAME,
        ZIP_CODE_NUMBER,
        COUNTY_NAME,
        COORDINATE_TYPE,
        COORDINATES,
        PROVIDER_ADDRESS_ROLE_TYPE_DESCRIPTION,
        PRIMARY_PHONE_NUMBER,
        HANDICAP_ACCESS_INDICATOR,
        OWNING_MEDICAL_GROUP_KEY,
        LOCATION_OWNING_PROVIDER_NUMBER,
        UPMC_OWNED_LOCATION_INDICATOR,
        TAX_ID_NUMBER,
        UPMC_OWNERSHIP_STATUS_DESCRIPTION,
        WEEKEND_SCHEDULE_HOURS_INDICATOR,
        EVENING_SCHEDULE_HOURS_INDICATOR,
        WEEKDAY_NAME,
        SCHEDULED_HOURS_TEXT,
        LANGUAGE_NAME,
        BOARD_CERTIFICATION,
        ACCREDITATION_AGENCY_NAME,
        ICON_FILE_TEXT,
        PROGRAM_DESCRIPTION,
        PROGRAM_LINK_TEXT,
        SPECIALTY,
        CARE_TYPE,
        REFERRAL_INDICATOR,
        SPECIALTY_ENTITY,
        PRIMARY_SPECIALTY_INDICATOR,
        PROVIDER_TYPE,
        LOAD_DATE,
        TELE_HEALTH_INDICATOR,
        ACCREDITATION_AGENCY_URL,
        PROVIDER_NPI,
        OFFICE_LANGUAGE_NAME,
        OFFICE_LANGUAGE_SUPPORT_SERVICE,
        PROVIDER_FIRST_NAME,
        PROVIDER_LAST_NAME,
        VIRTUAL_CARE_MODEL_INDICATOR,
        MASUPER_PCP_INDICATOR,
        ALTERNATE_PHONE_NUMBER,
        FAX_NUMBER,
        MAIL_ORDER_FLAG,
        LGBTQIA_CULTURAL_COMPETENCY_INDICATOR,
        LEGAL_ADDRESS_RELATIONSHIP_KEY,
        BILLING_PROVIDER_CLAIM_TYPE,
        SUBPART_NPIS,
        PROMISE_ID,
        MEDICARE_NUMBER,
        MEDICARE_STATE
    )
SELECT
    IFF(ID = 'NULL', NULL, ID),
    IFF(CLIENT_ID = 'NULL', NULL, CLIENT_ID),
    IFF(TPA_ID = 'NULL', NULL, TPA_ID),
    IFF(TPA_DIV_ID = 'NULL', NULL, TPA_DIV_ID),
    IFF(DATA_SOURCE_NAME = 'NULL', NULL, DATA_SOURCE_NAME),
    IFF(PROVIDER_KEY = 'NULL', NULL, REPLACE(PROVIDER_KEY, '~', '|')),
    IFF(NETWORK_ID = 'NULL', NULL, NETWORK_ID),
    TRY_TO_NUMBER(IFF(ODS_PROVIDER_KEY = 'NULL', NULL, ODS_PROVIDER_KEY)),
    IFF(PROVIDER_NUMBER = 'NULL', NULL, PROVIDER_NUMBER),
    IFF(PROVIDER_FULL_NAME = 'NULL', NULL, PROVIDER_FULL_NAME),
    IFF(PROVIDER_NAME_PARTITION = 'NULL', NULL, PROVIDER_NAME_PARTITION),
    IFF(PROVIDER_SUB_TYPE_DESCRIPTION = 'NULL', NULL, PROVIDER_SUB_TYPE_DESCRIPTION),
    IFF(PROVIDER_ROLE_TYPE_DESCRIPTION = 'NULL', NULL, PROVIDER_ROLE_TYPE_DESCRIPTION),
    IFF(MEDICAID_INDICATOR = 'NULL', NULL, MEDICAID_INDICATOR),
    IFF(EMAIL_ADDRESS_TEXT = 'NULL', NULL, EMAIL_ADDRESS_TEXT),
    IFF(PRACTITIONER_GENDER_NAME = 'NULL', NULL, PRACTITIONER_GENDER_NAME),
    IFF(PRACTITIONER_BIRTH_DATE = 'NULL', NULL, PRACTITIONER_BIRTH_DATE),
    IFF(PROVIDER_CONTRACT_ID = 'NULL', NULL, REPLACE(PROVIDER_CONTRACT_ID, '~', '|')),
    IFF(VCODE = 'NULL', NULL, VCODE),
    IFF(FACILITY_TYPE = 'NULL', NULL, FACILITY_TYPE),
    IFF(OFFICE_ID = 'NULL', NULL, OFFICE_ID),
    IFF(OFFICE_NAME = 'NULL', NULL, OFFICE_NAME),
    IFF(SERVICE_AREA_STATE_ABBREVIATION_NAME = 'NULL', NULL, SERVICE_AREA_STATE_ABBREVIATION_NAME),
    IFF(SERVICE_AREA_COUNTY_NAME = 'NULL', NULL, SERVICE_AREA_COUNTY_NAME),
    IFF(ADDRESSLINE1_TEXT = 'NULL', NULL, ADDRESSLINE1_TEXT),
    IFF(ADDRESSLINE2_TEXT = 'NULL', NULL, ADDRESSLINE2_TEXT),
    IFF(CITY_NAME = 'NULL', NULL, CITY_NAME),
    IFF(STATE_ABBREVIATION_NAME = 'NULL', NULL, STATE_ABBREVIATION_NAME),
    IFF(COUNTRY_NAME = 'NULL', NULL, COUNTRY_NAME),
    IFF(ZIP_CODE_NUMBER = 'NULL', NULL, ZIP_CODE_NUMBER),
    IFF(COUNTY_NAME = 'NULL', NULL, COUNTY_NAME),
    IFF(COORDINATE_TYPE = 'NULL', NULL, COORDINATE_TYPE),
    IFF(COORDINATES = 'NULL', NULL, COORDINATES),
    IFF(PROVIDER_ADDRESS_ROLE_TYPE_DESCRIPTION = 'NULL', NULL, PROVIDER_ADDRESS_ROLE_TYPE_DESCRIPTION),
    IFF(PRIMARY_PHONE_NUMBER = 'NULL', NULL, PRIMARY_PHONE_NUMBER),
    IFF(HANDICAP_ACCESS_INDICATOR = 'NULL', NULL, HANDICAP_ACCESS_INDICATOR),
    TRY_TO_NUMBER(IFF(OWNING_MEDICAL_GROUP_KEY = 'NULL', NULL, OWNING_MEDICAL_GROUP_KEY)),
    IFF(LOCATION_OWNING_PROVIDER_NUMBER = 'NULL', NULL, LOCATION_OWNING_PROVIDER_NUMBER),
    IFF(UPMC_OWNED_LOCATION_INDICATOR = 'NULL', NULL, UPMC_OWNED_LOCATION_INDICATOR),
    IFF(TAX_ID_NUMBER = 'NULL', NULL, TAX_ID_NUMBER),
    IFF(UPMC_OWNERSHIP_STATUS_DESCRIPTION = 'NULL', NULL, UPMC_OWNERSHIP_STATUS_DESCRIPTION),
    IFF(WEEKEND_SCHEDULE_HOURS_INDICATOR = 'NULL', NULL, WEEKEND_SCHEDULE_HOURS_INDICATOR),
    IFF(EVENING_SCHEDULE_HOURS_INDICATOR = 'NULL', NULL, EVENING_SCHEDULE_HOURS_INDICATOR),
    IFF(WEEKDAY_NAME = 'NULL', NULL, WEEKDAY_NAME),
    IFF(SCHEDULED_HOURS_TEXT = 'NULL', NULL, SCHEDULED_HOURS_TEXT),
    IFF(LANGUAGE_NAME = 'NULL', NULL, LANGUAGE_NAME),
    IFF(BOARD_CERTIFICATION = 'NULL', NULL, BOARD_CERTIFICATION),
    IFF(ACCREDITATION_AGENCY_NAME = 'NULL', NULL, ACCREDITATION_AGENCY_NAME),
    IFF(ICON_FILE_TEXT = 'NULL', NULL, ICON_FILE_TEXT),
    IFF(PROGRAM_DESCRIPTION = 'NULL', NULL, PROGRAM_DESCRIPTION),
    IFF(PROGRAM_LINK_TEXT = 'NULL', NULL, PROGRAM_LINK_TEXT),
    IFF(SPECIALTY = 'NULL', NULL, SPECIALTY),
    IFF(CARE_TYPE = 'NULL', NULL, CARE_TYPE),
    IFF(REFERRAL_INDICATOR = 'NULL', NULL, REFERRAL_INDICATOR),
    IFF(SPECIALTY_ENTITY = 'NULL', NULL, SPECIALTY_ENTITY),
    IFF(PRIMARY_SPECIALTY_INDICATOR = 'NULL', NULL, PRIMARY_SPECIALTY_INDICATOR),
    IFF(PROVIDER_TYPE = 'NULL', NULL, PROVIDER_TYPE),
    IFF(LOAD_DATE = 'NULL', NULL, LOAD_DATE),
    IFF(TELE_HEALTH_INDICATOR = 'NULL', NULL, TELE_HEALTH_INDICATOR),
    IFF(ACCREDITATION_AGENCY_URL = 'NULL', NULL, ACCREDITATION_AGENCY_URL),
    IFF(PROVIDER_NPI = 'NULL', NULL, PROVIDER_NPI),
    IFF(OFFICE_LANGUAGE_NAME = 'NULL', NULL, OFFICE_LANGUAGE_NAME),
    IFF(OFFICE_LANGUAGE_SUPPORT_SERVICE = 'NULL', NULL, OFFICE_LANGUAGE_SUPPORT_SERVICE),
    IFF(PROVIDER_FIRST_NAME = 'NULL', NULL, PROVIDER_FIRST_NAME),
    IFF(PROVIDER_LAST_NAME = 'NULL', NULL, PROVIDER_LAST_NAME),
    IFF(VIRTUAL_CARE_MODEL_INDICATOR = 'NULL', NULL, VIRTUAL_CARE_MODEL_INDICATOR),
    IFF(MASUPER_PCP_INDICATOR = 'NULL', NULL, MASUPER_PCP_INDICATOR),
    IFF(ALTERNATE_PHONE_NUMBER = 'NULL', NULL, ALTERNATE_PHONE_NUMBER),
    IFF(FAX_NUMBER = 'NULL', NULL, FAX_NUMBER),
    IFF(MAIL_ORDER_FLAG = 'NULL', NULL, MAIL_ORDER_FLAG),
    IFF(LGBTQIA_CULTURAL_COMPETENCY_INDICATOR = 'NULL', NULL, LGBTQIA_CULTURAL_COMPETENCY_INDICATOR),
    TRY_TO_NUMBER(IFF(LEGAL_ADDRESS_RELATIONSHIP_KEY = 'NULL', NULL, LEGAL_ADDRESS_RELATIONSHIP_KEY)),
    IFF(BILLING_PROVIDER_CLAIM_TYPE = 'NULL', NULL, BILLING_PROVIDER_CLAIM_TYPE),
    IFF(SUBPART_NPIS = 'NULL', NULL, SUBPART_NPIS),
	IFF(PROMISE_ID = 'NULL', NULL, PROMISE_ID),
    IFF(MEDICARE_NUMBER = 'NULL', NULL, MEDICARE_NUMBER),
    IFF(MEDICARE_STATE = 'NULL', NULL, MEDICARE_STATE)
FROM
    &{IDAP_LAKE}.PROVIDER.DIRECTORY_NON_PARTICIPANT_VW;`;
sqlCommandArray.push(sqlCommand);

//TRUNCATE INSERT LEGALADDRESSREL table
sqlCommand = `
INSERT OVERWRITE INTO PROVIDER_ONLINE.LEGAL_ADDRESS_RELATIONSHIP
    (
        LEGAL_ADDRESS_RELATIONSHIP_KEY,
        PROVIDER_KEY,
        LEGAL_KEY,
        LEGAL_OFFICE_NAME,
        LEGAL_ADDRESS1,
        LEGAL_ADDRESS2,
        LEGAL_CITY,
        LEGAL_STATE,
        LEGAL_ZIP
    )
SELECT
    TRY_TO_NUMBER(IFF(LEGAL_ADDRESS_RELATIONSHIP_KEY = 'NULL', NULL, LEGAL_ADDRESS_RELATIONSHIP_KEY)),
    TRY_TO_NUMBER(IFF(PROVIDER_KEY = 'NULL', NULL, PROVIDER_KEY)),
    TRY_TO_NUMBER(IFF(LEGAL_KEY = 'NULL', NULL, LEGAL_KEY)),
    IFF(LEGAL_OFFICE_NAME = 'NULL', NULL, LEGAL_OFFICE_NAME),
    IFF(LEGAL_ADDRESS1 = 'NULL', NULL, LEGAL_ADDRESS1),
    IFF(LEGAL_ADDRESS2 = 'NULL', NULL, LEGAL_ADDRESS2),
    IFF(LEGAL_CITY = 'NULL', NULL, LEGAL_CITY),
    IFF(LEGAL_STATE = 'NULL', NULL, LEGAL_STATE),
    IFF(LEGAL_ZIP = 'NULL', NULL, LEGAL_ZIP)
FROM
    &{IDAP_LAKE}.PROVIDER.LEGAL_ADDRESS_RELATIONSHIP_VW;`;
sqlCommandArray.push(sqlCommand);

try
{
    //Execute SQL Command
    for (let i = 0; i < sqlCommandArray.length; i++) {

      //Run SQL
      targetTableName = tableArray[i]
      statement = snowflake.createStatement({ sqlText: sqlCommandArray[i] });
      let sqlResult = statement.execute();
      sqlResult.next();
      let affectedNum = sqlResult.getNumRowsAffected();
      result += targetTableName + " succeeded and affected " + affectedNum + " rows " + "\n";
      let endTime = new Date().toISOString();

      //Log results to table
      sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
          (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT)
          VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9);`;

      snowflake.execute
      (
          {sqlText: sqlLogCommand,
          binds: [targetTableName, "TABLE", startTime, endTime, statement.getNumRowsInserted(), statement.getNumRowsUpdated(), statement.getNumRowsDeleted(), result, statement.getSqlText()]
          }
      );
    }

}
catch (err)
{
    let code = err.code || err.name;
    let state = err.state || '(JavaScript error, not provided)'
    let message = (err.message || '(JavaScript error, not provided)').replace(/'/g, "''")
    let stack = (err.stackTraceTxt || err.stack).replace(/'/g, "''");
    let endTime = new Date().toISOString();
    result = procedureName + ' Failed'

    //Log results to table
    sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;
        
    snowflake.execute
    (
        {sqlText: sqlLogCommand,
        binds:[procedureName, "STORED_PROCEDURE", startTime, endTime, result, statement.getSqlText(), code, state, message, stack]
        }
    );
    throw message;
}
return result;
$$
;
!set variable_substitution=true;