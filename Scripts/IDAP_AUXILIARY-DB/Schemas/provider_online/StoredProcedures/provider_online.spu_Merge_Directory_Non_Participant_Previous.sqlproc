CREATE OR REPLACE PROCEDURE PROVIDER_ONLINE.SPU_MERGE_DIRECTORY_NON_PARTICIPANT_PREVIOUS()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = "PROVIDER_ONLINE.DIRECTORY_NON_PARTICIPANT_PREVIOUS";
const sqlCommandArray = [];
var sqlLogCommand = "", result = "";

//Set Previous MD5 as Current to indicate previous load
sqlCommand = `
UPDATE PROVIDER_ONLINE.DIRECTORY_NON_PARTICIPANT_PREVIOUS
SET
    PROVIDER_DIRECTORY_JSON_PREVIOUS_MD5 = PROVIDER_DIRECTORY_JSON_CURRENT_MD5
WHERE LAST_AUDIT_ACTION != 'DELETE';`;
sqlCommandArray.push(sqlCommand);

//MERGE update existing, and Insert new records
sqlCommand = `
MERGE INTO
    DIRECTORY_NON_PARTICIPANT_PREVIOUS TGT USING (
        SELECT
            ID,
            NETWORK_ID,
            PROVIDER_KEY,
            MD5(TO_CHAR(PROVDIRJSONTXT)) AS MD5
        FROM
            PROVIDER_ONLINE.PROVIDERS_JSON_SELECT_CACTUS_VW
        UNION ALL
        SELECT
            ID,
            NETWORK_ID,
            PROVIDER_KEY,
            MD5(TO_CHAR(PROVDIRJSONTXT)) AS MD5
        FROM
            PROVIDER_ONLINE.PROVIDERS_JSON_SELECT_MC400_VW
        UNION ALL
        SELECT
            ID,
            NETWORK_ID,
            PROVIDER_KEY,
            MD5(TO_CHAR(PROVDIRJSONTXT)) AS MD5
        FROM
            PROVIDER_ONLINE.PROVIDERS_JSON_SELECT_MEDGROUP_CACTUS_VW
        UNION ALL
        SELECT
            ID,
            NETWORK_ID,
            PROVIDER_KEY,
            MD5(TO_CHAR(PROVDIRJSONTXT)) AS MD5
        FROM
            PROVIDER_ONLINE.PROVIDERS_JSON_SELECT_MEDGROUP_MC400_VW
    ) SRC ON TGT.ID = SRC.ID
    AND TGT.NETWORK_ID = SRC.NETWORK_ID
    AND TGT.PROVIDER_KEY = SRC.PROVIDER_KEY
WHEN MATCHED
THEN UPDATE SET
    PROVIDER_DIRECTORY_JSON_CURRENT_MD5 = SRC.MD5,
    LAST_UPDATED_DATETIME = CURRENT_TIMESTAMP(),
    LAST_AUDIT_ACTION = 'UPDATE'
WHEN NOT MATCHED THEN INSERT
    (
        PROVIDER_KEY,
        NETWORK_ID,
        ID,
        LAST_AUDIT_ACTION,
        PROVIDER_DIRECTORY_JSON_CURRENT_MD5,
        PROVIDER_DIRECTORY_JSON_PREVIOUS_MD5,
        INSERT_DATETIME,
        LAST_UPDATED_DATETIME
    )
VALUES
    (
        SRC.PROVIDER_KEY,
        SRC.NETWORK_ID,
        SRC.ID,
        'INSERT',
        SRC.MD5,
        NULL,
        CURRENT_TIMESTAMP(),
        CURRENT_TIMESTAMP()
    );`;
sqlCommandArray.push(sqlCommand);

//Update to set Soft Delete Records
sqlCommand = `
UPDATE PROVIDER_ONLINE.DIRECTORY_NON_PARTICIPANT_PREVIOUS
SET
    DIRECTORY_NON_PARTICIPANT_PREVIOUS.PROVIDER_DIRECTORY_JSON_CURRENT_MD5 = NULL,
    DIRECTORY_NON_PARTICIPANT_PREVIOUS.LAST_AUDIT_ACTION = 'DELETE'
FROM
    (
        SELECT DISTINCT
            PREV.ID,
            PREV.NETWORK_ID,
            PREV.PROVIDER_KEY,
            DNP.ID AS NONPAR_ID
        FROM
            PROVIDER_ONLINE.DIRECTORY_NON_PARTICIPANT_PREVIOUS PREV
            LEFT JOIN PROVIDER_ONLINE.DIRECTORY_NON_PARTICIPANT DNP ON PREV.ID = DNP.ID
            AND PREV.NETWORK_ID = DNP.CLIENT_ID || DNP.TPA_ID || DNP.TPA_DIV_ID || DNP.NETWORK_ID
            AND PREV.PROVIDER_KEY = DNP.PROVIDER_KEY
    ) SUBQUERY
WHERE
    DIRECTORY_NON_PARTICIPANT_PREVIOUS.ID = SUBQUERY.ID
    AND DIRECTORY_NON_PARTICIPANT_PREVIOUS.NETWORK_ID = SUBQUERY.NETWORK_ID
    AND DIRECTORY_NON_PARTICIPANT_PREVIOUS.PROVIDER_KEY = SUBQUERY.PROVIDER_KEY
    AND SUBQUERY.NONPAR_ID IS NULL;`;
sqlCommandArray.push(sqlCommand);

try
{
    //Execute SQL Command
    for (let i = 0; i < sqlCommandArray.length; i++) {

      //Run SQL
      statement = snowflake.createStatement({ sqlText: sqlCommandArray[i] });
      let sqlResult = statement.execute();
      sqlResult.next();
      let affectedNum = sqlResult.getNumRowsAffected();
      result += targetTableName + " succeeded and affected " + affectedNum + " rows " + "\n";
      let endTime = new Date().toISOString();

      //Log results to table
      sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
          (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT)
          VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9);`;

      snowflake.execute
      (
          {sqlText: sqlLogCommand,
          binds: [targetTableName, "TABLE", startTime, endTime, statement.getNumRowsInserted(), statement.getNumRowsUpdated(), statement.getNumRowsDeleted(), result, statement.getSqlText()]
          }
      );
    }

}
catch (err)
{
    let code = err.code || err.name;
    let state = err.state || '(JavaScript error, not provided)'
    let message = (err.message || '(JavaScript error, not provided)').replace(/'/g, "''")
    let stack = (err.stackTraceTxt || err.stack).replace(/'/g, "''");
    let endTime = new Date().toISOString();
    result = procedureName + ' Failed'

    //Log results to table
    sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;
        
    snowflake.execute
    (
        {sqlText: sqlLogCommand,
        binds:[procedureName, "STORED_PROCEDURE", startTime, endTime, result, statement.getSqlText(), code, state, message, stack]
        }
    );
    throw message;
}
return result;
$$
;