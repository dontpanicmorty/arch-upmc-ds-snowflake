CREATE OR REPLACE PROCEDURE UTIL.SPU_EPIC_EXPORT("ADF_EPIC_COPY_CONTROL_KEY" VARCHAR, "RUN_ID" VARCHAR)
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS '

//-------
// INPUTS
//------
var adf_epic_control_key = ADF_EPIC_COPY_CONTROL_KEY;
var run_id = RUN_ID;

//-------
// Variables Replaceable by need 
//-----
var tgt_stage = ''@UTIL.HPDSDATALAKE_OUTGOING'';

//------
//Variables for logging
//------
var startTime = new Date().toISOString();

//-----
// Execute control_table_query
//----
//Control table query 
var control_table_query = "\\
    SELECT  IS_ACTIVE, \\
            SOURCE_DATABASE_NAME, \\
            SOURCE_SCHEMA_NAME, \\
            SOURCE_VIEW_NAME, \\
            SOURCE_FILE_FORMAT, \\
            TARGET_DATA_LAKE_PATH, \\
            EPIC_TARGET_FILE_PATH, \\
            EPIC_TARGET_FILE_NAME, \\
            EPIC_FILE_DATE_FORMAT, \\
            EPIC_TARGET_FILE_EXTENSION \\
    FROM    UTIL.ADF_EPIC_EXPORT_COPY_CONTROL \\
    WHERE   ADF_EPIC_COPY_CONTROL_KEY = ?;";
    
// Getting results from control file table for specified control file key
var control_table_data = snowflake.createStatement({sqlText: control_table_query, binds: [adf_epic_control_key]});
var res_control_table_data = control_table_data.execute();
    res_control_table_data.next();

//COLLECTING VARIABLES FROM CONTROL TABLE    
var is_active               = res_control_table_data.getColumnValue(1);
var source_database_name    = res_control_table_data.getColumnValue(2);
var source_schema_name      = res_control_table_data.getColumnValue(3);
var source_view_name        = res_control_table_data.getColumnValue(4);
var source_file_format      = res_control_table_data.getColumnValue(5);
var target_data_lake_path   = res_control_table_data.getColumnValue(6);
var epic_target_file_path   = res_control_table_data.getColumnValue(7);
var epic_target_file_name   = res_control_table_data.getColumnValue(8);
var epic_file_date_format   = res_control_table_data.getColumnValue(9);
var epic_target_file_ext    = res_control_table_data.getColumnValue(10);

var source_table_parsed = source_database_name + ''.'' + source_schema_name + ''.'' + source_view_name;

//-----
//Execute obj_type_query
//-----
//Object type query 
var obj_type_query = "\\
    SELECT  TABLE_TYPE \\
    FROM    " + source_database_name + ".INFORMATION_SCHEMA.TABLES \\
    WHERE   TABLE_SCHEMA = ''" + source_schema_name + "'' \\
    AND     TABLE_NAME   = ''" + source_view_name + "'';";
    
var obj_type_data_snowflake = snowflake.createStatement({sqlText: obj_type_query});
var res_obj_type_data = obj_type_data_snowflake.execute();
    res_obj_type_data.next();
  
var obj_type = res_obj_type_data.getColumnValue(1);



//IF EXPORT IS INACTIVE LET USER KNOW
if(is_active === false){
    return "THIS EXPORT IS INACTIVE";
    }

//-----
// BUILD DATE STAMP AND FILE NAME
//-----
var now = new Date();
var year  = now.getFullYear().toString();
var month = ("0" + (now.getMonth() + 1)).slice(-2);
var day   = ("0" + now.getDate()).slice(-2);
var hour  = ("0" + now.getHours()).slice(-2);
var min   = ("0" + now.getMinutes()).slice(-2);
var sec   = ("0" + now.getSeconds()).slice(-2);

// Build date stamp from EPIC_FILE_DATE_FORMAT column
var date_stamp = epic_file_date_format
    .replace("YYYY", year)
    .replace("MM", month)
    .replace("DD", day)
    .replace("HH", hour)
    .replace("MI", min)
    .replace("SS", sec);

// Build final file name with date appended: e.g. Acuity_20260430.txt
var final_file_name = epic_target_file_name + "_" + date_stamp + epic_target_file_ext;

//-----
// BUILD EXPORT QUERY
//-----
var final_copy_query = "\\
    COPY INTO " + tgt_stage + target_data_lake_path + final_file_name + " \\
    FROM ( \\
        SELECT * \\
        FROM " + source_table_parsed + " ) \\
    HEADER = FALSE \\
    SINGLE = TRUE \\
    MAX_FILE_SIZE = 5368709120 \\
    FILE_FORMAT = ( FORMAT_NAME = " + source_file_format + " ); "
    

try{
//EXECUTING COPY INTO AND RETURNING RESULTS OF QUERY
var sql_statement = snowflake.createStatement({
    sqlText: final_copy_query
});
var sql_results = sql_statement.execute();

//GET RECORD COUNT FOR COPY INTO
var result_array = [];
while (sql_results.next()) {
    result_array.push(sql_results.getColumnValue(1));
}

var unloaded_recs = result_array.toString();

///////////////////////////////////////For logging
var endTime = new Date().toISOString();
var result = ''SUCCESS'';

var sqlLogCommand ="INSERT INTO LOGDATA.ADF_EPIC_EXPORT_HISTORY (ADF_EPIC_CONTROL_KEY, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, RESULT_TEXT, SQL_STATEMENT, RUN_ID, TARGET_FILE_NAME) VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10);";      


snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [adf_epic_control_key, source_table_parsed, obj_type, startTime, endTime, unloaded_recs, result, final_copy_query, run_id, final_file_name]
        }
    );

////////////////////////////////////FOR LOGGING^


//the return that provides the result set
return unloaded_recs;


}
catch(err)
{
//////////////////////////////////FOR LOGGING
var endTime = new Date().toISOString();
var sqlLogCommand = "INSERT INTO LOGDATA.ADF_EPIC_EXPORT_HISTORY (ADF_EPIC_CONTROL_KEY, NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, RUN_ID, TARGET_FILE_NAME, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT) VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10,:11,:12,:13)";

snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[adf_epic_control_key, source_table_parsed, obj_type, startTime, endTime, "FAILED", final_copy_query, run_id, final_file_name, err.code, err.state, err.message, err.stackTraceTxt]
        }
    );
//////////////////////////////////FOR LOGGING^

throw "EPIC EXPORT FAILED: " + err.message;
}


';