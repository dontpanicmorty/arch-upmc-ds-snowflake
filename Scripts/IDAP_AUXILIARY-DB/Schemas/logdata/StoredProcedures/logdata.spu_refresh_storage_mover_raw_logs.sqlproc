CREATE OR REPLACE PROCEDURE LOGDATA.SPU_REFRESH_STORAGE_MOVER_RAW_LOGS()
  RETURNS STRING
  LANGUAGE JAVASCRIPT
  EXECUTE AS OWNER
AS
$$
try {
    var sql_command = `
        ALTER EXTERNAL TABLE LOGDATA.STORAGE_MOVER_RAW_LOGS REFRESH
    `;

    var stmt = snowflake.createStatement({ sqlText: sql_command });
    stmt.execute();

    return 'External table LOGDATA.STORAGE_MOVER_RAW_LOGS refreshed successfully.';
} catch (err) {
    return 'Error refreshing external table: ' + err.message;
}
$$;