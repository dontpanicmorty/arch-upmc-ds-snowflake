CREATE OR REPLACE PROCEDURE QUALITY.SPU_LOAD_CLEARSENSE_PATIENTS("RUN_ID" VARCHAR(16777216), "DATA_FLOW_NAME" VARCHAR(16777216))
RETURNS VARCHAR(16777216)
LANGUAGE JAVASCRIPT
COMMENT='Load QUALITY.CCD_PATIENTS from XML_SECTION'
EXECUTE AS OWNER
AS '

//---------------------------------------
//-- Prepare for execution
//---------------------------------------

    var startTime = new Date().toISOString();    
    var dataDomainName = "";
    var stepOrderNumber = 0;
    var stepProcedureName = "QUALITY.SPU_LOAD_CLEARSENSE_PATIENTS";
    
    var lookupCommand = `
SELECT DATA_FLOW_NAME, DATA_DOMAIN_NAME, STEP_ORDER_NUMBER, STEP_PROCEDURE_NAME
FROM UTIL.DATA_FLOW_CONTROL_TABLE
WHERE IS_ACTIVE = ''Y'' AND DATA_FLOW_NAME = :1 AND STEP_PROCEDURE_NAME = :2
ORDER BY STEP_ORDER_NUMBER; 
`;

    var logStartCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES ( 
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,null
    ,''Starting''
    )
`;

    var logEndCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Succeeded''
)
`;

    var logErrorCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS
    ,ERROR_CODE
    ,ERROR_STATE
    ,ERROR_MESSAGE
    ,ERROR_STACK_TRACE_TEXT
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Error''
    ,:7
    ,:8
    ,:9
    ,:10
)
`;      


//-----------------------------------------
//-- SQL to load QUALITY.PATIENTS - START
//-----------------------------------------


    var sqlLogCommand = `
INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9);
`;



    var sqlDeletePatientsCommand = ` 
DELETE FROM QUALITY.CCD_PATIENTS WHERE MRN IN ( SELECT DISTINCT MRN FROM QUALITY.SECTION_XML ); 
`;


    var sqlInsertCcdPatientsCommand = `
INSERT INTO QUALITY.CCD_PATIENTS(
     MRN,
     SECTION_TITLE,
     FILENAME,
     ID_EXTENSION,
     ID_ROOT,
     ID_CODE,
     ID_CODE_NAME,
     ID_CODE_SYSTEM,
     ID_CODE_SYSTEM_NAME,
     PATIENT_LANGUAGE_CODE,
     PATIENT_ID_EXT,
     PATIENT_NAME,
     PATIENT_ADDRESS_LINE,
     PATIENT_CITY,
     PATIENT_STATE,
     PATIENT_ZIP,
     PATIENT_COUNTY,
     PATIENT_PHONE_NUM,
     PATIENT_CONTACT_2,
     PATIENT_CONTACT_3,
     GENDER_CODE,
     GENDER,
     BIRTH_DATE,
     MARITAL_CODE,
     MARITAL_STATUS,
     RACE_CODE,
     RACE_NAME,
     RACE_CODE_SYSTEM,
     ETHNICITY_CODE,
     ETHNICITY_NAME,
     ETHNICITY_CODE_SYSTEM_NAME,
     LANGUAGE_CODE,
     LANGUAGE_PROFICIENCY,
     LANGUAGE_PREFERENCE_IND,
     AUTHOR_TIME,
     AUTHOR_ID_ROOT,
     AUTHOR_ADDR_NULL_FLAVOR,
     AUTHOR_PHONE_NUMBER,
     ASSIGNED_NAME,
     MODEL_NAME,
     SOFTWARE_NAME,
     ORG_ROOT,
     ORG_EXT,
     ORG_NAME,
     ORG_PHONE_NUMBER,
     ORG_STREET_ADDRESS,
     ORG_CITY,
     ORG_STATE,
     ORG_ZIP_CODE,
     ORG_COUNTRY,
     CUSTODIAN_ID,
     CUSTODIAN_NAME,
     CUSTODIAN_PHONE_NUM,
     CUSTODIAN_STREET_ADDRESS,
     CUSTODIAN_CITY,
     CUSTODIAN_STATE,
     CUSTODIAN_ZIP_CODE,
     CUSTODIAN_COUNTRY,
     SERVICE_EVENT_CLASS,
     SERVICE_EVENT_START_DATE,
     SERVICE_EVENT_END_DATE,
     PERFORMER_TYPE_CODE,
     PERFORMER_FUNCTION_CODE,
     PERFORMER_FUNCTION_NAME,
     PERFORMER_FUNCTION_CODE_SYSTEM,
     PERFORMER_FUNCTION_TEXT,
     ENTITY_ID,
     ENTITY_ID_ROOT,
     ENTITY_CODE,
     ENTITY_NAME,
     ENTITY_CODE_SYSTEM_NAME,
     ENTITY_ADDR_NULL_FLAVOR,
     ENTITY_TELECOM_NULL_FLAVOR,
     ENTITY_PERSON_NAME,
     XML_DATA_ROW_NUM,
     XML_DATA_TS_LAST_MODIFY,
     XML_DATA_SCAN_TIME,
     INSERT_DATETIME
)
SELECT
     MRN,
     SECTION_TITLE,
     FILENAME,
     ID_EXTENSION,
     ID_ROOT,
     ID_CODE,
     ID_CODE_NAME,
     ID_CODE_SYSTEM,
     ID_CODE_SYSTEM_NAME,
     PATIENT_LANGUAGE_CODE,
     PATIENT_ID_EXT,
     PATIENT_NAME,
     PATIENT_ADDRESS_LINE,
     PATIENT_CITY,
     PATIENT_STATE,
     PATIENT_ZIP,
     PATIENT_COUNTY,
     PATIENT_PHONE_NUM,
     PATIENT_CONTACT_2,
     PATIENT_CONTACT_3,
     GENDER_CODE,
     GENDER,
     BIRTH_DATE,
     MARITAL_CODE,
     MARITAL_STATUS,
     RACE_CODE,
     RACE_NAME,
     RACE_CODE_SYSTEM,
     ETHNICITY_CODE,
     ETHNICITY_NAME,
     ETHNICITY_CODE_SYSTEM_NAME,
     LANGUAGE_CODE,
     LANGUAGE_PROFICIENCY,
     LANGUAGE_PREFERENCE_IND,
     AUTHOR_TIME,
     AUTHOR_ID_ROOT,
     AUTHOR_ADDR_NULL_FLAVOR,
     AUTHOR_PHONE_NUMBER,
     ASSIGNED_NAME,
     MODEL_NAME,
     SOFTWARE_NAME,
     ORG_ROOT,
     ORG_EXT,
     ORG_NAME,
     ORG_PHONE_NUMBER,
     ORG_STREET_ADDRESS,
     ORG_CITY,
     ORG_STATE,
     ORG_ZIP_CODE,
     ORG_COUNTRY,
     CUSTODIAN_ID,
     CUSTODIAN_NAME,
     CUSTODIAN_PHONE_NUM,
     CUSTODIAN_STREET_ADDRESS,
     CUSTODIAN_CITY,
     CUSTODIAN_STATE,
     CUSTODIAN_ZIP_CODE,
     CUSTODIAN_COUNTRY,
     SERVICE_EVENT_CLASS,
     SERVICE_EVENT_START_DATE,
     SERVICE_EVENT_END_DATE,
     PERFORMER_TYPE_CODE,
     PERFORMER_FUNCTION_CODE,
     PERFORMER_FUNCTION_NAME,
     PERFORMER_FUNCTION_CODE_SYSTEM,
     PERFORMER_FUNCTION_TEXT,
     ENTITY_ID,
     ENTITY_ID_ROOT,
     ENTITY_CODE,
     ENTITY_NAME,
     ENTITY_CODE_SYSTEM_NAME,
     ENTITY_ADDR_NULL_FLAVOR,
     ENTITY_TELECOM_NULL_FLAVOR,
     ENTITY_PERSON_NAME,
     XML_DATA_ROW_NUM,
     XML_DATA_TS_LAST_MODIFY,
     XML_DATA_SCAN_TIME,
     CURRENT_TIMESTAMP()
FROM QUALITY.CCD_PATIENTS_VW;
`;

//-----------------------------------------
//-- SQL to load QUALITY.PATIENTS - END
//-----------------------------------------




    try
    {
    
//---------------------------------------
//-- Lookup context details
//---------------------------------------

        var lookupSet = snowflake.execute({
            sqlText: lookupCommand, 
            binds: [DATA_FLOW_NAME,stepProcedureName]
        });        

        // check and handle for empty response
        if(!lookupSet.next())
        {     
            throw "Unable to lookup data flow context from UTIL.DATA_FLOW_CONTROL_TABLE";
        }

        dataDomainName = lookupSet.getColumnValueAsString(''DATA_DOMAIN_NAME'');    
        stepOrderNumber = lookupSet.getColumnValue(''STEP_ORDER_NUMBER'');

//---------------------------------------
//-- Log Execution Start
//---------------------------------------

        snowflake.execute({
            sqlText: logStartCommand, 
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        



//---------------------------------------
//-- Step logic goes here - STARTING
//---------------------------------------
  
    var sfStatement = snowflake.createStatement({sqlText: sqlDeletePatientsCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
    
    // Log record deletion stats to LOGDATA.TABLE_LOAD_HISTORY
    var sqlLogCommandDel = 
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT,RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10);
`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommandDel,
        binds: [RUN_ID, "QUALITY.CCD_PATIENTS", "TABLE", startTime, endTime, 
		        sfStatement.getNumRowsInserted(), 
				sfStatement.getNumRowsUpdated(), 
                sfStatement.getNumRowsDeleted(), 
				result, sfStatement.getSqlText()]
        }
    );    





    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCcdPatientsCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
    
    // Log Insert results to LOGDATA.TABLE_LOAD_HISTORY
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [RUN_ID, "QUALITY.CCD_PATIENTS", "TABLE", startTime, endTime, 
		        sfStatement.getNumRowsInserted(), 
				sfStatement.getNumRowsUpdated(),				
				result, sfStatement.getSqlText()]
        }
    );    




        

//---------------------------------------
//-- Step logic goes here - ENDING
//---------------------------------------





//---------------------------------------
//-- Log Execution Succeeded
//---------------------------------------

        snowflake.execute({
            sqlText: logEndCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        
        return "Success";
    }
    catch (err)    
    {
    
//---------------------------------------
//-- Error handling / Log Execution Failed
//---------------------------------------

        if(err.code !== undefined)
        { 
            var errCode = err.code; 
            var errState = err.state;
            var errMessage = err.message;
            var errTrace = err.stackTraceTxt;
        }
        else 
        { 
            var errCode = "";
            var errState = "";
            var errMessage = err;
            var errTrace = "";
        }
            
        snowflake.execute({
            sqlText: logErrorCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime,errCode,errState,errMessage,errTrace]
        });  

        throw err;
    }        
';