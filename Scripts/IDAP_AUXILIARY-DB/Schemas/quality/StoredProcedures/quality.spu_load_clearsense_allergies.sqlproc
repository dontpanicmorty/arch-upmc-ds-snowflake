CREATE OR REPLACE PROCEDURE QUALITY.SPU_LOAD_CLEARSENSE_ALLERGIES("RUN_ID" VARCHAR(16777216), "DATA_FLOW_NAME" VARCHAR(16777216))
RETURNS VARCHAR(16777216)
LANGUAGE JAVASCRIPT
COMMENT='Load QUALITY.CCD_ALLERGIES from XML_SECTION'
EXECUTE AS OWNER
AS '

//---------------------------------------
//-- Prepare for execution
//---------------------------------------

    var startTime = new Date().toISOString();    
    var dataDomainName = "";
    var stepOrderNumber = 0;
    var stepProcedureName = "QUALITY.SPU_LOAD_CLEARSENSE_ALLERGIES";
    
    var lookupCommand = `
SELECT DATA_FLOW_NAME, DATA_DOMAIN_NAME, STEP_ORDER_NUMBER, STEP_PROCEDURE_NAME
FROM UTIL.DATA_FLOW_CONTROL_TABLE
WHERE IS_ACTIVE = ''Y'' AND DATA_FLOW_NAME = :1 AND STEP_PROCEDURE_NAME = :2
ORDER BY STEP_ORDER_NUMBER; 
`;

    var logStartCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
     RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES ( 
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,null
    ,''Starting''
    )
`;

    var logEndCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
     RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Succeeded''
)
`;

    var logErrorCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS
    ,ERROR_CODE
    ,ERROR_STATE
    ,ERROR_MESSAGE
    ,ERROR_STACK_TRACE_TEXT
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Error''
    ,:7
    ,:8
    ,:9
    ,:10
)
`;      


//-----------------------------------------
//-- SQL to load QUALITY.CCD_ALLERGIES - START
//-----------------------------------------


    var sqlLogCommand = `
INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9);
`;



    var sqlDeleteAllergiesCommand = ` 
DELETE FROM QUALITY.CCD_ALLERGIES WHERE MRN IN ( SELECT DISTINCT MRN FROM QUALITY.SECTION_XML ); 
`;


    var sqlInsertCcdAllergiesCommand = 
`
INSERT INTO QUALITY.CCD_ALLERGIES (
    SECTION_TITLE,
	FILENAME,
	MRN,
    TEMPLATE_ID_ROOT,
    TEMPLATE_ID_EXT,
	ENTRY_TYPE_CODE,
	ACT_CLASS_CODE,
	ACT_MOOD_CODE,
	ACT_ID_ROOT,
	ACT_ID_EXT,
	ACT_CODE,
	ACT_CODE_NAME,
	ACT_CODE_SYSTEM,
	ACT_CODE_SYSTEM_NAME,
	ACT_STATUS_CODE,
    EFFECTIVE_TIME_LOW,
    EFFECTIVE_TIME_HIGH,
	AUTHOR_TIME,
	ASSIGNED_AUTHOR_ID_ROOT,
	ASSIGNED_AUTHOR_ID_EXT,
	ASSIGNED_AUTHOR_CODE,
	ASSIGNED_AUTHOR_CODE_NAME,
	ASSIGNED_AUTHOR_CODE_SYSTEM,
	ASSIGNED_AUTHOR_CODE_SYSTEM_NAME,
	ASSIGNED_PERSON,
	ENTRY_RELSHIP_TYPE_CODE,
	ENTRY_RELSHIP_OBS_CLASS_CODE,
	ENTRY_RELSHIP_OBS_MOOD_CODE,
    ENTRY_RELSHIP_TEMPLATE_ID_ROOT,
	ENTRY_RELSHIP_TEMPLATE_ID_EXT,
	ENTRY_RELSHIP_OBS_ID_ROOT,
	ENTRY_RELSHIP_OBS_ID_EXT,
	ENTRY_RELSHIP_OBS_CODE,
	ENTRY_RELSHIP_OBS_CODE_SYSTEM,
	ENTRY_RELSHIP_OBS_STATUS_CODE,
    ENTRY_RELSHIP_OBS_EFF_TIME_LOW,
    ENTRY_RELSHIP_OBS_EFF_TIME_HIGH,
	ENTRY_RELSHIP_OBS_VALUE,
	ENTRY_RELSHIP_OBS_CODE_L2,
	ENTRY_RELSHIP_OBS_NAME,
	ENTRY_RELSHIP_OBS_CODE_SYSTEM_NAME,
	ENTRY_RELSHIP_OBS_AUTHOR_TIME,
    ENTRY_RELSHIP_OBS_ASSIGNED_AUTHOR_ROOT,
	ENTRY_RELSHIP_OBS_ASSIGNED_AUTHOR_EXT,
	ENTRY_RELSHIP_OBS_ASSIGNED_AUTHOR_CODE,
	ENTRY_RELSHIP_OBS_ASSIGNED_AUTHOR_DISP_NAME,
	ENTRY_RELSHIP_OBS_ASSIGNED_AUTHOR_CODE_SYSTEM,
	ENTRY_RELSHIP_OBS_ASSIGNED_AUTHOR_CODE_SYSTEM_NAME,
	ENTRY_RELSHIP_ASSIGNED_PERSON,
	PARTICIPANT_TYPE_CODE,
	PARTICIPANT_ROLE_CLASS_CODE,
	PLAYING_ENTITY_CLASS_CODE,
	PLAYING_ENTITY_CODE,
	PLAYING_ENTITY_CODE_NAME,
	PLAYING_ENTITY_CODE_SYSTEM,
	PLAYING_ENTITY_CODE_SYSTEM_NAME,
	ALLERGY_REFERENCE_VALUE,
	FLAT_ER_TYPE_CODE,
	FLAT_ER_INVERSION_IND,
	FLAT_ER_OBS_CLASS_CODE,
	FLAT_ER_OBS_MOOD_CODE,
	FLAT_ER_ID_ROOT,
	FLAT_ER_ID_EXT,
	FLAT_ER_OBS_CODE,
	FLAT_ER_OBS_NAME,
	FLAT_ER_OBS_CODE_SYSTEM,
	FLAT_ER_OBS_CODE_SYSTEM_NAME,
	FLAT_ER_OBS_CODE_STATUS_CODE,
	FLAT_ER_OBS_VALUE,
	FLAT_ER_OBS_VALUE_CODE,
	FLAT_ER_OBS_VALUE_CODE_NAME,
	FLAT_ER_OBS_VALUE_CODE_SYSTEM,
	FLAT_ER_OBS_CODE_SYSTEM_NAME_L2,
	ROW_NUM,
     TS_LAST_MODIFY,
     SCAN_TIME,
     INSERT_DATETIME
	 )
SELECT
	SECTION_TITLE,
	FILENAME,
	MRN,
    TEMPLATE_ID_ROOT,
    TEMPLATE_ID_EXT,
	ENTRY_TYPE_CODE,
	ACT_CLASS_CODE,
	ACT_MOOD_CODE,
	ACT_ID_ROOT,
	ACT_ID_EXT,
	ACT_CODE,
	ACT_CODE_NAME,
	ACT_CODE_SYSTEM,
	ACT_CODE_SYSTEM_NAME,
	ACT_STATUS_CODE,
    EFFECTIVE_TIME_LOW,
    EFFECTIVE_TIME_HIGH,
	AUTHOR_TIME,
	ASSIGNED_AUTHOR_ID_ROOT,
	ASSIGNED_AUTHOR_ID_EXT,
	ASSIGNED_AUTHOR_CODE,
	ASSIGNED_AUTHOR_CODE_NAME,
	ASSIGNED_AUTHOR_CODE_SYSTEM,
	ASSIGNED_AUTHOR_CODE_SYSTEM_NAME,
	ASSIGNED_PERSON,
	ENTRY_RELSHIP_TYPE_CODE,
	ENTRY_RELSHIP_OBS_CLASS_CODE,
	ENTRY_RELSHIP_OBS_MOOD_CODE,
    ENTRY_RELSHIP_TEMPLATE_ID_ROOT,
	ENTRY_RELSHIP_TEMPLATE_ID_EXT,
	ENTRY_RELSHIP_OBS_ID_ROOT,
	ENTRY_RELSHIP_OBS_ID_EXT,
	ENTRY_RELSHIP_OBS_CODE,
	ENTRY_RELSHIP_OBS_CODE_SYSTEM,
	ENTRY_RELSHIP_OBS_STATUS_CODE,
    ENTRY_RELSHIP_OBS_EFF_TIME_LOW,
    ENTRY_RELSHIP_OBS_EFF_TIME_HIGH,
	ENTRY_RELSHIP_OBS_VALUE,
	ENTRY_RELSHIP_OBS_CODE_L2,
	ENTRY_RELSHIP_OBS_NAME,
	ENTRY_RELSHIP_OBS_CODE_SYSTEM_NAME,
	ENTRY_RELSHIP_OBS_AUTHOR_TIME,
    ENTRY_RELSHIP_OBS_ASSIGNED_AUTHOR_ROOT,
	ENTRY_RELSHIP_OBS_ASSIGNED_AUTHOR_EXT,
	ENTRY_RELSHIP_OBS_ASSIGNED_AUTHOR_CODE,
	ENTRY_RELSHIP_OBS_ASSIGNED_AUTHOR_DISP_NAME,
	ENTRY_RELSHIP_OBS_ASSIGNED_AUTHOR_CODE_SYSTEM,
	ENTRY_RELSHIP_OBS_ASSIGNED_AUTHOR_CODE_SYSTEM_NAME,
	ENTRY_RELSHIP_ASSIGNED_PERSON,
	PARTICIPANT_TYPE_CODE,
	PARTICIPANT_ROLE_CLASS_CODE,
	PLAYING_ENTITY_CLASS_CODE,
	PLAYING_ENTITY_CODE,
	PLAYING_ENTITY_CODE_NAME,
	PLAYING_ENTITY_CODE_SYSTEM,
	PLAYING_ENTITY_CODE_SYSTEM_NAME,
	ALLERGY_REFERENCE_VALUE,
	FLAT_ER_TYPE_CODE,
	FLAT_ER_INVERSION_IND,
	FLAT_ER_OBS_CLASS_CODE,
	FLAT_ER_OBS_MOOD_CODE,
	FLAT_ER_ID_ROOT,
	FLAT_ER_ID_EXT,
	FLAT_ER_OBS_CODE,
	FLAT_ER_OBS_NAME,
	FLAT_ER_OBS_CODE_SYSTEM,
	FLAT_ER_OBS_CODE_SYSTEM_NAME,
	FLAT_ER_OBS_CODE_STATUS_CODE,
	FLAT_ER_OBS_VALUE,
	FLAT_ER_OBS_VALUE_CODE,
	FLAT_ER_OBS_VALUE_CODE_NAME,
	FLAT_ER_OBS_VALUE_CODE_SYSTEM,
	FLAT_ER_OBS_CODE_SYSTEM_NAME_L2,
     XML_ROW_NUMBER,
     XML_TS_LAST_MODIFY,
	 XML_TS_SCAN_TIME,
	 CURRENT_TIMESTAMP()
FROM QUALITY.CCD_ALLERGIES_VW;
`;



//-----------------------------------------
//-- SQL to load QUALITY.CCD_ALLERGIES - END
//-----------------------------------------




    try
    {
    
//---------------------------------------
//-- Lookup context details
//---------------------------------------

        var lookupSet = snowflake.execute({
            sqlText: lookupCommand, 
            binds: [DATA_FLOW_NAME,stepProcedureName]
        });        

        // check and handle for empty response
        if(!lookupSet.next())
        {     
            throw "Unable to lookup data flow context from UTIL.DATA_FLOW_CONTROL_TABLE";
        }

        dataDomainName = lookupSet.getColumnValueAsString(''DATA_DOMAIN_NAME'');    
        stepOrderNumber = lookupSet.getColumnValue(''STEP_ORDER_NUMBER'');

//---------------------------------------
//-- Log Execution Start
//---------------------------------------

        snowflake.execute({
            sqlText: logStartCommand, 
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        



//---------------------------------------
//-- Step logic goes here - STARTING
//--------------------------------------- 
    
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteAllergiesCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
    
    // Log record deletion stats to LOGDATA.TABLE_LOAD_HISTORY
    var sqlLogCommandDel = 
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT,RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10);
`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommandDel,
        binds: [RUN_ID, "QUALITY.CCD_ALLERGIES", "TABLE", startTime, endTime, 
		        sfStatement.getNumRowsInserted(), 
				sfStatement.getNumRowsUpdated(), 
                sfStatement.getNumRowsDeleted(), 
				result, sfStatement.getSqlText()]
        }
    );    





    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCcdAllergiesCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
    
    // Log ALLERGIES Insert results to LOGDATA.TABLE_LOAD_HISTORY
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [RUN_ID, "QUALITY.CCD_ALLERGIES", "TABLE", startTime, endTime, 
		        sfStatement.getNumRowsInserted(), 
				sfStatement.getNumRowsUpdated(),				
				result, sfStatement.getSqlText()]
        }
    );    


//---------------------------------------
//-- Step logic goes here - ENDING
//---------------------------------------





//---------------------------------------
//-- Log Execution Succeeded
//---------------------------------------

        snowflake.execute({
            sqlText: logEndCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        
        return "Success";
    }
    catch (err)    
    {
    
//---------------------------------------
//-- Error handling / Log Execution Failed
//---------------------------------------

        if(err.code !== undefined)
        { 
            var errCode = err.code; 
            var errState = err.state;
            var errMessage = err.message;
            var errTrace = err.stackTraceTxt;
        }
        else 
        { 
            var errCode = "";
            var errState = "";
            var errMessage = err;
            var errTrace = "";
        }
            
        snowflake.execute({
            sqlText: logErrorCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime,errCode,errState,errMessage,errTrace]
        });  

        throw err;
    }        
';
