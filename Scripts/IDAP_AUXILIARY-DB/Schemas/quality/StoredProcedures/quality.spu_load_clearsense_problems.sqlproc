CREATE OR REPLACE PROCEDURE QUALITY.SPU_LOAD_CLEARSENSE_PROBLEMS("RUN_ID" VARCHAR(16777216), "DATA_FLOW_NAME" VARCHAR(16777216))
RETURNS VARCHAR(16777216)
LANGUAGE JAVASCRIPT
COMMENT='Load QUALITY.CCD_PROBLEMS from XML_SECTION'
EXECUTE AS OWNER
AS '

//---------------------------------------
//-- Prepare for execution
//---------------------------------------

    var startTime = new Date().toISOString();    
    var dataDomainName = "";
    var stepOrderNumber = 0;
    var stepProcedureName = "QUALITY.SPU_LOAD_CLEARSENSE_PROBLEMS";
    
    var lookupCommand = `
SELECT DATA_FLOW_NAME, DATA_DOMAIN_NAME, STEP_ORDER_NUMBER, STEP_PROCEDURE_NAME
FROM UTIL.DATA_FLOW_CONTROL_TABLE
WHERE IS_ACTIVE = ''Y'' AND DATA_FLOW_NAME = :1 AND STEP_PROCEDURE_NAME = :2
ORDER BY STEP_ORDER_NUMBER; 
`;

    var logStartCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
     RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES ( 
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,null
    ,''Starting''
    )
`;

    var logEndCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
     RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Succeeded''
)
`;

    var logErrorCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS
    ,ERROR_CODE
    ,ERROR_STATE
    ,ERROR_MESSAGE
    ,ERROR_STACK_TRACE_TEXT
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Error''
    ,:7
    ,:8
    ,:9
    ,:10
)
`;      


//-----------------------------------------
//-- SQL to load QUALITY.CCD_PROBLEMS - START
//-----------------------------------------


    var sqlLogCommand = `
INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9);
`;



    var sqlDeleteProblemsCommand = ` 
DELETE FROM QUALITY.CCD_PROBLEMS WHERE MRN IN ( SELECT DISTINCT MRN FROM QUALITY.SECTION_XML ); 
`;


    var sqlInsertCcdProblemsCommand = `
INSERT INTO QUALITY.CCD_PROBLEMS (
     SECTION_TITLE,
     FILENAME,
     MRN,
     SECTION_CODE,
     DISPLAY_NAME,
     CODE_SYSTEM,
     CODE_SYSTEM_NAME,
     ENTRY_TYPE_CODE,
     ACT_CLASS_CODE,
     ACT_MOOD_CODE,
     TEMPLATE_ROOT,
     TEMPLATE_EXTENSION,
     ID_ROOT,
     ID_EXTENSION,
     ACT_CODE,
     ACT_CODE_SYSTEM,
     STATUS_CODE,
     EFFECTIVE_TIME_LOW,
     EFFECTIVE_TIME_HIGH,
     AUTHOR_TEMPLATE_ROOT,
     AUTHOR_TIME,
     ASSIGNED_AUTHOR_ID,
     ASSIGNED_AUTHOR_EXTENSION,
     ASSIGNED_AUTHOR_CODE,
     ASSIGNED_PERSON_UNKNOWN,
     ASSIGNED_PERSON_NAME,
     ER_TYPE_CODE,
     ER_INVERSION_IND,
     ER_SEQUENCE,
     ER_OBS_CLASS_CODE,
     ER_OBS_MOOD_CODE,
     ER_OBS_TEMPLATE_ROOT,
     ER_OBS_TEMPLATE_EXTENSION,
     ER_OBS_ID_ROOT,
     ER_OBS_ID_EXTENSION,
     ER_OBS_CODE,
     ER_OBS_CODE_NAME,
     ER_OBS_CODE_SYSTEM,
     ER_OBS_CODE_SYSTEM_NAME,
     ER_OBS_TRANSLATE_CODE,
     ER_OBS_TRANSLATE_CODE_NAME,
     ER_OBS_TRANSLATE_CODE_SYSTEM,
     ER_OBS_TRANSLATE_CODE_SYSTEM_NAME,
     ER_OBS_STATUS_CODE,
     ER_OBS_EFFECTIVE_TIME_NOW,
     ER_OBS_EFFECTIVE_TIME_HIGH,
     ER_OBS_VALUE_TYPE,
     ER_OBS_VALUE_CODE,
     ER_OBS_VALUE_NAME,
     ER_OBS_VALUE_CODE_SYSTEM,
     ER_OBS_VALUE_CODE_SYSTEM_NAME,
     ORIG_TEXT_REF,
     VALUE_TRANS_CODE,
     VALUE_TRANS_DISPLAY_NAME,
     VALUE_TRANS_CODE_SYSTEM,
     VALUE_TRANS_CODE_SYSTEM_NAME,
     ER_AUTHOR_ROOT,
     ER_AUTHOR_TIME,
     ER_AUTHOR_ID_ROOT,
     ER_AUTHOR_ID_EXTENSION,
     ER_AUTHOR_CODE,
     ASSIGNED_PERSION_UNKNOWN,
     ER_ASSIGNED_PERSON_NAME,
     ROW_NUM,
     TS_LAST_MODIFY,
     SCAN_TIME
) 
SELECT
     SECTION_TITLE,
     FILENAME,
     MRN,
     SECTION_CODE,
     DISPLAY_NAME,
     CODE_SYSTEM,
     CODE_SYSTEM_NAME,
     ENTRY_TYPE_CODE,
     ACT_CLASS_CODE,
     ACT_MOOD_CODE,
     TEMPLATE_ROOT,
     TEMPLATE_EXTENSION,
     ID_ROOT,
     ID_EXTENSION,
     ACT_CODE,
     ACT_CODE_SYSTEM,
     STATUS_CODE,
     EFFECTIVE_TIME_LOW,
     EFFECTIVE_TIME_HIGH,
     AUTHOR_TEMPLATE_ROOT,
     AUTHOR_TIME,
     ASSIGNED_AUTHOR_ID,
     ASSIGNED_AUTHOR_EXTENSION,
     ASSIGNED_AUTHOR_CODE,
     ASSIGNED_PERSON_UNKNOWN,
     ASSIGNED_PERSON_NAME,
     ER_TYPE_CODE,
     ER_INVERSION_IND,
     ER_SEQUENCE,
     ER_OBS_CLASS_CODE,
     ER_OBS_MOOD_CODE,
     ER_OBS_TEMPLATE_ROOT,
     ER_OBS_TEMPLATE_EXTENSION,
     ER_OBS_ID_ROOT,
     ER_OBS_ID_EXTENSION,
     ER_OBS_CODE,
     ER_OBS_CODE_NAME,
     ER_OBS_CODE_SYSTEM,
     ER_OBS_CODE_SYSTEM_NAME,
     ER_OBS_TRANSLATE_CODE,
     ER_OBS_TRANSLATE_CODE_NAME,
     ER_OBS_TRANSLATE_CODE_SYSTEM,
     ER_OBS_TRANSLATE_CODE_SYSTEM_NAME,
     ER_OBS_STATUS_CODE,
     ER_OBS_EFFECTIVE_TIME_NOW,
     ER_OBS_EFFECTIVE_TIME_HIGH,
     ER_OBS_VALUE_TYPE,
     ER_OBS_VALUE_CODE,
     ER_OBS_VALUE_NAME,
     ER_OBS_VALUE_CODE_SYSTEM,
     ER_OBS_VALUE_CODE_SYSTEM_NAME,
     ORIG_TEXT_REF,
     VALUE_TRANS_CODE,
     VALUE_TRANS_DISPLAY_NAME,
     VALUE_TRANS_CODE_SYSTEM,
     VALUE_TRANS_CODE_SYSTEM_NAME,
     ER_AUTHOR_ROOT,
     ER_AUTHOR_TIME,
     ER_AUTHOR_ID_ROOT,
     ER_AUTHOR_ID_EXTENSION,
     ER_AUTHOR_CODE,
     ASSIGNED_PERSION_UNKNOWN,
     ER_ASSIGNED_PERSON_NAME,
     ROW_NUM,
     TS_LAST_MODIFY,
     SCAN_TIME
FROM QUALITY.CCD_PROBLEMS_VW;
`;



//-----------------------------------------
//-- SQL to load QUALITY.CCD_PROBLEMS - END
//-----------------------------------------




    try
    {
    
//---------------------------------------
//-- Lookup context details
//---------------------------------------

        var lookupSet = snowflake.execute({
            sqlText: lookupCommand, 
            binds: [DATA_FLOW_NAME,stepProcedureName]
        });        

        // check and handle for empty response
        if(!lookupSet.next())
        {     
            throw "Unable to lookup data flow context from UTIL.DATA_FLOW_CONTROL_TABLE";
        }

        dataDomainName = lookupSet.getColumnValueAsString(''DATA_DOMAIN_NAME'');    
        stepOrderNumber = lookupSet.getColumnValue(''STEP_ORDER_NUMBER'');

//---------------------------------------
//-- Log Execution Start
//---------------------------------------

        snowflake.execute({
            sqlText: logStartCommand, 
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        



//---------------------------------------
//-- Step logic goes here - STARTING
//--------------------------------------- 
    
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteProblemsCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
    
    // Log record deletion stats to LOGDATA.TABLE_LOAD_HISTORY
    var sqlLogCommandDel = 
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT,RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10);
`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommandDel,
        binds: [RUN_ID, "QUALITY.CCD_PROBLEMS", "TABLE", startTime, endTime, 
		        sfStatement.getNumRowsInserted(), 
				sfStatement.getNumRowsUpdated(), 
                sfStatement.getNumRowsDeleted(), 
				result, sfStatement.getSqlText()]
        }
    );    





    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCcdProblemsCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
    
    // Log Insert results to LOGDATA.TABLE_LOAD_HISTORY
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [RUN_ID, "QUALITY.CCD_PROBLEMS", "TABLE", startTime, endTime, 
		        sfStatement.getNumRowsInserted(), 
				sfStatement.getNumRowsUpdated(),				
				result, sfStatement.getSqlText()]
        }
    );    


//---------------------------------------
//-- Step logic goes here - ENDING
//---------------------------------------





//---------------------------------------
//-- Log Execution Succeeded
//---------------------------------------

        snowflake.execute({
            sqlText: logEndCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        
        return "Success";
    }
    catch (err)    
    {
    
//---------------------------------------
//-- Error handling / Log Execution Failed
//---------------------------------------

        if(err.code !== undefined)
        { 
            var errCode = err.code; 
            var errState = err.state;
            var errMessage = err.message;
            var errTrace = err.stackTraceTxt;
        }
        else 
        { 
            var errCode = "";
            var errState = "";
            var errMessage = err;
            var errTrace = "";
        }
            
        snowflake.execute({
            sqlText: logErrorCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime,errCode,errState,errMessage,errTrace]
        });  

        throw err;
    }        
';
