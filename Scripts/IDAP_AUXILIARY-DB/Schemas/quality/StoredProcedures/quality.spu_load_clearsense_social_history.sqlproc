CREATE OR REPLACE PROCEDURE QUALITY.SPU_LOAD_CLEARSENSE_SOCIAL_HISTORY("RUN_ID" VARCHAR(16777216), "DATA_FLOW_NAME" VARCHAR(16777216))
RETURNS VARCHAR(16777216)
LANGUAGE JAVASCRIPT
COMMENT='Load QUALITY.CCD_SOCIAL_HISTORY from XML_SECTION'
EXECUTE AS OWNER
AS '

//---------------------------------------
//-- Prepare for execution
//---------------------------------------

    var startTime = new Date().toISOString();    
    var dataDomainName = "";
    var stepOrderNumber = 0;
    var stepProcedureName = "QUALITY.SPU_LOAD_CLEARSENSE_SOCIAL_HISTORY";
    
    var lookupCommand = `
SELECT DATA_FLOW_NAME, DATA_DOMAIN_NAME, STEP_ORDER_NUMBER, STEP_PROCEDURE_NAME
FROM UTIL.DATA_FLOW_CONTROL_TABLE
WHERE IS_ACTIVE = ''Y'' AND DATA_FLOW_NAME = :1 AND STEP_PROCEDURE_NAME = :2
ORDER BY STEP_ORDER_NUMBER; 
`;

    var logStartCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
     RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES ( 
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,null
    ,''Starting''
    )
`;

    var logEndCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
     RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Succeeded''
)
`;

    var logErrorCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS
    ,ERROR_CODE
    ,ERROR_STATE
    ,ERROR_MESSAGE
    ,ERROR_STACK_TRACE_TEXT
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Error''
    ,:7
    ,:8
    ,:9
    ,:10
)
`;      


//-----------------------------------------
//-- SQL to load QUALITY.CCD_SOCIAL_HISTORY - START
//-----------------------------------------


    var sqlLogCommand = `
INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9);
`;



    var sqlDeleteSocialHistoryCommand = ` 
DELETE FROM QUALITY.CCD_SOCIAL_HISTORY WHERE MRN IN ( SELECT DISTINCT MRN FROM QUALITY.SECTION_XML ); 
`;


    var sqlInsertCcdSocialHistoryCommand = `
INSERT INTO QUALITY.CCD_SOCIAL_HISTORY (
     SECTION_TITLE,
     FILENAME,
     MRN,
     SECTION_DATE,
     SECTION_CODE,
     SECTION_NAME,
     SECTION_CODE_SYSTEM,
     SECTION_CODE_SYSTEM_NAME,
     ENTRY_TYPE_CODE,
     OBSERVATION_CLASS_CODE,
     OBSERVATION_MOOD_CODE,
     TEMPLATE_ID_EXT,
     OBS_ID_ROOT,
     OBS_ID_EXT,
     OBS_CODE,
     OBS_CODE_NAME,
     OBS_CODE_SYSTEM,
     OBS_CODE_SYSTEM_NAME,
     CODE_TEXT,
     TRANSLATE_CODE,
     TRANSLATE_NAME,
     TRANSLATE_CODE_SYSTEM,
     TRANSLATE_CODE_SYSTEM_NAME,
     STATUS_CODE,
     EFFECTIVE_TIME,
     EFFECTIVE_NULL_FLAVOR,
     OBS_VALUE,
     OBS_VALUE_CODE,
     OBS_DISPLAY_NAME,
     OBS_TIME,
     OBS_TIME_NULL_FLAVOR,
     ASSIGNED_AUTHOR_ID,
     ASSIGNED_AUTHOR_NULL_FLAVOR,
     ASSIGNED_AUTHOR_CODE,
     ASSIGNED_AUTHOR_CODE_NULL_FLAVOR,
     ASSIGNED_PERSON_NAME,
     XML_ROW_NUMBER,
     XML_TS_LAST_MODIFY,
     XML_TS_SCAN_TIME,
     INSERT_DATETIME
)
SELECT
     SECTION_TITLE,
     FILENAME,
     MRN,
     SECTION_DATE,
     SECTION_CODE,
     SECTION_NAME,
     SECTION_CODE_SYSTEM,
     SECTION_CODE_SYSTEM_NAME,
     ENTRY_TYPE_CODE,
     OBSERVATION_CLASS_CODE,
     OBSERVATION_MOOD_CODE,
     TEMPLATE_ID_EXT,
     OBS_ID_ROOT,
     OBS_ID_EXT,
     OBS_CODE,
     OBS_CODE_NAME,
     OBS_CODE_SYSTEM,
     OBS_CODE_SYSTEM_NAME,
     CODE_TEXT,
     TRANSLATE_CODE,
     TRANSLATE_NAME,
     TRANSLATE_CODE_SYSTEM,
     TRANSLATE_CODE_SYSTEM_NAME,
     STATUS_CODE,
     EFFECTIVE_TIME,
     EFFECTIVE_NULL_FLAVOR,
     OBS_VALUE,
     OBS_VALUE_CODE,
     OBS_DISPLAY_NAME,
     OBS_TIME,
     OBS_TIME_NULL_FLAVOR,
     ASSIGNED_AUTHOR_ID,
     ASSIGNED_AUTHOR_NULL_FLAVOR,
     ASSIGNED_AUTHOR_CODE,
     ASSIGNED_AUTHOR_CODE_NULL_FLAVOR,
     ASSIGNED_PERSON_NAME,
     XML_DATA_ROW_NUM,
     XML_DATA_TS_LAST_MODIFY,
     XML_DATA_SCAN_TIME,
     CURRENT_TIMESTAMP()
FROM QUALITY.CCD_SOCIAL_HISTORY_VW;
`;



//-----------------------------------------
//-- SQL to load QUALITY.CCD_SOCIAL_HISTORY - END
//-----------------------------------------




    try
    {
    
//---------------------------------------
//-- Lookup context details
//---------------------------------------

        var lookupSet = snowflake.execute({
            sqlText: lookupCommand, 
            binds: [DATA_FLOW_NAME,stepProcedureName]
        });        

        // check and handle for empty response
        if(!lookupSet.next())
        {     
            throw "Unable to lookup data flow context from UTIL.DATA_FLOW_CONTROL_TABLE";
        }

        dataDomainName = lookupSet.getColumnValueAsString(''DATA_DOMAIN_NAME'');    
        stepOrderNumber = lookupSet.getColumnValue(''STEP_ORDER_NUMBER'');

//---------------------------------------
//-- Log Execution Start
//---------------------------------------

        snowflake.execute({
            sqlText: logStartCommand, 
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        



//---------------------------------------
//-- Step logic goes here - STARTING
//--------------------------------------- 
    
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteSocialHistoryCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
    
    // Log record deletion stats to LOGDATA.TABLE_LOAD_HISTORY
    var sqlLogCommandDel = 
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT,RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10);
`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommandDel,
        binds: [RUN_ID, "QUALITY.CCD_SOCIAL_HISTORY", "TABLE", startTime, endTime, 
		        sfStatement.getNumRowsInserted(), 
				sfStatement.getNumRowsUpdated(), 
                sfStatement.getNumRowsDeleted(), 
				result, sfStatement.getSqlText()]
        }
    );    





    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCcdSocialHistoryCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
    
    // Log Insert results to LOGDATA.TABLE_LOAD_HISTORY
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [RUN_ID, "QUALITY.CCD_SOCIAL_HISTORY", "TABLE", startTime, endTime, 
		        sfStatement.getNumRowsInserted(), 
				sfStatement.getNumRowsUpdated(),				
				result, sfStatement.getSqlText()]
        }
    );    


//---------------------------------------
//-- Step logic goes here - ENDING
//---------------------------------------





//---------------------------------------
//-- Log Execution Succeeded
//---------------------------------------

        snowflake.execute({
            sqlText: logEndCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        
        return "Success";
    }
    catch (err)    
    {
    
//---------------------------------------
//-- Error handling / Log Execution Failed
//---------------------------------------

        if(err.code !== undefined)
        { 
            var errCode = err.code; 
            var errState = err.state;
            var errMessage = err.message;
            var errTrace = err.stackTraceTxt;
        }
        else 
        { 
            var errCode = "";
            var errState = "";
            var errMessage = err;
            var errTrace = "";
        }
            
        snowflake.execute({
            sqlText: logErrorCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime,errCode,errState,errMessage,errTrace]
        });  

        throw err;
    }        
';