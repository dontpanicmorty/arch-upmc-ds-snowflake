
CREATE OR REPLACE PROCEDURE QUALITY.SPU_LOAD_CLEARSENSE_PATIENTS_ATHENA_PERFORMER("RUN_ID" VARCHAR(16777216), "DATA_FLOW_NAME" VARCHAR(16777216))
RETURNS VARCHAR(16777216)
LANGUAGE JAVASCRIPT
COMMENT='Load QUALITY.CCD_PATIENTS_ATHENA_PERFORMER from XML_SECTION'
EXECUTE AS OWNER
AS '

//---------------------------------------
//-- Prepare for execution
//---------------------------------------

    var startTime = new Date().toISOString();    
    var dataDomainName = "";
    var stepOrderNumber = 0;
    var stepProcedureName = "QUALITY.SPU_LOAD_CLEARSENSE_PATIENTS_ATHENA_PERFORMER";
    
    var lookupCommand = `
SELECT DATA_FLOW_NAME, DATA_DOMAIN_NAME, STEP_ORDER_NUMBER, STEP_PROCEDURE_NAME
FROM UTIL.DATA_FLOW_CONTROL_TABLE
WHERE IS_ACTIVE = ''Y'' AND DATA_FLOW_NAME = :1 AND STEP_PROCEDURE_NAME = :2
ORDER BY STEP_ORDER_NUMBER; 
`;

    var logStartCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES ( 
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,null
    ,''Starting''
    )
`;

    var logEndCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Succeeded''
)
`;

    var logErrorCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS
    ,ERROR_CODE
    ,ERROR_STATE
    ,ERROR_MESSAGE
    ,ERROR_STACK_TRACE_TEXT
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Error''
    ,:7
    ,:8
    ,:9
    ,:10
)
`;      


//-----------------------------------------
//-- SQL to load QUALITY.PATIENTS_ATHENA_PERFORMER - START
//-----------------------------------------


    var sqlLogCommand = `
INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9);
`;


    var sqlMergeCcdPatientsAthenaPerformerCommand = `
MERGE INTO quality.CCD_PATIENTS_ATHENA_PERFORMER TGT USING 
           QUALITY.CCD_PATIENTS_ATHENA_PERFORMER_VW SRC
     ON SRC.PATIENT_PERFORMER_HKEY = TGT.PATIENT_PERFORMER_HKEY
     WHEN MATCHED THEN 
          UPDATE SET
               TGT.LAST_UPDATE_DATETIME = CURRENT_TIMESTAMP()
     WHEN NOT MATCHED THEN
          INSERT ( TGT.SECTION_TITLE,
                   TGT.PATIENT_PERFORMER_HKEY,
                   TGT.PERFORMER_TYPE_CODE,
                   TGT.PVID,
                   TGT.PVID_OID,
                   TGT.DOCTOR_FACILITY,
                   TGT.DOCTOR_FACILITY_OID,
                   TGT.NPI,
                   TGT.NPI_OID,
                   TGT.FEDERAL_TAX_ID,
                   TGT.FEDERAL_TAX_ID_OID,
                   TGT.ADDRESS_LINE_1,
                   TGT.ADDRESS_LINE_2,
                   TGT.CITY,
                   TGT.STATE,
                   TGT.ZIP_CODE,
                   TGT.TELECOM_USE_1,
                   TGT.TELEPHONE_NUM_1,
                   TGT.TELECOM_USE_2,
                   TGT.TELEPHONE_NUM_2,
                   TGT.PERFORMER_NAME,
	               TGT.XML_DATA_ROW_NUM,
	               TGT.XML_DATA_TS_LAST_MODIFY,
	               TGT.SCAN_TIME
          )
          values (
                   SRC.SECTION_TITLE,
                   SRC.PATIENT_PERFORMER_HKEY,
                   SRC.PERFORMER_TYPE_CODE,
                   SRC.PVID,
                   SRC.PVID_OID,
                   SRC.DOCTOR_FACILITY,
                   SRC.DOCTOR_FACILITY_OID,
                   SRC.NPI,
                   SRC.NPI_OID,
                   SRC.FEDERAL_TAX_ID,
                   SRC.FEDERAL_TAX_ID_OID,
                   SRC.ADDRESS_LINE_1,
                   SRC.ADDRESS_LINE_2,
                   SRC.CITY,
                   SRC.STATE,
                   SRC.ZIP_CODE,
                   SRC.TELECOM_USE_1,
                   SRC.TELEPHONE_NUM_1,
                   SRC.TELECOM_USE_2,
                   SRC.TELEPHONE_NUM_2,
                   SRC.PERFORMER_NAME,
	               SRC.XML_ROW_NUM,
	               SRC.TS_LAST_MODIFY,
	               SRC.SCAN_TIME                 
          );
`;


//-----------------------------------------
//-- SQL to load QUALITY.PATIENTS_ATHENA_PERFORMER - END
//-----------------------------------------




    try
    {
    
//---------------------------------------
//-- Lookup context details
//---------------------------------------

        var lookupSet = snowflake.execute({
            sqlText: lookupCommand, 
            binds: [DATA_FLOW_NAME,stepProcedureName]
        });        

        // check and handle for empty response
        if(!lookupSet.next())
        {     
            throw "Unable to lookup data flow context from UTIL.DATA_FLOW_CONTROL_TABLE";
        }

        dataDomainName = lookupSet.getColumnValueAsString(''DATA_DOMAIN_NAME'');    
        stepOrderNumber = lookupSet.getColumnValue(''STEP_ORDER_NUMBER'');

//---------------------------------------
//-- Log Execution Start
//---------------------------------------

        snowflake.execute({
            sqlText: logStartCommand, 
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        



//---------------------------------------
//-- Step logic goes here - STARTING
//---------------------------------------
  
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCcdPatientsAthenaPerformerCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
    
    // Log Insert results to LOGDATA.TABLE_LOAD_HISTORY
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [RUN_ID, "QUALITY.CCD_PATIENTS_ATHENA_PERFORMER", "TABLE", startTime, endTime, 
		        sfStatement.getNumRowsInserted(), 
				sfStatement.getNumRowsUpdated(),				
				result, sfStatement.getSqlText()]
        }
    );    

//---------------------------------------
//-- Step logic goes here - ENDING
//---------------------------------------


//---------------------------------------
//-- Log Execution Succeeded
//---------------------------------------

        snowflake.execute({
            sqlText: logEndCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        
        return "Success";
    }
    catch (err)    
    {
    
//---------------------------------------
//-- Error handling / Log Execution Failed
//---------------------------------------

        if(err.code !== undefined)
        { 
            var errCode = err.code; 
            var errState = err.state;
            var errMessage = err.message;
            var errTrace = err.stackTraceTxt;
        }
        else 
        { 
            var errCode = "";
            var errState = "";
            var errMessage = err;
            var errTrace = "";
        }
            
        snowflake.execute({
            sqlText: logErrorCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime,errCode,errState,errMessage,errTrace]
        });  

        throw err;
    }        
';
