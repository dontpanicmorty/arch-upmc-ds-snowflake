
CREATE OR REPLACE PROCEDURE QUALITY.SPU_LOAD_CLEARSENSE_PROCEDURES("RUN_ID" VARCHAR(16777216), "DATA_FLOW_NAME" VARCHAR(16777216))
RETURNS VARCHAR(16777216)
LANGUAGE JAVASCRIPT
COMMENT='Load QUALITY.CCD_PROCEDURES from XML_SECTION'
EXECUTE AS OWNER
AS '






//---------------------------------------
//-- Prepare for execution
//---------------------------------------

    var startTime = new Date().toISOString();    
    var dataDomainName = "";
    var stepOrderNumber = 0;
    var stepProcedureName = "QUALITY.SPU_LOAD_CLEARSENSE_PROCEDURES";
    
    var lookupCommand = `
SELECT DATA_FLOW_NAME, DATA_DOMAIN_NAME, STEP_ORDER_NUMBER, STEP_PROCEDURE_NAME
FROM UTIL.DATA_FLOW_CONTROL_TABLE
WHERE IS_ACTIVE = ''Y'' AND DATA_FLOW_NAME = :1 AND STEP_PROCEDURE_NAME = :2
ORDER BY STEP_ORDER_NUMBER; 
`;

    var logStartCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES ( 
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,null
    ,''Starting''
    )
`;

    var logEndCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Succeeded''
)
`;

    var logErrorCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS
    ,ERROR_CODE
    ,ERROR_STATE
    ,ERROR_MESSAGE
    ,ERROR_STACK_TRACE_TEXT
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Error''
    ,:7
    ,:8
    ,:9
    ,:10
)
`;      


//-----------------------------------------
//-- SQL to load QUALITY.PROCEDURES - START
//-----------------------------------------


    var sqlLogCommand = `
INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9);
`;

    var sqlDeleteProceduresCommand = ` 
DELETE FROM QUALITY.CCD_PROCEDURES WHERE MRN IN ( SELECT DISTINCT MRN FROM QUALITY.SECTION_XML ); 
`;


    var sqlInsertCcdProceduresCommand = `
INSERT INTO QUALITY.CCD_PROCEDURES 
   (
    SECTION_TITLE,
    FILENAME,
    MRN,
    ENTRY_TYPE_CODE,
    ENTRY_CLASS_CODE,
    ENTRY_MOOD_CODE,
    PROCEDURE_TEMPLATE_ROOT,
    PROCEDURE_TEMPLATE_EXT,
    PROCEDURE_TEMPLATE_ROOT_2,
    PROCEDURE_TEMPLATE_EXT_2,
    PROCEDURE_TEMPLATE_ROOT_3,
    PROCEDURE_TEMPL_ID_ROOT,
    PROCEDURE_TEMPL_ID_EXT,
    PROCEDURE_SECTION_CODE,
    PROCEDURE_SECTION_CODE_DISPLAY_NAME,
    PROCEDURE_SECTION_CODE_SYSTEM,
    PROCEDURE_SECTION_CODE_SYSTEM_NAME,
    PROCEDURE_CODE,
    PROCEDURE_OBS_CODE_SYSTEM,
    CODE_SYSTEM_NAME,
    PROCEDURE_DISPLAY_NAME,
    PROCEDURE_REFERENCE_VALUE,
    PROCEDURE_STATUS,
    PROCEDURE_DATE,
    PERFORMER_TYPE_CODE,
    ENTITY_CLASS_CODE,
    ASSIGNED_PERSON_NPI,
    ENTITY_ROOT,
    ENTITY_NULL_FLAVOR,
    TELECOM_NULL_FLAVOR,
    TELEPHONE_NUMBER,
    TELEPHONE_USE,
    ASSIGN_PERSON_CLASS_CODE,
    DETERMINER_CODE,
    ASSIGNED_PERSON,
    REP_ORG_EXT,
    REP_ORG_ROOT,
    REP_ORG_NAME,
    REP_ORG_PHONE_USE,
    REP_ORG_PHONE_NUMBER,
    REP_ORG_ADDR_USE,
    REP_ORG_ADDRESS,
    REP_ORG_CITY,
    REP_ORG_STATE,
    REP_ORG_ZIP,
    REP_ORG_COUNTRY,
    AUTHOR_TEMPL_ID_ROOT,
    AUTHOR_TIME,
    AUTHOR_AA_ID_ROOT,
    AUTHOR_AA_ID_EXT,
    AUTHOR_AA_CODE,
    AUTHOR_AA_DISP_NAME,
    AUTHOR_AA_CODE_SYSTEM,
    AUTHOR_AA_CODE_SYSTEM_NAME,
    AUTHOR_AA_AP_NAME,
    XML_ROW_NUMBER,
    XML_TS_LAST_MODIFY,
    XML_TS_SCAN_TIME,
    INSERT_DATETIME
 )
SELECT
    SECTION_TITLE,
    FILENAME,
    MRN,
    ENTRY_TYPE_CODE,
    ENTRY_CLASS_CODE,
    ENTRY_MOOD_CODE,
    PROCEDURE_TEMPLATE_ROOT,
    PROCEDURE_TEMPLATE_EXT,
    PROCEDURE_TEMPLATE_ROOT_2,
    PROCEDURE_TEMPLATE_EXT_2,
    PROCEDURE_TEMPLATE_ROOT_3,
    PROCEDURE_TEMPL_ID_ROOT,
    PROCEDURE_TEMPL_ID_EXT,
    PROCEDURE_SECTION_CODE,
    PROCEDURE_SECTION_CODE_DISPLAY_NAME,
    PROCEDURE_SECTION_CODE_SYSTEM,
    PROCEDURE_SECTION_CODE_SYSTEM_NAME,
    PROCEDURE_CODE,
    PROCEDURE_OBS_CODE_SYSTEM,
    CODE_SYSTEM_NAME,
    PROCEDURE_DISPLAY_NAME,
    PROCEDURE_REFERENCE_VALUE,
    PROCEDURE_STATUS,
    PROCEDURE_DATE,
    PERFORMER_TYPE_CODE,
    ENTITY_CLASS_CODE,
    ASSIGNED_PERSON_NPI,
    ENTITY_ROOT,
    ENTITY_NULL_FLAVOR,
    TELECOM_NULL_FLAVOR,
    TELEPHONE_NUMBER,
    TELEPHONE_USE,
    ASSIGN_PERSON_CLASS_CODE,
    DETERMINER_CODE,
    ASSIGNED_PERSON,
    REP_ORG_EXT,
    REP_ORG_ROOT,
    REP_ORG_NAME,
    REP_ORG_PHONE_USE,
    REP_ORG_PHONE_NUMBER,
    REP_ORG_ADDR_USE,
    REP_ORG_ADDRESS,
    REP_ORG_CITY,
    REP_ORG_STATE,
    REP_ORG_ZIP,
    REP_ORG_COUNTRY,
    AUTHOR_TEMPL_ID_ROOT,
    AUTHOR_TIME,
    AUTHOR_AA_ID_ROOT,
    AUTHOR_AA_ID_EXT,
    AUTHOR_AA_CODE,
    AUTHOR_AA_DISP_NAME,
    AUTHOR_AA_CODE_SYSTEM,
    AUTHOR_AA_CODE_SYSTEM_NAME,
    AUTHOR_AA_AP_NAME,
    XML_ROW_NUMBER,
    XML_TS_LAST_MODIFY,
    XML_TS_SCAN_TIME,
    CURRENT_TIMESTAMP()
FROM QUALITY.CCD_PROCEDURES_VW;
`;



//-----------------------------------------
//-- SQL to load QUALITY.PROCEDURES - END
//-----------------------------------------




    try
    {
    
//---------------------------------------
//-- Lookup context details
//---------------------------------------

        var lookupSet = snowflake.execute({
            sqlText: lookupCommand, 
            binds: [DATA_FLOW_NAME,stepProcedureName]
        });        

        // check and handle for empty response
        if(!lookupSet.next())
        {     
            throw "Unable to lookup data flow context from UTIL.DATA_FLOW_CONTROL_TABLE";
        }

        dataDomainName = lookupSet.getColumnValueAsString(''DATA_DOMAIN_NAME'');    
        stepOrderNumber = lookupSet.getColumnValue(''STEP_ORDER_NUMBER'');

//---------------------------------------
//-- Log Execution Start
//---------------------------------------

        snowflake.execute({
            sqlText: logStartCommand, 
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        



//---------------------------------------
//-- Step logic goes here - STARTING
//---------------------------------------


   

    
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteProceduresCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
    
    // Log record deletion stats to LOGDATA.TABLE_LOAD_HISTORY
    var sqlLogCommandDel = 
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT,RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10);
`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommandDel,
        binds: [RUN_ID, "QUALITY.CCD_PROCEDURES", "TABLE", startTime, endTime, 
		        sfStatement.getNumRowsInserted(), 
				sfStatement.getNumRowsUpdated(), 
                sfStatement.getNumRowsDeleted(), 
				result, sfStatement.getSqlText()]
        }
    );    





    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCcdProceduresCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
    
    // Log Insert results to LOGDATA.TABLE_LOAD_HISTORY
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [RUN_ID, "QUALITY.CCD_PROCEDURES", "TABLE", startTime, endTime, 
		        sfStatement.getNumRowsInserted(), 
				sfStatement.getNumRowsUpdated(),				
				result, sfStatement.getSqlText()]
        }
    );    

//---------------------------------------
//-- Step logic goes here - ENDING
//---------------------------------------





//---------------------------------------
//-- Log Execution Succeeded
//---------------------------------------

        snowflake.execute({
            sqlText: logEndCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        
        return "Success";
    }
    catch (err)    
    {
    
//---------------------------------------
//-- Error handling / Log Execution Failed
//---------------------------------------

        if(err.code !== undefined)
        { 
            var errCode = err.code; 
            var errState = err.state;
            var errMessage = err.message;
            var errTrace = err.stackTraceTxt;
        }
        else 
        { 
            var errCode = "";
            var errState = "";
            var errMessage = err;
            var errTrace = "";
        }
            
        snowflake.execute({
            sqlText: logErrorCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime,errCode,errState,errMessage,errTrace]
        });  

        throw err;
    }        
';
