
CREATE OR REPLACE PROCEDURE QUALITY.SPU_LOAD_CLEARSENSE_PATIENTS_ATHENA_AUTHOR("RUN_ID" VARCHAR(16777216), "DATA_FLOW_NAME" VARCHAR(16777216))
RETURNS VARCHAR(16777216)
LANGUAGE JAVASCRIPT
COMMENT='Load QUALITY.CCD_PATIENTS_ATHENA_AUTHOR from XML_SECTION'
EXECUTE AS OWNER
AS '

//---------------------------------------
//-- Prepare for execution
//---------------------------------------

    var startTime = new Date().toISOString();    
    var dataDomainName = "";
    var stepOrderNumber = 0;
    var stepProcedureName = "QUALITY.SPU_LOAD_CLEARSENSE_PATIENTS_ATHENA_AUTHOR";
    
    var lookupCommand = `
SELECT DATA_FLOW_NAME, DATA_DOMAIN_NAME, STEP_ORDER_NUMBER, STEP_PROCEDURE_NAME
FROM UTIL.DATA_FLOW_CONTROL_TABLE
WHERE IS_ACTIVE = ''Y'' AND DATA_FLOW_NAME = :1 AND STEP_PROCEDURE_NAME = :2
ORDER BY STEP_ORDER_NUMBER; 
`;

    var logStartCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES ( 
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,null
    ,''Starting''
    )
`;

    var logEndCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Succeeded''
)
`;

    var logErrorCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS
    ,ERROR_CODE
    ,ERROR_STATE
    ,ERROR_MESSAGE
    ,ERROR_STACK_TRACE_TEXT
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Error''
    ,:7
    ,:8
    ,:9
    ,:10
)
`;      


//-----------------------------------------
//-- SQL to load QUALITY.PATIENTS_ATHENA_AUTHOR - START
//-----------------------------------------


    var sqlLogCommand = `
INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9);
`;


    var sqlMergeCcdPatientsAthenaAuthorCommand = `
MERGE INTO quality.CCD_PATIENTS_ATHENA_AUTHOR TGT USING 
           QUALITY.CCD_PATIENTS_ATHENA_AUTHOR_VW SRC
     ON SRC.PATIENT_AUTHOR_HKEY = TGT.PATIENT_AUTHOR_HKEY
     WHEN MATCHED THEN 
          UPDATE SET
               TGT.LAST_UPDATE_DATETIME = CURRENT_TIMESTAMP()
     WHEN NOT MATCHED THEN
          INSERT ( TGT.PATIENT_AUTHOR_HKEY,
	               TGT.TEMPLATE_OID_1,
	               TGT.TEMPLATE_OID_2,
	       TGT.PVID,
           TGT.PVID_OID,
           TGT.DOCTOR_FACILITY,
           TGT.DOCTOR_FACILITY_OID,
           TGT.NPI,
           TGT.NPI_OID,
           TGT.ASSIGN_AUTHOR_OID,
           TGT.AUTHOR_ADDR_NULL,
           TGT.AUTHOR_ADDR_STREET_ADDRESS_NULL,
           TGT.AUTHOR_ADDR_STREET_ADDRESS_1,
           TGT.AUTHOR_ADDR_STREET_ADDRESS_2,
           TGT.AUTHOR_ADDR_CITY_NULL,
           TGT.AUTHOR_ADDR_CITY,
           TGT.AUTHOR_ADDR_STATE_NULL,
           TGT.AUTHOR_ADDR_STATE,
           TGT.AUTHOR_ADDR_ZIP_CODE_NULL,
           TGT.AUTHOR_ADDR_ZIP_CODE,
           TGT.AUTHOR_ADDR_COUNTRY_NULL,
           TGT.AUTHOR_TELECOM_NULL,
           TGT.ASSIGNED_PERSON_NAME,
           TGT.AUTHORING_DEVICE_MODEL,
           TGT.AUTHORING_DEVICE_SOFTWARE,
           TGT.R_API_RESOURCE_ID,
           TGT.R_API_RESOURCE_ID_OID,
           TGT.R_NPI,
           TGT.R_NPI_OID,
           TGT.R_FEDERAL_TAX_ID,
           TGT.R_FEDERAL_TAX_ID_OID,
           TGT.REP_ORG_NAME,
           TGT.REP_ORG_TELECOM_USE,
           TGT.REP_ORG_TELEPHONE_NUMBER,
           TGT.REP_ORG_STREET_ADDRESS_1,
           TGT.REP_ORG_STREET_ADDRESS_2,
           TGT.REP_ORG_CITY,
           TGT.REP_ORG_STATE,
           TGT.REP_ORG_ZIP_CODE,
           TGT.XML_DATA_ROW_NUM,
           TGT.XML_DATA_TS_LAST_MODIFY,
	       TGT.SCAN_TIME       
          ) 
          values (
	               SRC.PATIENT_AUTHOR_HKEY,
	               SRC.TEMPLATE_OID_1,
	               SRC.TEMPLATE_OID_2,
	               SRC.PVID,
	               SRC.PVID_OID,
	               SRC.DOCTOR_FACILITY,
	               SRC.DOCTOR_FACILITY_OID,
	               SRC.NPI,
	               SRC.NPI_OID,
	               SRC.ASSIGN_AUTHOR_OID,
	               SRC.AUTHOR_ADDR_NULL,
	               SRC.AUTHOR_ADDR_STREET_ADDRESS_NULL,
	               SRC.AUTHOR_ADDR_STREET_ADDRESS_1,
	               SRC.AUTHOR_ADDR_STREET_ADDRESS_2,
	               SRC.AUTHOR_ADDR_CITY_NULL,
	               SRC.AUTHOR_ADDR_CITY,
	               SRC.AUTHOR_ADDR_STATE_NULL,
	               SRC.AUTHOR_ADDR_STATE,
	               SRC.AUTHOR_ADDR_ZIP_CODE_NULL,
	               SRC.AUTHOR_ADDR_ZIP_CODE,
	               SRC.AUTHOR_ADDR_COUNTRY_NULL,
	               SRC.AUTHOR_TELECOM_NULL,
	               SRC.ASSIGNED_PERSON_NAME,
	               SRC.AUTHORING_DEVICE_MODEL,
	               SRC.AUTHORING_DEVICE_SOFTWARE,
	               SRC.R_API_RESOURCE_ID,
	               SRC.R_API_RESOURCE_ID_OID,
	               SRC.R_NPI,
	               SRC.R_NPI_OID,
	               SRC.R_FEDERAL_TAX_ID,
	               SRC.R_FEDERAL_TAX_ID_OID,
	               SRC.REP_ORG_NAME,
	               SRC.REP_ORG_TELECOM_USE,
	               SRC.REP_ORG_TELEPHONE_NUMBER,
	               SRC.REP_ORG_STREET_ADDRESS_1,
	               SRC.REP_ORG_STREET_ADDRESS_2,
	               SRC.REP_ORG_CITY,
	               SRC.REP_ORG_STATE,
	               SRC.REP_ORG_ZIP_CODE,
	               SRC.XML_ROW_NUM,
	               SRC.TS_LAST_MODIFY,
	               SRC.SCAN_TIME                 
     );
`;


//-----------------------------------------
//-- SQL to load QUALITY.PATIENTS_ATHENA_AUTHOR - END
//-----------------------------------------




    try
    {
    
//---------------------------------------
//-- Lookup context details
//---------------------------------------

        var lookupSet = snowflake.execute({
            sqlText: lookupCommand, 
            binds: [DATA_FLOW_NAME,stepProcedureName]
        });        

        // check and handle for empty response
        if(!lookupSet.next())
        {     
            throw "Unable to lookup data flow context from UTIL.DATA_FLOW_CONTROL_TABLE";
        }

        dataDomainName = lookupSet.getColumnValueAsString(''DATA_DOMAIN_NAME'');    
        stepOrderNumber = lookupSet.getColumnValue(''STEP_ORDER_NUMBER'');

//---------------------------------------
//-- Log Execution Start
//---------------------------------------

        snowflake.execute({
            sqlText: logStartCommand, 
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        



//---------------------------------------
//-- Step logic goes here - STARTING
//---------------------------------------
  
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCcdPatientsAthenaAuthorCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
    
    // Log Insert results to LOGDATA.TABLE_LOAD_HISTORY
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [RUN_ID, "QUALITY.CCD_PATIENTS_ATHENA_AUTHOR", "TABLE", startTime, endTime, 
		        sfStatement.getNumRowsInserted(), 
				sfStatement.getNumRowsUpdated(),				
				result, sfStatement.getSqlText()]
        }
    );    

//---------------------------------------
//-- Step logic goes here - ENDING
//---------------------------------------


//---------------------------------------
//-- Log Execution Succeeded
//---------------------------------------

        snowflake.execute({
            sqlText: logEndCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        
        return "Success";
    }
    catch (err)    
    {
    
//---------------------------------------
//-- Error handling / Log Execution Failed
//---------------------------------------

        if(err.code !== undefined)
        { 
            var errCode = err.code; 
            var errState = err.state;
            var errMessage = err.message;
            var errTrace = err.stackTraceTxt;
        }
        else 
        { 
            var errCode = "";
            var errState = "";
            var errMessage = err;
            var errTrace = "";
        }
            
        snowflake.execute({
            sqlText: logErrorCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime,errCode,errState,errMessage,errTrace]
        });  

        throw err;
    }        
';
