CREATE OR REPLACE PROCEDURE QUALITY.SPU_LOAD_CLEARSENSE_PAYERS("RUN_ID" VARCHAR(16777216), "DATA_FLOW_NAME" VARCHAR(16777216))
RETURNS VARCHAR(16777216)
LANGUAGE JAVASCRIPT
COMMENT='Load QUALITY.CCD_PAYERS from XML_SECTION'
EXECUTE AS OWNER
AS '

//---------------------------------------
//-- Prepare for execution
//---------------------------------------

    var startTime = new Date().toISOString();    
    var dataDomainName = "";
    var stepOrderNumber = 0;
    var stepProcedureName = "QUALITY.SPU_LOAD_CLEARSENSE_PAYERS";
    
    var lookupCommand = `
SELECT DATA_FLOW_NAME, DATA_DOMAIN_NAME, STEP_ORDER_NUMBER, STEP_PROCEDURE_NAME
FROM UTIL.DATA_FLOW_CONTROL_TABLE
WHERE IS_ACTIVE = ''Y'' AND DATA_FLOW_NAME = :1 AND STEP_PROCEDURE_NAME = :2
ORDER BY STEP_ORDER_NUMBER; 
`;

    var logStartCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
     RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES ( 
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,null
    ,''Starting''
    )
`;

    var logEndCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
     RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Succeeded''
)
`;

    var logErrorCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS
    ,ERROR_CODE
    ,ERROR_STATE
    ,ERROR_MESSAGE
    ,ERROR_STACK_TRACE_TEXT
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Error''
    ,:7
    ,:8
    ,:9
    ,:10
)
`;      


//-----------------------------------------
//-- SQL to load QUALITY.CCD_PAYERS - START
//-----------------------------------------


    var sqlLogCommand = `
INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9);
`;



    var sqlDeletePayersCommand = ` 
DELETE FROM QUALITY.CCD_PAYERS WHERE MRN IN ( SELECT DISTINCT MRN FROM QUALITY.SECTION_XML ); 
`;


    var sqlInsertCcdPayersCommand = 
`
INSERT INTO QUALITY.CCD_PAYERS (
     SECTION_TITLE,
     FILENAME,
     MRN,
     SECTION_DATE,
     SECTION_CODE,
     SECTION_NAME,
     CODE_SYSTEM,
     CODE_SYSTEM_NAME,
     ENTRY_TYPE_CODE,
     ENTRY_CLASS_CODE,
     ENTRY_MOOD_CODE,
     TEMPLATE_DATE,
     ID_ROOT,
     ID_EXTENSION,
     CODE,
     CODE_DISPLAY_NAME,
     STATUS_CODE,
     ER_TYPE_CODE,
     ACT_CLASS_CODE,
     ACT_MOOD_CODE,
     ACT_TEMPLATE_ID_EXT,
     ACT_ID_ROOT,
     ACT_ID_EXT,
     ACT_CODE,
     ACT_DISPLAY_NAME,
     ACT_CODE_SYSTEM,
     ACT_CODE_SYSTEM_NAME,
     ACT_TRANSLACTION_NULL,
     ACT_STATUS_CODE,
     PERFORMER_TYPE_CODE,
     PERFORMER_ASSIGNED_ENTITY_CLASS,
     PERFORMER_ASSIGNED_ENTITY_ID_ROOT,
     PERFORMER_ASSIGNED_ENTITY_ID_EXT,
     PERFORMER_ASSIGNED_ENTITY_CODE,
     PERFORMER_ASSIGNED_ENTITY_NAME,
     PERFORMER_ASSIGNED_ENTITY_CODE_SYSTEM,
     PERFORMER_ASSIGNED_ENTITY_CODE_SYSTEM_NAME,
     REPRESENT_ORG_NAME,
     REPRESENT_ORG_PHONE_USE,
     REPRESENT_ORG_PHONE_NUM,
     REPRESENT_ORG_ADDRESS,
     REPRESENT_ORG_CITY,
     REPRESENT_ORG_STATE,
     REPRESENT_ORG_ZIPCODE,
     REPRESENT_ORG_COUNTRY,
     PARTICIPANT_TYPE_CODE,
     PARTICIPANT_TEMPLATE_ROOT,
     PARTICIPANT_TIME,
     PARTICIPANT_ROLE_CLASS,
     PARTICIPANT_ROLE_ID_ROOT,
     PARTICIPANT_ROLE_ID_EXT,
     PARTICIPANT_ROLE_CODE,
     PARTICIPANT_ROLE_NAME,
     PARTICIPANT_ROLE_CODE_SYSTEM,
     PARTICIPANT_ROLE_CODE_SYSTEM_NAME,
     PARTICIPANT_ROLE_STREET_ADDRESS,
     PARTICIPANT_ROLE_CITY,
     PARTICIPANT_ROLE_STATE,
     PARTICIPANT_ROLE_ZIPCODE,
     PARTICIPANT_NAME,
     PARTICIPANT_BIRTHDATE,
     ENTRY_RELATIONSHIP_TYPE_CODE,
     ENTRY_RELATIONSHIP_CLASS_CODE,
     ENTRY_RELATIONSHIP_MOOD_CODE,
     ENTRY_RELATIONSHIP_ID_ROOT,
     ENTRY_RELATIONSHIP_ID_EXT,
     ROW_NUM,
     TS_LAST_MODIFY,
     SCAN_TIME,
     INSERT_DATETIME
)
SELECT
     SECTION_TITLE,
     FILENAME,
     MRN,
     SECTION_DATE,
     SECTION_CODE,
     SECTION_NAME,
     CODE_SYSTEM,
     CODE_SYSTEM_NAME,
     ENTRY_TYPE_CODE,
     ENTRY_CLASS_CODE,
     ENTRY_MOOD_CODE,
     TEMPLATE_DATE,
     ID_ROOT,
     ID_EXTENSION,
     CODE,
     CODE_DISPLAY_NAME,
     STATUS_CODE,
     ER_TYPE_CODE,
     ACT_CLASS_CODE,
     ACT_MOOD_CODE,
     ACT_TEMPLATE_ID_EXT,
     ACT_ID_ROOT,
     ACT_ID_EXT,
     ACT_CODE,
     ACT_DISPLAY_NAME,
     ACT_CODE_SYSTEM,
     ACT_CODE_SYSTEM_NAME,
     ACT_TRANSLACTION_NULL,
     ACT_STATUS_CODE,
     PERFORMER_TYPE_CODE,
     PERFORMER_ASSIGNED_ENTITY_CLASS,
     PERFORMER_ASSIGNED_ENTITY_ID_ROOT,
     PERFORMER_ASSIGNED_ENTITY_ID_EXT,
     PERFORMER_ASSIGNED_ENTITY_CODE,
     PERFORMER_ASSIGNED_ENTITY_NAME,
     PERFORMER_ASSIGNED_ENTITY_CODE_SYSTEM,
     PERFORMER_ASSIGNED_ENTITY_CODE_SYSTEM_NAME,
     REPRESENT_ORG_NAME,
     REPRESENT_ORG_PHONE_USE,
     REPRESENT_ORG_PHONE_NUM,
     REPRESENT_ORG_ADDRESS,
     REPRESENT_ORG_CITY,
     REPRESENT_ORG_STATE,
     REPRESENT_ORG_ZIPCODE,
     REPRESENT_ORG_COUNTRY,
     PARTICIPANT_TYPE_CODE,
     PARTICIPANT_TEMPLATE_ROOT,
     PARTICIPANT_TIME,
     PARTICIPANT_ROLE_CLASS,
     PARTICIPANT_ROLE_ID_ROOT,
     PARTICIPANT_ROLE_ID_EXT,
     PARTICIPANT_ROLE_CODE,
     PARTICIPANT_ROLE_NAME,
     PARTICIPANT_ROLE_CODE_SYSTEM,
     PARTICIPANT_ROLE_CODE_SYSTEM_NAME,
     PARTICIPANT_ROLE_STREET_ADDRESS,
     PARTICIPANT_ROLE_CITY,
     PARTICIPANT_ROLE_STATE,
     PARTICIPANT_ROLE_ZIPCODE,
     PARTICIPANT_NAME,
     PARTICIPANT_BIRTHDATE,
     ENTRY_RELATIONSHIP_TYPE_CODE,
     ENTRY_RELATIONSHIP_CLASS_CODE,
     ENTRY_RELATIONSHIP_MOOD_CODE,
     ENTRY_RELATIONSHIP_ID_ROOT,
     ENTRY_RELATIONSHIP_ID_EXT,
     XML_ROW_NUMBER,
     XML_TS_LAST_MODIFY,
     XML_TS_SCAN_TIME,
     CURRENT_TIMESTAMP()
FROM QUALITY.CCD_PAYERS_VW;
`;



//-----------------------------------------
//-- SQL to load QUALITY.CCD_PAYERS - END
//-----------------------------------------




    try
    {
    
//---------------------------------------
//-- Lookup context details
//---------------------------------------

        var lookupSet = snowflake.execute({
            sqlText: lookupCommand, 
            binds: [DATA_FLOW_NAME,stepProcedureName]
        });        

        // check and handle for empty response
        if(!lookupSet.next())
        {     
            throw "Unable to lookup data flow context from UTIL.DATA_FLOW_CONTROL_TABLE";
        }

        dataDomainName = lookupSet.getColumnValueAsString(''DATA_DOMAIN_NAME'');    
        stepOrderNumber = lookupSet.getColumnValue(''STEP_ORDER_NUMBER'');

//---------------------------------------
//-- Log Execution Start
//---------------------------------------

        snowflake.execute({
            sqlText: logStartCommand, 
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        



//---------------------------------------
//-- Step logic goes here - STARTING
//--------------------------------------- 
    
    var sfStatement = snowflake.createStatement({sqlText: sqlDeletePayersCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
    
    // Log record deletion stats to LOGDATA.TABLE_LOAD_HISTORY
    var sqlLogCommandDel = 
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT,RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10);
`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommandDel,
        binds: [RUN_ID, "QUALITY.CCD_PAYERS", "TABLE", startTime, endTime, 
		        sfStatement.getNumRowsInserted(), 
				sfStatement.getNumRowsUpdated(), 
                sfStatement.getNumRowsDeleted(), 
				result, sfStatement.getSqlText()]
        }
    );    





    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCcdPayersCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
    
    // Log PAYERS Insert results to LOGDATA.TABLE_LOAD_HISTORY
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [RUN_ID, "QUALITY.CCD_PAYERS", "TABLE", startTime, endTime, 
		        sfStatement.getNumRowsInserted(), 
				sfStatement.getNumRowsUpdated(),				
				result, sfStatement.getSqlText()]
        }
    );    


//---------------------------------------
//-- Step logic goes here - ENDING
//---------------------------------------





//---------------------------------------
//-- Log Execution Succeeded
//---------------------------------------

        snowflake.execute({
            sqlText: logEndCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        
        return "Success";
    }
    catch (err)    
    {
    
//---------------------------------------
//-- Error handling / Log Execution Failed
//---------------------------------------

        if(err.code !== undefined)
        { 
            var errCode = err.code; 
            var errState = err.state;
            var errMessage = err.message;
            var errTrace = err.stackTraceTxt;
        }
        else 
        { 
            var errCode = "";
            var errState = "";
            var errMessage = err;
            var errTrace = "";
        }
            
        snowflake.execute({
            sqlText: logErrorCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime,errCode,errState,errMessage,errTrace]
        });  

        throw err;
    }        
';