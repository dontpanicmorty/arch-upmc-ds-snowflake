CREATE OR REPLACE PROCEDURE QUALITY.SPU_LOAD_CLEARSENSE_ENCOUNTERS("RUN_ID" VARCHAR(16777216), "DATA_FLOW_NAME" VARCHAR(16777216))
RETURNS VARCHAR(16777216)
LANGUAGE JAVASCRIPT
COMMENT='Load QUALITY.CCD_ENCOUNTERS from XML_SECTION'
EXECUTE AS OWNER
AS '

//---------------------------------------
//-- Prepare for execution
//---------------------------------------

    var startTime = new Date().toISOString();    
    var dataDomainName = "";
    var stepOrderNumber = 0;
    var stepProcedureName = "QUALITY.SPU_LOAD_CLEARSENSE_ENCOUNTERS";
    
    var lookupCommand = `
SELECT DATA_FLOW_NAME, DATA_DOMAIN_NAME, STEP_ORDER_NUMBER, STEP_PROCEDURE_NAME
FROM UTIL.DATA_FLOW_CONTROL_TABLE
WHERE IS_ACTIVE = ''Y'' AND DATA_FLOW_NAME = :1 AND STEP_PROCEDURE_NAME = :2
ORDER BY STEP_ORDER_NUMBER; 
`;

    var logStartCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
     RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES ( 
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,null
    ,''Starting''
    )
`;

    var logEndCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
     RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Succeeded''
)
`;

    var logErrorCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS
    ,ERROR_CODE
    ,ERROR_STATE
    ,ERROR_MESSAGE
    ,ERROR_STACK_TRACE_TEXT
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Error''
    ,:7
    ,:8
    ,:9
    ,:10
)
`;      


//-----------------------------------------
//-- SQL to load QUALITY.CCD_ENCOUNTERS - START
//-----------------------------------------


    var sqlLogCommand = `
INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9);
`;



    var sqlDeleteEncountersCommand = ` 
DELETE FROM QUALITY.CCD_ENCOUNTERS WHERE MRN IN ( SELECT DISTINCT MRN FROM QUALITY.SECTION_XML ); 
`;


    var sqlInsertCcdEncountersCommand = `
INSERT INTO QUALITY.CCD_ENCOUNTERS 
   (
    SECTION_TITLE,
    FILENAME,
    MRN,
    TEMPLATE_ID_EXT,
    TEMPLATE_ID_ROOT,
    TEMPLATE_ID_ROOT_2,
    ENCOUNTER_CODE,
    ENCOUNTER_CODE_SYSTEM,
    ENCOUNTER_CODE_SYSTEM_NAME,
    ENCOUNTER_CODE_DISPLAY_NAME,
    ENCOUNTER_REFERENCE_VALUE,
    ENCOUNTER_DATE,
    RENDERING_NPI,
    RENDERING_NAME,
    SECTION_DISPLAY_NAME,
    ENTRY_TYPE_CODE,
    ENCOUNTER_CLASS_CODE,
    ENCOUNTER_MOOD_CODE,
    ENCOUNTER_ID_ROOT,
    ENCOUNTER_ID_EXT,
    ENTRY_CODE,
    ENTRY_ENCOUNTER_NAME,
    ENTRY_ENCOUNTER_CODE_SYSTEM,
    ENTRY_CODE_SYSTEM_NAME,
    PERFORMER_TYPE_CODE,
    ENTITY_CLASS_CODE,
    ENTITY_ID_ROOT,
    ENTITY_ID_EXT,
    ENTITY_ADDR_NULL_FLAVOR,
    ENTITY_TELECOM_USE,
    ENTITY_TELEPHONE_NUM,
    DETERMINER_CODE,
    ASSIGN_PERSON_CLASS_CODE,
    REP_ORGANIZATION_ID_ROOT,
    REP_ORGANIZATION_ID_EXT,
    REP_ORGANIZATION_NAME,
    REP_ORGANIZATION_TELECOM_USE,
    REP_ORGANIZATION_TELEPHONE_NUM,
    REP_ORGANIZATION_ADDR_USE,
    REP_ORGANIZATION_STREET_ADDRESS,
    REP_ORGANIZATION_CITY,
    REP_ORGANIZATION_STATE,
    REP_ORGANIZATION_ZIP,
    REP_ORGANIZATION_COUNTRY,
    PARTICIPANT_TYPE_CODE,
    PARTICIPANT_ROLE_CLASS_CODE,
    PARTICIPANT_TEMPLATE_ID_ROOT,
    PARTICIPANT_ROLE_CODE,
    PARTICIPANT_ROLE_NAME,
    PARTICIPANT_ROLE_CODE_SYSTEM,
    PARTICIPANT_ROLE_CODE_SYSTEM_NAME,
    PARTICIPANT_ROLE_ADDR_USE,
    PARTICIPANT_ROLE_STREET_ADDRESS,
    PARTICIPANT_ROLE_STREET_ADDRESS_2,
    PARTICIPANT_ROLE_CITY,
    PARTICIPANT_ROLE_STATE,
    PARTICIPANT_ROLE_ZIPCODE,
    PARTICIPANT_ROLE_COUNTRY,
    PARTICIPANT_TELEPHONE_USE,
    PARTICIPANT_TELEPHONE_NUMBER,
    PARTICIPANT_FAX_USE,
    PARTICIPANT_FAX_NUMBER,
    PLAY_ENTITY_CLASS_CODE,
    PLAY_ENTITY_NAME,
    ER_TYPE_CODE,
    ER_CLASS_CODE,
    ER_MOOD_CODE,
    ACT_TEMPLATE_ID_ROOT,
    ACT_TEMPLATE_ID_EXTENSION,
    ACT_TEMPLATE_ID_ROOT_2,
    ER_CODE,
    ER_NAME,
    ER_CODE_SYSTEM,
    ER_CODE_SYSTEM_NAME,
    ER_LEVEL2_TYPE_CODE,
    ER_OBS_CLASS_CODE,
    ER_OBS_MOOD_CODE,
    ER_OBS_TEMPL_ID_EXTENSION,
    ER_OBS_TEMPL_ID_ROOT,
    ER_OBS_TEMPL_ID_ROOT_2,
    ER_OBS_ID_ROOT,
    ENCOUNTER_L2_CODE,
    ENCOUNTER_L2_NAME,
    ENCOUNTER_L2_CODE_SYSTEM,
    ENCOUNTER_L2_CODE_SYSTEM_NAME,
    ENCOUNTER_TRANSLATE_CODE,
    ENCOUNTER_L2_XLATE_NAME,
    ENCOUNTER_L2_XLATE_CODE_SYSTEM,
    ENCOUNTER_L2_XLATE_CODE_SYSTEM_NAME,
    ENCOUNTER_L2_STATUS_CODE,
    ENCOUNTER_L2_EFF_TIME,
    ENCOUNTER_L2_VALUE,
    ENCOUNTER_L2_NULL_FLAVOR,
    ENCOUNTER_L2_XLATION_TYPE,
    ENCOUNTER_TRANSLATION_CODE_VALUE,
    ENCOUNTER_L2_TRANSLATION_NAME,
    ENCOUNTER_L2_TRANSLATION_CODE_SYSTEM,
    ENCOUNTER_L2_TRANSLATION_CODE_SYSTEM_NAME,
    XML_ROW_NUMBER,
    XML_TS_LAST_MODIFY,     
	XML_TS_SCAN_TIME,
    INSERT_DATETIME
	)
    SELECT 
        SECTION_TITLE,
        FILENAME,
        MRN,
        TEMPLATE_ID_EXT,
        TEMPLATE_ID_ROOT,
        TEMPLATE_ID_ROOT_2,
        ENCOUNTER_CODE,
        ENCOUNTER_CODE_SYSTEM,
        ENCOUNTER_CODE_SYSTEM_NAME,
        ENCOUNTER_CODE_DISPLAY_NAME,
        ENCOUNTER_REFERENCE_VALUE,
        ENCOUNTER_DATE,
        RENDERING_NPI,
        RENDERING_NAME,
        SECTION_DISPLAY_NAME,
        ENTRY_TYPE_CODE,
        ENCOUNTER_CLASS_CODE,
        ENCOUNTER_MOOD_CODE,
        ENCOUNTER_ID_ROOT,
        ENCOUNTER_ID_EXT,
        ENTRY_CODE,
        ENTRY_ENCOUNTER_NAME,
        ENTRY_ENCOUNTER_CODE_SYSTEM,
        ENTRY_CODE_SYSTEM_NAME,
        PERFORMER_TYPE_CODE,
        ENTITY_CLASS_CODE,
        ENTITY_ID_ROOT,
        ENTITY_ID_EXT,
        ENTITY_ADDR_NULL_FLAVOR,
        ENTITY_TELECOM_USE,
        ENTITY_TELEPHONE_NUM,
        DETERMINER_CODE,
        ASSIGN_PERSON_CLASS_CODE,
        REP_ORGANIZATION_ID_ROOT,
        REP_ORGANIZATION_ID_EXT,
        REP_ORGANIZATION_NAME,
        REP_ORGANIZATION_TELECOM_USE,
        REP_ORGANIZATION_TELEPHONE_NUM,
        REP_ORGANIZATION_ADDR_USE,
        REP_ORGANIZATION_STREET_ADDRESS,
        REP_ORGANIZATION_CITY,
        REP_ORGANIZATION_STATE,
        REP_ORGANIZATION_ZIP,
        REP_ORGANIZATION_COUNTRY,
        PARTICIPANT_TYPE_CODE,
        PARTICIPANT_ROLE_CODE_CLASS_CODE,
        PARTICIPANT_TEMPLATE_ID_ROOT,
        PARTICIPANT_ROLE_CODE,
        PARTICIPANT_ROLE_NAME,
        PARTICIPANT_ROLE_CODE_SYSTEM,
        PARTICIPANT_ROLE_CODE_SYSTEM_NAME,
        PARTICIPANT_ROLE_ADDR_USE,
        PARTICIPANT_ROLE_STREET_ADDRESS,
        PARTICIPANT_ROLE_STREET_ADDRESS_2,
        PARTICIPANT_ROLE_CITY,
        PARTICIPANT_ROLE_STATE,
        PARTICIPANT_ROLE_ZIPCODE,
        PARTICIPANT_ROLE_COUNTRY,
        PARTICIPANT_TELEPHONE_USE,
        PARTICIPANT_TELEPHONE_NUMBER,
        PARTICIPANT_FAX_USE,
        PARTICIPANT_FAX_NUMBER,
        PLAY_ENTITY_CLASS_CODE,
        PLAY_ENTITY_NAME,
        ER_TYPE_CODE,
        ER_CLASS_CODE,
        ER_MOOD_CODE,
        ACT_TEMPLATE_ID_ROOT,
        ACT_TEMPLATE_ID_EXTENSION,
        ACT_TEMPLATE_ID_ROOT_2,
        ER_CODE,
        ER_NAME,
        ER_CODE_SYSTEM,
        ER_CODE_SYSTEM_NAME,
        ER_LEVEL2_TYPE_CODE,
        ER_OBS_CLASS_CODE,
        ER_OBS_MOOD_CODE,
        ER_OBS_TEMPL_ID_EXTENSION,
        ER_OBS_TEMPL_ID_ROOT,
        ER_OBS_TEMPL_ID_ROOT_2, 
        ER_OBS_ID_ROOT,
        ENCOUNTER_L2_CODE,
        ENCOUNTER_L2_NAME,
        ENCOUNTER_L2_CODE_SYSTEM,
        ENCOUNTER_L2_CODE_SYSTEM_NAME,
        ENCOUNTER_TRANSLATE_CODE,
        ENCOUNTER_L2_XLATE_NAME,
        ENCOUNTER_L2_XLATE_CODE_SYSTEM,
        ENCOUNTER_L2_XLATE_CODE_SYSTEM_NAME,
        ENCOUNTER_L2_STATUS_CODE,
        ENCOUNTER_L2_EFF_TIME,
        ENCOUNTER_L2_VALUE,
        ENCOUNTER_L2_NULL_FLAVOR,
        ENCOUNTER_L2_XLATION_TYPE,
        ENCOUNTER_TRANSLATION_CODE_VALUE,
        ENCOUNTER_L2_TRANSLATION_NAME,
        ENCOUNTER_L2_TRANSLATION_CODE_SYSTEM,
        ENCOUNTER_L2_TRANSLATION_CODE_SYSTEM_NAME,
        XML_DATA_ROW_NUM,
        XML_DATA_TS_LAST_MODIFY,
        XML_DATA_SCAN_TIME,
        CURRENT_TIMESTAMP()
FROM QUALITY.CCD_ENCOUNTERS_VW;
`;



//-----------------------------------------
//-- SQL to load QUALITY.CCD_ENCOUNTERS - END
//-----------------------------------------




    try
    {
    
//---------------------------------------
//-- Lookup context details
//---------------------------------------

        var lookupSet = snowflake.execute({
            sqlText: lookupCommand, 
            binds: [DATA_FLOW_NAME,stepProcedureName]
        });        

        // check and handle for empty response
        if(!lookupSet.next())
        {     
            throw "Unable to lookup data flow context from UTIL.DATA_FLOW_CONTROL_TABLE";
        }

        dataDomainName = lookupSet.getColumnValueAsString(''DATA_DOMAIN_NAME'');    
        stepOrderNumber = lookupSet.getColumnValue(''STEP_ORDER_NUMBER'');

//---------------------------------------
//-- Log Execution Start
//---------------------------------------

        snowflake.execute({
            sqlText: logStartCommand, 
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        



//---------------------------------------
//-- Step logic goes here - STARTING
//--------------------------------------- 
    
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteEncountersCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
    
    // Log record deletion stats to LOGDATA.TABLE_LOAD_HISTORY
    var sqlLogCommandDel = 
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT,RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10);
`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommandDel,
        binds: [RUN_ID, "QUALITY.CCD_ENCOUNTERS", "TABLE", startTime, endTime, 
		        sfStatement.getNumRowsInserted(), 
				sfStatement.getNumRowsUpdated(), 
                sfStatement.getNumRowsDeleted(), 
				result, sfStatement.getSqlText()]
        }
    );    





    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCcdEncountersCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
    
    // Log Insert results to LOGDATA.TABLE_LOAD_HISTORY
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [RUN_ID, "QUALITY.CCD_ENCOUNTERS", "TABLE", startTime, endTime, 
		        sfStatement.getNumRowsInserted(), 
				sfStatement.getNumRowsUpdated(),				
				result, sfStatement.getSqlText()]
        }
    );    


//---------------------------------------
//-- Step logic goes here - ENDING
//---------------------------------------





//---------------------------------------
//-- Log Execution Succeeded
//---------------------------------------

        snowflake.execute({
            sqlText: logEndCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        
        return "Success";
    }
    catch (err)    
    {
    
//---------------------------------------
//-- Error handling / Log Execution Failed
//---------------------------------------

        if(err.code !== undefined)
        { 
            var errCode = err.code; 
            var errState = err.state;
            var errMessage = err.message;
            var errTrace = err.stackTraceTxt;
        }
        else 
        { 
            var errCode = "";
            var errState = "";
            var errMessage = err;
            var errTrace = "";
        }
            
        snowflake.execute({
            sqlText: logErrorCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime,errCode,errState,errMessage,errTrace]
        });  

        throw err;
    }        
';