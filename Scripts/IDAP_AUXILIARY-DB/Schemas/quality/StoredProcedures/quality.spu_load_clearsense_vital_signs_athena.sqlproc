CREATE OR REPLACE PROCEDURE QUALITY.SPU_LOAD_CLEARSENSE_VITAL_SIGNS_ATHENA("RUN_ID" VARCHAR(16777216), "DATA_FLOW_NAME" VARCHAR(16777216))
RETURNS VARCHAR(16777216)
LANGUAGE JAVASCRIPT
COMMENT='Load QUALITY.CCD_VITAL_SIGNS_ATHENA from XML'
EXECUTE AS OWNER
AS '

//---------------------------------------
//-- Prepare for execution
//---------------------------------------

    var startTime = new Date().toISOString();    
    var dataDomainName = "";
    var stepOrderNumber = 0;
    var stepProcedureName = "QUALITY.SPU_LOAD_CLEARSENSE_VITAL_SIGNS_ATHENA";
    
    var lookupCommand = `
SELECT DATA_FLOW_NAME, DATA_DOMAIN_NAME, STEP_ORDER_NUMBER, STEP_PROCEDURE_NAME
FROM UTIL.DATA_FLOW_CONTROL_TABLE
WHERE IS_ACTIVE = ''Y'' AND DATA_FLOW_NAME = :1 AND STEP_PROCEDURE_NAME = :2
ORDER BY STEP_ORDER_NUMBER; 
`;

    var logStartCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
     RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES ( 
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,null
    ,''Starting''
    )
`;

    var logEndCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
     RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Succeeded''
)
`;

    var logErrorCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS
    ,ERROR_CODE
    ,ERROR_STATE
    ,ERROR_MESSAGE
    ,ERROR_STACK_TRACE_TEXT
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Error''
    ,:7
    ,:8
    ,:9
    ,:10
)
`;      


//-----------------------------------------
//-- SQL to load QUALITY.CCD_VITAL_SIGNS_ATHENA - START
//-----------------------------------------


    var sqlLogCommand = `
INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9);
`;



    var sqlDeleteVitalSignsCommand = ` 
DELETE FROM QUALITY.CCD_VITAL_SIGNS_ATHENA WHERE MRN IN ( SELECT DISTINCT MRN FROM QUALITY.SECTION_XML ); 
`;


    var sqlInsertCcdVitalSignsAthenaCommand = `
INSERT INTO QUALITY.CCD_VITAL_SIGNS_ATHENA (
     FILENAME,
     SECTION_TITLE,
     MRN,
     TEMPLATE_ID_EXTENSION,
     TEMPLATE_ID_ROOT,
     TEMPLATE_ID_ROOT_2,
     TEMPLATE_ID_EXTENSION_3,
     TEMPLATE_ID_ROOT_3,
     TEMPLATE_ID_ROOT_4,
     SECTION_CODE, 
     SECTION_CODE_SYSTEM,
     SECTION_CODE_SYSTEM_NAME,
     SECTION_CODE_DISPLAY_NAME,
     ENTRY_TYPE_CODE,
     ORGANIZER_CLASS_CODE,
     ORGANIZER_MOOD_CODE,
     ORGANIZER_TEMPLATE_EXTENSION,
     ORGANIZER_TEMPLATE_ROOT,
     ORGANIZER_TEMPLATE_ROOT_2,
     ENTRY_ID_AUTHORITY_NAME,
     ENTRY_ID_EXTENSION,
     ENTRY_ID_ROOT,
     ENTRY_CODE,
     ENTRY_CODE_SYSTEM,
     ENTRY_CODE_DISPLAY_NAME,
     ENTRY_TRANSLATION_CODE,
     ENTRY_TRANSLATION_CODE_SYSTEM,
     ENTRY_TRANSLATION_DISPLAY_NAME,
     ENTRY_STATUS_CODE,
     ENTRY_EFFECTIVE_DATE,
     OBSERVATION_CLASS_CODE,
     OBSERVATION_MOOD_CODE,
     OBSERVATION_TEMPLATE_ID,
     OBSERVATION_ROOT,
     OBSERVATION_ROOT_2,
     COMPONENT_ID_AUTHORITY_NAME,
     COMPONENT_ID_EXTENSION,
     COMPONENT_ID_ROOT,
     COMPONENT_CODE,
     COMPONENT_CODE_SYSTEM,
     COMPONENT_CODE_SYSTEM_NAME,
     COMPONENT_CODE_DISPLAY_NAME,
     COMPONENT_ORIGINAL_TEXT,
     ATHENA_NAME,
     ATHENA_CODE,
     TRANSLATE_NAME,
     TRANSLATE_CODE,
     COMPONENT_STATUS_CODE,
     COMPONENT_EFFECTIVE_TIME,
     COMPONENT_VALUE_UNIT,
     COMPONENT_VALUE,
     COMPONENT_VALUE_ORIGINAL_TEXT,
     COMPONENT_VALUE_TYPE,
     AUTHOR_TEMPLATE_ROOT,
     AUTHOR_TEMPLATE_ROOT_2,
     AUTHOR_TIME,
     PVID,
     DOCTOR_FACILITY,
     NPI,
     FEDERAL_TAX_ID,
     AUTHOR_ADDR_NULL,
     AUTHOR_STREET_ADDRESS_NULL,
     AUTHOR_STREET_ADDRESS,
     AUTHOR_STREET_ADDRESS_2,
     AUTHOR_CITY_NULL,
     AUTHOR_CITY,
     AUTHOR_STATE_NULL,
     AUTHOR_STATE,
     AUTHOR_ZIP_CODE_NULL,
     AUTHOR_ZIP_CODE,
     AUTHOR_COUNTRY_NULL,
     AUTHOR_COUNTRY,
     AUTHOR_TELEPHONE_NULL,
     AUTHOR_TELEPHONE_USE,
     AUTHOR_TELEPHONE_NUMBER,
     AUTHOR_TELEPHONE_USE_2,
     AUTHOR_TELEPHONE_NUMBER_2,
     ASSIGNED_PERSON_NAME,
     REP_ORGANIZATION_ASSIGN_AUTHORITY,
     REP_ORGANIZATION_EXTENSION,
     REP_ORGANIZATION_ROOT,
     REP_ORGANIZATION_NAME,
     REP_ORGANIZATION_PHONE_USE,
     REP_ORGANIZATION_PHONE_NUMBER,
     REP_ORGANIZATION_STREET_ADDRESS,
     REP_ORGANIZATION_STREET_ADDRESS_2,
     REP_ORGANIZATION_CITY,
     REP_ORGANIZATION_STATE,
     REP_ORGANIZATION_ZIP_CODE,
     XML_ROW_NUMBER,
     TS_LAST_MODIFY,
     SCAN_TIME
)
SELECT
     FILENAME,
     SECTION_TITLE,
     MRN,
     TEMPLATE_ID_EXTENSION,
     TEMPLATE_ID_ROOT,
     TEMPLATE_ID_ROOT_2,
     TEMPLATE_ID_EXTENSION_3,
     TEMPLATE_ID_ROOT_3,
     TEMPLATE_ID_ROOT_4,
     SECTION_CODE, 
     SECTION_CODE_SYSTEM,
     SECTION_CODE_SYSTEM_NAME,
     SECTION_CODE_DISPLAY_NAME,
     ENTRY_TYPE_CODE,
     ORGANIZER_CLASS_CODE,
     ORGANIZER_MOOD_CODE,
     ORGANIZER_TEMPLATE_EXTENSION,
     ORGANIZER_TEMPLATE_ROOT,
     ORGANIZER_TEMPLATE_ROOT_2,
     ENTRY_ID_AUTHORITY_NAME,
     ENTRY_ID_EXTENSION,
     ENTRY_ID_ROOT,
     ENTRY_CODE,
     ENTRY_CODE_SYSTEM,
     ENTRY_CODE_DISPLAY_NAME,
     ENTRY_TRANSLATION_CODE,
     ENTRY_TRANSLATION_CODE_SYSTEM,
     ENTRY_TRANSLATION_DISPLAY_NAME,
     ENTRY_STATUS_CODE,
     ENTRY_EFFECTIVE_DATE,
     OBSERVATION_CLASS_CODE,
     OBSERVATION_MOOD_CODE,
     OBSERVATION_TEMPLATE_ID,
     OBSERVATION_ROOT,
     OBSERVATION_ROOT_2,
     COMPONENT_ID_AUTHORITY_NAME,
     COMPONENT_ID_EXTENSION,
     COMPONENT_ID_ROOT,
     COMPONENT_CODE,
     COMPONENT_CODE_SYSTEM,
     COMPONENT_CODE_SYSTEM_NAME,
     COMPONENT_CODE_DISPLAY_NAME,
     COMPONENT_ORIGINAL_TEXT,
     ATHENA_NAME,
     ATHENA_CODE,
     TRANSLATE_NAME,
     TRANSLATE_CODE,
     COMPONENT_STATUS_CODE,
     COMPONENT_EFFECTIVE_TIME,
     COMPONENT_VALUE_UNIT,
     COMPONENT_VALUE,
     COMPONENT_VALUE_ORIGINAL_TEXT,
     COMPONENT_VALUE_TYPE,
     AUTHOR_TEMPLATE_ROOT,
     AUTHOR_TEMPLATE_ROOT_2,
     AUTHOR_TIME,
     PVID,
     DOCTOR_FACILITY,
     NPI,
     FEDERAL_TAX_ID,
     AUTHOR_ADDR_NULL,
     AUTHOR_STREET_ADDRESS_NULL,
     AUTHOR_STREET_ADDRESS,
     AUTHOR_STREET_ADDRESS_2,
     AUTHOR_CITY_NULL,
     AUTHOR_CITY,
     AUTHOR_STATE_NULL,
     AUTHOR_STATE,
     AUTHOR_ZIP_CODE_NULL,
     AUTHOR_ZIP_CODE,
     AUTHOR_COUNTRY_NULL,
     AUTHOR_COUNTRY,
     AUTHOR_TELEPHONE_NULL,
     AUTHOR_TELEPHONE_USE,
     AUTHOR_TELEPHONE_NUMBER,
     AUTHOR_TELEPHONE_USE_2,
     AUTHOR_TELEPHONE_NUMBER_2,
     ASSIGNED_PERSON_NAME,
     REP_ORGANIZATION_ASSIGN_AUTHORITY,
     REP_ORGANIZATION_EXTENSION,
     REP_ORGANIZATION_ROOT,
     REP_ORGANIZATION_NAME,
     REP_ORGANIZATION_PHONE_USE,
     REP_ORGANIZATION_PHONE_NUMBER,
     REP_ORGANIZATION_STREET_ADDRESS,
     REP_ORGANIZATION_STREET_ADDRESS_2,
     REP_ORGANIZATION_CITY,
     REP_ORGANIZATION_STATE,
     REP_ORGANIZATION_ZIP_CODE,
     XML_ROW_NUM,
     TS_LAST_MODIFY,
	 SCAN_TIME
FROM QUALITY.CCD_VITAL_SIGNS_ATHENA_VW
`;



//-----------------------------------------
//-- SQL to load QUALITY.CCD_VITAL_SIGNS_ATHENA - END
//-----------------------------------------




    try
    {
    
//---------------------------------------
//-- Lookup context details
//---------------------------------------

        var lookupSet = snowflake.execute({
            sqlText: lookupCommand, 
            binds: [DATA_FLOW_NAME,stepProcedureName]
        });        

        // check and handle for empty response
        if(!lookupSet.next())
        {     
            throw "Unable to lookup data flow context from UTIL.DATA_FLOW_CONTROL_TABLE";
        }

        dataDomainName = lookupSet.getColumnValueAsString(''DATA_DOMAIN_NAME'');    
        stepOrderNumber = lookupSet.getColumnValue(''STEP_ORDER_NUMBER'');

//---------------------------------------
//-- Log Execution Start
//---------------------------------------

        snowflake.execute({
            sqlText: logStartCommand, 
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        



//---------------------------------------
//-- Step logic goes here - STARTING
//--------------------------------------- 
    
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteVitalSignsCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
    
    // Log record deletion stats to LOGDATA.TABLE_LOAD_HISTORY
    var sqlLogCommandDel = 
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT,RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9,:10);
`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommandDel,
        binds: [RUN_ID, "QUALITY.CCD_VITAL_SIGNS_ATHENA", "TABLE", startTime, endTime, 
		        sfStatement.getNumRowsInserted(), 
				sfStatement.getNumRowsUpdated(), 
                sfStatement.getNumRowsDeleted(), 
				result, sfStatement.getSqlText()]
        }
    );    





    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCcdVitalSignsAthenaCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
    
    // Log Insert results to LOGDATA.TABLE_LOAD_HISTORY
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [RUN_ID, "QUALITY.CCD_VITAL_SIGNS_ATHENA", "TABLE", startTime, endTime, 
		        sfStatement.getNumRowsInserted(), 
				sfStatement.getNumRowsUpdated(),				
				result, sfStatement.getSqlText()]
        }
    );    


//---------------------------------------
//-- Step logic goes here - ENDING
//---------------------------------------





//---------------------------------------
//-- Log Execution Succeeded
//---------------------------------------

        snowflake.execute({
            sqlText: logEndCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        
        return "Success";
    }
    catch (err)    
    {
    
//---------------------------------------
//-- Error handling / Log Execution Failed
//---------------------------------------

        if(err.code !== undefined)
        { 
            var errCode = err.code; 
            var errState = err.state;
            var errMessage = err.message;
            var errTrace = err.stackTraceTxt;
        }
        else 
        { 
            var errCode = "";
            var errState = "";
            var errMessage = err;
            var errTrace = "";
        }
            
        snowflake.execute({
            sqlText: logErrorCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime,errCode,errState,errMessage,errTrace]
        });  

        throw err;
    }        
';
