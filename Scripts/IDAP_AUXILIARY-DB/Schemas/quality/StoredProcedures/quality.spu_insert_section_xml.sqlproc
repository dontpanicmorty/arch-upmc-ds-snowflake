!set variable_substitution=true;

CREATE OR REPLACE PROCEDURE QUALITY.SPU_INSERT_SECTION_XML("RUN_ID" VARCHAR(16777216), "DATA_FLOW_NAME" VARCHAR(16777216))
RETURNS VARCHAR(16777216)
LANGUAGE JAVASCRIPT
COMMENT='Load QUALITY.SECTION_XML FROM IDAP_LAKE.RAW_XML'
EXECUTE AS OWNER
AS '

//---------------------------------------
//-- Prepare for execution
//---------------------------------------

    var startTime = new Date().toISOString();    
    var dataDomainName = "";
    var stepOrderNumber = 0;
    var stepProcedureName = "QUALITY.SPU_INSERT_SECTION_XML";
    
    var lookupCommand = `
SELECT DATA_FLOW_NAME, DATA_DOMAIN_NAME, STEP_ORDER_NUMBER, STEP_PROCEDURE_NAME
FROM UTIL.DATA_FLOW_CONTROL_TABLE
WHERE IS_ACTIVE = ''Y'' AND DATA_FLOW_NAME = :1 AND STEP_PROCEDURE_NAME = :2
ORDER BY STEP_ORDER_NUMBER; 
`;

    var logStartCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES ( 
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,null
    ,''Starting''
    )
`;

    var logEndCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS    
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Succeeded''
)
`;

    var logErrorCommand = `
INSERT INTO LOGDATA.DATA_FLOW_LOAD_HISTORY 
(
    RUN_ID
    ,DATA_FLOW_NAME
    ,DATA_DOMAIN_NAME
    ,STEP_ORDER_NUMBER
    ,STEP_PROCEDURE_NAME
    ,EXECUTION_START_TIME
    ,EXECUTION_END_TIME
    ,EXECUTION_STATUS
    ,ERROR_CODE
    ,ERROR_STATE
    ,ERROR_MESSAGE
    ,ERROR_STACK_TRACE_TEXT
)
VALUES (
    :1
    ,:2
    ,:3
    ,:4
    ,:5
    ,:6
    ,CONVERT_TIMEZONE(''UTC'',CURRENT_TIMESTAMP())
    ,''Error''
    ,:7
    ,:8
    ,:9
    ,:10
)
`;      

var sqlLogCommand = 
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(JOB_ID, NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3,:4::timestamp_ltz,:5::timestamp_ltz,:6,:7,:8,:9)
;`;

var sqlTruncateCommand = 
`TRUNCATE TABLE QUALITY.SECTION_XML;`;



//-----------------------------------------
//-- SQL to INSERT QUALITY.SECTION_XML
//-----------------------------------------

var sqlInsertCommand =
`
INSERT INTO QUALITY.SECTION_XML( 
     FILENAME, 
     ROW_NUM, 
     TS_LAST_MODIFY, 
     SCAN_TIME, 
     MRN, 
     SECTION_TITLE, 
     XML,
     CS_TRANSACTION_ID )
select   
     BASE_FILENAME
    ,ROW_NUM
    ,TS_LAST_MODIFY
    ,SCAN_TIME
    ,GET(XMLGET(XMLGET(XMLGET( XML, ''recordTarget''),''patientRole''),''id''),''@extension'')::string as mrn
    ,xmlget(XMLGET(f.VALUE, ''section''),''title''):"$"::string as section_title
    ,f.value as xml
    ,X.CS_TRANSACTION_ID
FROM &{idap_lake}.QUALITY.RAW_XML X
 ,LATERAL FLATTEN(XMLGET(XMLGET(X.XML, ''component''), ''structuredBody''):"$") f
where f.value like ''%component%section%''
AND BASE_FILENAME IN (
     SELECT FILENAME FROM (
          SELECT PATIENT_MRN AS MRN, 
                 MAX( CS_TRANSACTION_ID ) || ''.xml'' AS FILENAME
           FROM &{idap_lake}.QUALITY.CCD_CONTROL
           GROUP BY PATIENT_MRN
           )
     )
`;





    try
    {
    
//---------------------------------------
//-- Lookup context details
//---------------------------------------

        var lookupSet = snowflake.execute({
            sqlText: lookupCommand, 
            binds: [DATA_FLOW_NAME,stepProcedureName]
        });        

        // check and handle for empty response
        if(!lookupSet.next())
        {     
            throw "Unable to lookup data flow context from UTIL.DATA_FLOW_CONTROL_TABLE";
        }

        dataDomainName = lookupSet.getColumnValueAsString(''DATA_DOMAIN_NAME'');    
        stepOrderNumber = lookupSet.getColumnValue(''STEP_ORDER_NUMBER'');

//---------------------------------------
//-- Log Execution Start
//---------------------------------------

        snowflake.execute({
            sqlText: logStartCommand, 
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        



//---------------------------------------
//-- Step logic goes here - STARTING
//---------------------------------------






    // truncate QUALITY.SECTION_XML table 
    var sfStatement = snowflake.createStatement({sqlText: sqlTruncateCommand});
    sfStatement.execute();


    var startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    // Log results to LOGDATA.TABLE_LOAD_HISTORY
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [RUN_ID, "QUALITY.SECTION_XML", "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), result, sfStatement.getSqlText()]
        }
    );    


//---------------------------------------
//-- Step logic goes here - ENDING
//---------------------------------------





//---------------------------------------
//-- Log Execution Succeeded
//---------------------------------------

        snowflake.execute({
            sqlText: logEndCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime]
        });
        
        return "Success";
    }
    catch (err)    
    {
    
//---------------------------------------
//-- Error handling / Log Execution Failed
//---------------------------------------

        if(err.code !== undefined)
        { 
            var errCode = err.code; 
            var errState = err.state;
            var errMessage = err.message;
            var errTrace = err.stackTraceTxt;
        }
        else 
        { 
            var errCode = "";
            var errState = "";
            var errMessage = err;
            var errTrace = "";
        }
            
        snowflake.execute({
            sqlText: logErrorCommand,
            binds: [RUN_ID,DATA_FLOW_NAME,dataDomainName,stepOrderNumber,stepProcedureName,startTime,errCode,errState,errMessage,errTrace]
        });  

        throw err;
    }        
';

!set variable_substitution=false;     
