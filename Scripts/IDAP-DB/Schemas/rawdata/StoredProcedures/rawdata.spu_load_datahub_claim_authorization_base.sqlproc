CREATE OR REPLACE PROCEDURE RAWDATA.SPU_LOAD_DATAHUB_CLAIM_AUTHORIZATION_BASE()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
/* get procedure start time and set variables */
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `RAWDATA.DATAHUB_CLAIM_AUTHORIZATION_BASE`;

/* Create INSERT OVERWRITE statement to be executed */
var sqlInsertCommand =
`INSERT OVERWRITE INTO RAWDATA.DATAHUB_CLAIM_AUTHORIZATION_BASE
(
HUB_CLAIM_AUTHORIZATION_HKEY,   
TPA_CLIENT_ID,
TPA_ID,
TPA_DIV_ID,
DATA_SOURCE_NAME,
AUTHORIZATION_NBR,
MEMBER_NBR,
MEMBER_FIRST_NAME,
MEMBER_LAST_NAME,
MEMBER_DOB,
SUBMITTING_PROVIDER_ID,
MEDICAL_GROUP_NAME,
MEDICAL_GROUP_ADDRESS_LINE_1,
MEDICAL_GROUP_ADDRESS_LINE_2,
MEDICAL_GROUP_CITY,
MEDICAL_GROUP_STATE_ABBREV_NAME,
MEDICAL_GROUP_ZIP_CODE,
MEDICAL_GROUP_PRIMARY_PHONE_NBR,
CARE_TYPE_NAME,
AUTHORIZATION_STATUS_DESC,
AUTHORIZATION_DETERMINATION_STATUS_DESC,
AUTHORIZATION_DETERMINATION_DATE,
PLAN_CODE,
PLAN_TYPE_CODE,
LINE_OF_BUSINESS_CODE
)
SELECT
HUB_CLAIM_AUTHORIZATION_HKEY,   
TPA_CLIENT_ID,
TPA_ID,
TPA_DIV_ID,
DATA_SOURCE_NAME,
AUTHORIZATION_NBR,
MEMBER_NBR,
MEMBER_FIRST_NAME,
MEMBER_LAST_NAME,
MEMBER_DOB,
SUBMITTING_PROVIDER_ID,
MEDICAL_GROUP_NAME,
MEDICAL_GROUP_ADDRESS_LINE_1,
MEDICAL_GROUP_ADDRESS_LINE_2,
MEDICAL_GROUP_CITY,
MEDICAL_GROUP_STATE_ABBREV_NAME,
MEDICAL_GROUP_ZIP_CODE,
MEDICAL_GROUP_PRIMARY_PHONE_NBR,
CARE_TYPE_NAME,
AUTHORIZATION_STATUS_DESC,
AUTHORIZATION_DETERMINATION_STATUS_DESC,
AUTHORIZATION_DETERMINATION_DATE,
PLAN_CODE,
PLAN_TYPE_CODE,
LINE_OF_BUSINESS_CODE
FROM RAWDATA.DATAHUB_CLAIM_AUTHORIZATION_BASE_SELECT_VW
;`;

try 
{
    /*Execute INSERT OVERRIDE Command */
    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    /*Log results to table*/
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), result, sfStatement.getSqlText()]}
    );
}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds:
        [
            targetTableName
            ,"TABLE"
            ,startTime
            ,endTime
            ,result
            ,sfStatement.getSqlText()
            ,err.code
            ,err.state
            ,err.message
            ,err.stackTraceTxt
        ]
        }
    );        
    throw result;
}
return result;
$$
;