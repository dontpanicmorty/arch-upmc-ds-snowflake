CREATE OR REPLACE PROCEDURE RAWDATA.SPU_LOAD_DATAHUB_PHARMACY_CLAIM_DETAIL_BASE()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
/* get procedure start time and set variables */
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `RAWDATA.DATAHUB_PHARMACY_CLAIM_DETAIL_BASE`;

/* Create INSERT OVERWRITE statement to be executed */
var sqlInsertCommand =
`INSERT OVERWRITE INTO RAWDATA.DATAHUB_PHARMACY_CLAIM_DETAIL_BASE
(
	HUB_CLAIM_HKEY,
	HUB_CLAIM_DETAIL_HKEY,
	TPA_CLIENT_ID,
	TPA_ID,
	TPA_DIV_ID,
	DATA_SOURCE_NAME,
	CLAIM_NBR,
	CLAIM_LINE_NBR,
	CLAIM_LINE_SEQ_NBR,
	CLAIM_LINE_PROCEDURE_ADJ_CODE,
	ASSIGNED_CLAIM_ID,
	TRANSACTION_TYPE_CODE,
	TRANSACTION_TYPE_DESC,
	TRANSACTION_ADJUSTMENT_TYPE_CODE,
	TRANSACTION_ADJUSTMENT_TYPE_DESC,
	BATCH_CODE,
	COPAY_TIER_LEVEL_NBR,
	ADJUDICATION_PHARMACY_CLASS_CODE,
	ADJUDICATION_PHARMACY_CLASS_DESC,
	CLAIM_COB_CODE,
	CLAIM_COB_DESC,
	ADJUSTMENT_TYPE_CODE,
	ADJUSTMENT_TYPE_DESC,
	FILLED_DATE,
	PAYMENT_DATE,
	RECEIVED_DATE,
	ADJUDICATION_DATE,
	PRESCRIPTION_WRITTEN_DATE,
	PHARMACY_CLAIM_CNT,
	CHARGE_AMT,
	COPAY_AMT,
	DEDUCTIBLE_AMT,
	COINSURANCE_AMT,
	DAY_SUPPLY_CNT,
	INGREDIENT_COST_AMT,
	SALES_TAX_AMT,
	DISPENSING_FEE_AMT,
	NET_CHECK_DUE_AMT,
	DRUG_METRIC_QTY,
	PRODUCT_SELECTION_AMT,
	BENEFIT_EXCEED_AMT,
	AWP_UNIT_AMT,
	UNIT_PRICE_ALLOWED_MAX_AMT,
	USUAL_CUSTOMARY_AMT,
	ADMINISTRATIVE_FEE_AMT,
	AWP_TOTAL_AMT,
	HRA_APPLIED_AMT,
	PRE_COB_CLAIM_AMT,
	COB_RECOVERY_AMT,
	DRUG_CALCULATED_DISCOUNT_AMT,
	DRUG_DISCOUNT_ELIGIBLE_AMT,
	HRA_SPENDING_AMT,
	HRA_SPENDING_AMT_UPDATE_DATE,
	HIA_SPENDING_AMT,
	HIA_SPENDING_AMT_UPDATE_DATE,
	TOTAL_SPENDING_AMT,
	OTHER_PAYOR_AMT,
	TROOP_APPLIED_AMT,
	MEMBER_PAID_AMT,
	REPORT_EFFECTIVE_DATE,
	TRANSITION_FILL_IND
)
SELECT
	HUB_CLAIM_HKEY,
	HUB_CLAIM_DETAIL_HKEY,
	TPA_CLIENT_ID,
	TPA_ID,
	TPA_DIV_ID,
	DATA_SOURCE_NAME,
	CLAIM_NBR,
	CLAIM_LINE_NBR,
	CLAIM_LINE_SEQ_NBR,
	CLAIM_LINE_PROCEDURE_ADJ_CODE,
	ASSIGNED_CLAIM_ID,
	TRANSACTION_TYPE_CODE,
	TRANSACTION_TYPE_DESC,
	TRANSACTION_ADJUSTMENT_TYPE_CODE,
	TRANSACTION_ADJUSTMENT_TYPE_DESC,
	BATCH_CODE,
	COPAY_TIER_LEVEL_NBR,
	ADJUDICATION_PHARMACY_CLASS_CODE,
	ADJUDICATION_PHARMACY_CLASS_DESC,
	CLAIM_COB_CODE,
	CLAIM_COB_DESC,
	ADJUSTMENT_TYPE_CODE,
	ADJUSTMENT_TYPE_DESC,
	FILLED_DATE,
	PAYMENT_DATE,
	RECEIVED_DATE,
	ADJUDICATION_DATE,
	PRESCRIPTION_WRITTEN_DATE,
	PHARMACY_CLAIM_CNT,
	CHARGE_AMT,
	COPAY_AMT,
	DEDUCTIBLE_AMT,
	COINSURANCE_AMT,
	DAY_SUPPLY_CNT,
	INGREDIENT_COST_AMT,
	SALES_TAX_AMT,
	DISPENSING_FEE_AMT,
	NET_CHECK_DUE_AMT,
	DRUG_METRIC_QTY,
	PRODUCT_SELECTION_AMT,
	BENEFIT_EXCEED_AMT,
	AWP_UNIT_AMT,
	UNIT_PRICE_ALLOWED_MAX_AMT,
	USUAL_CUSTOMARY_AMT,
	ADMINISTRATIVE_FEE_AMT,
	AWP_TOTAL_AMT,
	HRA_APPLIED_AMT,
	PRE_COB_CLAIM_AMT,
	COB_RECOVERY_AMT,
	DRUG_CALCULATED_DISCOUNT_AMT,
	DRUG_DISCOUNT_ELIGIBLE_AMT,
	HRA_SPENDING_AMT,
	HRA_SPENDING_AMT_UPDATE_DATE,
	HIA_SPENDING_AMT,
	HIA_SPENDING_AMT_UPDATE_DATE,
	TOTAL_SPENDING_AMT,
	OTHER_PAYOR_AMT,
	TROOP_APPLIED_AMT,
	MEMBER_PAID_AMT,
	REPORT_EFFECTIVE_DATE,
	TRANSITION_FILL_IND
FROM RAWDATA.DATAHUB_PHARMACY_CLAIM_DETAIL_BASE_SELECT_VW
;`;

try 
{
    /*Execute INSERT OVERRIDE Command */
    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    /*Log results to table*/
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), result, sfStatement.getSqlText()]}
    );
}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds:
        [
            targetTableName
            ,"TABLE"
            ,startTime
            ,endTime
            ,result
            ,sfStatement.getSqlText()
            ,err.code
            ,err.state
            ,err.message
            ,err.stackTraceTxt
        ]
        }
    );        
    throw result;
}
return result;
$$
;