CREATE OR REPLACE PROCEDURE RAWDATA.SPU_LOAD_DATAHUB_CLAIM_HEADER_ICD_DIAGNOSIS_CODE()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
/* get procedure start time and set variables */
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `RAWDATA.DATAHUB_CLAIM_HEADER_ICD_DIAGNOSIS_CODE`;

/* Create INSERT OVERWRITE statement to be executed */
var sqlInsertCommand =
`INSERT OVERWRITE INTO RAWDATA.DATAHUB_CLAIM_HEADER_ICD_DIAGNOSIS_CODE
(
HUB_CLAIM_HKEY
,TPA_CLIENT_ID
,TPA_DIV_ID
,TPA_ID
,DATA_SOURCE_NAME
,CLAIM_NBR
,CODE_POSITION_NBR
,CODE_VALUE
,CODE_DESC
,CODE_DESC_LONG
,CODE_SPANISH_DESC
,CODE_VERSION
,CODE_QUALIFIER
,POA_CODE
,GROUP_CODE
,GROUP_DESC
,ICD_DIAGNOSIS_CATEGORIES
)
SELECT
HUB_CLAIM_HKEY
,TPA_CLIENT_ID
,TPA_DIV_ID
,TPA_ID
,DATA_SOURCE_NAME
,CLAIM_NBR
,CODE_POSITION_NBR
,CODE_VALUE
,CODE_DESC
,CODE_DESC_LONG
,CODE_SPANISH_DESC
,CODE_VERSION
,CODE_QUALIFIER
,POA_CODE
,GROUP_CODE
,GROUP_DESC
,ICD_DIAGNOSIS_CATEGORIES
FROM RAWDATA.DATAHUB_CLAIM_HEADER_ICD_DIAGNOSIS_CODE_SELECT_VW
;`;

try 
{
    /*Execute INSERT OVERRIDE Command */
    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    /*Log results to table*/
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), result, sfStatement.getSqlText()]}
    );
}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds:
        [
            targetTableName
            ,"TABLE"
            ,startTime
            ,endTime
            ,result
            ,sfStatement.getSqlText()
            ,err.code
            ,err.state
            ,err.message
            ,err.stackTraceTxt
        ]
        }
    );        
    throw result;
}
return result;
$$
;