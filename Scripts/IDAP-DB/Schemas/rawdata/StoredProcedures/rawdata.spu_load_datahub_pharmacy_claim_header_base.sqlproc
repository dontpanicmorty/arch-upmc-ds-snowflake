CREATE OR REPLACE PROCEDURE RAWDATA.SPU_LOAD_DATAHUB_PHARMACY_CLAIM_HEADER_BASE()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
/* get procedure start time and set variables */
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `RAWDATA.DATAHUB_PHARMACY_CLAIM_HEADER_BASE`;

/* Create INSERT OVERWRITE statement to be executed */
var sqlInsertCommand =
`INSERT OVERWRITE INTO RAWDATA.DATAHUB_PHARMACY_CLAIM_HEADER_BASE
(
	HUB_CLAIM_HKEY,
	TPA_CLIENT_ID,
	TPA_ID,
	TPA_DIV_ID,
	DATA_SOURCE_NAME,
	CLAIM_NBR,
	ORIGINAL_CLAIM_LOB,
	CARE_TYPE_NAME,
	CLAIM_TYPE_CODE,
	CLAIM_TYPE_DESC,
	DISPENSE_CODE,
	DISPENSE_CODE_DESC,
	REFILL_CODE,
	PRESCRIPTION_NBR,
	AUTHORIZATION_NBR,
	PRESCRIPTION_ORIGIN_CODE,
	PRESCRIPTION_ORIGIN_DESC,
	PHARMACY_NETWORK_CODE,
	PHARMACY_NETWORK_DESC,
	PRICE_SOURCE_CODE,
	PRICE_SOURCE_DESC,
	COMPOUND_CODE,
	COMPOUND_CODE_DESC,
	ESI_FUNDED_IND,
	ESI_FUNDED_IND_DESC,
	TROOP_ELIGIBILITY_CODE,
	LOW_INCOME_SUBSIDY_CODE,
	LOW_INCOME_SUBSIDY_DESC,
	PARTIAL_FILL_STATUS_CODE,
	PARTIAL_FILL_STATUS_DESC,
	FORMULARY_FLAG_CODE,
	FORMULARY_FLAG_CODE_DESC,
	DISPENSE_PHARMACY_TYPE_CODE,
	DISPENSE_PHARMACY_TYPE_DESC,
	OTHER_COVERAGE_CODE,
	OTHER_COVERAGE_DESC,
	DRUG_DISCOUNT_EXCLUSION_CODE,
	DRUG_DISCOUNT_EXCLUSION_DESC,
	DRUG_DISCOUNT_APPLICABLE_CODE,
	DRUG_DISCOUNT_APPLICABLE_DESC,
	AWP_INDICATION_CODE,
	AWP_INDICATION_DESC,
	PATIENT_RESIDENCE_CODE,
	PATIENT_RESIDENCE_DESC,
	BENEFIT_PLAN_LEVEL_CODE,
	FILL_METHOD_CODE,
	FILL_METHOD_DESC,
	ESI_PLAN_NBR,
	CMS_CONTRACT_ID,
	CMS_PBP_ID,
	CLAIM_GENERIC_PRICE_CODE,
	CLAIM_GENERIC_PRICE_DESC,
	SAVE_ON_RX_IND,
	M3P_ORIGIN,
	M3P_ORIGIN_DESC,
	MANUFACTURER_DISCOUNT_TYPE,
	MANUFACTURER_DISCOUNT_TYPE_DESC,
	CLAIM_HIC3_CODE,
	CLAIM_HIC3_DESC,
	CLAIM_GENERIC_SOURCE_CODE,
	CLAIM_GENERIC_SOURCE_DESC,
	PRICING_USED_IND,
	PRICING_USED_IND_DESC,
	SUPPLEMENTAL_COVERAGE_TROOP_QUALIFICATION,
	SUPPLEMENTAL_COVERAGE_TROOP_DESC,
	HUB_DRUG_HKEY,
	NDC_CODE,
	HUB_MEMBER_HKEY,
	MEMBER_NBR,
	HUB_MEMBERSHIP_GROUP_HKEY,
	GROUP_NBR,
	SUB_GROUP_NBR,
	HUB_PLAN_HKEY,
	PLAN_CODE,
	PLAN_TYPE_CODE,
	RIDER_CODE,
	MEMBER_AGE_NBR,
	RX_FORMULARY_CODE,
	RX_FORMULARY_DESC,
	HUB_OFFICE_PHARMACY_HKEY,
    OFFICE_ID_PHARMACY,
    HUB_OFFICE_PRESCRIBER_HKEY,
    OFFICE_ID_PRESCRIBER,
    HUB_PROVIDER_PHARMACY_HKEY,
    PROVIDER_ID_PHARMACY,
    HUB_PROVIDER_PRESCRIBER_HKEY,
    PROVIDER_ID_PRESCRIBER
)
SELECT
	HUB_CLAIM_HKEY,
	TPA_CLIENT_ID,
	TPA_ID,
	TPA_DIV_ID,
	DATA_SOURCE_NAME,
	CLAIM_NBR,
	ORIGINAL_CLAIM_LOB,
	CARE_TYPE_NAME,
	CLAIM_TYPE_CODE,
	CLAIM_TYPE_DESC,
	DISPENSE_CODE,
	DISPENSE_CODE_DESC,
	REFILL_CODE,
	PRESCRIPTION_NBR,
	AUTHORIZATION_NBR,
	PRESCRIPTION_ORIGIN_CODE,
	PRESCRIPTION_ORIGIN_DESC,
	PHARMACY_NETWORK_CODE,
	PHARMACY_NETWORK_DESC,
	PRICE_SOURCE_CODE,
	PRICE_SOURCE_DESC,
	COMPOUND_CODE,
	COMPOUND_CODE_DESC,
	ESI_FUNDED_IND,
	ESI_FUNDED_IND_DESC,
	TROOP_ELIGIBILITY_CODE,
	LOW_INCOME_SUBSIDY_CODE,
	LOW_INCOME_SUBSIDY_DESC,
	PARTIAL_FILL_STATUS_CODE,
	PARTIAL_FILL_STATUS_DESC,
	FORMULARY_FLAG_CODE,
	FORMULARY_FLAG_CODE_DESC,
	DISPENSE_PHARMACY_TYPE_CODE,
	DISPENSE_PHARMACY_TYPE_DESC,
	OTHER_COVERAGE_CODE,
	OTHER_COVERAGE_DESC,
	DRUG_DISCOUNT_EXCLUSION_CODE,
	DRUG_DISCOUNT_EXCLUSION_DESC,
	DRUG_DISCOUNT_APPLICABLE_CODE,
	DRUG_DISCOUNT_APPLICABLE_DESC,
	AWP_INDICATION_CODE,
	AWP_INDICATION_DESC,
	PATIENT_RESIDENCE_CODE,
	PATIENT_RESIDENCE_DESC,
	BENEFIT_PLAN_LEVEL_CODE,
	FILL_METHOD_CODE,
	FILL_METHOD_DESC,
	ESI_PLAN_NBR,
	CMS_CONTRACT_ID,
	CMS_PBP_ID,
	CLAIM_GENERIC_PRICE_CODE,
	CLAIM_GENERIC_PRICE_DESC,
	SAVE_ON_RX_IND,
	M3P_ORIGIN,
	M3P_ORIGIN_DESC,
	MANUFACTURER_DISCOUNT_TYPE,
	MANUFACTURER_DISCOUNT_TYPE_DESC,
	CLAIM_HIC3_CODE,
	CLAIM_HIC3_DESC,
	CLAIM_GENERIC_SOURCE_CODE,
	CLAIM_GENERIC_SOURCE_DESC,
	PRICING_USED_IND,
	PRICING_USED_IND_DESC,
	SUPPLEMENTAL_COVERAGE_TROOP_QUALIFICATION,
	SUPPLEMENTAL_COVERAGE_TROOP_DESC,
	HUB_DRUG_HKEY,
	NDC_CODE,
	HUB_MEMBER_HKEY,
	MEMBER_NBR,
	HUB_MEMBERSHIP_GROUP_HKEY,
	GROUP_NBR,
	SUB_GROUP_NBR,
	HUB_PLAN_HKEY,
	PLAN_CODE,
	PLAN_TYPE_CODE,
	RIDER_CODE,
	MEMBER_AGE_NBR,
	RX_FORMULARY_CODE,
	RX_FORMULARY_DESC,
	HUB_OFFICE_PHARMACY_HKEY,
    OFFICE_ID_PHARMACY,
    HUB_OFFICE_PRESCRIBER_HKEY,
    OFFICE_ID_PRESCRIBER,
    HUB_PROVIDER_PHARMACY_HKEY,
    PROVIDER_ID_PHARMACY,
    HUB_PROVIDER_PRESCRIBER_HKEY,
    PROVIDER_ID_PRESCRIBER
FROM RAWDATA.DATAHUB_PHARMACY_CLAIM_HEADER_BASE_SELECT_VW
;`;

try 
{
    /*Execute INSERT OVERRIDE Command */
    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    /*Log results to table*/
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), result, sfStatement.getSqlText()]}
    );
}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds:
        [
            targetTableName
            ,"TABLE"
            ,startTime
            ,endTime
            ,result
            ,sfStatement.getSqlText()
            ,err.code
            ,err.state
            ,err.message
            ,err.stackTraceTxt
        ]
        }
    );        
    throw result;
}
return result;
$$
;