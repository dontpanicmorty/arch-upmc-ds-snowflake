CREATE OR REPLACE PROCEDURE RAWDATA.SPU_LOAD_MC400_DWOAO_APWORK()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
/* get procedure start time and set variables */
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `RAWDATA.MC400_DWOAO_APWORK`;

/* Create INSERT OVERWRITE statement to be executed */
var sqlInsertCommand =
`INSERT OVERWRITE INTO RAWDATA.MC400_DWOAO_APWORK
    (ROWID,
    TPAROWID,
    HENCDPROWID,
    HINSDPROWID,
    PRIMARYDATEOFSERVICE,
    FORMNUMBER,
    SPECIFICDATEOFSERVICE,
    PROCEDURECODE,
    SYSGENID,
    SYSTEMTIMESTAMP,
    COMPCODE,
    BANKCODE,
    PRODTYPE,
    BATCHNUMBER,
    VENDORNO,
    AMOUNT,
    GLDISTCODE,
    STATUS,
    NONENCCAP,
    FILETYPE,
    CLAIMSDETAILRECEIVEDATE,
    RECIDENT,
    STATISTICALCLAIM,
    POSTDATE,
    CALCULATEINTERESTFLAG,
    INTERESTCALBASEDFINALIZEDATE,
    INTERESTAPPLIEDFLAG,
    CHGUSER,
    CHGORIG,
    CHGLAST,
    LASTUPDATED,
    LASTAPPLIED,
    DELETEDFLAG,
    APWORKSEQNBR
    )
SELECT
    ROWID,
    TPAROWID,
    HENCDPROWID,
    HINSDPROWID,
    PRIMARYDATEOFSERVICE,
    FORMNUMBER,
    SPECIFICDATEOFSERVICE,
    PROCEDURECODE,
    SYSGENID,
    SYSTEMTIMESTAMP,
    COMPCODE,
    BANKCODE,
    PRODTYPE,
    BATCHNUMBER,
    VENDORNO,
    AMOUNT,
    GLDISTCODE,
    STATUS,
    NONENCCAP,
    FILETYPE,
    CLAIMSDETAILRECEIVEDATE,
    RECIDENT,
    STATISTICALCLAIM,
    POSTDATE,
    CALCULATEINTERESTFLAG,
    INTERESTCALBASEDFINALIZEDATE,
    INTERESTAPPLIEDFLAG,
    CHGUSER,
    CHGORIG,
    CHGLAST,
    LASTUPDATED,
    LASTAPPLIED,
    DELETEDFLAG,
    APWORKSEQNBR
FROM RAWDATA.MC400_DWOAO_APWORK_SELECT_VW
;`;

try 
{
    /*Execute INSERT OVERRIDE Command */
    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCommand});
    var resultSet = sfStatement.execute();
    var endTime = new Date().toISOString();
    
    /*Get first row of result set for logging */
    resultSet.next();

    var result = "Succeeded";

    /*Log results to table*/
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds: 
        [
            targetTableName
            ,"TABLE"
            ,startTime
            ,endTime
            ,resultSet.getColumnValueAsString("number of rows inserted")
            ,result
            ,sfStatement.getSqlText()
        ]
        }
    );
}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds:
        [
            targetTableName
            ,"TABLE"
            ,startTime
            ,endTime
            ,result
            ,sfStatement.getSqlText()
            ,err.code
            ,err.state
            ,err.message
            ,err.stackTraceTxt
        ]
        }
    );        
    throw result;
}
return result;
$$
;