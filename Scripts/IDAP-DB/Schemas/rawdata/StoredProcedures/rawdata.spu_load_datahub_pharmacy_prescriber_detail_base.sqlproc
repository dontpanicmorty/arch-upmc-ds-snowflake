CREATE OR REPLACE PROCEDURE RAWDATA.SPU_LOAD_DATAHUB_PHARMACY_PRESCRIBER_DETAIL_BASE()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
/* get procedure start time and set variables */
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `RAWDATA.DATAHUB_PHARMACY_PRESCRIBER_DETAIL_BASE`;

/* Create INSERT OVERWRITE statement to be executed */
var sqlInsertCommand =
`INSERT OVERWRITE INTO RAWDATA.DATAHUB_PHARMACY_PRESCRIBER_DETAIL_BASE
(
