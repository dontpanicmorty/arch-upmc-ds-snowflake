    PRACTICE_ADDRESS_STATE_ABBREV_NAME,
    PRACTICE_ADDRESS_ZIP_CODE,
	PRACTICE_ADDRESS_STATE_FULL_NAME,
	PRACTICE_ADDRESS_COUNTY_NAME,
	PRACTICE_ADDRESS_COUNTRY_NAME,
	PRACTICE_ADDRESS_COUNTRY_ISO2,
	PRACTICE_ADDRESS_COUNTRY_ISO3,
	PRACTICE_ADDRESS_LATITUDE_NBR,
	PRACTICE_ADDRESS_LONGITUDE_NBR,
	OFFICE_MANAGER_NAME,
	HANDICAP_ACCESS_IND,
	TELE_HEALTH_IND,
	RECEIVES_MAIL_IND,
	E_PRESCRIBE_IND,
	MA_SUPER_PCP_IND,
	EMR_SYSTEM_NAME,
	PRACTICE_ADDRESS_PHONE_NBR,
	PRACTICE_ADDRESS_PHONE_EXTENSION_NBR,
	PRACTICE_ADDRESS_PHONE_NBR_FORMATTED,
	PRACTICE_ADDRESS_FAX_NBR,
	PRACTICE_ADDRESS_FAX_NBR_FORMATTED,
	MAILING_ADDRESS_PHONE_NBR,
	MAILING_ADDRESS_PHONE_EXTENSION_NBR,
	MAILING_ADDRESS_PHONE_NBR_FORMATTED,
	MAILING_ADDRESS_FAX_NBR,
	MAILING_ADDRESS_FAX_NBR_FORMATTED,
	INTERNATIONAL_PHONE_CODE,
	EMAIL_ADDRESS_TEXT,
	PRESCRIBER_SOURCE_CODE,
    PRESCRIBER_IDENTIFIER_ARRAY,
    PRIMARY_TAXONOMY_CODE,
    PRIMARY_TAXONOMY_TYPE,
    PRIMARY_TAXONOMY_CLASS,
    PRIMARY_TAXONOMY_SPECIALIZATION,
	FIRST_NAME,
	LAST_NAME,
	MIDDLE_NAME,
	MIDDLE_INITIAL_NAME,
	SUFFIX_NAME,
	GENDER_NAME,
	GENDER_CODE,
	SOCIAL_SECURITY_NBR,
	TAX_ID_NBR,
	EMAIL_ADDRESS,
	DEGREE_TEXT,
	LOCUM_TENENS_IND,
	INVISIBLE_PROVIDER_IND,
	TEMPORARY_PROVIDER_IND,
	NATIONAL_PROVIDER_ID,
	DATE_OF_BIRTH,
	UPIN_NBR,
	WEBSITE_URL,
	PRIMARY_SPECIALTY_NAME,
	PRIMARY_PHO_CODE,
	PRIMARY_PHO_NAME,
	PRIMARY_PHO_TERMINATION_DATE,
	SECONDARY_PHO_CODE,
	SECONDARY_PHO_NAME,
	SECONDARY_PHO_TERMINATION_DATE,
	TERTIARY_PHO_CODE,
	TERTIARY_PHO_NAME,
	TERTIARY_PHO_TERMINATION_DATE,
	PROVIDER_START_DATE,
	ACTIVE_IND,
	PA_MEDICAID_IND,
	PP_ACA_ENHANCED_PAY_IND,
	MALPRACTICE_COVERAGE_IND,
	OWNERSHIP_STATUS_CODE,
	OWNERSHIP_STATUS_DESC,
	URI
)
SELECT
    HUB_PROVIDER_HKEY,
    HUB_OFFICE_HKEY,
    TPA_CLIENT_ID,
    TPA_ID,
    TPA_DIV_ID,
    DATA_SOURCE_NAME,
    PROVIDER_ID,
	OFFICE_ID,
    PRESCRIBER_NAME,
    PROVIDER_TYPE_NAME,
	MAILING_ADDRESS_TYPE_CODE,
	MAILING_ADDRESS_TYPE_DESC,
	MAILING_FULL_ADDRESS_FORMATTED,
	MAILING_ADDRESS_LINE_1,
    MAILING_ADDRESS_LINE_2,
    MAILING_ADDRESS_CITY,
    MAILING_ADDRESS_STATE_ABBREV_NAME,
    MAILING_ADDRESS_ZIP_CODE,
	MAILING_ADDRESS_STATE_FULL_NAME,
	MAILING_ADDRESS_COUNTY_NAME,
	MAILING_ADDRESS_COUNTRY_NAME,
	MAILING_ADDRESS_COUNTRY_ISO2,
	MAILING_ADDRESS_COUNTRY_ISO3,
	MAILING_ADDRESS_LATITUDE_NBR,
	MAILING_ADDRESS_LONGITUDE_NBR,
	PRACTICE_ADDRESS_TYPE_CODE,
	PRACTICE_ADDRESS_TYPE_DESC,
	PRACTICE_FULL_ADDRESS_FORMATTED,
	PRACTICE_ADDRESS_LINE_1,
    PRACTICE_ADDRESS_LINE_2,
    PRACTICE_ADDRESS_CITY,
    PRACTICE_ADDRESS_STATE_ABBREV_NAME,
    PRACTICE_ADDRESS_ZIP_CODE,
	PRACTICE_ADDRESS_STATE_FULL_NAME,
	PRACTICE_ADDRESS_COUNTY_NAME,
	PRACTICE_ADDRESS_COUNTRY_NAME,
	PRACTICE_ADDRESS_COUNTRY_ISO2,
	PRACTICE_ADDRESS_COUNTRY_ISO3,
	PRACTICE_ADDRESS_LATITUDE_NBR,
	PRACTICE_ADDRESS_LONGITUDE_NBR,
	OFFICE_MANAGER_NAME,
	HANDICAP_ACCESS_IND,
	TELE_HEALTH_IND,
	RECEIVES_MAIL_IND,
	E_PRESCRIBE_IND,
	MA_SUPER_PCP_IND,
	EMR_SYSTEM_NAME,
	PRACTICE_ADDRESS_PHONE_NBR,
	PRACTICE_ADDRESS_PHONE_EXTENSION_NBR,
	PRACTICE_ADDRESS_PHONE_NBR_FORMATTED,
	PRACTICE_ADDRESS_FAX_NBR,
	PRACTICE_ADDRESS_FAX_NBR_FORMATTED,
	MAILING_ADDRESS_PHONE_NBR,
	MAILING_ADDRESS_PHONE_EXTENSION_NBR,
	MAILING_ADDRESS_PHONE_NBR_FORMATTED,
	MAILING_ADDRESS_FAX_NBR,
	MAILING_ADDRESS_FAX_NBR_FORMATTED,
