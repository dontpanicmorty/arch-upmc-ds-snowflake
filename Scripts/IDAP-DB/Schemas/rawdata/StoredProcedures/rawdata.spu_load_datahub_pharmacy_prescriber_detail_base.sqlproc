	TAX_ID_NBR,
	EMAIL_ADDRESS,
	DEGREE_TEXT,
	LOCUM_TENENS_IND,
	INVISIBLE_PROVIDER_IND,
	TEMPORARY_PROVIDER_IND,
	NATIONAL_PROVIDER_ID,
	DATE_OF_BIRTH,
	UPIN_NBR,
	WEBSITE_URL,
	PRIMARY_SPECIALTY_NAME,
	PRIMARY_PHO_CODE,
	PRIMARY_PHO_NAME,
	PRIMARY_PHO_TERMINATION_DATE,
	SECONDARY_PHO_CODE,
	SECONDARY_PHO_NAME,
	SECONDARY_PHO_TERMINATION_DATE,
	TERTIARY_PHO_CODE,
	TERTIARY_PHO_NAME,
	TERTIARY_PHO_TERMINATION_DATE,
	PROVIDER_START_DATE,
	ACTIVE_IND,
	PA_MEDICAID_IND,
	PP_ACA_ENHANCED_PAY_IND,
	MALPRACTICE_COVERAGE_IND,
	OWNERSHIP_STATUS_CODE,
	OWNERSHIP_STATUS_DESC,
	URI
FROM RAWDATA.DATAHUB_PHARMACY_PRESCRIBER_DETAIL_BASE_SELECT_VW
;`;

try 
{
    /*Execute INSERT OVERRIDE Command */
    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    /*Log results to table*/
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), result, sfStatement.getSqlText()]}
    );
}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds:
        [
            targetTableName
            ,"TABLE"
            ,startTime
            ,endTime
            ,result
            ,sfStatement.getSqlText()
            ,err.code
            ,err.state
            ,err.message
            ,err.stackTraceTxt
        ]
        }
    );        
    throw result;
}
return result;
$$
;