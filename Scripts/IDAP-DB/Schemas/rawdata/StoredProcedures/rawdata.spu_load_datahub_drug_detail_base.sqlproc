CREATE OR REPLACE PROCEDURE RAWDATA.SPU_LOAD_DATAHUB_DRUG_DETAIL_BASE()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
/* get procedure start time and set variables */
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `RAWDATA.DATAHUB_DRUG_DETAIL_BASE`;

/* Create INSERT OVERWRITE statement to be executed */
var sqlInsertCommand =
`INSERT OVERWRITE INTO RAWDATA.DATAHUB_DRUG_DETAIL_BASE
(
    HUB_DRUG_HKEY,
    TPA_CLIENT_ID,
    TPA_ID,
    TPA_DIV_ID,
    DATA_SOURCE_NAME,
    NDC_CODE,
    DOSAGE_METHOD_CODE,
    BRAND_DRUG_NAME,
    DOSAGE_METHOD_DESC,
    GENERIC_DRUG_NAME,
    DRUG_STRENGTH_DESC,
    THER_CLASS_AHFS_CODE,
    THER_CLASS_AHFS_DESC,
    THER_CLASS_GEN_CODE,
    THER_CLASS_GEN_DESC,
    DRUG_CLASS_CODE,
    DRUG_CLASS_DESC,
    ABUSE_RATING_CODE,
    ABUSE_RATING_DESC,
    DRUG_FORM_CODE,
    DRUG_FORM_DESC,
    ROUTE_CODE,
    ROUTE_DESC,
    GCN_CODE,
    DRUG_LABEL_NAME,
    GENERIC_PRICE_CODE,
    GENERIC_PRICE_DESC,
    HIC3_CODE,
    HIC3_DESC,
    GENERIC_SOURCE_CODE,
    GENERIC_SOURCE_DESC,
    INNOVATOR_FLAG,
    NEW_DRUG_APPLICATOR_FLAG,
    GENERIC_THERAPEUTIC_FLAG,
    GENERIC_MANUFACTURER_FLAG,
    MAINTENANCE_DRUG_FLAG,
    MED_ID,
    MED_DESC,
    MED_NAME_ID,
    MED_NAME,
    WHOLESALE_ACQUISIT_COST_DATE,
    WHOLESALE_ACQUISITION_COST_AMT,
    GSN_CODE,
    SPECIALTY_DRUG_IND,
    MEDISPAN_GPI_CODE,
    MEDISPAN_GPI_DESC, 
    MANUFACTURER_NAME
)
SELECT
    HUB_DRUG_HKEY,
    TPA_CLIENT_ID,
    TPA_ID,
    TPA_DIV_ID,
    DATA_SOURCE_NAME,
    NDC_CODE,
    DOSAGE_METHOD_CODE,
    BRAND_DRUG_NAME,
    DOSAGE_METHOD_DESC,
    GENERIC_DRUG_NAME,
    DRUG_STRENGTH_DESC,
    THER_CLASS_AHFS_CODE,
    THER_CLASS_AHFS_DESC,
    THER_CLASS_GEN_CODE,
    THER_CLASS_GEN_DESC,
    DRUG_CLASS_CODE,
    DRUG_CLASS_DESC,
    ABUSE_RATING_CODE,
    ABUSE_RATING_DESC,
    DRUG_FORM_CODE,
    DRUG_FORM_DESC,
    ROUTE_CODE,
    ROUTE_DESC,
    GCN_CODE,
    DRUG_LABEL_NAME,
    GENERIC_PRICE_CODE,
    GENERIC_PRICE_DESC,
    HIC3_CODE,
    HIC3_DESC,
    GENERIC_SOURCE_CODE,
    GENERIC_SOURCE_DESC,
    INNOVATOR_FLAG,
    NEW_DRUG_APPLICATOR_FLAG,
    GENERIC_THERAPEUTIC_FLAG,
    GENERIC_MANUFACTURER_FLAG,
    MAINTENANCE_DRUG_FLAG,
    MED_ID,
    MED_DESC,
    MED_NAME_ID,
    MED_NAME,
    WHOLESALE_ACQUISIT_COST_DATE,
    WHOLESALE_ACQUISITION_COST_AMT,
    GSN_CODE,
    SPECIALTY_DRUG_IND,
    MEDISPAN_GPI_CODE,
    MEDISPAN_GPI_DESC,
    MANUFACTURER_NAME
FROM RAWDATA.DATAHUB_DRUG_DETAIL_BASE_SELECT_VW
;`;

try 
{
    /*Execute INSERT OVERRIDE Command */
    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    /*Log results to table*/
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), result, sfStatement.getSqlText()]}
    );
}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds:
        [
            targetTableName
            ,"TABLE"
            ,startTime
            ,endTime
            ,result
            ,sfStatement.getSqlText()
            ,err.code
            ,err.state
            ,err.message
            ,err.stackTraceTxt
        ]
        }
    );        
    throw result;
}
return result;
$$
;