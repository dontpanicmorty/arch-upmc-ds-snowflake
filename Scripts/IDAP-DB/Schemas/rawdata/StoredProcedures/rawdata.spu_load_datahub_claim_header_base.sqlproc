CREATE OR REPLACE PROCEDURE RAWDATA.SPU_LOAD_DATAHUB_CLAIM_HEADER_BASE()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
/* get procedure start time and set variables */
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `RAWDATA.DATAHUB_CLAIM_HEADER_BASE`;

/* Create INSERT OVERWRITE statement to be executed */
var sqlInsertCommand =
`INSERT OVERWRITE INTO RAWDATA.DATAHUB_CLAIM_HEADER_BASE
(
    HUB_CLAIM_HKEY,
    TPA_CLIENT_ID,
    TPA_ID,
    TPA_DIV_ID,
    DATA_SOURCE_NAME,
    CLAIM_NBR,
    HUB_INSERT_DATETIME,
    MG_MEDICAL_GROUP_ID,
    HUB_MEMBER_HKEY,
    MEMBER_NBR,
    SUBSCRIBER_ID,
    PERSON_ID,
    GROUP_NBR,
    SUB_GROUP_NBR,
    PLAN_DESC,
    PLAN_TYPE_DESC,
    RIDER_CODES,
    GROUP_NAME,
    SUB_GROUP_NAME,
    CLAIM_ENTRY_DATE,
    LINE_OF_BUSINESS_CODE,
    PLAN_CODE,
    PLAN_TYPE_CODE,
    BILLING_PROVIDER_PARTICIPATING_STATUS_CODE,
    ADMITTED_FLAG,
    ADMITTED_DATE,
    ADMITTED_HOUR,
    ADMISSION_SOURCE_CODE,
    ADMISSION_SOURCE_DESC,
    ADMISSION_TYPE_CODE,
    ADMISSION_TYPE_DESC,
    DISCHARGE_DATE,
    DISCHARGE_HOUR,
    DISCHARGE_STATUS_CODE,
    DISCHARGE_STATUS_DESC,
    BILLING_TYPE_CODE,
    BILLING_TYPE_DESC,
    CALCULATED_BILL_TOTAL_AMT,
    CARE_TYPE_NAME,
    DIVISION_NUMBER,
    ELECTRONIC_CLAIM_TYPE_CODE,
    ELECTRONIC_CLAIM_TYPE_DESC,
    ENCOUNTER_REASON_CODE,
    FORM_NBR,
    IS_PROCESSING_COMPLETE,
    MICROFILM_NBR,
    PLACE_OF_SERVICE_CODE,
    PLACE_OF_SERVICE_DESC,
    PRICING_ZIP_SOURCE,
    PATIENT_ACCOUNT_NUMBER,
    SHOCK_CLAIM_IND,
    SOURCE_LAST_UPDATED_DATETIME,
    IS_PREDETERMINATION_CLAIM_FLAG,
    ORIGINAL_CLAIM_ID,
    MULTISOURCE_CLAIM_IND,
    BILLING_PROVIDER_ID,
    BILLING_PROVIDER_NAME,
    BILLING_PROVIDER_TAX_ID_NBR,
    BILLING_PROVIDER_NPI,
    BILLING_PROVIDER_VENDOR_NBR,
    OFFICE_ID,
    OFFICE_NAME,
    ATTENDING_PHYSICIAN_ID,
    ICD_DIAGNOSIS_CODES_ARRAY,
    REFERRING_PROVIDER_ID,
    CLAIM_TYPE_CODE,
    IPA_CODE,
    SERVICE_ZIP_CODE,
    EDI_837_FACILITY_NPI_NBR,
    EDI_837_FACILITY_NAME,
    EDI_837_FACILITY_TELEPHONE_NBR,
    EDI_837_FACILITY_ADDRESS_LINE_1_TEXT,
    EDI_837_FACILITY_ADDRESS_LINE_2_TEXT,
    EDI_837_FACILITY_CITY_NAME,
    EDI_837_FACILITY_STATE_ABBREV_NAME,
    EDI_837_FACILITY_ZIP_CODE_NBR,
    EDI_837_FACILITY_OTHER_ID,
    SEVERITY_OF_ILLNESS,
    DIAGNOSIS_RELATED_GROUP_CODE,
    PROVIDER_SPECIALTY,
    PAID_STATUS_FOR_CMS
)
    SELECT
    HUB_CLAIM_HKEY,
    TPA_CLIENT_ID,
    TPA_ID,
    TPA_DIV_ID,
    DATA_SOURCE_NAME,
    CLAIM_NBR,
    HUB_INSERT_DATETIME,
    MG_MEDICAL_GROUP_ID,
    HUB_MEMBER_HKEY,
    MEMBER_NBR,
    SUBSCRIBER_ID,
    PERSON_ID,
    GROUP_NBR,
    SUB_GROUP_NBR,
    PLAN_DESC,
    PLAN_TYPE_DESC,
    RIDER_CODES,
    GROUP_NAME,
    SUB_GROUP_NAME,
    CLAIM_ENTRY_DATE,
    LINE_OF_BUSINESS_CODE,
    PLAN_CODE,
    PLAN_TYPE_CODE,
    BILLING_PROVIDER_PARTICIPATING_STATUS_CODE,
    ADMITTED_FLAG,
    ADMITTED_DATE,
    ADMITTED_HOUR,
    ADMISSION_SOURCE_CODE,
    ADMISSION_SOURCE_DESC,
    ADMISSION_TYPE_CODE,
    ADMISSION_TYPE_DESC,
    DISCHARGE_DATE,
    DISCHARGE_HOUR,
    DISCHARGE_STATUS_CODE,
    DISCHARGE_STATUS_DESC,
    BILLING_TYPE_CODE,
    BILLING_TYPE_DESC,
    CALCULATED_BILL_TOTAL_AMT,
    CARE_TYPE_NAME,
    DIVISION_NUMBER,
    ELECTRONIC_CLAIM_TYPE_CODE,
    ELECTRONIC_CLAIM_TYPE_DESC,
    ENCOUNTER_REASON_CODE,
    FORM_NBR,
    IS_PROCESSING_COMPLETE,
    MICROFILM_NBR,
    PLACE_OF_SERVICE_CODE,
    PLACE_OF_SERVICE_DESC,
    PRICING_ZIP_SOURCE,
    PATIENT_ACCOUNT_NUMBER,
    SHOCK_CLAIM_IND,
    SOURCE_LAST_UPDATED_DATETIME,
    IS_PREDETERMINATION_CLAIM_FLAG,
    ORIGINAL_CLAIM_ID,
    MULTISOURCE_CLAIM_IND,
    BILLING_PROVIDER_ID,
    BILLING_PROVIDER_NAME,
    BILLING_PROVIDER_TAX_ID_NBR,
    BILLING_PROVIDER_NPI,
    BILLING_PROVIDER_VENDOR_NBR,
    OFFICE_ID,
    OFFICE_NAME,
    ATTENDING_PHYSICIAN_ID,
    ICD_DIAGNOSIS_CODES_ARRAY,
    REFERRING_PROVIDER_ID,
    CLAIM_TYPE_CODE,
    IPA_CODE,
    SERVICE_ZIP_CODE,
    EDI_837_FACILITY_NPI_NBR,
    EDI_837_FACILITY_NAME,
    EDI_837_FACILITY_TELEPHONE_NBR,
    EDI_837_FACILITY_ADDRESS_LINE_1_TEXT,
    EDI_837_FACILITY_ADDRESS_LINE_2_TEXT,
    EDI_837_FACILITY_CITY_NAME,
    EDI_837_FACILITY_STATE_ABBREV_NAME,
    EDI_837_FACILITY_ZIP_CODE_NBR,
    EDI_837_FACILITY_OTHER_ID,
    SEVERITY_OF_ILLNESS,
    DIAGNOSIS_RELATED_GROUP_CODE,
    PROVIDER_SPECIALTY,
    PAID_STATUS_FOR_CMS
FROM RAWDATA.DATAHUB_CLAIM_HEADER_BASE_SELECT_VW
;`;

try 
{
    /*Execute INSERT OVERRIDE Command */
    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    /*Log results to table*/
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), result, sfStatement.getSqlText()]}
    );
}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds:
        [
            targetTableName
            ,"TABLE"
            ,startTime
            ,endTime
            ,result
            ,sfStatement.getSqlText()
            ,err.code
            ,err.state
            ,err.message
            ,err.stackTraceTxt
        ]
        }
    );        
    throw result;
}
return result;
$$
;