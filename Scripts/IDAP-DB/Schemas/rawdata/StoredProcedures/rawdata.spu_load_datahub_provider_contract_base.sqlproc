CREATE OR REPLACE PROCEDURE RAWDATA.SPU_LOAD_DATAHUB_PROVIDER_CONTRACT_BASE()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
/* get procedure start time and set variables */
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `RAWDATA.DATAHUB_PROVIDER_CONTRACT_BASE`;

/* Create INSERT OVERWRITE statement to be executed */
var sqlInsertCommand =
`INSERT OVERWRITE INTO RAWDATA.DATAHUB_PROVIDER_CONTRACT_BASE
(
	TPA_CLIENT_ID
	, TPA_ID
	, TPA_DIV_ID
	, DATA_SOURCE_NAME
	, CARE_TYPE_NAME
	, PROVIDER_ID
	, MEDICAL_GROUP_ID
	, OFFICE_ID
	, OFFICE_NAME
	, PROVIDER_ADDRESS_ACTIVE_IND
	, PROVIDER_ADDRESS_TYPE_CODE
	, PROVIDER_ADDRESS_LINE_1
	, PROVIDER_ADDRESS_LINE_2
	, PROVIDER_CITY_NAME
	, PROVIDER_COUNTY_NAME
	, PROVIDER_ZIP_CODE
	, PROVIDER_STATE_ABBREV_NAME
	, PROVIDER_STATE_FULL_NAME
	, PROVIDER_COUNTRY_NAME
	, MASTER_ADDRESS_HKEY
	, VERIFIED_DELIVERY_LINE_1
	, VERIFIED_DELIVERY_LINE_2
	, VERIFIED_DELIVERY_LAST_LINE
	, VERIFIED_SMARTY_KEY
	, VERIFIED_URBANIZATION
	, VERIFIED_PRIMARY_NUMBER
	, VERIFIED_STREET_NAME
	, VERIFIED_STREET_PREDIRECTION
	, VERIFIED_STREET_POSTDIRECTION
	, VERIFIED_STREET_SUFFIX
	, VERIFIED_SECONDARY_NUMBER
	, VERIFIED_SECONDARY_DESIGNATOR
	, VERIFIED_EXTRA_SECONDARY_NUMBER
	, VERIFIED_EXTRA_SECONDARY_DESIGNATOR
	, VERIFIED_PMB_DESIGNATOR
	, VERIFIED_PMB_NUMBER
	, VERIFIED_CITY_NAME
	, VERIFIED_DEFAULT_CITY_NAME
	, VERIFIED_STATE_ABBREVIATION
	, VERIFIED_ZIPCODE
	, VERIFIED_PLUS4_CODE
	, VERIFIED_RECORD_TYPE
	, VERIFIED_ZIP_TYPE
	, VERIFIED_COUNTY_FIPS
	, VERIFIED_COUNTY_NAME
	, VERIFIED_CONGRESSIONAL_DISTRICT_CODE
	, VERIFIED_LATITUDE
	, VERIFIED_LONGITUDE
	, VERIFIED_LAT_LONG_PRECISION
	, VERIFIED_TIME_ZONE
	, VERIFIED_UTC_OFFSET
	, VERIFIED_DST_INDICATOR
	, VERIFIED_DPV_FOOTNOTES
	, VERIFIED_RAW_RESPONSE
	, PROVIDER_ADDRESS_START_DATE
	, PROVIDER_ADDRESS_TERM_DATE
	, SUPPRESSED_IN_DIRECTORY_IND
	, PROVIDER_CONTRACT_ACTIVE_IND
	, CONTRACT_MODEL_TEXT
	, PROVIDER_CONTRACT_START_DATE
	, PROVIDER_CONTRACT_END_DATE
	, PRODUCT_NAME
	, PRODUCT_TYPE
	, PRODUCT_LEVEL_NAME
	, RESTRICTION_AGE_MIN
	, RESTRICTION_AGE_MAX
	, RESTRICTION_GENDER
	, SPECIAL_RESTRICTION_DESC
	, EXISTING_PATIENTS_ONLY_IND
	, CONTRACT_TERM_REASON
	, HUB_PROVIDER_CONTRACT_HKEY
	, HUB_MEDICAL_GROUP_CONTRACT_HKEY
	, HUB_OFFICE_HKEY
	, HUB_PROVIDER_HKEY
	, HUB_MEDICAL_GROUP_HKEY


)
SELECT
	TPA_CLIENT_ID
	, TPA_ID
	, TPA_DIV_ID
	, DATA_SOURCE_NAME
	, CARE_TYPE_NAME
	, PROVIDER_ID
	, MEDICAL_GROUP_ID
	, OFFICE_ID
	, OFFICE_NAME
	, PROVIDER_ADDRESS_ACTIVE_IND
	, PROVIDER_ADDRESS_TYPE_CODE
	, PROVIDER_ADDRESS_LINE_1
	, PROVIDER_ADDRESS_LINE_2
	, PROVIDER_CITY_NAME
	, PROVIDER_COUNTY_NAME
	, PROVIDER_ZIP_CODE
	, PROVIDER_STATE_ABBREV_NAME
	, PROVIDER_STATE_FULL_NAME
	, PROVIDER_COUNTRY_NAME
	, MASTER_ADDRESS_HKEY
	, VERIFIED_DELIVERY_LINE_1
	, VERIFIED_DELIVERY_LINE_2
	, VERIFIED_DELIVERY_LAST_LINE
	, VERIFIED_SMARTY_KEY
	, VERIFIED_URBANIZATION
	, VERIFIED_PRIMARY_NUMBER
	, VERIFIED_STREET_NAME
	, VERIFIED_STREET_PREDIRECTION
	, VERIFIED_STREET_POSTDIRECTION
	, VERIFIED_STREET_SUFFIX
	, VERIFIED_SECONDARY_NUMBER
	, VERIFIED_SECONDARY_DESIGNATOR
	, VERIFIED_EXTRA_SECONDARY_NUMBER
	, VERIFIED_EXTRA_SECONDARY_DESIGNATOR
	, VERIFIED_PMB_DESIGNATOR
	, VERIFIED_PMB_NUMBER
	, VERIFIED_CITY_NAME
	, VERIFIED_DEFAULT_CITY_NAME
	, VERIFIED_STATE_ABBREVIATION
	, VERIFIED_ZIPCODE
	, VERIFIED_PLUS4_CODE
	, VERIFIED_RECORD_TYPE
	, VERIFIED_ZIP_TYPE
	, VERIFIED_COUNTY_FIPS
	, VERIFIED_COUNTY_NAME
	, VERIFIED_CONGRESSIONAL_DISTRICT_CODE
	, VERIFIED_LATITUDE
	, VERIFIED_LONGITUDE
	, VERIFIED_LAT_LONG_PRECISION
	, VERIFIED_TIME_ZONE
	, VERIFIED_UTC_OFFSET
	, VERIFIED_DST_INDICATOR
	, VERIFIED_DPV_FOOTNOTES
	, VERIFIED_RAW_RESPONSE
	, PROVIDER_ADDRESS_START_DATE
	, PROVIDER_ADDRESS_TERM_DATE
	, SUPPRESSED_IN_DIRECTORY_IND
	, PROVIDER_CONTRACT_ACTIVE_IND
	, CONTRACT_MODEL_TEXT
	, PROVIDER_CONTRACT_START_DATE
	, PROVIDER_CONTRACT_END_DATE
	, PRODUCT_NAME
	, PRODUCT_TYPE
	, PRODUCT_LEVEL_NAME
	, RESTRICTION_AGE_MIN
	, RESTRICTION_AGE_MAX
	, RESTRICTION_GENDER
	, SPECIAL_RESTRICTION_DESC
	, EXISTING_PATIENTS_ONLY_IND
	, CONTRACT_TERM_REASON
	, HUB_PROVIDER_CONTRACT_HKEY
	, HUB_MEDICAL_GROUP_CONTRACT_HKEY
	, HUB_OFFICE_HKEY
	, HUB_PROVIDER_HKEY
	, HUB_MEDICAL_GROUP_HKEY

FROM RAWDATA.DATAHUB_PROVIDER_CONTRACT_BASE_SELECT_VW
;`;

try 
{
    /*Execute INSERT OVERRIDE Command */
    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    /*Log results to table*/
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), result, sfStatement.getSqlText()]}
    );
}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds:
        [
            targetTableName
            ,"TABLE"
            ,startTime
            ,endTime
            ,result
            ,sfStatement.getSqlText()
            ,err.code
            ,err.state
            ,err.message
            ,err.stackTraceTxt
        ]
        }
    );        
    throw result;
}
return result;
$$
;