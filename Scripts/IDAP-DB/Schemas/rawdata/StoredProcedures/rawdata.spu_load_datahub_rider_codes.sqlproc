CREATE OR REPLACE PROCEDURE RAWDATA.SPU_LOAD_DATAHUB_RIDER_CODES()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
/* get procedure start time and set variables */
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `RAWDATA.DATAHUB_RIDER_CODES`;

/* Create INSERT OVERWRITE statement to be executed */
var sqlInsertCommand =
`INSERT OVERWRITE INTO RAWDATA.DATAHUB_RIDER_CODES
(
HUB_RIDER_HKEY,
TPA_CLIENT_ID,
TPA_ID,
TPA_DIV_ID,
DATA_SOURCE_NAME,
RIDER_CODE,
RIDER_EFFECTIVE_DATE,
RIDER_DESC,
RIDER_TERMINATION_DATE,
TIER_METHOD_CODE,
RIDER_AMT_1,
RIDER_AMT_2,
RIDER_AMT_3,
RIDER_AMT_4,
RIDER_AMT_5,
RIDER_AMT_6,
RIDER_AMT_7,
RIDER_AMT_8,
RIDER_AMT_9,
RIDER_AMT_10,
RIDER_TYPE_CODE,
RIDER_TYPE_DESC,
AR_CASH_GL_DISTRIBUTION_CODE,
COMPANY_CODE,
ELIGIBILITY_RULE_CODE,
GL_DISTRIBUTION_CODE,
GROUP_NBR,
SUB_GROUP_NBR,
FORMULARY_CODE,
FORMULARY_CODE_DESC
) 
SELECT  HUB_RIDER_HKEY,
        TPA_CLIENT_ID,
        TPA_ID,
        TPA_DIV_ID,
        DATA_SOURCE_NAME,
        RIDER_CODE,
        RIDER_EFFECTIVE_DATE,
        RIDER_DESC,
        RIDER_TERMINATION_DATE,
        TIER_METHOD_CODE,
        RIDER_AMT_1,
        RIDER_AMT_2,
        RIDER_AMT_3,
        RIDER_AMT_4,
        RIDER_AMT_5,
        RIDER_AMT_6,
        RIDER_AMT_7,
        RIDER_AMT_8,
        RIDER_AMT_9,
        RIDER_AMT_10,
        RIDER_TYPE_CODE,
        RIDER_TYPE_DESC,
        AR_CASH_GL_DISTRIBUTION_CODE,
        COMPANY_CODE,
        ELIGIBILITY_RULE_CODE,
        GL_DISTRIBUTION_CODE,
        GROUP_NBR,
        SUB_GROUP_NBR,
        FORMULARY_CODE,
        FORMULARY_CODE_DESC
FROM RAWDATA.DATAHUB_RIDER_CODES_SELECT_VW
;`;

try 
{
    /*Execute INSERT OVERRIDE Command */
    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    /*Log results to table*/
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), result, sfStatement.getSqlText()]}
    );
}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds:
        [
            targetTableName
            ,"TABLE"
            ,startTime
            ,endTime
            ,result
            ,sfStatement.getSqlText()
            ,err.code
            ,err.state
            ,err.message
            ,err.stackTraceTxt
        ]
        }
    );        
    throw result;
}
return result;
$$
;