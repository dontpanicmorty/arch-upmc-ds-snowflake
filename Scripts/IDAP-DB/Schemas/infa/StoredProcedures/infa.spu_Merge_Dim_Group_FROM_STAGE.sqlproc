CREATE OR REPLACE PROCEDURE INFA.SPU_MERGE_DIM_GROUP_FROM_STAGE()
RETURNS VARCHAR NOT NULL
language javascript
AS
$$
var result = "";
var sql_command = "";
sql_command += "MERGE INTO DIMDATA.DIM_GROUP AS T";
sql_command += " USING INFA.DIM_GROUP AS S";
sql_command += " ON (T.DIM_GROUP_KEY=S.DIM_GROUP_KEY)";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'D' THEN DELETE";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'U' THEN UPDATE";
sql_command += " SET T.MD5_VALUE_TEXT=S.MD5_VALUE_TEXT, T.INSERT_DATETIME=S.INSERT_DATETIME, T.LAST_UPDATED_DATETIME=S.LAST_UPDATED_DATETIME, T.TPA_CLIENT_ID = S.TPA_CLIENT_ID, T.TPA_ID = S.TPA_ID, T.TPA_DIV_ID = S.TPA_DIV_ID, T.GROUP_NBR = S.GROUP_NBR, T.CORPORATE_ID = S.CORPORATE_ID, T.GROUP_NAME = S.GROUP_NAME, T.GROUP_SIZE_NBR = S.GROUP_SIZE_NBR, T.GROUP_STATE_ABBREVIATION_NAME = S.GROUP_STATE_ABBREVIATION_NAME, T.GROUP_FIPS_COUNTY_CODE = S.GROUP_FIPS_COUNTY_CODE, T.GROUP_FIPS_COUNTY_NAME = S.GROUP_FIPS_COUNTY_NAME, T.GROUP_ZIP_CODE_NBR = S.GROUP_ZIP_CODE_NBR, T.ORIGINAL_START_DATE = S.ORIGINAL_START_DATE, T.RENEWAL_DATE = S.RENEWAL_DATE, T.CURRENT_GROUP_START_DATE = S.CURRENT_GROUP_START_DATE, T.CURRENT_GROUP_END_DATE = S.CURRENT_GROUP_END_DATE, T.STOP_LOSS_UPMC_IND = S.STOP_LOSS_UPMC_IND, T.STOP_LOSSCARRIER_CODE = S.STOP_LOSSCARRIER_CODE, T.AGGREGATE_STOP_LOSS_IND = S.AGGREGATE_STOP_LOSS_IND, T.STOP_LOSS_DEDUCTIBLE_AMT = S.STOP_LOSS_DEDUCTIBLE_AMT, T.UNION_AFFILIATION_IND = S.UNION_AFFILIATION_IND, T.AGGREGATE_COMPANY_ATTACH_THRESHOLD_AMT = S.AGGREGATE_COMPANY_ATTACH_THRESHOLD_AMT, T.AGGREGATE_FAMILY_ATTACH_THRESHOLD_AMT = S.AGGREGATE_FAMILY_ATTACH_THRESHOLD_AMT, T.AGGREGATE_SINGLE_ATTACH_THRESHOLD_AMT = S.AGGREGATE_SINGLE_ATTACH_THRESHOLD_AMT, T.CONTRACT_MAX_PAYOUT_THRESHOLD_AMT = S.CONTRACT_MAX_PAYOUT_THRESHOLD_AMT, T.AGGREGATE_MAX_LIFETIME_COVERAGE_THRESHOLD_AMT = S.AGGREGATE_MAX_LIFETIME_COVERAGE_THRESHOLD_AMT, T.THRESHOLD_CALCULATION_LEVEL_CODE = S.THRESHOLD_CALCULATION_LEVEL_CODE, T.STOP_LOSS_LEVEL_FUNDING_IND = S.STOP_LOSS_LEVEL_FUNDING_IND, T.SPECIFIC_STOP_LOSS_IND = S.SPECIFIC_STOP_LOSS_IND, T.COMPANY_COUNTY_NAME = S.COMPANY_COUNTY_NAME, T.COMPANY_ID = S.COMPANY_ID, T.LEGAL_EMPLOYEE_SIZE_NBR = S.LEGAL_EMPLOYEE_SIZE_NBR, T.DPW_PLAN_CODE = S.DPW_PLAN_CODE, T.PRIOR_GROUP_END_DATE = S.PRIOR_GROUP_END_DATE, T.PRIOR_GROUP_START_DATE = S.PRIOR_GROUP_START_DATE";
sql_command += " WHEN NOT MATCHED THEN INSERT";
sql_command += " (T.DIM_GROUP_KEY, T.MD5_VALUE_TEXT, T.INSERT_DATETIME, T.LAST_UPDATED_DATETIME, T.TPA_CLIENT_ID, T.TPA_ID, T.TPA_DIV_ID, T.GROUP_NBR, T.CORPORATE_ID, T.GROUP_NAME, T.GROUP_SIZE_NBR, T.GROUP_STATE_ABBREVIATION_NAME, T.GROUP_FIPS_COUNTY_CODE, T.GROUP_FIPS_COUNTY_NAME, T.GROUP_ZIP_CODE_NBR, T.ORIGINAL_START_DATE, T.RENEWAL_DATE, T.CURRENT_GROUP_START_DATE, T.CURRENT_GROUP_END_DATE, T.STOP_LOSS_UPMC_IND, T.STOP_LOSSCARRIER_CODE, T.AGGREGATE_STOP_LOSS_IND, T.STOP_LOSS_DEDUCTIBLE_AMT, T.UNION_AFFILIATION_IND, T.AGGREGATE_COMPANY_ATTACH_THRESHOLD_AMT, T.AGGREGATE_FAMILY_ATTACH_THRESHOLD_AMT, T.AGGREGATE_SINGLE_ATTACH_THRESHOLD_AMT, T.CONTRACT_MAX_PAYOUT_THRESHOLD_AMT, T.AGGREGATE_MAX_LIFETIME_COVERAGE_THRESHOLD_AMT, T.THRESHOLD_CALCULATION_LEVEL_CODE, T.STOP_LOSS_LEVEL_FUNDING_IND, T.SPECIFIC_STOP_LOSS_IND, T.COMPANY_COUNTY_NAME, T.COMPANY_ID, T.LEGAL_EMPLOYEE_SIZE_NBR, T.DPW_PLAN_CODE, T.PRIOR_GROUP_END_DATE, T.PRIOR_GROUP_START_DATE)";
sql_command += " VALUES";
sql_command += " (S.DIM_GROUP_KEY, S.MD5_VALUE_TEXT, S.INSERT_DATETIME, S.LAST_UPDATED_DATETIME, S.TPA_CLIENT_ID, S.TPA_ID, S.TPA_DIV_ID, S.GROUP_NBR, S.CORPORATE_ID, S.GROUP_NAME, S.GROUP_SIZE_NBR, S.GROUP_STATE_ABBREVIATION_NAME, S.GROUP_FIPS_COUNTY_CODE, S.GROUP_FIPS_COUNTY_NAME, S.GROUP_ZIP_CODE_NBR, S.ORIGINAL_START_DATE, S.RENEWAL_DATE, S.CURRENT_GROUP_START_DATE, S.CURRENT_GROUP_END_DATE, S.STOP_LOSS_UPMC_IND, S.STOP_LOSSCARRIER_CODE, S.AGGREGATE_STOP_LOSS_IND, S.STOP_LOSS_DEDUCTIBLE_AMT, S.UNION_AFFILIATION_IND, S.AGGREGATE_COMPANY_ATTACH_THRESHOLD_AMT, S.AGGREGATE_FAMILY_ATTACH_THRESHOLD_AMT, S.AGGREGATE_SINGLE_ATTACH_THRESHOLD_AMT, S.CONTRACT_MAX_PAYOUT_THRESHOLD_AMT, S.AGGREGATE_MAX_LIFETIME_COVERAGE_THRESHOLD_AMT, S.THRESHOLD_CALCULATION_LEVEL_CODE, S.STOP_LOSS_LEVEL_FUNDING_IND, S.SPECIFIC_STOP_LOSS_IND, S.COMPANY_COUNTY_NAME, S.COMPANY_ID, S.LEGAL_EMPLOYEE_SIZE_NBR, S.DPW_PLAN_CODE, S.PRIOR_GROUP_END_DATE, S.PRIOR_GROUP_START_DATE);";

try 
    {
        var statement = snowflake.createStatement({sqlText: sql_command});
        var resultSet = statement.execute();
        resultSet.next();
        result = "Succeeded";
        result += "\n RowsInserted: " + resultSet.getColumnValueAsString("number of rows inserted");
        result += "\n RowsUpdated: " + resultSet.getColumnValueAsString("number of rows updated");
        result += "\n RowsDeleted: " + resultSet.getColumnValueAsString("number of rows deleted");
        
    }
catch (err)
    {
      result = "Failed: Code: " + err.code + "\n  State: " + err.state;
      result += "\n  Message: " + err.message;
      result += "\nStack Trace:\n" + err.stackTraceTxt;
      throw result;
    }
return result;
$$
;	