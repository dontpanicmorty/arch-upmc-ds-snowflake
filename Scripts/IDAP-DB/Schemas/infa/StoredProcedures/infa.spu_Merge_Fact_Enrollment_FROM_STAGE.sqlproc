CREATE OR REPLACE PROCEDURE INFA.SPU_MERGE_FACT_ENROLLMENT_FROM_STAGE()
RETURNS VARCHAR NOT NULL
language javascript
AS
$$
var result = "";
var sql_command = "";
sql_command += "MERGE INTO DIMDATA.FACT_ENROLLMENT AS T";
sql_command += " USING INFA.FACT_ENROLLMENT AS S";
sql_command += " ON (T.FACT_ENROLLMENT_KEY=S.FACT_ENROLLMENT_KEY)";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'D' THEN DELETE";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'U' THEN UPDATE";
sql_command += " SET T.MD5_VALUE_TEXT=S.MD5_VALUE_TEXT, T.INSERT_DATETIME=S.INSERT_DATETIME, T.LAST_UPDATED_DATETIME=S.LAST_UPDATED_DATETIME, T.DIM_TPA_HIERARCHY_KEY = S.DIM_TPA_HIERARCHY_KEY, T.DIM_MEMBER_KEY = S.DIM_MEMBER_KEY, T.DIM_ENROLLMENT_SPAN_KEY = S.DIM_ENROLLMENT_SPAN_KEY, T.DIM_PLAN_KEY = S.DIM_PLAN_KEY, T.DIM_SALES_CHANNEL_KEY = S.DIM_SALES_CHANNEL_KEY, T.ELIGIBILITY_START_DATE_KEY = S.ELIGIBILITY_START_DATE_KEY, T.ELIGIBILITY_END_DATE_KEY = S.ELIGIBILITY_END_DATE_KEY, T.ENROLLMENT_DATE_KEY = S.ENROLLMENT_DATE_KEY, T.RENEWAL_DATE_KEY = S.RENEWAL_DATE_KEY, T.ELIGIBILITY_START_DATE = S.ELIGIBILITY_START_DATE, T.ELIGIBILITY_END_DATE = S.ELIGIBILITY_END_DATE, T.ENROLLMENT_DATE = S.ENROLLMENT_DATE, T.RENEWAL_DATE = S.RENEWAL_DATE, T.DIM_GROUP_KEY = S.DIM_GROUP_KEY, T.DIM_SUB_GROUP_KEY = S.DIM_SUB_GROUP_KEY, T.DIM_GL_DISTRIBUTION_KEY = S.DIM_GL_DISTRIBUTION_KEY, T.SUBSCRIBER_FLAG = S.SUBSCRIBER_FLAG, T.DIM_RATE_CELL_KEY = S.DIM_RATE_CELL_KEY, T.DIM_RIDER_KEY = S.DIM_RIDER_KEY, T.MEDICAL_RIDER_FLAG = S.MEDICAL_RIDER_FLAG, T.DIM_ELIGIBILITY_TYPE_KEY = S.DIM_ELIGIBILITY_TYPE_KEY, T.DIM_PLAN_SEGMENT_KEY = S.DIM_PLAN_SEGMENT_KEY" ;
sql_command += " WHEN NOT MATCHED AND S.CONVERT_IND = 'I' THEN INSERT";
sql_command += " (T.FACT_ENROLLMENT_KEY, T.MD5_VALUE_TEXT, T.INSERT_DATETIME, T.LAST_UPDATED_DATETIME, T.DIM_TPA_HIERARCHY_KEY, T.DIM_MEMBER_KEY, T.DIM_ENROLLMENT_SPAN_KEY, T.DIM_PLAN_KEY, T.DIM_SALES_CHANNEL_KEY, T.ELIGIBILITY_START_DATE_KEY, T.ELIGIBILITY_END_DATE_KEY, T.ENROLLMENT_DATE_KEY, T.RENEWAL_DATE_KEY, T.ELIGIBILITY_START_DATE, T.ELIGIBILITY_END_DATE, T.ENROLLMENT_DATE, T.RENEWAL_DATE, T.DIM_GROUP_KEY, T.DIM_SUB_GROUP_KEY, T.DIM_GL_DISTRIBUTION_KEY , T.SUBSCRIBER_FLAG, T.DIM_RATE_CELL_KEY, T.DIM_RIDER_KEY, T.MEDICAL_RIDER_FLAG, T.DIM_ELIGIBILITY_TYPE_KEY, T.DIM_PLAN_SEGMENT_KEY)";
sql_command += " VALUES";
sql_command += " (S.FACT_ENROLLMENT_KEY, S.MD5_VALUE_TEXT, S.INSERT_DATETIME, S.LAST_UPDATED_DATETIME, S.DIM_TPA_HIERARCHY_KEY, S.DIM_MEMBER_KEY, S.DIM_ENROLLMENT_SPAN_KEY, S.DIM_PLAN_KEY, S.DIM_SALES_CHANNEL_KEY, S.ELIGIBILITY_START_DATE_KEY, S.ELIGIBILITY_END_DATE_KEY, S.ENROLLMENT_DATE_KEY, S.RENEWAL_DATE_KEY, S.ELIGIBILITY_START_DATE, S.ELIGIBILITY_END_DATE, S.ENROLLMENT_DATE, S.RENEWAL_DATE, S.DIM_GROUP_KEY, S.DIM_SUB_GROUP_KEY, S.DIM_GL_DISTRIBUTION_KEY , S.SUBSCRIBER_FLAG, S.DIM_RATE_CELL_KEY, S.DIM_RIDER_KEY, S.MEDICAL_RIDER_FLAG, S.DIM_ELIGIBILITY_TYPE_KEY, S.DIM_PLAN_SEGMENT_KEY)";

try 
    {
        var statement = snowflake.createStatement({sqlText: sql_command});
        var resultSet = statement.execute();
        resultSet.next();
        result = "Succeeded";
        result += "\n RowsInserted: " + resultSet.getColumnValueAsString("number of rows inserted");
        result += "\n RowsUpdated: " + resultSet.getColumnValueAsString("number of rows updated");
        result += "\n RowsDeleted: " + resultSet.getColumnValueAsString("number of rows deleted");
        
    }
catch (err)
    {
      result = "Failed: Code: " + err.code + "\n  State: " + err.state;
      result += "\n  Message: " + err.message;
      result += "\nStack Trace:\n" + err.stackTraceTxt;
      throw result;
    }
return result;
$$
;