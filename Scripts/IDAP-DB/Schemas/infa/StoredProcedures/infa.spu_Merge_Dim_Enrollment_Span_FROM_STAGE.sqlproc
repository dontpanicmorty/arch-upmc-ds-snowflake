CREATE OR REPLACE PROCEDURE INFA.SPU_MERGE_DIM_ENROLLMENT_SPAN_FROM_STAGE()
RETURNS VARCHAR NOT NULL
language javascript
AS
$$
var result = "";
var sql_command = "";
sql_command += "MERGE INTO DIMDATA.DIM_ENROLLMENT_SPAN AS T";
sql_command += " USING INFA.DIM_ENROLLMENT_SPAN AS S";
sql_command += " ON (T.DIM_ENROLLMENT_SPAN_KEY=S.DIM_ENROLLMENT_SPAN_KEY)";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'D' THEN DELETE";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'U' THEN UPDATE";
sql_command += " SET T.MD5_VALUE_TEXT=S.MD5_VALUE_TEXT, T.INSERT_DATETIME=S.INSERT_DATETIME, T.LAST_UPDATED_DATETIME=S.LAST_UPDATED_DATETIME, T.IS_LOGICAL_DELETE_FLAG=S.IS_LOGICAL_DELETE_FLAG, T.TPA_CLIENT_ID = S.TPA_CLIENT_ID, T.TPA_ID = S.TPA_ID, T.TPA_DIV_ID = S.TPA_DIV_ID, T.MEMBER_NBR = S.MEMBER_NBR, T.MASTER_MEMBER_ID = S.MASTER_MEMBER_ID, T.ELIGIBILITY_START_DATE = S.ELIGIBILITY_START_DATE, T.ELIGIBILITY_END_DATE = S.ELIGIBILITY_END_DATE, T.SPAN_TYPE_CODE = S.SPAN_TYPE_CODE, T.TERMINATION_REASON_CODE = S.TERMINATION_REASON_CODE, T.TERMINATION_REASON_DESC = S.TERMINATION_REASON_DESC, T.ACA_MEMBER_STATUS_CODE = S.ACA_MEMBER_STATUS_CODE, T.ACA_ENROLLMENT_TYPE_CODE = S.ACA_ENROLLMENT_TYPE_CODE, T.ACA_RENEWAL_DATE = S.ACA_RENEWAL_DATE, T.ACA_NPN_NBR = S.ACA_NPN_NBR, T.ACA_SUBSIDY_LEVEL_NAME = S.ACA_SUBSIDY_LEVEL_NAME, T.ENROLLMENT_DATE = S.ENROLLMENT_DATE, T.ACA_TERMED_FLAG = S.ACA_TERMED_FLAG, T.ACA_SMOKING_STATUS_CODE = S.ACA_SMOKING_STATUS_CODE, T.CONTRACT_NBR = S.CONTRACT_NBR, T.FLEXIBLE_SPENDING_ACCOUNT_IND = S.FLEXIBLE_SPENDING_ACCOUNT_IND, T.PLAN_BENEFIT_PACKAGE_ID = S.PLAN_BENEFIT_PACKAGE_ID, T.MEMBER_TERMINATION_DATE = S.MEMBER_TERMINATION_DATE, T.SUB_SOURCE_NAME = S.SUB_SOURCE_NAME, T.DPW_FACILITATED_COUNTY_DESC = S.DPW_FACILITATED_COUNTY_DESC, T.ASSISTANCE_CATEGORY_CODE = S.ASSISTANCE_CATEGORY_CODE, T.PROGRAM_STATUS_CODE = S.PROGRAM_STATUS_CODE, T.MEDICARE_SNP_TYPE_DESC = S.MEDICARE_SNP_TYPE_DESC";
sql_command += " WHEN NOT MATCHED THEN INSERT";
sql_command += " (T.DIM_ENROLLMENT_SPAN_KEY, T.MD5_VALUE_TEXT, T.INSERT_DATETIME, T.LAST_UPDATED_DATETIME, T.IS_LOGICAL_DELETE_FLAG, T.TPA_CLIENT_ID, T.TPA_ID, T.TPA_DIV_ID, T.MEMBER_NBR, T.MASTER_MEMBER_ID, T.ELIGIBILITY_START_DATE, T.ELIGIBILITY_END_DATE, T.SPAN_TYPE_CODE, T.TERMINATION_REASON_CODE, T.TERMINATION_REASON_DESC, T.ACA_MEMBER_STATUS_CODE, T.ACA_ENROLLMENT_TYPE_CODE, T.ACA_RENEWAL_DATE, T.ACA_NPN_NBR, T.ACA_SUBSIDY_LEVEL_NAME, T.ENROLLMENT_DATE, T.ACA_TERMED_FLAG, T.ACA_SMOKING_STATUS_CODE, T.CONTRACT_NBR, T.FLEXIBLE_SPENDING_ACCOUNT_IND, T.PLAN_BENEFIT_PACKAGE_ID, T.MEMBER_TERMINATION_DATE, T.SUB_SOURCE_NAME, T.DPW_FACILITATED_COUNTY_DESC, T.ASSISTANCE_CATEGORY_CODE, T.PROGRAM_STATUS_CODE, T.MEDICARE_SNP_TYPE_DESC)";
sql_command += " VALUES";
sql_command += " (S.DIM_ENROLLMENT_SPAN_KEY, S.MD5_VALUE_TEXT, S.INSERT_DATETIME, S.LAST_UPDATED_DATETIME, S.IS_LOGICAL_DELETE_FLAG, S.TPA_CLIENT_ID, S.TPA_ID, S.TPA_DIV_ID, S.MEMBER_NBR, S.MASTER_MEMBER_ID, S.ELIGIBILITY_START_DATE, S.ELIGIBILITY_END_DATE, S.SPAN_TYPE_CODE, S.TERMINATION_REASON_CODE, S.TERMINATION_REASON_DESC, S.ACA_MEMBER_STATUS_CODE, S.ACA_ENROLLMENT_TYPE_CODE, S.ACA_RENEWAL_DATE, S.ACA_NPN_NBR, S.ACA_SUBSIDY_LEVEL_NAME, S.ENROLLMENT_DATE, S.ACA_TERMED_FLAG, S.ACA_SMOKING_STATUS_CODE, S.CONTRACT_NBR, S.FLEXIBLE_SPENDING_ACCOUNT_IND, S.PLAN_BENEFIT_PACKAGE_ID, S.MEMBER_TERMINATION_DATE, S.SUB_SOURCE_NAME, S.DPW_FACILITATED_COUNTY_DESC, S.ASSISTANCE_CATEGORY_CODE, S.PROGRAM_STATUS_CODE, S.MEDICARE_SNP_TYPE_DESC);";

try 
    {
        var statement = snowflake.createStatement({sqlText: sql_command});
        var resultSet = statement.execute();
        resultSet.next();
        result = "Succeeded";
        result += "\n RowsInserted: " + resultSet.getColumnValueAsString("number of rows inserted");
        result += "\n RowsUpdated: " + resultSet.getColumnValueAsString("number of rows updated");
        result += "\n RowsDeleted: " + resultSet.getColumnValueAsString("number of rows deleted");
        
    }
catch (err)
    {
      result = "Failed: Code: " + err.code + "\n  State: " + err.state;
      result += "\n  Message: " + err.message;
      result += "\nStack Trace:\n" + err.stackTraceTxt;
      throw result;
    }
return result;
$$
;	