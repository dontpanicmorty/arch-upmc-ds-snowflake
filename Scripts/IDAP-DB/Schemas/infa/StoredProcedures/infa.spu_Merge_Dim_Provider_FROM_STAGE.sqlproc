CREATE OR REPLACE PROCEDURE INFA.SPU_MERGE_DIM_PROVIDER_FROM_STAGE()
RETURNS VARCHAR NOT NULL
language javascript
AS
$$
var result = "";
var sql_command = 
`MERGE INTO DIMDATA.DIM_PROVIDER AS T
USING INFA.DIM_PROVIDER AS S
    ON (T.DIM_PROVIDER_KEY=S.DIM_PROVIDER_KEY)
WHEN MATCHED AND S.CONVERT_IND = 'D'
    THEN DELETE
WHEN MATCHED AND S.CONVERT_IND = 'U' THEN UPDATE
    SET
        T.MD5_VALUE_TEXT=S.MD5_VALUE_TEXT, 
        T.INSERT_DATETIME=S.INSERT_DATETIME, 
        T.LAST_UPDATED_DATETIME=S.LAST_UPDATED_DATETIME, 
        T.IS_LOGICAL_DELETE_FLAG = S.IS_LOGICAL_DELETE_FLAG, 
        T.ROW_EFFECTIVE_DATETIME = S.ROW_EFFECTIVE_DATETIME, 
        T.ROW_EXPIRATION_DATETIME = S.ROW_EXPIRATION_DATETIME, 
        T.IS_CURRENTROW_FLAG = S.IS_CURRENTROW_FLAG,
        T.DATA_SOURCE_NAME = S.DATA_SOURCE_NAME,
        T.PROVIDER_ID = S.PROVIDER_ID, 
        T.TPA_CLIENT_ID = S.TPA_CLIENT_ID, 
        T.TPA_ID = S.TPA_ID, 
        T.TPA_DIVISION_ID = S.TPA_DIVISION_ID, 
        T.PROVIDER_TYPE_CODE = S.PROVIDER_TYPE_CODE, 
        T.PROVIDER_TYPE_DESC = S.PROVIDER_TYPE_DESC, 
        T.PROVIDER_ROLE_TYPE_CODE = S.PROVIDER_ROLE_TYPE_CODE, 
        T.PROVIDER_ROLE_TYPE_DESC = S.PROVIDER_ROLE_TYPE_DESC, 
        T.PROVIDER_FULL_NAME = S.PROVIDER_FULL_NAME, 
        T.PRACTITIONER_LAST_NAME = S.PRACTITIONER_LAST_NAME, 
        T.PRACTITIONER_FIRST_NAME = S.PRACTITIONER_FIRST_NAME, 
        T.PRACTITIONER_MIDDLE_NAME = S.PRACTITIONER_MIDDLE_NAME, 
        T.PRACTITIONER_MIDDLE_INITIAL = S.PRACTITIONER_MIDDLE_INITIAL, 
        T.PRACTITIONER_NAME_SUFFIX = S.PRACTITIONER_NAME_SUFFIX, 
        T.PRACTITIONER_GENDER_CODE = S.PRACTITIONER_GENDER_CODE, 
        T.PRACTITIONER_GENDER_NAME = S.PRACTITIONER_GENDER_NAME, 
        T.PRACTITIONER_BIRTH_DATE = S.PRACTITIONER_BIRTH_DATE, 
        T.MEDICAL_GROUP_TIN_NBR = S.MEDICAL_GROUP_TIN_NBR, 
        T.PRACTITIONER_UPIN_NBR = S.PRACTITIONER_UPIN_NBR, 
        T.PRACTITIONER_SSN_NBR = S.PRACTITIONER_SSN_NBR, 
        T.PRACTITIONER_DEGREE = S.PRACTITIONER_DEGREE, 
        T.PROVIDER_EMAIL_ADDRESS = S.PROVIDER_EMAIL_ADDRESS, 
        T.PROVIDER_WEBSITE_URL = S.PROVIDER_WEBSITE_URL, 
        T.PRIMARY_SPECIALTY_NAME = S.PRIMARY_SPECIALTY_NAME, 
        T.PRIMARY_PHO_CODE = S.PRIMARY_PHO_CODE, 
        T.PRIMARY_PHO_NAME = S.PRIMARY_PHO_NAME, 
        T.PRIMARY_PHO_TERMINATION_DATE = S.PRIMARY_PHO_TERMINATION_DATE, 
        T.SECONDARY_PHO_CODE = S.SECONDARY_PHO_CODE, 
        T.SECONDARY_PHO_NAME = S.SECONDARY_PHO_NAME, 
        T.SECONDARY_PHO_TERMINATION_DATE = S.SECONDARY_PHO_TERMINATION_DATE, 
        T.TERTIARY_PHO_CODE = S.TERTIARY_PHO_CODE, 
        T.TERTIARY_PHO_NAME = S.TERTIARY_PHO_NAME, 
        T.TERTIARY_PHO_TERMINATION_DATE = S.TERTIARY_PHO_TERMINATION_DATE, 
        T.PROVIDER_START_DATE = S.PROVIDER_START_DATE, 
        T.FACILITY_INCEPTION_DATE = S.FACILITY_INCEPTION_DATE, 
        T.PROVIDER_ACTIVE_IND = S.PROVIDER_ACTIVE_IND, 
        T.PRACTITIONER_LOCUM_TENENS_IND = S.PRACTITIONER_LOCUM_TENENS_IND, 
        T.INVISIBLE_PROVIDER_IND = S.INVISIBLE_PROVIDER_IND, 
        T.TEMPORARY_PROVIDER_IND = S.TEMPORARY_PROVIDER_IND, 
        T.PA_MEDICAID_IND = S.PA_MEDICAID_IND, 
        T.PP_ACA_ENHANCED_PAY_IND = S.PP_ACA_ENHANCED_PAY_IND, 
        T.HAS_MALPRACTICE_INSURANCE_IND = S.HAS_MALPRACTICE_INSURANCE_IND, 
        T.OWNERSHIP_STATUS_CODE = S.OWNERSHIP_STATUS_CODE, 
        T.OWNERSHIP_STATUS_DESC = S.OWNERSHIP_STATUS_DESC,
        T.SOURCE_PROVIDER_NBR = S.SOURCE_PROVIDER_NBR,
        T.SOURCE_SYSTEM = 'SQLSERVER'

WHEN NOT MATCHED THEN INSERT
    (T.DIM_PROVIDER_KEY, T.MD5_VALUE_TEXT, T.INSERT_DATETIME, T.LAST_UPDATED_DATETIME, T.IS_LOGICAL_DELETE_FLAG, T.ROW_EFFECTIVE_DATETIME, T.ROW_EXPIRATION_DATETIME, T.IS_CURRENTROW_FLAG, T.DATA_SOURCE_NAME, T.PROVIDER_ID, T.TPA_CLIENT_ID, T.TPA_ID, T.TPA_DIVISION_ID, T.PROVIDER_TYPE_CODE, T.PROVIDER_TYPE_DESC, T.PROVIDER_ROLE_TYPE_CODE, T.PROVIDER_ROLE_TYPE_DESC, T.PROVIDER_FULL_NAME, T.PRACTITIONER_LAST_NAME, T.PRACTITIONER_FIRST_NAME, T.PRACTITIONER_MIDDLE_NAME, T.PRACTITIONER_MIDDLE_INITIAL, T.PRACTITIONER_NAME_SUFFIX, T.PRACTITIONER_GENDER_CODE, T.PRACTITIONER_GENDER_NAME, T.PRACTITIONER_BIRTH_DATE, T.MEDICAL_GROUP_TIN_NBR, T.PRACTITIONER_UPIN_NBR, T.PRACTITIONER_SSN_NBR, T.PRACTITIONER_DEGREE, T.PROVIDER_EMAIL_ADDRESS, T.PROVIDER_WEBSITE_URL, T.PRIMARY_SPECIALTY_NAME, T.PRIMARY_PHO_CODE, T.PRIMARY_PHO_NAME, T.PRIMARY_PHO_TERMINATION_DATE, T.SECONDARY_PHO_CODE, T.SECONDARY_PHO_NAME, T.SECONDARY_PHO_TERMINATION_DATE, T.TERTIARY_PHO_CODE, T.TERTIARY_PHO_NAME, T.TERTIARY_PHO_TERMINATION_DATE, T.PROVIDER_START_DATE, T.FACILITY_INCEPTION_DATE, T.PROVIDER_ACTIVE_IND, T.PRACTITIONER_LOCUM_TENENS_IND, T.INVISIBLE_PROVIDER_IND, T.TEMPORARY_PROVIDER_IND, T.PA_MEDICAID_IND, T.PP_ACA_ENHANCED_PAY_IND, T.HAS_MALPRACTICE_INSURANCE_IND, T.OWNERSHIP_STATUS_CODE, T.OWNERSHIP_STATUS_DESC, T.SOURCE_SYSTEM, T.SOURCE_PROVIDER_NBR)
VALUES
    (S.DIM_PROVIDER_KEY, S.MD5_VALUE_TEXT, S.INSERT_DATETIME, S.LAST_UPDATED_DATETIME, S.IS_LOGICAL_DELETE_FLAG, S.ROW_EFFECTIVE_DATETIME, S.ROW_EXPIRATION_DATETIME, S.IS_CURRENTROW_FLAG, S.DATA_SOURCE_NAME, S.PROVIDER_ID, S.TPA_CLIENT_ID, S.TPA_ID, S.TPA_DIVISION_ID, S.PROVIDER_TYPE_CODE, S.PROVIDER_TYPE_DESC, S.PROVIDER_ROLE_TYPE_CODE, S.PROVIDER_ROLE_TYPE_DESC, S.PROVIDER_FULL_NAME, S.PRACTITIONER_LAST_NAME, S.PRACTITIONER_FIRST_NAME, S.PRACTITIONER_MIDDLE_NAME, S.PRACTITIONER_MIDDLE_INITIAL, S.PRACTITIONER_NAME_SUFFIX, S.PRACTITIONER_GENDER_CODE, S.PRACTITIONER_GENDER_NAME, S.PRACTITIONER_BIRTH_DATE, S.MEDICAL_GROUP_TIN_NBR, S.PRACTITIONER_UPIN_NBR, S.PRACTITIONER_SSN_NBR, S.PRACTITIONER_DEGREE, S.PROVIDER_EMAIL_ADDRESS, S.PROVIDER_WEBSITE_URL, S.PRIMARY_SPECIALTY_NAME, S.PRIMARY_PHO_CODE, S.PRIMARY_PHO_NAME, S.PRIMARY_PHO_TERMINATION_DATE, S.SECONDARY_PHO_CODE, S.SECONDARY_PHO_NAME, S.SECONDARY_PHO_TERMINATION_DATE, S.TERTIARY_PHO_CODE, S.TERTIARY_PHO_NAME, S.TERTIARY_PHO_TERMINATION_DATE, S.PROVIDER_START_DATE, S.FACILITY_INCEPTION_DATE, S.PROVIDER_ACTIVE_IND, S.PRACTITIONER_LOCUM_TENENS_IND, S.INVISIBLE_PROVIDER_IND, S.TEMPORARY_PROVIDER_IND, S.PA_MEDICAID_IND, S.PP_ACA_ENHANCED_PAY_IND, S.HAS_MALPRACTICE_INSURANCE_IND, S.OWNERSHIP_STATUS_CODE, S.OWNERSHIP_STATUS_DESC, 'SQLSERVER', S.SOURCE_PROVIDER_NBR)
;`;

try 
    {
        var statement = snowflake.createStatement({sqlText: sql_command});
        var resultSet = statement.execute();
        resultSet.next();
        result = "Succeeded";
        result += "\n RowsInserted: " + resultSet.getColumnValueAsString("number of rows inserted");
        result += "\n RowsUpdated: " + resultSet.getColumnValueAsString("number of rows updated");
        result += "\n RowsDeleted: " + resultSet.getColumnValueAsString("number of rows deleted");
        
    }
catch (err)
    {
      result = "Failed: Code: " + err.code + "\n  State: " + err.state;
      result += "\n  Message: " + err.message;
      result += "\nStack Trace:\n" + err.stackTraceTxt;
      throw result;
    }
return result;
$$
;