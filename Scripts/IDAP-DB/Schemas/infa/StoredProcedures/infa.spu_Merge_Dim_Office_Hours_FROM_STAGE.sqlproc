CREATE OR REPLACE PROCEDURE INFA.SPU_MERGE_DIM_OFFICE_HOURS_FROM_STAGE()
RETURNS VARCHAR NOT NULL
language javascript
AS
$$
var result = "";
var sql_command = "";
sql_command += "MERGE INTO DIMDATA.DIM_OFFICE_HOURS AS T";
sql_command += " USING INFA.DIM_OFFICE_HOURS AS S";
sql_command += " ON (T.DIM_OFFICE_HOURS_KEY=S.DIM_OFFICE_HOURS_KEY)";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'D' THEN DELETE";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'U' THEN UPDATE";
sql_command += " SET T.MD5_VALUE_TEXT=S.MD5_VALUE_TEXT, T.INSERT_DATETIME=S.INSERT_DATETIME, T.LAST_UPDATED_DATETIME=S.LAST_UPDATED_DATETIME, T.IS_LOGICAL_DELETE_FLAG = S.IS_LOGICAL_DELETE_FLAG, T.MONDAY_OFFICE_HOURS = S.MONDAY_OFFICE_HOURS, T.TUESDAY_OFFICE_HOURS = S.TUESDAY_OFFICE_HOURS, T.WEDNESDAY_OFFICE_HOURS = S.WEDNESDAY_OFFICE_HOURS, T.THURSDAY_OFFICE_HOURS = S.THURSDAY_OFFICE_HOURS, T.FRIDAY_OFFICE_HOURS = S.FRIDAY_OFFICE_HOURS, T.SATURDAY_OFFICE_HOURS = S.SATURDAY_OFFICE_HOURS, T.SUNDAY_OFFICE_HOURS = S.SUNDAY_OFFICE_HOURS, T.OPEN_MONDAY_IND = S.OPEN_MONDAY_IND, T.OPEN_TUESDAY_IND = S.OPEN_TUESDAY_IND, T.OPEN_WEDNESDAY_IND = S.OPEN_WEDNESDAY_IND, T.OPEN_THURSDAY_IND = S.OPEN_THURSDAY_IND, T.OPEN_FRIDAY_IND = S.OPEN_FRIDAY_IND, T.OPEN_SATURDAY_IND = S.OPEN_SATURDAY_IND, T.OPEN_SUNDAY_IND = S.OPEN_SUNDAY_IND";
sql_command += " WHEN NOT MATCHED THEN INSERT";
sql_command += " (T.DIM_OFFICE_HOURS_KEY, T.MD5_VALUE_TEXT, T.INSERT_DATETIME, T.LAST_UPDATED_DATETIME, T.IS_LOGICAL_DELETE_FLAG, T.MONDAY_OFFICE_HOURS, T.TUESDAY_OFFICE_HOURS, T.WEDNESDAY_OFFICE_HOURS, T.THURSDAY_OFFICE_HOURS, T.FRIDAY_OFFICE_HOURS, T.SATURDAY_OFFICE_HOURS, T.SUNDAY_OFFICE_HOURS, T.OPEN_MONDAY_IND, T.OPEN_TUESDAY_IND, T.OPEN_WEDNESDAY_IND, T.OPEN_THURSDAY_IND, T.OPEN_FRIDAY_IND, T.OPEN_SATURDAY_IND, T.OPEN_SUNDAY_IND)";
sql_command += " VALUES";
sql_command += " (S.DIM_OFFICE_HOURS_KEY, S.MD5_VALUE_TEXT, S.INSERT_DATETIME, S.LAST_UPDATED_DATETIME, S.IS_LOGICAL_DELETE_FLAG, S.MONDAY_OFFICE_HOURS, S.TUESDAY_OFFICE_HOURS, S.WEDNESDAY_OFFICE_HOURS, S.THURSDAY_OFFICE_HOURS, S.FRIDAY_OFFICE_HOURS, S.SATURDAY_OFFICE_HOURS, S.SUNDAY_OFFICE_HOURS, S.OPEN_MONDAY_IND, S.OPEN_TUESDAY_IND, S.OPEN_WEDNESDAY_IND, S.OPEN_THURSDAY_IND, S.OPEN_FRIDAY_IND, S.OPEN_SATURDAY_IND, S.OPEN_SUNDAY_IND)";

try 
    {
        var statement = snowflake.createStatement({sqlText: sql_command});
        var resultSet = statement.execute();
        resultSet.next();
        result = "Succeeded";
        result += "\n RowsInserted: " + resultSet.getColumnValueAsString("number of rows inserted");
        result += "\n RowsUpdated: " + resultSet.getColumnValueAsString("number of rows updated");
        result += "\n RowsDeleted: " + resultSet.getColumnValueAsString("number of rows deleted");
        
    }
catch (err)
    {
      result = "Failed: Code: " + err.code + "\n  State: " + err.state;
      result += "\n  Message: " + err.message;
      result += "\nStack Trace:\n" + err.stackTraceTxt;
      throw result;
    }
return result;
$$
;