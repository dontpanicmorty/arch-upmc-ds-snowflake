CREATE OR REPLACE PROCEDURE INFA.SPU_MERGE_DIM_SALES_CHANNEL_FROM_STAGE()
RETURNS VARCHAR NOT NULL
language javascript
AS
$$
var result = "";
var sql_command = "";
sql_command += "MERGE INTO DIMDATA.DIM_SALES_CHANNEL AS T";
sql_command += " USING INFA.DIM_SALES_CHANNEL AS S";
sql_command += " ON (T.DIM_SALES_CHANNEL_KEY=S.DIM_SALES_CHANNEL_KEY)";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'D' THEN DELETE";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'U' THEN UPDATE";
sql_command += " SET T.MD5_VALUE_TEXT=S.MD5_VALUE_TEXT, T.INSERT_DATETIME=S.INSERT_DATETIME, T.LAST_UPDATED_DATETIME=S.LAST_UPDATED_DATETIME, T.CHANNEL_ID = S.CHANNEL_ID, T.CHANNEL_NAME = S.CHANNEL_NAME, T.SUB_CHANNEL_NAME = S.SUB_CHANNEL_NAME";
sql_command += " WHEN NOT MATCHED THEN INSERT";
sql_command += " (T.DIM_SALES_CHANNEL_KEY, T.MD5_VALUE_TEXT, T.INSERT_DATETIME, T.LAST_UPDATED_DATETIME, T.CHANNEL_ID, T.CHANNEL_NAME, T.SUB_CHANNEL_NAME)";
sql_command += " VALUES";
sql_command += " (S.DIM_SALES_CHANNEL_KEY, S.MD5_VALUE_TEXT, S.INSERT_DATETIME, S.LAST_UPDATED_DATETIME, S.CHANNEL_ID, S.CHANNEL_NAME, S.SUB_CHANNEL_NAME)";

try 
    {
        var statement = snowflake.createStatement({sqlText: sql_command});
        var resultSet = statement.execute();
        resultSet.next();
        result = "Succeeded";
        result += "\n RowsInserted: " + resultSet.getColumnValueAsString("number of rows inserted");
        result += "\n RowsUpdated: " + resultSet.getColumnValueAsString("number of rows updated");
        result += "\n RowsDeleted: " + resultSet.getColumnValueAsString("number of rows deleted");
        
    }
catch (err)
    {
      result = "Failed: Code: " + err.code + "\n  State: " + err.state;
      result += "\n  Message: " + err.message;
      result += "\nStack Trace:\n" + err.stackTraceTxt;
      throw result;
    }
return result;
$$
;