CREATE OR REPLACE PROCEDURE INFA.SPU_MERGE_DIM_PROVIDER_CERTIFICATION_FROM_STAGE()
RETURNS VARCHAR NOT NULL
language javascript
AS
$$
var result = "";
var sql_command = "";
sql_command += "MERGE INTO DIMDATA.DIM_PROVIDER_CERTIFICATION AS T";
sql_command += " USING INFA.DIM_PROVIDER_CERTIFICATION AS S";
sql_command += " ON (T.DIM_PROVIDER_CERTIFICATION_KEY=S.DIM_PROVIDER_CERTIFICATION_KEY)";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'D' THEN DELETE";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'U' THEN UPDATE";
sql_command += " SET T.MD5_VALUE_TEXT=S.MD5_VALUE_TEXT, T.INSERT_DATETIME=S.INSERT_DATETIME, T.LAST_UPDATED_DATETIME=S.LAST_UPDATED_DATETIME, T.IS_LOGICAL_DELETE_FLAG = S.IS_LOGICAL_DELETE_FLAG, T.DIM_PROVIDER_KEY = S.DIM_PROVIDER_KEY, T.CERTIFICATION_TYPE_DESC = S.CERTIFICATION_TYPE_DESC, T.CERTIFICATION_NAME = S.CERTIFICATION_NAME, T.CERTIFICATION_NBR = S.CERTIFICATION_NBR, T.CERTIFICATION_STATE_ABBREV_NAME = S.CERTIFICATION_STATE_ABBREV_NAME, T.CERTIFICATION_STATE_FULL_NAME = S.CERTIFICATION_STATE_FULL_NAME, T.CERTIFICATION_START_DATE = S.CERTIFICATION_START_DATE, T.CERTIFICATION_END_DATE = S.CERTIFICATION_END_DATE, T.RECERTIFICATION_DATE = S.RECERTIFICATION_DATE, T.CERTIFICATION_VERIFICATION_DATE = S.CERTIFICATION_VERIFICATION_DATE, T.CERTIFICATION_STATUS_CODE = S.CERTIFICATION_STATUS_CODE, T.CERTIFICATION_STATUS_DESC = S.CERTIFICATION_STATUS_DESC, T.CERTIFICATION_ACTIVE_IND = S.CERTIFICATION_ACTIVE_IND, T.LIFETIME_CERTIFICATION_IND = S.LIFETIME_CERTIFICATION_IND";
sql_command += " WHEN NOT MATCHED THEN INSERT";
sql_command += " (T.DIM_PROVIDER_CERTIFICATION_KEY, T.MD5_VALUE_TEXT, T.INSERT_DATETIME, T.LAST_UPDATED_DATETIME, T.IS_LOGICAL_DELETE_FLAG, T.DIM_PROVIDER_KEY, T.CERTIFICATION_TYPE_DESC, T.CERTIFICATION_NAME, T.CERTIFICATION_NBR, T.CERTIFICATION_STATE_ABBREV_NAME, T.CERTIFICATION_STATE_FULL_NAME, T.CERTIFICATION_START_DATE, T.CERTIFICATION_END_DATE, T.RECERTIFICATION_DATE, T.CERTIFICATION_VERIFICATION_DATE, T.CERTIFICATION_STATUS_CODE, T.CERTIFICATION_STATUS_DESC, T.CERTIFICATION_ACTIVE_IND, T.LIFETIME_CERTIFICATION_IND)";
sql_command += " VALUES";
sql_command += " (S.DIM_PROVIDER_CERTIFICATION_KEY, S.MD5_VALUE_TEXT, S.INSERT_DATETIME, S.LAST_UPDATED_DATETIME, S.IS_LOGICAL_DELETE_FLAG, S.DIM_PROVIDER_KEY, S.CERTIFICATION_TYPE_DESC, S.CERTIFICATION_NAME, S.CERTIFICATION_NBR, S.CERTIFICATION_STATE_ABBREV_NAME, S.CERTIFICATION_STATE_FULL_NAME, S.CERTIFICATION_START_DATE, S.CERTIFICATION_END_DATE, S.RECERTIFICATION_DATE, S.CERTIFICATION_VERIFICATION_DATE, S.CERTIFICATION_STATUS_CODE, S.CERTIFICATION_STATUS_DESC, S.CERTIFICATION_ACTIVE_IND, S.LIFETIME_CERTIFICATION_IND)";

try 
    {
        var statement = snowflake.createStatement({sqlText: sql_command});
        var resultSet = statement.execute();
        resultSet.next();
        result = "Succeeded";
        result += "\n RowsInserted: " + resultSet.getColumnValueAsString("number of rows inserted");
        result += "\n RowsUpdated: " + resultSet.getColumnValueAsString("number of rows updated");
        result += "\n RowsDeleted: " + resultSet.getColumnValueAsString("number of rows deleted");
        
    }
catch (err)
    {
      result = "Failed: Code: " + err.code + "\n  State: " + err.state;
      result += "\n  Message: " + err.message;
      result += "\nStack Trace:\n" + err.stackTraceTxt;
      throw result;
    }
return result;
$$
;