CREATE OR REPLACE PROCEDURE INFA.SPU_MERGE_PROVIDER_SPECIALTY_GROUPING_FROM_STAGE()
RETURNS VARCHAR NOT NULL
language javascript
AS
$$
var result = "";
var sql_command =
`MERGE INTO DIMDATA.PROVIDER_SPECIALTY_GROUPING AS T
    USING INFA.PROVIDER_SPECIALTY_GROUPING AS S
        ON (T.PROVIDER_SPECIALTY_GROUPING_KEY=S.PROVIDER_SPECIALTY_GROUPING_KEY)
WHEN MATCHED AND S.CONVERT_IND = 'D'
    THEN DELETE
WHEN MATCHED AND S.CONVERT_IND = 'U'
    THEN UPDATE
    SET T.MD5_VALUE_TEXT=S.MD5_VALUE_TEXT, T.INSERT_DATETIME=S.INSERT_DATETIME, T.LAST_UPDATED_DATETIME=S.LAST_UPDATED_DATETIME, T.IS_LOGICAL_DELETE_FLAG = S.IS_LOGICAL_DELETE_FLAG, T.SPECIALTY_GROUPING_LIST = S.SPECIALTY_GROUPING_LIST, T.SPECIALTY_CARE_TYPE_CODE = S.SPECIALTY_CARE_TYPE_CODE, T.CARE_TYPE_DESC = S.CARE_TYPE_DESC
WHEN NOT MATCHED THEN INSERT
    (T.PROVIDER_SPECIALTY_GROUPING_KEY, T.MD5_VALUE_TEXT, T.INSERT_DATETIME, T.LAST_UPDATED_DATETIME, T.IS_LOGICAL_DELETE_FLAG, T.SPECIALTY_GROUPING_LIST, T.SPECIALTY_CARE_TYPE_CODE, T.CARE_TYPE_DESC)
VALUES
    (S.PROVIDER_SPECIALTY_GROUPING_KEY, S.MD5_VALUE_TEXT, S.INSERT_DATETIME, S.LAST_UPDATED_DATETIME, S.IS_LOGICAL_DELETE_FLAG, S.SPECIALTY_GROUPING_LIST, S.SPECIALTY_CARE_TYPE_CODE, S.CARE_TYPE_DESC)
;`;    

try 
    {
        var statement = snowflake.createStatement({sqlText: sql_command});
        var resultSet = statement.execute();
        resultSet.next();
        result = "Succeeded";
        result += "\n RowsInserted: " + resultSet.getColumnValueAsString("number of rows inserted");
        result += "\n RowsUpdated: " + resultSet.getColumnValueAsString("number of rows updated");
        result += "\n RowsDeleted: " + resultSet.getColumnValueAsString("number of rows deleted");
        
    }
catch (err)
    {
      result = "Failed: Code: " + err.code + "\n  State: " + err.state;
      result += "\n  Message: " + err.message;
      result += "\nStack Trace:\n" + err.stackTraceTxt;
      throw result;
    }
return result;
$$
;