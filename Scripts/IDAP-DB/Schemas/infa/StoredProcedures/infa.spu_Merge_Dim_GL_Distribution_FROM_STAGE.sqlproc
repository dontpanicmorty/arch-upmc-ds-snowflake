CREATE OR REPLACE PROCEDURE INFA.SPU_MERGE_DIM_GL_DISTRIBUTION_FROM_STAGE()
RETURNS VARCHAR NOT NULL
language javascript
AS
$$
var result = "";
var sql_command = "";
sql_command += "MERGE INTO DIMDATA.DIM_GL_DISTRIBUTION AS T";
sql_command += " USING INFA.DIM_GL_DISTRIBUTION AS S";
sql_command += " ON (T.DIM_GL_DISTRIBUTION_KEY=S.DIM_GL_DISTRIBUTION_KEY)";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'D' THEN DELETE";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'U' THEN UPDATE";
sql_command += " SET T.MD5_VALUE_TEXT=S.MD5_VALUE_TEXT, T.INSERT_DATETIME=S.INSERT_DATETIME, T.LAST_UPDATED_DATETIME=S.LAST_UPDATED_DATETIME, T.TPA_CLIENT_ID = S.TPA_CLIENT_ID, T.TPA_ID = S.TPA_ID, T.TPA_DIV_ID = S.TPA_DIV_ID, T.GL_DISTRIBUTION_CODE = S.GL_DISTRIBUTION_CODE, T.GL_DISTRIBUTION_DESC = S.GL_DISTRIBUTION_DESC, T.COMPANY_CODE = S.COMPANY_CODE, T.FINANCE_BUSINESS_UNIT_DESC = S.FINANCE_BUSINESS_UNIT_DESC, T.FINANCE_PRODUCT_CODE = S.FINANCE_PRODUCT_CODE, T.FINANCE_PRODUCT_DESC =S.FINANCE_PRODUCT_DESC, T.FINANCE_COST_CENTER_NAME = S.FINANCE_COST_CENTER_NAME, T.CREDIT_GL_NBR = S.CREDIT_GL_NBR, T.DEBIT_GL_NBR = S.DEBIT_GL_NBR, T.SECONDARY_CREDIT_GL_NBR =S.SECONDARY_CREDIT_GL_NBR, T.SECONDARY_DEBIT_GL_NBR = S.SECONDARY_DEBIT_GL_NBR, T.DISCOUNT_GL_NBR = S.DISCOUNT_GL_NBR, T.DISCOUNT_OFFSET_GL_NBR =S.DISCOUNT_OFFSET_GL_NBR, T.INTEREST_GL_NBR = S.INTEREST_GL_NBR, T.INTEREST_OFFSET_GL_NBR = S.INTEREST_OFFSET_GL_NBR, T.FINANCE_LOB_DESC = S.FINANCE_LOB_DESC";
sql_command += " WHEN NOT MATCHED THEN INSERT";
sql_command += " (T.DIM_GL_DISTRIBUTION_KEY, T.MD5_VALUE_TEXT, T.INSERT_DATETIME, T.LAST_UPDATED_DATETIME, T.TPA_CLIENT_ID, T.TPA_ID, T.TPA_DIV_ID, T.GL_DISTRIBUTION_CODE, T.GL_DISTRIBUTION_DESC, T.COMPANY_CODE, T.FINANCE_BUSINESS_UNIT_DESC, T.FINANCE_PRODUCT_CODE, T.FINANCE_PRODUCT_DESC, T.FINANCE_COST_CENTER_NAME, T.CREDIT_GL_NBR, T.DEBIT_GL_NBR, T.SECONDARY_CREDIT_GL_NBR, T.SECONDARY_DEBIT_GL_NBR, T.DISCOUNT_GL_NBR, T.DISCOUNT_OFFSET_GL_NBR, T.INTEREST_GL_NBR, T.INTEREST_OFFSET_GL_NBR, T.FINANCE_LOB_DESC)";
sql_command += " VALUES";
sql_command += " (S.DIM_GL_DISTRIBUTION_KEY, S.MD5_VALUE_TEXT, S.INSERT_DATETIME, S.LAST_UPDATED_DATETIME, S.TPA_CLIENT_ID, S.TPA_ID, S.TPA_DIV_ID, S.GL_DISTRIBUTION_CODE, S.GL_DISTRIBUTION_DESC, S.COMPANY_CODE, S.FINANCE_BUSINESS_UNIT_DESC, S.FINANCE_PRODUCT_CODE, S.FINANCE_PRODUCT_DESC, S.FINANCE_COST_CENTER_NAME, S.CREDIT_GL_NBR, S.DEBIT_GL_NBR, S.SECONDARY_CREDIT_GL_NBR, S.SECONDARY_DEBIT_GL_NBR, S.DISCOUNT_GL_NBR, S.DISCOUNT_OFFSET_GL_NBR, S.INTEREST_GL_NBR, S.INTEREST_OFFSET_GL_NBR, S.FINANCE_LOB_DESC);";

try 
    {
        var statement = snowflake.createStatement({sqlText: sql_command});
        var resultSet = statement.execute();
        resultSet.next();
        result = "Succeeded";
        result += "\n RowsInserted: " + resultSet.getColumnValueAsString("number of rows inserted");
        result += "\n RowsUpdated: " + resultSet.getColumnValueAsString("number of rows updated");
        result += "\n RowsDeleted: " + resultSet.getColumnValueAsString("number of rows deleted");
        
    }
catch (err)
    {
      result = "Failed: Code: " + err.code + "\n  State: " + err.state;
      result += "\n  Message: " + err.message;
      result += "\nStack Trace:\n" + err.stackTraceTxt;
      throw result;
    }
return result;
$$
;	