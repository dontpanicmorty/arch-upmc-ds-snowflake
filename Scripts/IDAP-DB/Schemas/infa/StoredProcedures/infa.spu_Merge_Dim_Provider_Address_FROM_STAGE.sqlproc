CREATE OR REPLACE PROCEDURE INFA.SPU_MERGE_DIM_PROVIDER_ADDRESS_FROM_STAGE()
RETURNS VARCHAR NOT NULL
language javascript
AS
$$
var result = "";
var sql_command =
`MERGE INTO DIMDATA.DIM_PROVIDER_ADDRESS AS T
    USING INFA.DIM_PROVIDER_ADDRESS AS S
        ON (T.DIM_PROVIDER_ADDRESS_KEY=S.DIM_PROVIDER_ADDRESS_KEY)
 WHEN MATCHED AND S.CONVERT_IND = 'D'
    THEN DELETE
 WHEN MATCHED AND S.CONVERT_IND = 'U'
    THEN UPDATE
    SET T.MD5_VALUE_TEXT=S.MD5_VALUE_TEXT
    , T.INSERT_DATETIME=S.INSERT_DATETIME
    , T.LAST_UPDATED_DATETIME=S.LAST_UPDATED_DATETIME
    , T.IS_LOGICAL_DELETE_FLAG = S.IS_LOGICAL_DELETE_FLAG
    , T.TPA_CLIENT_ID = S.TPA_CLIENT_ID
    , T.TPA_ID = S.TPA_ID
    , T.TPA_DIVISION_ID = S.TPA_DIVISION_ID
    , T.PROVIDER_ADDRESS_TYPE_CODE = S.PROVIDER_ADDRESS_TYPE_CODE
    , T.PROVIDER_ADDRESS_TYPE_DESC = S.PROVIDER_ADDRESS_TYPE_DESC
    , T.PROVIDER_OFFICE_ID = S.PROVIDER_OFFICE_ID
    , T.PROVIDER_OFFICE_NAME = S.PROVIDER_OFFICE_NAME
    , T.PROVIDER_FULL_ADDRESS_FORMATTED = S.PROVIDER_FULL_ADDRESS_FORMATTED
    , T.PROVIDER_ADDRESS_LINE1_TEXT = S.PROVIDER_ADDRESS_LINE1_TEXT
    , T.PROVIDER_ADDRESS_LINE2_TEXT = S.PROVIDER_ADDRESS_LINE2_TEXT
    , T.PROVIDER_CITY_NAME = S.PROVIDER_CITY_NAME
    , T.PROVIDER_STATE_ABBREV_NAME = S.PROVIDER_STATE_ABBREV_NAME
    , T.PROVIDER_STATE_FULL_NAME = S.PROVIDER_STATE_FULL_NAME
    , T.PROVIDER_COUNTY_NAME = S.PROVIDER_COUNTY_NAME
    , T.PROVIDER_COUNTRY_NAME = S.PROVIDER_COUNTRY_NAME
    , T.PROVIDER_COUNTRY_ISO2 = S.PROVIDER_COUNTRY_ISO2
    , T.PROVIDER_COUNTRY_ISO3 = S.PROVIDER_COUNTRY_ISO3
    , T.PROVIDER_ZIP_CODE_NBR = S.PROVIDER_ZIP_CODE_NBR
    , T.PROVIDER_LATITUDE_NBR = S.PROVIDER_LATITUDE_NBR
    , T.PROVIDER_LONGITUDE_NBR = S.PROVIDER_LONGITUDE_NBR
    , T.PROVIDER_OFFICE_MANAGER_NAME = S.PROVIDER_OFFICE_MANAGER_NAME
    , T.HANDICAP_ACCESS_IND = S.HANDICAP_ACCESS_IND
    , T.TELE_HEALTH_IND = S.TELE_HEALTH_IND
    , T.RECEIVES_MAIL_IND = S.RECEIVES_MAIL_IND
    , T.E_PRESCRIBE_IND = S.E_PRESCRIBE_IND
    , T.MA_SUPER_PCP_IND = S.MA_SUPER_PCP_IND
    , T.EMR_SYSTEM_NAME = S.EMR_SYSTEM_NAME
 WHEN NOT MATCHED THEN INSERT
    (T.DIM_PROVIDER_ADDRESS_KEY, T.MD5_VALUE_TEXT, T.INSERT_DATETIME, T.LAST_UPDATED_DATETIME, T.IS_LOGICAL_DELETE_FLAG, T.TPA_CLIENT_ID, T.TPA_ID, T.TPA_DIVISION_ID, T.PROVIDER_ADDRESS_TYPE_CODE, T.PROVIDER_ADDRESS_TYPE_DESC, T.PROVIDER_OFFICE_ID, T.PROVIDER_OFFICE_NAME, T.PROVIDER_FULL_ADDRESS_FORMATTED , T.PROVIDER_ADDRESS_LINE1_TEXT, T.PROVIDER_ADDRESS_LINE2_TEXT, T.PROVIDER_CITY_NAME, T.PROVIDER_STATE_ABBREV_NAME, T.PROVIDER_STATE_FULL_NAME, T.PROVIDER_COUNTY_NAME, T.PROVIDER_COUNTRY_NAME, T.PROVIDER_COUNTRY_ISO2, T.PROVIDER_COUNTRY_ISO3, T.PROVIDER_ZIP_CODE_NBR, T.PROVIDER_LATITUDE_NBR, T.PROVIDER_LONGITUDE_NBR, T.PROVIDER_OFFICE_MANAGER_NAME, T.HANDICAP_ACCESS_IND, T.TELE_HEALTH_IND, T.RECEIVES_MAIL_IND, T.E_PRESCRIBE_IND, T.MA_SUPER_PCP_IND, T.EMR_SYSTEM_NAME)
 VALUES
    (S.DIM_PROVIDER_ADDRESS_KEY, S.MD5_VALUE_TEXT, S.INSERT_DATETIME, S.LAST_UPDATED_DATETIME, S.IS_LOGICAL_DELETE_FLAG, S.TPA_CLIENT_ID, S.TPA_ID, S.TPA_DIVISION_ID, S.PROVIDER_ADDRESS_TYPE_CODE, S.PROVIDER_ADDRESS_TYPE_DESC, S.PROVIDER_OFFICE_ID, S.PROVIDER_OFFICE_NAME, S.PROVIDER_FULL_ADDRESS_FORMATTED , S.PROVIDER_ADDRESS_LINE1_TEXT, S.PROVIDER_ADDRESS_LINE2_TEXT, S.PROVIDER_CITY_NAME, S.PROVIDER_STATE_ABBREV_NAME, S.PROVIDER_STATE_FULL_NAME, S.PROVIDER_COUNTY_NAME, S.PROVIDER_COUNTRY_NAME, S.PROVIDER_COUNTRY_ISO2, S.PROVIDER_COUNTRY_ISO3, S.PROVIDER_ZIP_CODE_NBR, S.PROVIDER_LATITUDE_NBR, S.PROVIDER_LONGITUDE_NBR, S.PROVIDER_OFFICE_MANAGER_NAME, S.HANDICAP_ACCESS_IND, S.TELE_HEALTH_IND, S.RECEIVES_MAIL_IND, S.E_PRESCRIBE_IND, S.MA_SUPER_PCP_IND, S.EMR_SYSTEM_NAME)
;`;

try 
    {
        var statement = snowflake.createStatement({sqlText: sql_command});
        var resultSet = statement.execute();
        resultSet.next();
        result = "Succeeded";
        result += "\n RowsInserted: " + resultSet.getColumnValueAsString("number of rows inserted");
        result += "\n RowsUpdated: " + resultSet.getColumnValueAsString("number of rows updated");
        result += "\n RowsDeleted: " + resultSet.getColumnValueAsString("number of rows deleted");
        
    }
catch (err)
    {
      result = "Failed: Code: " + err.code + "\n  State: " + err.state;
      result += "\n  Message: " + err.message;
      result += "\nStack Trace:\n" + err.stackTraceTxt;
      throw result;
    }
return result;
$$
;