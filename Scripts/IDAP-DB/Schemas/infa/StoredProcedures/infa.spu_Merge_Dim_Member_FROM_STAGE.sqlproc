CREATE OR REPLACE PROCEDURE INFA.SPU_MERGE_DIM_MEMBER_FROM_STAGE()
RETURNS VARCHAR NOT NULL
language javascript
AS
$$
var result = "";
var sql_command = "";
sql_command += "MERGE INTO DIMDATA.DIM_MEMBER AS T";
sql_command += " USING INFA.DIM_MEMBER AS S";
sql_command += " ON (T.DIM_MEMBER_KEY=S.DIM_MEMBER_KEY)";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'D' THEN DELETE";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'U' THEN UPDATE";
sql_command += " SET T.MD5_VALUE_TEXT=S.MD5_VALUE_TEXT, T.INSERT_DATETIME=S.INSERT_DATETIME, T.LAST_UPDATED_DATETIME=S.LAST_UPDATED_DATETIME, T.TPA_CLIENT_ID=S.TPA_CLIENT_ID, T.TPA_ID=S.TPA_ID, T.TPA_DIV_ID=S.TPA_DIV_ID, T.MEMBER_NBR=S.MEMBER_NBR, T.MASTER_MEMBER_ID=S.MASTER_MEMBER_ID, T.MEMBER_FULL_NAME=S.MEMBER_FULL_NAME, T.MEMBER_LAST_NAME=S.MEMBER_LAST_NAME, T.MEMBER_FIRST_NAME=S.MEMBER_FIRST_NAME, T.MEMBER_BIRTH_DATE=S.MEMBER_BIRTH_DATE, T.GENDER_CODE=S.GENDER_CODE, T.SUBSCRIBER_RELATIONSHIP_CODE=S.SUBSCRIBER_RELATIONSHIP_CODE, T.SUBSCRIBER_RELATIONSHIP_DESC=S.SUBSCRIBER_RELATIONSHIP_DESC, T.MEMBER_ADDED_DATE=S.MEMBER_ADDED_DATE, T.MEMBER_DEATH_DATE=S.MEMBER_DEATH_DATE, T.MEMBER_MIDDLE_NAME=S.MEMBER_MIDDLE_NAME, T.SUBSCRIBER_RELATIONSHIP_TYPE_CODE=S.SUBSCRIBER_RELATIONSHIP_TYPE_CODE, T.SUB_SOURCE_NAME=S.SUB_SOURCE_NAME, T.RESTRICTED_MEMBER_IND=S.RESTRICTED_MEMBER_IND, T.PRIVACY_RESTRICTION_IND=S.PRIVACY_RESTRICTION_IND, T.PRIVACY_ALERT_IND=S.PRIVACY_ALERT_IND, T.FINANCE_REPORTING_REGION=S.FINANCE_REPORTING_REGION, T.SOCIAL_SECURITY_NBR=S.SOCIAL_SECURITY_NBR, T.EMPI_NBR=S.EMPI_NBR, T.CURRENT_CHCSNP_ALIGNMENT_DESC=S.CURRENT_CHCSNP_ALIGNMENT_DESC, T.RESPONSIBLE_PARTY_NAME=S.RESPONSIBLE_PARTY_NAME, T.RECIPIENT_ID=S.RECIPIENT_ID, T.MEDICAID_ID=S.MEDICAID_ID, T.EPIC_MR_NBR=S.EPIC_MR_NBR,T.EPIC_ENT_ID=S.EPIC_ENT_ID, T.MEDIPAC_MR_NBR=S.MEDIPAC_MR_NBR, T.PART_D_RISK_FACTOR=S.PART_D_RISK_FACTOR, T.SECONDARY_MEMBER_IDENTIFIER_TEXT=S.SECONDARY_MEMBER_IDENTIFIER_TEXT, T.TERTIARY_MEMBER_IDENTIFIER_TEXT=S.TERTIARY_MEMBER_IDENTIFIER_TEXT, T.SUBSCRIBER_NBR=S.SUBSCRIBER_NBR, T.PERSON_NBR=S.PERSON_NBR, T.MEMBER_SALUTORY_NAME=S.MEMBER_SALUTORY_NAME, T.CURRENT_ELIG_STATUS_CODE01=S.CURRENT_ELIG_STATUS_CODE01, T.CURRENT_ELIG_STATUS_CODE02=S.CURRENT_ELIG_STATUS_CODE02, T.CURRENT_ELIG_STATUS_DESC01=S.CURRENT_ELIG_STATUS_DESC01, T.CURRENT_ELIG_STATUS_DESC02=S.CURRENT_ELIG_STATUS_DESC02, T.PREGNANCY_DUE_DATE=S.PREGNANCY_DUE_DATE, T.HIC_NBR=S.HIC_NBR, T.CURRENT_CHRONIC_CONDITION_CNT=S.CURRENT_CHRONIC_CONDITION_CNT, T.RACE_DESC=S.RACE_DESC, T.MEMBER_DPW_COUNTY_CODE=S.MEMBER_DPW_COUNTY_CODE, T.MEMBER_DPW_COUNTY_DESC=S.MEMBER_DPW_COUNTY_DESC, T.SELECTED_PCP_DIM_PROVIDER_KEY=S.SELECTED_PCP_DIM_PROVIDER_KEY, T.SELECTED_PCP_DIM_PROVIDER_ADDRESS_KEY=S.SELECTED_PCP_DIM_PROVIDER_ADDRESS_KEY, T.IMPUTED_PCP_DIM_PROVIDER_KEY=S.IMPUTED_PCP_DIM_PROVIDER_KEY, T.IMPUTED_PCP_DIM_PROVIDER_ADDRESS_KEY=S.IMPUTED_PCP_DIM_PROVIDER_ADDRESS_KEY, T.CLAIMS_SHARING_DESC=S.CLAIMS_SHARING_DESC";
sql_command += " WHEN NOT MATCHED THEN INSERT";
sql_command += " (T.DIM_MEMBER_KEY, MD5_VALUE_TEXT, INSERT_DATETIME, LAST_UPDATED_DATETIME, TPA_CLIENT_ID, TPA_ID, TPA_DIV_ID, MEMBER_NBR, MASTER_MEMBER_ID, MEMBER_FULL_NAME, MEMBER_LAST_NAME, MEMBER_FIRST_NAME, MEMBER_BIRTH_DATE, GENDER_CODE, SUBSCRIBER_RELATIONSHIP_CODE, SUBSCRIBER_RELATIONSHIP_DESC, MEMBER_ADDED_DATE, MEMBER_DEATH_DATE, MEMBER_MIDDLE_NAME, SUBSCRIBER_RELATIONSHIP_TYPE_CODE, SUB_SOURCE_NAME, RESTRICTED_MEMBER_IND, PRIVACY_RESTRICTION_IND, PRIVACY_ALERT_IND, FINANCE_REPORTING_REGION, SOCIAL_SECURITY_NBR, EMPI_NBR, CURRENT_CHCSNP_ALIGNMENT_DESC, RESPONSIBLE_PARTY_NAME, RECIPIENT_ID, MEDICAID_ID, EPIC_MR_NBR,EPIC_ENT_ID, MEDIPAC_MR_NBR, PART_D_RISK_FACTOR, SECONDARY_MEMBER_IDENTIFIER_TEXT, TERTIARY_MEMBER_IDENTIFIER_TEXT, SUBSCRIBER_NBR, PERSON_NBR, MEMBER_SALUTORY_NAME, CURRENT_ELIG_STATUS_CODE01, CURRENT_ELIG_STATUS_CODE02, CURRENT_ELIG_STATUS_DESC01, CURRENT_ELIG_STATUS_DESC02, PREGNANCY_DUE_DATE, HIC_NBR, CURRENT_CHRONIC_CONDITION_CNT, RACE_DESC, MEMBER_DPW_COUNTY_CODE, MEMBER_DPW_COUNTY_DESC, SELECTED_PCP_DIM_PROVIDER_KEY, SELECTED_PCP_DIM_PROVIDER_ADDRESS_KEY, IMPUTED_PCP_DIM_PROVIDER_KEY, IMPUTED_PCP_DIM_PROVIDER_ADDRESS_KEY, CLAIMS_SHARING_DESC)";
sql_command += " VALUES";
sql_command += " (S.DIM_MEMBER_KEY, S.MD5_VALUE_TEXT, S.INSERT_DATETIME, S.LAST_UPDATED_DATETIME, S.TPA_CLIENT_ID, S.TPA_ID, S.TPA_DIV_ID, S.MEMBER_NBR, S.MASTER_MEMBER_ID, S.MEMBER_FULL_NAME, S.MEMBER_LAST_NAME, S.MEMBER_FIRST_NAME, S.MEMBER_BIRTH_DATE, S.GENDER_CODE, S.SUBSCRIBER_RELATIONSHIP_CODE, S.SUBSCRIBER_RELATIONSHIP_DESC, S.MEMBER_ADDED_DATE, S.MEMBER_DEATH_DATE, S.MEMBER_MIDDLE_NAME, S.SUBSCRIBER_RELATIONSHIP_TYPE_CODE, S.SUB_SOURCE_NAME, S.RESTRICTED_MEMBER_IND, S.PRIVACY_RESTRICTION_IND, S.PRIVACY_ALERT_IND, S.FINANCE_REPORTING_REGION, S.SOCIAL_SECURITY_NBR, S.EMPI_NBR, S.CURRENT_CHCSNP_ALIGNMENT_DESC, S.RESPONSIBLE_PARTY_NAME, S.RECIPIENT_ID, S.MEDICAID_ID, S.EPIC_MR_NBR, S.EPIC_ENT_ID, S.MEDIPAC_MR_NBR, S.PART_D_RISK_FACTOR, S.SECONDARY_MEMBER_IDENTIFIER_TEXT, S.TERTIARY_MEMBER_IDENTIFIER_TEXT, S.SUBSCRIBER_NBR, S.PERSON_NBR, S.MEMBER_SALUTORY_NAME, S.CURRENT_ELIG_STATUS_CODE01, S.CURRENT_ELIG_STATUS_CODE02, S.CURRENT_ELIG_STATUS_DESC01, S.CURRENT_ELIG_STATUS_DESC02, S.PREGNANCY_DUE_DATE, S.HIC_NBR, S.CURRENT_CHRONIC_CONDITION_CNT, S.RACE_DESC, S.MEMBER_DPW_COUNTY_CODE, S.MEMBER_DPW_COUNTY_DESC, S.SELECTED_PCP_DIM_PROVIDER_KEY, S.SELECTED_PCP_DIM_PROVIDER_ADDRESS_KEY, S.IMPUTED_PCP_DIM_PROVIDER_KEY, S.IMPUTED_PCP_DIM_PROVIDER_ADDRESS_KEY, S.CLAIMS_SHARING_DESC);";

try 
    {
        var statement = snowflake.createStatement({sqlText: sql_command});
        var resultSet = statement.execute();
        resultSet.next();
        result = "Succeeded";
        result += "\n RowsInserted: " + resultSet.getColumnValueAsString("number of rows inserted");
        result += "\n RowsUpdated: " + resultSet.getColumnValueAsString("number of rows updated");
        result += "\n RowsDeleted: " + resultSet.getColumnValueAsString("number of rows deleted");
        
    }
catch (err)
    {
      result = "Failed: Code: " + err.code + "\n  State: " + err.state;
      result += "\n  Message: " + err.message;
      result += "\nStack Trace:\n" + err.stackTraceTxt;
      throw result;
    }
return result;
$$
;