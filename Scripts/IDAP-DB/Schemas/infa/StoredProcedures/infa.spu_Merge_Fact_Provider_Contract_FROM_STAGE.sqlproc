CREATE OR REPLACE PROCEDURE INFA.SPU_MERGE_FACT_PROVIDER_CONTRACT_FROM_STAGE()
RETURNS VARCHAR NOT NULL
language javascript
AS
$$
var result = "";
var sql_command =
`MERGE INTO DIMDATA.FACT_PROVIDER_CONTRACT AS T
    USING INFA.FACT_PROVIDER_CONTRACT AS S
        ON (T.FACT_PROVIDER_CONTRACT_KEY=S.FACT_PROVIDER_CONTRACT_KEY)
WHEN MATCHED AND S.CONVERT_IND = 'D'
    THEN DELETE
WHEN MATCHED AND S.CONVERT_IND = 'U'
    THEN UPDATE
    SET T.MD5_VALUE_TEXT=S.MD5_VALUE_TEXT, T.INSERT_DATETIME=S.INSERT_DATETIME, T.LAST_UPDATED_DATETIME=S.LAST_UPDATED_DATETIME, T.IS_LOGICAL_DELETE_FLAG = S.IS_LOGICAL_DELETE_FLAG, T.DIM_TPA_HIERARCHY_KEY = S.DIM_TPA_HIERARCHY_KEY, T.DIM_PROVIDER_KEY = S.DIM_PROVIDER_KEY, T.DIM_PROVIDER_CONTRACT_KEY = S.DIM_PROVIDER_CONTRACT_KEY, T.DIM_PROVIDER_ADDRESS_KEY = S.DIM_PROVIDER_ADDRESS_KEY, T.PROVIDER_SPECIALTY_GROUPING_KEY = S.PROVIDER_SPECIALTY_GROUPING_KEY, T.DIM_PROVIDER_CONTRACT_ATTRIBUTE_KEY = S.DIM_PROVIDER_CONTRACT_ATTRIBUTE_KEY, T.DIM_PROVIDER_CONTACT_INFO_KEY = S.DIM_PROVIDER_CONTACT_INFO_KEY, T.DIM_OFFICE_HOURS_KEY = S.DIM_OFFICE_HOURS_KEY, T.OWNING_MEDICAL_GROUP_KEY = S.OWNING_MEDICAL_GROUP_KEY, T.CONTRACT_START_DATE_KEY = S.CONTRACT_START_DATE_KEY, T.CONTRACT_TERMINATION_DATE_KEY = S.CONTRACT_TERMINATION_DATE_KEY, T.ADDRESS_START_DATE_KEY = S.ADDRESS_START_DATE_KEY, T.ADDRESS_TERM_DATE_KEY = S.ADDRESS_TERM_DATE_KEY, T.CONTRACT_LEVEL_NAME = S.CONTRACT_LEVEL_NAME, T.CONTRACT_ACTIVE_IND = S.CONTRACT_ACTIVE_IND, T.ADDRESS_ACTIVE_IND = S.ADDRESS_ACTIVE_IND, T.SUPPRESSED_IN_DIRECTORY_IND = S.SUPPRESSED_IN_DIRECTORY_IND, T.CARE_TYPE_DESC = S.CARE_TYPE_DESC
WHEN NOT MATCHED THEN INSERT
 (T.FACT_PROVIDER_CONTRACT_KEY, T.MD5_VALUE_TEXT, T.INSERT_DATETIME, T.LAST_UPDATED_DATETIME, T.IS_LOGICAL_DELETE_FLAG , T.DIM_TPA_HIERARCHY_KEY, T.DIM_PROVIDER_KEY, T.DIM_PROVIDER_CONTRACT_KEY, T.DIM_PROVIDER_ADDRESS_KEY, T.PROVIDER_SPECIALTY_GROUPING_KEY , T.DIM_PROVIDER_CONTRACT_ATTRIBUTE_KEY, T.DIM_PROVIDER_CONTACT_INFO_KEY, T.DIM_OFFICE_HOURS_KEY, T.OWNING_MEDICAL_GROUP_KEY, T.CONTRACT_START_DATE_KEY, T.CONTRACT_TERMINATION_DATE_KEY, T.ADDRESS_START_DATE_KEY, T.ADDRESS_TERM_DATE_KEY, T.CONTRACT_LEVEL_NAME, T.CONTRACT_ACTIVE_IND, T.ADDRESS_ACTIVE_IND, T.SUPPRESSED_IN_DIRECTORY_IND, T.CARE_TYPE_DESC)
VALUES
 (S.FACT_PROVIDER_CONTRACT_KEY, S.MD5_VALUE_TEXT, S.INSERT_DATETIME, S.LAST_UPDATED_DATETIME, S.IS_LOGICAL_DELETE_FLAG , S.DIM_TPA_HIERARCHY_KEY, S.DIM_PROVIDER_KEY, S.DIM_PROVIDER_CONTRACT_KEY, S.DIM_PROVIDER_ADDRESS_KEY, S.PROVIDER_SPECIALTY_GROUPING_KEY , S.DIM_PROVIDER_CONTRACT_ATTRIBUTE_KEY, S.DIM_PROVIDER_CONTACT_INFO_KEY, S.DIM_OFFICE_HOURS_KEY, S.OWNING_MEDICAL_GROUP_KEY, S.CONTRACT_START_DATE_KEY, S.CONTRACT_TERMINATION_DATE_KEY, S.ADDRESS_START_DATE_KEY, S.ADDRESS_TERM_DATE_KEY, S.CONTRACT_LEVEL_NAME, S.CONTRACT_ACTIVE_IND, S.ADDRESS_ACTIVE_IND, S.SUPPRESSED_IN_DIRECTORY_IND, S.CARE_TYPE_DESC)
;`;

try 
    {
        var statement = snowflake.createStatement({sqlText: sql_command});
        var resultSet = statement.execute();
        resultSet.next();
        result = "Succeeded";
        result += "\n RowsInserted: " + resultSet.getColumnValueAsString("number of rows inserted");
        result += "\n RowsUpdated: " + resultSet.getColumnValueAsString("number of rows updated");
        result += "\n RowsDeleted: " + resultSet.getColumnValueAsString("number of rows deleted");
        
    }
catch (err)
    {
      result = "Failed: Code: " + err.code + "\n  State: " + err.state;
      result += "\n  Message: " + err.message;
      result += "\nStack Trace:\n" + err.stackTraceTxt;
      throw result;
    }
return result;
$$
;