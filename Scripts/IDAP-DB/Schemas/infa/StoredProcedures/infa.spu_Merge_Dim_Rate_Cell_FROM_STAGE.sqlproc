CREATE OR REPLACE PROCEDURE INFA.SPU_MERGE_DIM_RATE_CELL_FROM_STAGE()
RETURNS VARCHAR NOT NULL
language javascript
AS
$$
var result = "";
var sql_command = "";
sql_command += "MERGE INTO DIMDATA.DIM_RATE_CELL AS T";
sql_command += " USING INFA.DIM_RATE_CELL AS S";
sql_command += " ON (T.DIM_RATE_CELL_KEY=S.DIM_RATE_CELL_KEY)";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'D' THEN DELETE";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'U' THEN UPDATE";
sql_command += " SET T.MD5_VALUE_TEXT=S.MD5_VALUE_TEXT, T.INSERT_DATETIME=S.INSERT_DATETIME, T.LAST_UPDATED_DATETIME=S.LAST_UPDATED_DATETIME, T.TPA_CLIENT_ID = S.TPA_CLIENT_ID, T.TPA_ID = S.TPA_ID, T.TPA_DIV_ID = S.TPA_DIV_ID, T.RATE_CELL_CODE = S.RATE_CELL_CODE, T.RATE_CELL_DESC = S.RATE_CELL_DESC, T.ASSISTANCE_CATEGORY_GROUP_CODES = S.ASSISTANCE_CATEGORY_GROUP_CODES, T.PROGRAM_STATUS_CODES = S.PROGRAM_STATUS_CODES, T.PROMISE_CODE = S.PROMISE_CODE, T.FRR_REPORT_NUMBER_DESC = S.FRR_REPORT_NUMBER_DESC, T.RATE_CELL_EFFECTIVE_DATE = S.RATE_CELL_EFFECTIVE_DATE, T.RATE_CELL_TERM_DATE = S.RATE_CELL_TERM_DATE, T.RATE_CELL_PHYSICAL_HEALTH_DESC = S.RATE_CELL_PHYSICAL_HEALTH_DESC, T.RATE_CELL_BEHAVIORAL_HEALTH_DESC = S.RATE_CELL_BEHAVIORAL_HEALTH_DESC, T.ASSISTANCE_CATEGORY_GROUP_PARENT_CODE = S.ASSISTANCE_CATEGORY_GROUP_PARENT_CODE, T.PROGRAM_STATUS_PARENT_CODE = S.PROGRAM_STATUS_PARENT_CODE, T.RATE_CELL_GENDER_CLASSIFICATION_CODE = S.RATE_CELL_GENDER_CLASSIFICATION_CODE, T.RATE_CELL_AGE_RANGE_TEXT = S.RATE_CELL_AGE_RANGE_TEXT, T.MEDICARE_PART_CODE = S.MEDICARE_PART_CODE";
sql_command += " WHEN NOT MATCHED THEN INSERT";
sql_command += " (T.DIM_RATE_CELL_KEY, T.MD5_VALUE_TEXT, T.INSERT_DATETIME, T.LAST_UPDATED_DATETIME, T.TPA_CLIENT_ID, T.TPA_ID, T.TPA_DIV_ID, T.RATE_CELL_CODE, T.RATE_CELL_DESC, T.ASSISTANCE_CATEGORY_GROUP_CODES, T.PROGRAM_STATUS_CODES, T.PROMISE_CODE, T.FRR_REPORT_NUMBER_DESC, T.RATE_CELL_EFFECTIVE_DATE, T.RATE_CELL_TERM_DATE, T.RATE_CELL_PHYSICAL_HEALTH_DESC, T.RATE_CELL_BEHAVIORAL_HEALTH_DESC, T.ASSISTANCE_CATEGORY_GROUP_PARENT_CODE, T.PROGRAM_STATUS_PARENT_CODE, T.RATE_CELL_GENDER_CLASSIFICATION_CODE, T.RATE_CELL_AGE_RANGE_TEXT, T.MEDICARE_PART_CODE)";
sql_command += " VALUES";
sql_command += " (S.DIM_RATE_CELL_KEY, S.MD5_VALUE_TEXT, S.INSERT_DATETIME, S.LAST_UPDATED_DATETIME, S.TPA_CLIENT_ID, S.TPA_ID, S.TPA_DIV_ID, S.RATE_CELL_CODE, S.RATE_CELL_DESC, S.ASSISTANCE_CATEGORY_GROUP_CODES, S.PROGRAM_STATUS_CODES, S.PROMISE_CODE, S.FRR_REPORT_NUMBER_DESC, S.RATE_CELL_EFFECTIVE_DATE, S.RATE_CELL_TERM_DATE, S.RATE_CELL_PHYSICAL_HEALTH_DESC, S.RATE_CELL_BEHAVIORAL_HEALTH_DESC, S.ASSISTANCE_CATEGORY_GROUP_PARENT_CODE, S.PROGRAM_STATUS_PARENT_CODE, S.RATE_CELL_GENDER_CLASSIFICATION_CODE, S.RATE_CELL_AGE_RANGE_TEXT, S.MEDICARE_PART_CODE)";

try 
    {
        var statement = snowflake.createStatement({sqlText: sql_command});
        var resultSet = statement.execute();
        resultSet.next();
        result = "Succeeded";
        result += "\n RowsInserted: " + resultSet.getColumnValueAsString("number of rows inserted");
        result += "\n RowsUpdated: " + resultSet.getColumnValueAsString("number of rows updated");
        result += "\n RowsDeleted: " + resultSet.getColumnValueAsString("number of rows deleted");
        
    }
catch (err)
    {
      result = "Failed: Code: " + err.code + "\n  State: " + err.state;
      result += "\n  Message: " + err.message;
      result += "\nStack Trace:\n" + err.stackTraceTxt;
      throw result;
    }
return result;
$$
;