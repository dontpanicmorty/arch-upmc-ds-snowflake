CREATE OR REPLACE PROCEDURE INFA.SPU_MERGE_DIM_PROVIDER_AFFILIATION_FROM_STAGE()
RETURNS VARCHAR NOT NULL
language javascript
AS
$$
var result = "";
var sql_command = "";
sql_command += "MERGE INTO DIMDATA.DIM_PROVIDER_AFFILIATION AS T";
sql_command += " USING INFA.DIM_PROVIDER_AFFILIATION AS S";
sql_command += " ON (T.DIM_PROVIDER_AFFILIATION_KEY=S.DIM_PROVIDER_AFFILIATION_KEY)";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'D' THEN DELETE";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'U' THEN UPDATE";
sql_command += " SET T.MD5_VALUE_TEXT=S.MD5_VALUE_TEXT, T.INSERT_DATETIME=S.INSERT_DATETIME, T.LAST_UPDATED_DATETIME=S.LAST_UPDATED_DATETIME, T.IS_LOGICAL_DELETE_FLAG = S.IS_LOGICAL_DELETE_FLAG, T.AFFILIATION_TYPE_CODE = S.AFFILIATION_TYPE_CODE, T.AFFILIATION_TYPE_DESC = S.AFFILIATION_TYPE_DESC, T.AFFILIATION_INSTITUTION_NAME = S.AFFILIATION_INSTITUTION_NAME, T.AFFILIATION_GATEWAY_TEXT = S.AFFILIATION_GATEWAY_TEXT, T.AFFILIATION_GATEWAY_TYPE_CODE = S.AFFILIATION_GATEWAY_TYPE_CODE, T.AFFILIATION_GATEWAY_TYPE_DESC = S.AFFILIATION_GATEWAY_TYPE_DESC, T.AFFILIATED_DIM_PROVIDER_KEY = S.AFFILIATED_DIM_PROVIDER_KEY";
sql_command += " WHEN NOT MATCHED THEN INSERT";
sql_command += " (T.DIM_PROVIDER_AFFILIATION_KEY, T.MD5_VALUE_TEXT, T.INSERT_DATETIME, T.LAST_UPDATED_DATETIME, T.IS_LOGICAL_DELETE_FLAG, T.AFFILIATION_TYPE_CODE, T.AFFILIATION_TYPE_DESC, T.AFFILIATION_INSTITUTION_NAME, T.AFFILIATION_GATEWAY_TEXT, T.AFFILIATION_GATEWAY_TYPE_CODE, T.AFFILIATION_GATEWAY_TYPE_DESC, T.AFFILIATED_DIM_PROVIDER_KEY)";
sql_command += " VALUES";
sql_command += " (S.DIM_PROVIDER_AFFILIATION_KEY, S.MD5_VALUE_TEXT, S.INSERT_DATETIME, S.LAST_UPDATED_DATETIME, S.IS_LOGICAL_DELETE_FLAG, S.AFFILIATION_TYPE_CODE, S.AFFILIATION_TYPE_DESC, S.AFFILIATION_INSTITUTION_NAME, S.AFFILIATION_GATEWAY_TEXT, S.AFFILIATION_GATEWAY_TYPE_CODE, S.AFFILIATION_GATEWAY_TYPE_DESC, S.AFFILIATED_DIM_PROVIDER_KEY)";

try 
    {
        var statement = snowflake.createStatement({sqlText: sql_command});
        var resultSet = statement.execute();
        resultSet.next();
        result = "Succeeded";
        result += "\n RowsInserted: " + resultSet.getColumnValueAsString("number of rows inserted");
        result += "\n RowsUpdated: " + resultSet.getColumnValueAsString("number of rows updated");
        result += "\n RowsDeleted: " + resultSet.getColumnValueAsString("number of rows deleted");
        
    }
catch (err)
    {
      result = "Failed: Code: " + err.code + "\n  State: " + err.state;
      result += "\n  Message: " + err.message;
      result += "\nStack Trace:\n" + err.stackTraceTxt;
      throw result;
    }
return result;
$$
;