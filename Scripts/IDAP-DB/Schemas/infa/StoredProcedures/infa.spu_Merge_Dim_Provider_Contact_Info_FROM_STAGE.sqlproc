CREATE OR REPLACE PROCEDURE INFA.SPU_MERGE_DIM_PROVIDER_CONTACT_INFO_FROM_STAGE()
RETURNS VARCHAR NOT NULL
language javascript
AS
$$
var result = "";
var sql_command = "";
sql_command += "MERGE INTO DIMDATA.DIM_PROVIDER_CONTACT_INFO AS T";
sql_command += " USING INFA.DIM_PROVIDER_CONTACT_INFO AS S";
sql_command += " ON (T.DIM_PROVIDER_CONTACT_INFO_KEY=S.DIM_PROVIDER_CONTACT_INFO_KEY)";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'D' THEN DELETE";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'U' THEN UPDATE";
sql_command += " SET T.MD5_VALUE_TEXT=S.MD5_VALUE_TEXT, T.INSERT_DATETIME=S.INSERT_DATETIME, T.LAST_UPDATED_DATETIME=S.LAST_UPDATED_DATETIME, T.IS_LOGICAL_DELETE_FLAG = S.IS_LOGICAL_DELETE_FLAG, T.PROVIDER_PRIMARY_PHONE_NBR = S.PROVIDER_PRIMARY_PHONE_NBR, T.PROVIDER_PRIMARY_PHONE_EXTENSION_NBR = S.PROVIDER_PRIMARY_PHONE_EXTENSION_NBR, T.PROVIDER_PRIMARY_PHONE_NBR_FORMATTED = S.PROVIDER_PRIMARY_PHONE_NBR_FORMATTED, T.PROVIDER_ALTERNATE_PHONE_NBR = S.PROVIDER_ALTERNATE_PHONE_NBR, T.PROVIDER_ALTERNATE_PHONE_EXTENSION_NBR = S.PROVIDER_ALTERNATE_PHONE_EXTENSION_NBR, T.PROVIDER_ALTERNATE_PHONE_NBR_FORMATTED = S.PROVIDER_ALTERNATE_PHONE_NBR_FORMATTED, T.PROVIDER_FAX_NBR = S.PROVIDER_FAX_NBR, T.PROVIDER_FAX_NBR_FORMATTED = S.PROVIDER_FAX_NBR_FORMATTED, T.PROVIDER_INTERNATIONAL_PHONE_CODE = S.PROVIDER_INTERNATIONAL_PHONE_CODE, T.PROVIDER_EMAIL_ADDRESS_TEXT = S.PROVIDER_EMAIL_ADDRESS_TEXT";
sql_command += " WHEN NOT MATCHED THEN INSERT";
sql_command += " (T.DIM_PROVIDER_CONTACT_INFO_KEY, T.MD5_VALUE_TEXT, T.INSERT_DATETIME, T.LAST_UPDATED_DATETIME, T.IS_LOGICAL_DELETE_FLAG, T.PROVIDER_PRIMARY_PHONE_NBR, T.PROVIDER_PRIMARY_PHONE_EXTENSION_NBR, T.PROVIDER_PRIMARY_PHONE_NBR_FORMATTED, T.PROVIDER_ALTERNATE_PHONE_NBR, T.PROVIDER_ALTERNATE_PHONE_EXTENSION_NBR, T.PROVIDER_ALTERNATE_PHONE_NBR_FORMATTED, T.PROVIDER_FAX_NBR, T.PROVIDER_FAX_NBR_FORMATTED, T.PROVIDER_INTERNATIONAL_PHONE_CODE, T.PROVIDER_EMAIL_ADDRESS_TEXT)";
sql_command += " VALUES";
sql_command += " (S.DIM_PROVIDER_CONTACT_INFO_KEY, S.MD5_VALUE_TEXT, S.INSERT_DATETIME, S.LAST_UPDATED_DATETIME, S.IS_LOGICAL_DELETE_FLAG, S.PROVIDER_PRIMARY_PHONE_NBR, S.PROVIDER_PRIMARY_PHONE_EXTENSION_NBR, S.PROVIDER_PRIMARY_PHONE_NBR_FORMATTED, S.PROVIDER_ALTERNATE_PHONE_NBR, S.PROVIDER_ALTERNATE_PHONE_EXTENSION_NBR, S.PROVIDER_ALTERNATE_PHONE_NBR_FORMATTED, S.PROVIDER_FAX_NBR, S.PROVIDER_FAX_NBR_FORMATTED, S.PROVIDER_INTERNATIONAL_PHONE_CODE, S.PROVIDER_EMAIL_ADDRESS_TEXT)";

try 
    {
        var statement = snowflake.createStatement({sqlText: sql_command});
        var resultSet = statement.execute();
        resultSet.next();
        result = "Succeeded";
        result += "\n RowsInserted: " + resultSet.getColumnValueAsString("number of rows inserted");
        result += "\n RowsUpdated: " + resultSet.getColumnValueAsString("number of rows updated");
        result += "\n RowsDeleted: " + resultSet.getColumnValueAsString("number of rows deleted");
        
    }
catch (err)
    {
      result = "Failed: Code: " + err.code + "\n  State: " + err.state;
      result += "\n  Message: " + err.message;
      result += "\nStack Trace:\n" + err.stackTraceTxt;
      throw result;
    }
return result;
$$
;