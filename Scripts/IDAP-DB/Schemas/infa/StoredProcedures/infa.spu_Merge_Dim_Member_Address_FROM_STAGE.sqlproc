CREATE OR REPLACE PROCEDURE INFA.SPU_MERGE_DIM_MEMBER_ADDRESS_FROM_STAGE()
RETURNS VARCHAR NOT NULL
language javascript
AS
$$
var result = "";
var sql_command = "";
sql_command += "MERGE INTO DIMDATA.DIM_MEMBER_ADDRESS AS T";
sql_command += " USING INFA.DIM_MEMBER_ADDRESS AS S";
sql_command += " ON (T.DIM_MEMBER_ADDRESS_KEY=S.DIM_MEMBER_ADDRESS_KEY)";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'D' THEN DELETE";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'U' THEN UPDATE";
sql_command += " SET T.MD5_VALUE_TEXT=S.MD5_VALUE_TEXT, T.DIM_MEMBER_KEY = S.DIM_MEMBER_KEY, T.MEMBER_ADDRESS_TYPE = S.MEMBER_ADDRESS_TYPE, T.MEMBER_ADDRESSLINE1_TEXT = S.MEMBER_ADDRESSLINE1_TEXT, T.MEMBER_ADDRESSLINE2_TEXT = S.MEMBER_ADDRESSLINE2_TEXT, T.MEMBER_CITY_NAME = S.MEMBER_CITY_NAME, T.MEMBER_STATE_ABBREVIATION_NAME = S.MEMBER_STATE_ABBREVIATION_NAME, T.MEMBER_ZIP_CODE_NBR = S.MEMBER_ZIP_CODE_NBR, T.MEMBER_FIPS_CODE = S.MEMBER_FIPS_CODE,T.MEMBER_FIPS_STATE_CODE = S.MEMBER_FIPS_STATE_CODE,T.MEMBER_FIPS_COUNTY_CODE = S.MEMBER_FIPS_COUNTY_CODE,T.MEMBER_CMS_COUNTY_CODE = S.MEMBER_CMS_COUNTY_CODE, T.MEMBER_COUNTY_DESC = S.MEMBER_COUNTY_DESC, T.MEMBER_LATITUDE_NBR = S.MEMBER_LATITUDE_NBR, T.MEMBER_LONGITUDE_NBR = S.MEMBER_LONGITUDE_NBR, T.EFFECTIVE_START_DATE = S.EFFECTIVE_START_DATE, T.EFFECTIVE_END_DATE = S.EFFECTIVE_END_DATE, T.ACTIVE_IND = S.ACTIVE_IND, T.VALID_IND = S.VALID_IND, T.CONGRESSIONAL_DISTRICT = S.CONGRESSIONAL_DISTRICT, T.VERIFIED_ADDRESSLINE1_TEXT = S.VERIFIED_ADDRESSLINE1_TEXT, T.VERIFIED_ADDRESSLINE2_TEXT = S.VERIFIED_ADDRESSLINE2_TEXT , T.VERIFIED_COUNTY_DESCRIPTION = S.VERIFIED_COUNTY_DESCRIPTION, T.VERIFIED_PRIMARY_NUMBER = S.VERIFIED_PRIMARY_NUMBER, T.VERIFIED_STREET_NAME = S.VERIFIED_STREET_NAME, T.VERIFIED_STREET_PREDIRECTION = S.VERIFIED_STREET_PREDIRECTION, T.VERIFIED_STREET_POSTDIRECTION = S.VERIFIED_STREET_POSTDIRECTION, T.VERIFIED_STREET_SUFFIX = S.VERIFIED_STREET_SUFFIX, T.VERIFIED_SECONDARY_NUMBER = S.VERIFIED_SECONDARY_NUMBER, T.VERIFIED_EXTRA_SECONDARY_NUMBER = S.VERIFIED_EXTRA_SECONDARY_NUMBER,  T.VERIFIED_CITY_NAME = S.VERIFIED_CITY_NAME , T.VERIFIED_STATE = S.VERIFIED_STATE, T.VERIFIED_ZIPCODE5_NBR = S.VERIFIED_ZIPCODE5_NBR, T.VERIFIED_ZIPCODE9_NBR = S.VERIFIED_ZIPCODE9_NBR, T.VERIFIED_PRECISION = S.VERIFIED_PRECISION, T.INSERT_DATETIME=S.INSERT_DATETIME, T.LAST_UPDATED_DATETIME=S.LAST_UPDATED_DATETIME";
sql_command += " WHEN NOT MATCHED THEN INSERT";
sql_command += " (T.DIM_MEMBER_ADDRESS_KEY, T.MD5_VALUE_TEXT, T.DIM_MEMBER_KEY, T.MEMBER_ADDRESS_TYPE, T.MEMBER_ADDRESSLINE1_TEXT, T.MEMBER_ADDRESSLINE2_TEXT , T.MEMBER_CITY_NAME, T.MEMBER_STATE_ABBREVIATION_NAME, T.MEMBER_ZIP_CODE_NBR, T.MEMBER_FIPS_CODE,T.MEMBER_FIPS_STATE_CODE,T.MEMBER_FIPS_COUNTY_CODE,T.MEMBER_CMS_COUNTY_CODE, T.MEMBER_COUNTY_DESC, T.MEMBER_LATITUDE_NBR, T.MEMBER_LONGITUDE_NBR, T.EFFECTIVE_START_DATE, T.EFFECTIVE_END_DATE, T.ACTIVE_IND, T.VALID_IND, T.CONGRESSIONAL_DISTRICT, T.VERIFIED_ADDRESSLINE1_TEXT, T.VERIFIED_ADDRESSLINE2_TEXT, T.VERIFIED_COUNTY_DESCRIPTION, T.VERIFIED_PRIMARY_NUMBER, T.VERIFIED_STREET_NAME, T.VERIFIED_STREET_PREDIRECTION, T.VERIFIED_STREET_POSTDIRECTION, T.VERIFIED_STREET_SUFFIX, T.VERIFIED_SECONDARY_NUMBER, T.VERIFIED_EXTRA_SECONDARY_NUMBER, T.VERIFIED_CITY_NAME, T.VERIFIED_STATE, T.VERIFIED_ZIPCODE5_NBR, T.VERIFIED_ZIPCODE9_NBR, T.VERIFIED_PRECISION, T.INSERT_DATETIME, T.LAST_UPDATED_DATETIME)";
sql_command += " VALUES";
sql_command += " (S.DIM_MEMBER_ADDRESS_KEY, S.MD5_VALUE_TEXT, S.DIM_MEMBER_KEY, S.MEMBER_ADDRESS_TYPE, S.MEMBER_ADDRESSLINE1_TEXT, S.MEMBER_ADDRESSLINE2_TEXT , S.MEMBER_CITY_NAME, S.MEMBER_STATE_ABBREVIATION_NAME, S.MEMBER_ZIP_CODE_NBR, S.MEMBER_FIPS_CODE,S.MEMBER_FIPS_STATE_CODE,S.MEMBER_FIPS_COUNTY_CODE,S.MEMBER_CMS_COUNTY_CODE, S.MEMBER_COUNTY_DESC, S.MEMBER_LATITUDE_NBR, S.MEMBER_LONGITUDE_NBR, S.EFFECTIVE_START_DATE, S.EFFECTIVE_END_DATE, S.ACTIVE_IND, S.VALID_IND, S.CONGRESSIONAL_DISTRICT, S.VERIFIED_ADDRESSLINE1_TEXT, S.VERIFIED_ADDRESSLINE2_TEXT, S.VERIFIED_COUNTY_DESCRIPTION, S.VERIFIED_PRIMARY_NUMBER, S.VERIFIED_STREET_NAME, S.VERIFIED_STREET_PREDIRECTION, S.VERIFIED_STREET_POSTDIRECTION, S.VERIFIED_STREET_SUFFIX, S.VERIFIED_SECONDARY_NUMBER, S.VERIFIED_EXTRA_SECONDARY_NUMBER, S.VERIFIED_CITY_NAME, S.VERIFIED_STATE, S.VERIFIED_ZIPCODE5_NBR, S.VERIFIED_ZIPCODE9_NBR,  S.VERIFIED_PRECISION, S.INSERT_DATETIME, S.LAST_UPDATED_DATETIME)";




try 
    {
        var statement = snowflake.createStatement({sqlText: sql_command});
        var resultSet = statement.execute();
        resultSet.next();
        result = "Succeeded";
        result += "\n RowsInserted: " + resultSet.getColumnValueAsString("number of rows inserted");
        result += "\n RowsUpdated: " + resultSet.getColumnValueAsString("number of rows updated");
        result += "\n RowsDeleted: " + resultSet.getColumnValueAsString("number of rows deleted");
        
    }
catch (err)
    {
      result = "Failed: Code: " + err.code + "\n  State: " + err.state;
      result += "\n  Message: " + err.message;
      result += "\nStack Trace:\n" + err.stackTraceTxt;
      throw result;
    }
return result;
$$
;