CREATE OR REPLACE PROCEDURE INFA.SPU_MERGE_DIM_SUB_GROUP_FROM_STAGE()
RETURNS VARCHAR NOT NULL
language javascript
AS
$$
var result = "";
var sql_command = "";
sql_command += "MERGE INTO DIMDATA.DIM_SUB_GROUP AS T";
sql_command += " USING INFA.DIM_SUB_GROUP AS S";
sql_command += " ON (T.DIM_SUB_GROUP_KEY=S.DIM_SUB_GROUP_KEY)";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'D' THEN DELETE";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'U' THEN UPDATE";
sql_command += " SET T.MD5_VALUE_TEXT=S.MD5_VALUE_TEXT, T.INSERT_DATETIME=S.INSERT_DATETIME, T.LAST_UPDATED_DATETIME=S.LAST_UPDATED_DATETIME, T.TPA_CLIENT_ID = S.TPA_CLIENT_ID, T.TPA_ID = S.TPA_ID, T.TPA_DIV_ID = S.TPA_DIV_ID, T.GROUP_NBR = S.GROUP_NBR, T.SUB_GROUP_NBR = S.SUB_GROUP_NBR, T.SUB_GROUP_CATEGORY_CODE = S.SUB_GROUP_CATEGORY_CODE, T.SUB_GROUP_NAME = S.SUB_GROUP_NAME, T.TERMINATION_DATE = S.TERMINATION_DATE, T.SUB_GROUP_BILLING_STATE_ABBREVIATION_NAME = S.SUB_GROUP_BILLING_STATE_ABBREVIATION_NAME, T.SUB_GROUP_BILLING_ZIP_CODE_NBR = S.SUB_GROUP_BILLING_ZIP_CODE_NBR, T.SUB_GROUP_BILLING_FIPS_COUNTY_CODE = S.SUB_GROUP_BILLING_FIPS_COUNTY_CODE, T.SUB_GROUP_BILLING_FIPS_COUNTY_NAME = S.SUB_GROUP_BILLING_FIPS_COUNTY_NAME, T.DIVISION_ID = S.DIVISION_ID, T.SUB_GROUP_ID = S.SUB_GROUP_ID, T.CURRENT_SUB_GROUP_EFFECTIVE_DATE = S.CURRENT_SUB_GROUP_EFFECTIVE_DATE, T.PENDING_RENEWAL_DATE = S.PENDING_RENEWAL_DATE, T.CURRENT_SUB_GROUP_END_DATE = S.CURRENT_SUB_GROUP_END_DATE";
sql_command += " WHEN NOT MATCHED THEN INSERT";
sql_command += " (T.DIM_SUB_GROUP_KEY, T.MD5_VALUE_TEXT, T.INSERT_DATETIME, T.LAST_UPDATED_DATETIME, T.TPA_CLIENT_ID, T.TPA_ID, T.TPA_DIV_ID, T.GROUP_NBR ,  T.SUB_GROUP_NBR, T.SUB_GROUP_CATEGORY_CODE, T.SUB_GROUP_NAME, T.TERMINATION_DATE, T.SUB_GROUP_BILLING_STATE_ABBREVIATION_NAME, T.SUB_GROUP_BILLING_ZIP_CODE_NBR, T.SUB_GROUP_BILLING_FIPS_COUNTY_CODE, T.SUB_GROUP_BILLING_FIPS_COUNTY_NAME, T.DIVISION_ID, T.SUB_GROUP_ID, T.CURRENT_SUB_GROUP_EFFECTIVE_DATE, T.PENDING_RENEWAL_DATE, T.CURRENT_SUB_GROUP_END_DATE)";
sql_command += " VALUES";
sql_command += " (S.DIM_SUB_GROUP_KEY, S.MD5_VALUE_TEXT, S.INSERT_DATETIME, S.LAST_UPDATED_DATETIME, S.TPA_CLIENT_ID, S.TPA_ID, S.TPA_DIV_ID, S.GROUP_NBR ,  S.SUB_GROUP_NBR, S.SUB_GROUP_CATEGORY_CODE, S.SUB_GROUP_NAME, S.TERMINATION_DATE, S.SUB_GROUP_BILLING_STATE_ABBREVIATION_NAME, S.SUB_GROUP_BILLING_ZIP_CODE_NBR, S.SUB_GROUP_BILLING_FIPS_COUNTY_CODE, S.SUB_GROUP_BILLING_FIPS_COUNTY_NAME, S.DIVISION_ID, S.SUB_GROUP_ID, S.CURRENT_SUB_GROUP_EFFECTIVE_DATE, S.PENDING_RENEWAL_DATE, S.CURRENT_SUB_GROUP_END_DATE)";

try 
    {
        var statement = snowflake.createStatement({sqlText: sql_command});
        var resultSet = statement.execute();
        resultSet.next();
        result = "Succeeded";
        result += "\n RowsInserted: " + resultSet.getColumnValueAsString("number of rows inserted");
        result += "\n RowsUpdated: " + resultSet.getColumnValueAsString("number of rows updated");
        result += "\n RowsDeleted: " + resultSet.getColumnValueAsString("number of rows deleted");
        
    }
catch (err)
    {
      result = "Failed: Code: " + err.code + "\n  State: " + err.state;
      result += "\n  Message: " + err.message;
      result += "\nStack Trace:\n" + err.stackTraceTxt;
      throw result;
    }
return result;
$$
;