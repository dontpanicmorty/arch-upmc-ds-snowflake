CREATE OR REPLACE PROCEDURE INFA.SPU_MERGE_DIM_PLAN_FROM_STAGE()
RETURNS VARCHAR NOT NULL
language javascript
AS
$$
var result = "";
var sql_command = "";
sql_command += "MERGE INTO DIMDATA.DIM_PLAN AS T";
sql_command += " USING INFA.DIM_PLAN AS S";
sql_command += " ON (T.DIM_PLAN_KEY=S.DIM_PLAN_KEY)";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'D' THEN DELETE";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'U' THEN UPDATE";
sql_command += " SET T.MD5_VALUE_TEXT=S.MD5_VALUE_TEXT, T.INSERT_DATETIME=S.INSERT_DATETIME, T.LAST_UPDATED_DATETIME=S.LAST_UPDATED_DATETIME, T.TPA_CLIENT_ID = S.TPA_CLIENT_ID, T.TPA_ID = S.TPA_ID, T.TPA_DIV_ID = S.TPA_DIV_ID, T.ACA_MARKET_SEGMENT_NAME = S.ACA_MARKET_SEGMENT_NAME, T.PLAN_CODE = S.PLAN_CODE, T.ACA_MIN_BENEFIT_YEAR = S.ACA_MIN_BENEFIT_YEAR, T.ACA_PLAN_TYPE_NAME = S.ACA_PLAN_TYPE_NAME, T.ACA_PRODUCT_CODE = S.ACA_PRODUCT_CODE, T.ACA_MARKETING_PLAN_NAME = S.ACA_MARKETING_PLAN_NAME, T.ACA_METAL_LEVEL_CODE = S.ACA_METAL_LEVEL_CODE, T.ACA_ON_EXCHANGE_IND = S.ACA_ON_EXCHANGE_IND, T.ACA_NETWORK_NAME = S.ACA_NETWORK_NAME, T.ACA_COST_SHARE_TYPE_NAME = S.ACA_COST_SHARE_TYPE_NAME, T.ACA_HIOS_ID = S.ACA_HIOS_ID, T.PLAN_TYPE_CODE = S.PLAN_TYPE_CODE, T.PLAN_DESC = S.PLAN_DESC, T.LOB_CODE = S.LOB_CODE, T.LOB_DESC = S.LOB_DESC, T.LOB_PRODUCT_CODE = S.LOB_PRODUCT_CODE, T.LOB_PRODUCT_DESC = S.LOB_PRODUCT_DESC, T.LOB_PLAN_TYPE_DESC = S.LOB_PLAN_TYPE_DESC, T.GRANDFATHERED_ACA_PLAN_IND = S.GRANDFATHERED_ACA_PLAN_IND, T.PLAN_CATEGORY_NAME = S.PLAN_CATEGORY_NAME, T.HEALTHY_U_IND = S.HEALTHY_U_IND, T.WELLNESS_IND = S.WELLNESS_IND, T.COMPANY_CODE = S.COMPANY_CODE, T.FUNDING_TYPE_DESC = S.FUNDING_TYPE_DESC, T.BUSINESS_UNIT_DESC = S.BUSINESS_UNIT_DESC, T.COMMERCIAL_ANALYTICS_PLAN_TYPE_GROUPING_CODE = S.COMMERCIAL_ANALYTICS_PLAN_TYPE_GROUPING_CODE, T.COMMERCIAL_ANALYTICS_PLAN_GROUPING_CODE = S.COMMERCIAL_ANALYTICS_PLAN_GROUPING_CODE";
sql_command += " WHEN NOT MATCHED THEN INSERT";
sql_command += " (T.DIM_PLAN_KEY, T.MD5_VALUE_TEXT, T.INSERT_DATETIME, T.LAST_UPDATED_DATETIME, T.TPA_CLIENT_ID, T.TPA_ID, T.TPA_DIV_ID, T.ACA_MARKET_SEGMENT_NAME, T.PLAN_CODE, T.ACA_MIN_BENEFIT_YEAR, T.ACA_PLAN_TYPE_NAME, T.ACA_PRODUCT_CODE, T.ACA_MARKETING_PLAN_NAME, T.ACA_METAL_LEVEL_CODE, T.ACA_ON_EXCHANGE_IND, T.ACA_NETWORK_NAME, T.ACA_COST_SHARE_TYPE_NAME, T.ACA_HIOS_ID, T.PLAN_TYPE_CODE, T.PLAN_DESC, T.LOB_CODE, T.LOB_DESC, T.LOB_PRODUCT_CODE, T.LOB_PRODUCT_DESC, T.LOB_PLAN_TYPE_DESC, T.GRANDFATHERED_ACA_PLAN_IND, T.PLAN_CATEGORY_NAME, T.HEALTHY_U_IND, T.WELLNESS_IND, T.COMPANY_CODE, T.FUNDING_TYPE_DESC, T.BUSINESS_UNIT_DESC, T.COMMERCIAL_ANALYTICS_PLAN_TYPE_GROUPING_CODE, T.COMMERCIAL_ANALYTICS_PLAN_GROUPING_CODE)";
sql_command += " VALUES";
sql_command += " (S.DIM_PLAN_KEY, S.MD5_VALUE_TEXT, S.INSERT_DATETIME, S.LAST_UPDATED_DATETIME, S.TPA_CLIENT_ID, S.TPA_ID, S.TPA_DIV_ID, S.ACA_MARKET_SEGMENT_NAME, S.PLAN_CODE, S.ACA_MIN_BENEFIT_YEAR, S.ACA_PLAN_TYPE_NAME, S.ACA_PRODUCT_CODE, S.ACA_MARKETING_PLAN_NAME, S.ACA_METAL_LEVEL_CODE, S.ACA_ON_EXCHANGE_IND, S.ACA_NETWORK_NAME, S.ACA_COST_SHARE_TYPE_NAME, S.ACA_HIOS_ID, S.PLAN_TYPE_CODE, S.PLAN_DESC, S.LOB_CODE, S.LOB_DESC, S.LOB_PRODUCT_CODE, S.LOB_PRODUCT_DESC, S.LOB_PLAN_TYPE_DESC, S.GRANDFATHERED_ACA_PLAN_IND, S.PLAN_CATEGORY_NAME, S.HEALTHY_U_IND, S.WELLNESS_IND, S.COMPANY_CODE, S.FUNDING_TYPE_DESC, S.BUSINESS_UNIT_DESC, S.COMMERCIAL_ANALYTICS_PLAN_TYPE_GROUPING_CODE, S.COMMERCIAL_ANALYTICS_PLAN_GROUPING_CODE)";

try 
    {
        var statement = snowflake.createStatement({sqlText: sql_command});
        var resultSet = statement.execute();
        resultSet.next();
        result = "Succeeded";
        result += "\n RowsInserted: " + resultSet.getColumnValueAsString("number of rows inserted");
        result += "\n RowsUpdated: " + resultSet.getColumnValueAsString("number of rows updated");
        result += "\n RowsDeleted: " + resultSet.getColumnValueAsString("number of rows deleted");
        
    }
catch (err)
    {
      result = "Failed: Code: " + err.code + "\n  State: " + err.state;
      result += "\n  Message: " + err.message;
      result += "\nStack Trace:\n" + err.stackTraceTxt;
      throw result;
    }
return result;
$$
;