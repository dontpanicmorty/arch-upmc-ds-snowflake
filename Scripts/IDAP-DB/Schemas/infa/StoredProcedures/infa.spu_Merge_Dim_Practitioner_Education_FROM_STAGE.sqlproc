CREATE OR REPLACE PROCEDURE INFA.SPU_MERGE_DIM_PRACTITIONER_EDUCATION_FROM_STAGE()
RETURNS VARCHAR NOT NULL
language javascript
AS
$$
var result = "";
var sql_command = "";
sql_command += "MERGE INTO DIMDATA.DIM_PRACTITIONER_EDUCATION AS T";
sql_command += " USING INFA.DIM_PRACTITIONER_EDUCATION AS S";
sql_command += " ON (T.DIM_PRACTITIONER_EDUCATION_KEY=S.DIM_PRACTITIONER_EDUCATION_KEY)";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'D' THEN DELETE";
sql_command += " WHEN MATCHED AND S.CONVERT_IND = 'U' THEN UPDATE";
sql_command += " SET T.MD5_VALUE_TEXT=S.MD5_VALUE_TEXT, T.INSERT_DATETIME=S.INSERT_DATETIME, T.LAST_UPDATED_DATETIME=S.LAST_UPDATED_DATETIME, T.EDUCATION_TYPE_CODE = S.EDUCATION_TYPE_CODE, T.EDUCATION_TYPE_DESC = S.EDUCATION_TYPE_DESC, T.EDUCATION_INSTITUTION_SOURCE_NBR = S.EDUCATION_INSTITUTION_SOURCE_NBR, T.EDUCATION_INSTITUTION_NAME = S.EDUCATION_INSTITUTION_NAME, T.EDUCATION_DEPARTMENT_CODE = S.EDUCATION_DEPARTMENT_CODE, T.EDUCATION_DEPARTMENT_NAME = S.EDUCATION_DEPARTMENT_NAME, T.EDUCATION_DEGREE_NAME = S.EDUCATION_DEGREE_NAME, T.IS_LOGICAL_DELETE_FLAG = S.IS_LOGICAL_DELETE_FLAG";
sql_command += " WHEN NOT MATCHED THEN INSERT";
sql_command += " (T.DIM_PRACTITIONER_EDUCATION_KEY, T.MD5_VALUE_TEXT, T.INSERT_DATETIME, T.LAST_UPDATED_DATETIME, T.EDUCATION_TYPE_CODE, T.EDUCATION_TYPE_DESC, T.EDUCATION_INSTITUTION_SOURCE_NBR, T.EDUCATION_INSTITUTION_NAME, T.EDUCATION_DEPARTMENT_CODE, T.EDUCATION_DEPARTMENT_NAME, T.EDUCATION_DEGREE_NAME, T.IS_LOGICAL_DELETE_FLAG)";
sql_command += " VALUES";
sql_command += " (S.DIM_PRACTITIONER_EDUCATION_KEY, S.MD5_VALUE_TEXT, S.INSERT_DATETIME, S.LAST_UPDATED_DATETIME, S.EDUCATION_TYPE_CODE, S.EDUCATION_TYPE_DESC, S.EDUCATION_INSTITUTION_SOURCE_NBR, S.EDUCATION_INSTITUTION_NAME, S.EDUCATION_DEPARTMENT_CODE, S.EDUCATION_DEPARTMENT_NAME, S.EDUCATION_DEGREE_NAME, S.IS_LOGICAL_DELETE_FLAG)";

try 
    {
        var statement = snowflake.createStatement({sqlText: sql_command});
        var resultSet = statement.execute();
        resultSet.next();
        result = "Succeeded";
        result += "\n RowsInserted: " + resultSet.getColumnValueAsString("number of rows inserted");
        result += "\n RowsUpdated: " + resultSet.getColumnValueAsString("number of rows updated");
        result += "\n RowsDeleted: " + resultSet.getColumnValueAsString("number of rows deleted");
        
    }
catch (err)
    {
      result = "Failed: Code: " + err.code + "\n  State: " + err.state;
      result += "\n  Message: " + err.message;
      result += "\nStack Trace:\n" + err.stackTraceTxt;
      throw result;
    }
return result;
$$
;