CREATE OR REPLACE PROCEDURE STAGEDATA.SPU_FSS_DECISION_ALGORITHM_CHC_PART1()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
COMMENT = 'This procedure runs the FSS algorithm where FSS_CLAIMS_DATA.LOB_CODE = ''CHC'' on records in STAGEDATA.FSS_DECISION_DATA'
EXECUTE AS OWNER
AS
$$
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `STAGEDATA.FSS_DECISION_DATA`;
var totalInsertedCount = 0;

function runMergeAndLog(sqlText, decisionOrder) {
    var startTime = new Date().toISOString();
    var insertCount = 0;
    var result = "Succeeded";
    var endTime;

    try {
        var sfStatement = snowflake.createStatement({sqlText: sqlText});
        sfStatement.execute();
        insertCount = sfStatement.getNumRowsInserted();
        totalInsertedCount += insertCount;
        endTime = new Date().toISOString();

        var sqlLogCommand = `
            INSERT INTO LOGDATA.FSS_TABLE_LOAD_HISTORY 
            (NAME, TYPE, LOB, DECISION_ORDER, START_TIME, END_TIME, INSERT_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
            VALUES (:1,:2,:3,:4,:5::timestamp_ltz,:6::timestamp_ltz,:7,:8,:9,:10);
        `;

        snowflake.execute({
            sqlText: sqlLogCommand,
            binds: [
                targetTableName,
                "TABLE",
                "CHC",
                decisionOrder,
                startTime,
                endTime,
                insertCount,
                result,
                sqlText,
                sfStatement.getQueryId()
            ]
        });

    } catch (err) {
        endTime = new Date().toISOString();
        result = "Failed";

        var sqlLogCommand = `
            INSERT INTO LOGDATA.FSS_TABLE_LOAD_HISTORY 
            (NAME, TYPE, LOB, DECISION_ORDER, START_TIME, END_TIME, INSERT_COUNT, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
            VALUES (:1,:2,:3,:4,:5::timestamp_ltz,:6::timestamp_ltz,:7,:8,:9,:10,:11,:12,:13,:14);
        `;

        snowflake.execute({
            sqlText: sqlLogCommand,
            binds: [
                targetTableName,
                "TABLE",
                "CHC",
                decisionOrder,
                startTime,
                endTime,
                0,
                result,
                sqlText,
                err.code,
                err.state,
                err.message,
                err.stackTraceTxt,
                sfStatement.getQueryId()
            ]
        });
    }
}


var sqlDecision67 = `
