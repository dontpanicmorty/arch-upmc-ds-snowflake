        CLAIM_NBR,
        CLAIM_LINE_NBR,
        CLAIM_SEQUENCE_NBR,
        PROCEDURE_ADJ_CODE,
        LOB_CODE,
        CPT4_CODE,
        REVENUE_CODE,
        ICD_DX_CODE,
        ICD_DX_VERSION,
        ICD_DX_GROUP,
        ICD_PROC_CODE,
        ICD_PROC_VERSION,
        BENEFIT_CATEGORY_CODE,
        LOCATION_CODE,
        SERVICE_TYPE,
        PLACE_OF_SERVICE_CODE,
        PROVIDER_TYPE_DESC,
        PROVIDER_TYPE,
        PROVIDER_SPECIALTY,
        HIAA_POS,
        DECISION_STEP,
        SUBGROUP,
        ROW_EFFECTIVE_DATETIME
    )
    VALUES (
        source.FSS_CLAIMS_DATA_KEY,
        source.FACT_CLAIM_LINE_KEY,
        source.FACT_CLAIM_LINE_LAST_UPDATED_DATETIME,
        source.DIM_CLAIM_HEADER_KEY,
        source.DIM_CLAIM_HEADER_LAST_UPDATED_DATETIME,
        source.DIM_CLAIM_DETAIL_KEY,
