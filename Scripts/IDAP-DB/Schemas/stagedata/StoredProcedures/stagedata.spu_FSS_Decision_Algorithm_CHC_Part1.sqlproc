USING (
    SELECT DISTINCT
        FSS_CLAIMS_DATA_KEY,
        FACT_CLAIM_LINE_KEY,
        FACT_CLAIM_LINE_LAST_UPDATED_DATETIME,
        DIM_CLAIM_HEADER_KEY,
