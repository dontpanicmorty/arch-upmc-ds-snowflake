        ICD_DX_VERSION,
        ICD_DX_GROUP,
        ICD_PROC_CODE,
        ICD_PROC_VERSION,
        BENEFIT_CATEGORY_CODE,
        LOCATION_CODE,
        SERVICE_TYPE,
        PLACE_OF_SERVICE_CODE,
        PROVIDER_TYPE_DESC,
        PROVIDER_TYPE,
        PROVIDER_SPECIALTY,
        HIAA_POS,
        '96' AS DECISION_STEP,
        '200260' AS SUBGROUP,
        '${startTime}' AS ROW_EFFECTIVE_DATETIME
    FROM STAGEDATA.FSS_CLAIMS_DATA
    WHERE
        (
            ((FSS_CLAIMS_DATA.ICD_DX_VERSION = '9' AND FSS_CLAIMS_DATA.ICD_DX_CODE NOT BETWEEN '290' AND '319.99') OR (FSS_CLAIMS_DATA.ICD_DX_VERSION = '10' AND SUBSTR(FSS_CLAIMS_DATA.ICD_DX_CODE,1,3) NOT BETWEEN 'F00' AND 'F99')) AND (FSS_CLAIMS_DATA.REVENUE_CODE LIKE '051%' OR FSS_CLAIMS_DATA.REVENUE_CODE LIKE '052%') AND FSS_CLAIMS_DATA.LOCATION_CODE = 'O' AND FSS_CLAIMS_DATA.PROVIDER_TYPE = 'FC'
        )
        AND FSS_CLAIMS_DATA.LOB_CODE = 'CHC'
) AS source
ON target.DIM_CLAIM_DETAIL_KEY = source.DIM_CLAIM_DETAIL_KEY
WHEN NOT MATCHED THEN
