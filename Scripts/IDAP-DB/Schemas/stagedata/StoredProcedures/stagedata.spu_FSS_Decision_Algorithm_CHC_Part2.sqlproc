                        OR SUBSTR(FSS_CLAIMS_DATA.ICD_DX_CODE,1,3) BETWEEN 'Z30' AND 'Z35'
                        OR SUBSTR(FSS_CLAIMS_DATA.ICD_DX_CODE,1,3) = 'Z37'
                        OR SUBSTR(FSS_CLAIMS_DATA.ICD_DX_CODE,1,3) = 'Z39'
                        OR SUBSTR(FSS_CLAIMS_DATA.ICD_DX_CODE,1,5) = 'Z98.5')
            AND (SUBSTR(FSS_CLAIMS_DATA.ICD_DX_CODE,1,6) NOT IN ('O26.89','O30.02','036.82','075.89','090.89')
                        OR SUBSTR(FSS_CLAIMS_DATA.ICD_DX_CODE,1,5) NOT IN ('O35.7','035.8'))))   
