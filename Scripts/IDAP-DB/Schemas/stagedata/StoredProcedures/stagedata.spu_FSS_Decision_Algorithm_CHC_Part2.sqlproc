CREATE OR REPLACE PROCEDURE STAGEDATA.SPU_FSS_DECISION_ALGORITHM_CHC_PART2()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
COMMENT = 'This procedure runs the FSS algorithm where FSS_CLAIMS_DATA.LOB_CODE = ''CHC'' on records in STAGEDATA.FSS_DECISION_DATA'
EXECUTE AS OWNER
AS
$$
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `STAGEDATA.FSS_DECISION_DATA`;
var totalInsertedCount = 0;

function runMergeAndLog(sqlText, decisionOrder) {
    var startTime = new Date().toISOString();
    var insertCount = 0;
    var result = "Succeeded";
    var endTime;

    try {
        var sfStatement = snowflake.createStatement({sqlText: sqlText});
        sfStatement.execute();
        insertCount = sfStatement.getNumRowsInserted();
        totalInsertedCount += insertCount;
        endTime = new Date().toISOString();

        var sqlLogCommand = `
            INSERT INTO LOGDATA.FSS_TABLE_LOAD_HISTORY 
            (NAME, TYPE, LOB, DECISION_ORDER, START_TIME, END_TIME, INSERT_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
            VALUES (:1,:2,:3,:4,:5::timestamp_ltz,:6::timestamp_ltz,:7,:8,:9,:10);
        `;

        snowflake.execute({
            sqlText: sqlLogCommand,
            binds: [
                targetTableName,
                "TABLE",
                "CHC",
                decisionOrder,
                startTime,
                endTime,
                insertCount,
                result,
                sqlText,
                sfStatement.getQueryId()
            ]
        });

    } catch (err) {
        endTime = new Date().toISOString();
        result = "Failed";

        var sqlLogCommand = `
            INSERT INTO LOGDATA.FSS_TABLE_LOAD_HISTORY 
            (NAME, TYPE, LOB, DECISION_ORDER, START_TIME, END_TIME, INSERT_COUNT, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
            VALUES (:1,:2,:3,:4,:5::timestamp_ltz,:6::timestamp_ltz,:7,:8,:9,:10,:11,:12,:13,:14);
        `;

        snowflake.execute({
            sqlText: sqlLogCommand,
            binds: [
                targetTableName,
                "TABLE",
                "CHC",
                decisionOrder,
                startTime,
                endTime,
                0,
                result,
                sqlText,
                err.code,
                err.state,
                err.message,
                err.stackTraceTxt,
                sfStatement.getQueryId()
            ]
        });
    }
}


var sqlDecision101 = `
MERGE INTO STAGEDATA.FSS_DECISION_DATA AS target
USING (
    SELECT DISTINCT
        FSS_CLAIMS_DATA_KEY,
        FACT_CLAIM_LINE_KEY,
        FACT_CLAIM_LINE_LAST_UPDATED_DATETIME,
        DIM_CLAIM_HEADER_KEY,
        DIM_CLAIM_HEADER_LAST_UPDATED_DATETIME,
        DIM_CLAIM_DETAIL_KEY,
        DIM_CLAIM_DETAIL_LAST_UPDATED_DATETIME,
        CLAIM_NBR,
        CLAIM_LINE_NBR,
        CLAIM_SEQUENCE_NBR,
        PROCEDURE_ADJ_CODE,
        LOB_CODE,
        CPT4_CODE,
        REVENUE_CODE,
        ICD_DX_CODE,
        ICD_DX_VERSION,
        ICD_DX_GROUP,
        ICD_PROC_CODE,
        ICD_PROC_VERSION,
        BENEFIT_CATEGORY_CODE,
        LOCATION_CODE,
        SERVICE_TYPE,
        PLACE_OF_SERVICE_CODE,
        PROVIDER_TYPE_DESC,
        PROVIDER_TYPE,
        PROVIDER_SPECIALTY,
        HIAA_POS,
        '101' AS DECISION_STEP,
        '600905' AS SUBGROUP,
        '${startTime}' AS ROW_EFFECTIVE_DATETIME
    FROM STAGEDATA.FSS_CLAIMS_DATA
    WHERE
        ((FSS_CLAIMS_DATA.ICD_DX_VERSION = '9'
        AND FSS_CLAIMS_DATA.ICD_DX_CODE NOT BETWEEN '290' AND '319.99')
        OR
        (FSS_CLAIMS_DATA.ICD_DX_VERSION = '10'
        AND SUBSTR(FSS_CLAIMS_DATA.ICD_DX_CODE,1,3) NOT BETWEEN 'F00' AND 'F99'))
            AND FSS_CLAIMS_DATA.PROVIDER_SPECIALTY IN ('SPEC-CARDP','SPEC-PCACA')
        AND FSS_CLAIMS_DATA.LOB_CODE = 'CHC'
) AS source
ON target.DIM_CLAIM_DETAIL_KEY = source.DIM_CLAIM_DETAIL_KEY
WHEN NOT MATCHED THEN
    INSERT (
        FSS_DECISION_DATA_KEY,
        FACT_CLAIM_LINE_KEY,
        FACT_CLAIM_LINE_LAST_UPDATED_DATETIME,
        DIM_CLAIM_HEADER_KEY,
        DIM_CLAIM_HEADER_LAST_UPDATED_DATETIME,
        DIM_CLAIM_DETAIL_KEY,
        DIM_CLAIM_DETAIL_LAST_UPDATED_DATETIME,
        CLAIM_NBR,
        CLAIM_LINE_NBR,
        CLAIM_SEQUENCE_NBR,
        PROCEDURE_ADJ_CODE,
        LOB_CODE,
        CPT4_CODE,
        REVENUE_CODE,
        ICD_DX_CODE,
        ICD_DX_VERSION,
        ICD_DX_GROUP,
        ICD_PROC_CODE,
        ICD_PROC_VERSION,
        BENEFIT_CATEGORY_CODE,
        LOCATION_CODE,
        SERVICE_TYPE,
        PLACE_OF_SERVICE_CODE,
        PROVIDER_TYPE_DESC,
        PROVIDER_TYPE,
        PROVIDER_SPECIALTY,
        HIAA_POS,
        DECISION_STEP,
        SUBGROUP,
        ROW_EFFECTIVE_DATETIME
    )
    VALUES (
        source.FSS_CLAIMS_DATA_KEY,
        source.FACT_CLAIM_LINE_KEY,
        source.FACT_CLAIM_LINE_LAST_UPDATED_DATETIME,
        source.DIM_CLAIM_HEADER_KEY,
        source.DIM_CLAIM_HEADER_LAST_UPDATED_DATETIME,
        source.DIM_CLAIM_DETAIL_KEY,
        source.DIM_CLAIM_DETAIL_LAST_UPDATED_DATETIME,
        source.CLAIM_NBR,
        source.CLAIM_LINE_NBR,
        source.CLAIM_SEQUENCE_NBR,
        source.PROCEDURE_ADJ_CODE,
        source.LOB_CODE,
        source.CPT4_CODE,
        source.REVENUE_CODE,
        source.ICD_DX_CODE,
        source.ICD_DX_VERSION,
        source.ICD_DX_GROUP,
        source.ICD_PROC_CODE,
        source.ICD_PROC_VERSION,
        source.BENEFIT_CATEGORY_CODE,
        source.LOCATION_CODE,
        source.SERVICE_TYPE,
        source.PLACE_OF_SERVICE_CODE,
        source.PROVIDER_TYPE_DESC,
        source.PROVIDER_TYPE,
        source.PROVIDER_SPECIALTY,
        source.HIAA_POS,
        source.DECISION_STEP,
        source.SUBGROUP,
        source.ROW_EFFECTIVE_DATETIME
    );
`;

runMergeAndLog(sqlDecision101, '101');


