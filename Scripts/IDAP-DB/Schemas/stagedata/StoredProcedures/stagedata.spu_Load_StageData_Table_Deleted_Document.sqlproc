CREATE OR REPLACE PROCEDURE STAGEDATA.SPU_LOAD_STAGEDATA_TABLE_DELETED_DOCUMENT()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = 'STAGEDATA.DELETED_DOCUMENT';

//There is no WHEN MATCHED clause in this MERGE statement, so it is effectively just an insert. We should not see deleted documents records come in multiple times for the same URI and DELETED_TIMESTAMP values.
var sqlMergeCommand =
`MERGE INTO STAGEDATA.DELETED_DOCUMENT tgt
USING (
    SELECT 
    $1:envelope:headers:uri::string AS URI,
    $1:envelope:instance:deletedDocument AS JSON_DATA,
    $1:envelope:instance:deletedDocument:deletedTimestamp::timestamp as DELETED_DATETIME
    FROM @STAGEDATA.SNOWFLAKEDATA_MARKLOGIC
        (FILE_FORMAT => STAGEDATA.ML_JSON_FORMAT, PATTERN => '(deletedDocument).*.gz')
    ) src
ON (src.URI = tgt.URI
    AND src.DELETED_DATETIME = tgt.DELETED_DATETIME)

WHEN NOT MATCHED THEN INSERT
        (
            DELETED_DOCUMENT_KEY,
            URI, 
            JSON_DATA, 
            INSERT_DATETIME, 
            LAST_UPDATED_DATETIME,
            DELETED_DATETIME
            )
    VALUES
        (
            (SELECT IFNULL(MAX(DELETED_DOCUMENT_KEY), 0) FROM STAGEDATA.DELETED_DOCUMENT) + ROW_NUMBER() OVER (ORDER BY 1),
            src.URI, 
            src.JSON_DATA, 
            CURRENT_TIMESTAMP(), 
            CURRENT_TIMESTAMP(),
            src.DELETED_DATETIME
        )
;`;

try 
{
    //Execute Merge Command
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), result, sfStatement.getSqlText()]
        }
    );

}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[targetTableName, "TABLE", startTime, endTime, result, sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt]
        }
    );        
    throw result;
}
return result;
$$
;