CREATE OR REPLACE PROCEDURE STAGEDATA.SPU_TEMP_CLAIM_DETAIL_DEDUPE()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
/* get procedure start time and set variables */
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `STAGEDATA.CLAIM_DETAIL`;


/* Create DELETE statement to be executed */
var sqlDeleteCommand =
`
DELETE FROM STAGEDATA.CLAIM_DETAIL
WHERE CLAIM_DETAIL_KEY IN
(
SELECT CLAIM_DETAIL_KEY
FROM
    (
    WITH claimLineDups AS 
    (
    SELECT
        JSON_DATA:envelope:instance:claimDetail:claimNbr, 
        JSON_DATA:envelope:instance:claimDetail:claimLineNbr, 
        JSON_DATA:envelope:instance:claimDetail:claimSequenceNbr,
        JSON_DATA:envelope:instance:claimDetail:procedureAdj,
        LAST_UPDATED_DATETIME, 
        CLAIM_DETAIL_KEY, 
        ROW_NUMBER()
    OVER (PARTITION BY 
        JSON_DATA:envelope:instance:claimDetail:claimNbr,
        JSON_DATA:envelope:instance:claimDetail:claimLineNbr, 
        JSON_DATA:envelope:instance:claimDetail:claimSequenceNbr,
        JSON_DATA:envelope:instance:claimDetail:procedureAdj
    ORDER BY 
        JSON_DATA:envelope:instance:claimDetail:claimNbr,
        JSON_DATA:envelope:instance:claimDetail:claimLineNbr,
        JSON_DATA:envelope:instance:claimDetail:claimSequenceNbr,
        LAST_UPDATED_DATETIME DESC) RANK_NBR
    FROM STAGEDATA.CLAIM_DETAIL
    )
    SELECT CLAIM_DETAIL_KEY FROM claimLineDups
    WHERE claimLineDups.RANK_NBR = 2 )
);
`;

try 
{
    
    /*Execute DELETE Command */
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand});
    sfStatement.execute();

    var endTime = new Date().toISOString();
    var result = "Succeeded";

    /*Log results to table*/
    sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds: 
        [
            targetTableName
            ,"TABLE"
            ,startTime
            ,endTime
            ,sfStatement.getNumRowsDeleted()
            ,result
            ,sfStatement.getSqlText()
        ]
        }
    );

}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds:
        [
            targetTableName
            ,"TABLE"
            ,startTime
            ,endTime
            ,result
            ,sfStatement.getSqlText()
            ,err.code
            ,err.state
            ,err.message
            ,err.stackTraceTxt
        ]
        }
    );        
    throw result;
}
return result;
$$
;
