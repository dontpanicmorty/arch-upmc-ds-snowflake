CREATE OR REPLACE PROCEDURE STAGEDATA.SPU_LOAD_GRP_PROCEDURE_MODIFIER()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$

/* get procedure start time and set variables */

var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `STAGEDATA.GRP_PROCEDURE_MODIFIER`;

/* Create INSERT OVERWRITE statement to be executed */
var sqlInsertCommand =
`
INSERT INTO STAGEDATA.GRP_PROCEDURE_MODIFIER
    (GRP_PROCEDURE_MODIFIER_KEY, CODE_VALUE)
SELECT
(SELECT IFNULL(MAX(GRP_PROCEDURE_MODIFIER_KEY), 1000) FROM STAGEDATA.GRP_PROCEDURE_MODIFIER) + ROW_NUMBER() OVER (ORDER BY 1)
,CODE_VALUE
FROM (SELECT DISTINCT CLAIM_DETAIL_PROCEDURE_MODIFIER_CODE_GRP.CODE_VALUE
    FROM STAGEDATA.CLAIM_DETAIL_PROCEDURE_MODIFIER_CODE_GRP
        LEFT OUTER JOIN STAGEDATA.GRP_PROCEDURE_MODIFIER
            ON (GRP_PROCEDURE_MODIFIER.CODE_VALUE = CLAIM_DETAIL_PROCEDURE_MODIFIER_CODE_GRP.CODE_VALUE)
    WHERE GRP_PROCEDURE_MODIFIER.GRP_PROCEDURE_MODIFIER_KEY IS NULL
    ) T1
;`;


/* The >999 is done to not update any of the static data, inserts start at 1000 from autoincrement */

var sqlDeleteCommand =
`
DELETE FROM STAGEDATA.GRP_PROCEDURE_MODIFIER
WHERE GRP_PROCEDURE_MODIFIER_KEY > 999
AND CODE_VALUE NOT IN (SELECT CLAIM_DETAIL_PROCEDURE_MODIFIER_CODE_GRP.CODE_VALUE FROM STAGEDATA.CLAIM_DETAIL_PROCEDURE_MODIFIER_CODE_GRP)
;`;

try 
{
    /*Execute INSERT OVERRIDE Command */
    var sfStatement = snowflake.createStatement({sqlText: sqlInsertCommand});
    var resultSet = sfStatement.execute();
    var endTime = new Date().toISOString();
    
    /*Get first row of result set for logging */
    resultSet.next();

    var result = "Succeeded";

    /*Log results to table*/
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds: 
        [
            targetTableName
            ,"TABLE"
            ,startTime
            ,endTime
            ,resultSet.getColumnValueAsString("number of rows inserted")
            ,result
            ,sfStatement.getSqlText()
        ]
        }
    );

    /* You must run a seperate query to find records in the target that do not exist in the source and mark them as deleted */
    /* Execute DELETE Command */
    startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand});
    var resultSet = sfStatement.execute();
    endTime = new Date().toISOString();
    
    /* Get first row of result set for logging */
    resultSet.next();

    var result = "Succeeded";

    /* Log results to table */
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds: 
        [
            targetTableName
            ,"TABLE"
            ,startTime
            ,endTime
            ,resultSet.getColumnValueAsString("number of rows deleted")
            ,result
            ,sfStatement.getSqlText()
        ]
        }
    );

}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    /* Log results to table */
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;

    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds:
        [
            targetTableName
            ,"TABLE"
            ,startTime
            ,endTime
            ,result
            ,sfStatement.getSqlText()
            ,err.code
            ,err.state
            ,err.message
            ,err.stackTraceTxt
        ]
        }
    );        
    throw result;
}
return result;
$$
;
