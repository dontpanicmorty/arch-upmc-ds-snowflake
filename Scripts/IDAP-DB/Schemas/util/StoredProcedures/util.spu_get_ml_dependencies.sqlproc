CREATE OR REPLACE PROCEDURE UTIL.SPU_GET_ML_DEPENDENCIES(DATABASE_NAME VARCHAR, SCHEMA_NAME VARCHAR)
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
COMMENT = "Populates util.view_dependencies with all ML JSON attributes used by views"
EXECUTE AS CALLER
AS
$$
var result = "Success";
var sqlCommand = "";
try
{  
    // Get list of views    
    sqlCommand =
        `SELECT TABLE_NAME, VIEW_DEFINITION
        FROM `+ DATABASE_NAME +`.INFORMATION_SCHEMA.VIEWS
        WHERE TABLE_SCHEMA = '`+ SCHEMA_NAME +`'
        AND VIEW_DEFINITION LIKE '%JSON_DATA%';`;
    var sfStatement = snowflake.createStatement({sqlText:sqlCommand}) ;
    var viewsResult = sfStatement.execute();

    var rowCount = sfStatement.getRowCount();

    var viewsDDLArray = [];    
    var localViewName = "";
    var localSchemaName = "";
    var localDDLText = '';
    var localRowObject = {};

    // Create object from SQL results
    while(viewsResult.next())
    {
        // Get name of View
        localViewName = viewsResult.getColumnValueAsString('TABLE_NAME');
        localSchemaName = SCHEMA_NAME;
        localDDLText = viewsResult.getColumnValueAsString('VIEW_DEFINITION');

        // PUSH NAME and DDL of view to ResultSet
        localRowObject = 
        {
            "tableName": localViewName,
            "schemaName": localSchemaName,
            "ddl": localDDLText
        };
        viewsDDLArray.push(localRowObject);
    }
    var localDDLLines = []
    var localSourceName = ""
    var localPathName = ""
    var sourceRegex = /:[a-zA-z]+::/g
    var pathRegex = /envelope:[a-zA-Z0-9:]*/g
    var localLine = ""
    var resultArray = []
    var sourceCollection = ""
    
    // Split Lines of each DDL Entry
    for(view of viewsDDLArray)
    {
        sourceCollection = view.ddl.match(/FROM [a-zA-Z_]*.*[a-zA-Z_]+.[a-zA-Z_]+/g)
        localDDLLines = view.ddl.split("/n");

        // Loop over individual lines to parse out sources and targets.
        localRowObject = {}

            for(line of localDDLLines){ // check for a sourceName

                localLine = line.toString();

                if(localLine.match(sourceRegex) !== null)
                {
                    localSourceName = localLine.match(sourceRegex);

                    for(source in localSourceName)
                    {

                        localSourceName[source] = localSourceName[source].match(/[^:]+/g);

                    }


                    localRowObject.sourceName = localSourceName;
                    localPathName = localLine.match(pathRegex);
                    localRowObject.path = localPathName    
                } else 
                {
                    localRowObject.sourceName = null;
                }

                // send a row if source is found.
                if(localRowObject.sourceName)
                {
                    localRowObject.tableName = view.tableName;
                    localRowObject.schemaName = view.schemaName;
                    localRowObject.sourceCollection = sourceCollection;
                    resultArray.push(localRowObject);
                }

            }
    }
    // remove current ML_JSON_DEPENDENCIES data from table
    sqlCommand = `TRUNCATE TABLE `+ DATABASE_NAME +`.util.ML_JSON_DEPENDENCIES;`; 
    sfStatement = snowflake.createStatement
    (
        {sqlText:sqlCommand}
    );
    sfStatement.execute();

    //Insert attributes into util.ML_JSON_DEPENDENCIES        
    for(view of resultArray)
    {          
        for(source in view.sourceName)
        {
            sqlCommand =    `INSERT INTO ` + DATABASE_NAME + `.util.ML_JSON_DEPENDENCIES
                            (VIEW_CATALOG,VIEW_SCHEMA,VIEW_NAME,JSON_ATTRIBUTE_NAME,JSON_PATH) 
                            values (?,?,?,?,?);`;
            sfStatement = snowflake.createStatement
            (
                {
                sqlText:sqlCommand,
                binds:[
                    DATABASE_NAME,
                    SCHEMA_NAME,
                    view.tableName,
                    view.sourceName[source][0],
                    view.path[source]
                    ]
                }
            );

            sfStatement.execute();
            

        }

    }

result = result;

}
catch (err) 
{
    result = "FAILED: Code: " + err.code + "\n State: " + err.state;
    result += "\n Message: " + err.message;
    result += "\nStack Trace:\n" + err.stackTraceTxt;
    
    result = result;
}
return  result;
$$