CREATE OR REPLACE PROCEDURE DIMDATA.SPU_LOAD_FACT_PHARMACY_CLAIM_LINE()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = 'DIMDATA.FACT_PHARMACY_CLAIM_LINE';

// Create merge statement to be executed.
var sqlMergeCommand =
`
MERGE INTO DIMDATA.FACT_PHARMACY_CLAIM_LINE AS tgt
USING (
        SELECT
        DIM_TPA_HIERARCHY_KEY
	    ,DIM_DATA_SOURCE_KEY
	    ,CLAIM_NBR
	    ,CLAIM_SEQUENCE_NBR
    	,DIM_PHARMACY_CLAIM_HEADER_KEY
    	,DIM_PHARMACY_CLAIM_DETAIL_KEY
    	,DIM_MEMBER_KEY
    	,DIM_GROUP_KEY
    	,DIM_SUB_GROUP_KEY
    	,DIM_DRUG_KEY
    	,DIM_MEMBER_DEMOGRAPHIC_KEY
    	,DIM_RIDER_KEY
    	,DIM_PLAN_KEY
    	,DIM_ENROLLMENT_SPAN_KEY
		,DIM_PROVIDER_PHARMACY_KEY
		,DIM_PROVIDER_ADDRESS_PHARMACY_KEY
		,DIM_PROVIDER_CONTACT_INFO_PHARMACY_KEY
		,DIM_PROVIDER_IDENTIFIER_PHARMACY_NABP_NBR_KEY
		,DIM_PROVIDER_IDENTIFIER_PHARMACY_NPI_KEY
		,DIM_PROVIDER_PRESCRIBER_KEY
		,DIM_PROVIDER_ADDRESS_PRESCRIBER_MAILING_KEY
		,DIM_PROVIDER_ADDRESS_PRESCRIBER_PRACTICE_KEY
		,DIM_PROVIDER_CONTACT_INFO_PRESCRIBER_MAILING_KEY
		,DIM_PROVIDER_CONTACT_INFO_PRESCRIBER_PRACTICE_KEY
		,DIM_PROVIDER_IDENTIFIER_PRESCRIBER_NPI_KEY
		,DIM_PROVIDER_TAXONOMY_PRESCRIBER_KEY
    	,DIM_FILLED_DATE_KEY
    	,DIM_PAYMENT_DATE_KEY
    	,DIM_RECEIVED_DATE_KEY
    	,DIM_ADJUDICATION_DATE_KEY
    	,DIM_PRESCRIPTION_WRITTEN_DATE_KEY
		,REPORT_EFFECTIVE_DATE
    	,FILLED_DATE
    	,PAYMENT_DATE
    	,RECEIVED_DATE
    	,ADJUDICATION_DATE
    	,PRESCRIPTION_WRITTEN_DATE
    	,PHARMACY_CLAIM_CNT
    	,CHARGE_AMT
    	,COPAY_AMT
    	,DEDUCTIBLE_AMT
    	,COINSURANCE_AMT
	    ,DAY_SUPPLY_CNT
    	,INGREDIENT_COST_AMT
    	,SALES_TAX_AMT
    	,DISPENSING_FEE_AMT
    	,NET_CHECK_DUE_AMT
    	,DRUG_METRIC_QTY
    	,PRODUCT_SELECTION_AMT
    	,BENEFIT_EXCEED_AMT
    	,AWP_UNIT_AMT
    	,UNIT_PRICE_ALLOWED_MAX_AMT
    	,USUAL_CUSTOMARY_AMT
    	,ADMINISTRATIVE_FEE_AMT
    	,AWP_TOTAL_AMT
    	,HRA_APPLIED_AMT
    	,PRE_COB_CLAIM_AMT
    	,COB_RECOVERY_AMT
    	,DRUG_CALCULATED_DISCOUNT_AMT
    	,DRUG_DISCOUNT_ELIGIBLE_AMT
    	,HRA_SPENDING_AMT
		,HRA_SPENDING_AMT_UPDATE_DATE
    	,HIA_SPENDING_AMT
		,HIA_SPENDING_AMT_UPDATE_DATE
		,TOTAL_SPENDING_AMT
    	,OTHER_PAYOR_AMT
    	,TROOP_APPLIED_AMT
		,MEMBER_PAID_AMT
        FROM STAGEDATA.FACT_PHARMACY_CLAIM_LINE_SELECT_VW
	MINUS
  SELECT DIM_TPA_HIERARCHY_KEY
	    ,DIM_DATA_SOURCE_KEY
	    ,CLAIM_NBR
	    ,CLAIM_SEQUENCE_NBR
    	,DIM_PHARMACY_CLAIM_HEADER_KEY
    	,DIM_PHARMACY_CLAIM_DETAIL_KEY
    	,DIM_MEMBER_KEY
    	,DIM_GROUP_KEY
    	,DIM_SUB_GROUP_KEY
    	,DIM_DRUG_KEY
    	,DIM_MEMBER_DEMOGRAPHIC_KEY
    	,DIM_RIDER_KEY
    	,DIM_PLAN_KEY
    	,DIM_ENROLLMENT_SPAN_KEY
		,DIM_PROVIDER_PHARMACY_KEY
		,DIM_PROVIDER_ADDRESS_PHARMACY_KEY
		,DIM_PROVIDER_CONTACT_INFO_PHARMACY_KEY
		,DIM_PROVIDER_IDENTIFIER_PHARMACY_NABP_NBR_KEY
		,DIM_PROVIDER_IDENTIFIER_PHARMACY_NPI_KEY
		,DIM_PROVIDER_PRESCRIBER_KEY
		,DIM_PROVIDER_ADDRESS_PRESCRIBER_MAILING_KEY
		,DIM_PROVIDER_ADDRESS_PRESCRIBER_PRACTICE_KEY
		,DIM_PROVIDER_CONTACT_INFO_PRESCRIBER_MAILING_KEY
		,DIM_PROVIDER_CONTACT_INFO_PRESCRIBER_PRACTICE_KEY
		,DIM_PROVIDER_IDENTIFIER_PRESCRIBER_NPI_KEY
		,DIM_PROVIDER_TAXONOMY_PRESCRIBER_KEY
    	,DIM_FILLED_DATE_KEY
    	,DIM_PAYMENT_DATE_KEY
    	,DIM_RECEIVED_DATE_KEY
    	,DIM_ADJUDICATION_DATE_KEY
    	,DIM_PRESCRIPTION_WRITTEN_DATE_KEY
		,REPORT_EFFECTIVE_DATE
    	,FILLED_DATE
    	,PAYMENT_DATE
    	,RECEIVED_DATE
    	,ADJUDICATION_DATE
    	,PRESCRIPTION_WRITTEN_DATE
    	,PHARMACY_CLAIM_CNT
    	,CHARGE_AMT
    	,COPAY_AMT
    	,DEDUCTIBLE_AMT
    	,COINSURANCE_AMT
	    ,DAY_SUPPLY_CNT
    	,INGREDIENT_COST_AMT
    	,SALES_TAX_AMT
    	,DISPENSING_FEE_AMT
    	,NET_CHECK_DUE_AMT
    	,DRUG_METRIC_QTY
    	,PRODUCT_SELECTION_AMT
    	,BENEFIT_EXCEED_AMT
    	,AWP_UNIT_AMT
    	,UNIT_PRICE_ALLOWED_MAX_AMT
    	,USUAL_CUSTOMARY_AMT
    	,ADMINISTRATIVE_FEE_AMT
    	,AWP_TOTAL_AMT
    	,HRA_APPLIED_AMT
    	,PRE_COB_CLAIM_AMT
    	,COB_RECOVERY_AMT
    	,DRUG_CALCULATED_DISCOUNT_AMT
    	,DRUG_DISCOUNT_ELIGIBLE_AMT
    	,HRA_SPENDING_AMT
		,HRA_SPENDING_AMT_UPDATE_DATE
    	,HIA_SPENDING_AMT
		,HIA_SPENDING_AMT_UPDATE_DATE
		,TOTAL_SPENDING_AMT
    	,OTHER_PAYOR_AMT
    	,TROOP_APPLIED_AMT
		,MEMBER_PAID_AMT
		FROM DIMDATA.FACT_PHARMACY_CLAIM_LINE
    ) AS src
ON (src.DIM_PHARMACY_CLAIM_DETAIL_KEY = tgt.DIM_PHARMACY_CLAIM_DETAIL_KEY) 
    
WHEN MATCHED AND 
	(
		tgt.DIM_TPA_HIERARCHY_KEY <> src.DIM_TPA_HIERARCHY_KEY
		OR tgt.DIM_DATA_SOURCE_KEY <> src.DIM_DATA_SOURCE_KEY
		OR tgt.CLAIM_NBR <> src.CLAIM_NBR
		OR tgt.CLAIM_SEQUENCE_NBR <> src.CLAIM_SEQUENCE_NBR
		OR tgt.DIM_PHARMACY_CLAIM_HEADER_KEY <> src.DIM_PHARMACY_CLAIM_HEADER_KEY
		OR tgt.DIM_PHARMACY_CLAIM_DETAIL_KEY <> src.DIM_PHARMACY_CLAIM_DETAIL_KEY
		OR tgt.DIM_MEMBER_KEY <> src.DIM_MEMBER_KEY
		OR tgt.DIM_GROUP_KEY <> src.DIM_GROUP_KEY
		OR tgt.DIM_SUB_GROUP_KEY <> src.DIM_SUB_GROUP_KEY
		OR tgt.DIM_DRUG_KEY <> src.DIM_DRUG_KEY
		OR tgt.DIM_MEMBER_DEMOGRAPHIC_KEY <> src.DIM_MEMBER_DEMOGRAPHIC_KEY
		OR tgt.DIM_RIDER_KEY <> src.DIM_RIDER_KEY
		OR tgt.DIM_PLAN_KEY <> src.DIM_PLAN_KEY
		OR tgt.DIM_ENROLLMENT_SPAN_KEY <> src.DIM_ENROLLMENT_SPAN_KEY
		OR tgt.DIM_PROVIDER_PHARMACY_KEY <> src.DIM_PROVIDER_PHARMACY_KEY
		OR tgt.DIM_PROVIDER_ADDRESS_PHARMACY_KEY <> src.DIM_PROVIDER_ADDRESS_PHARMACY_KEY
		OR tgt.DIM_PROVIDER_CONTACT_INFO_PHARMACY_KEY <> src.DIM_PROVIDER_CONTACT_INFO_PHARMACY_KEY
		OR tgt.DIM_PROVIDER_IDENTIFIER_PHARMACY_NABP_NBR_KEY <> src.DIM_PROVIDER_IDENTIFIER_PHARMACY_NABP_NBR_KEY
		OR tgt.DIM_PROVIDER_IDENTIFIER_PHARMACY_NPI_KEY <> src.DIM_PROVIDER_IDENTIFIER_PHARMACY_NPI_KEY
		OR tgt.DIM_PROVIDER_PRESCRIBER_KEY <> src.DIM_PROVIDER_PRESCRIBER_KEY
		OR tgt.DIM_PROVIDER_ADDRESS_PRESCRIBER_MAILING_KEY <> src.DIM_PROVIDER_ADDRESS_PRESCRIBER_MAILING_KEY
		OR tgt.DIM_PROVIDER_ADDRESS_PRESCRIBER_PRACTICE_KEY <> src.DIM_PROVIDER_ADDRESS_PRESCRIBER_PRACTICE_KEY
		OR tgt.DIM_PROVIDER_CONTACT_INFO_PRESCRIBER_MAILING_KEY <> src.DIM_PROVIDER_CONTACT_INFO_PRESCRIBER_MAILING_KEY
		OR tgt.DIM_PROVIDER_CONTACT_INFO_PRESCRIBER_PRACTICE_KEY <> src.DIM_PROVIDER_CONTACT_INFO_PRESCRIBER_PRACTICE_KEY
		OR tgt.DIM_PROVIDER_IDENTIFIER_PRESCRIBER_NPI_KEY <> src.DIM_PROVIDER_IDENTIFIER_PRESCRIBER_NPI_KEY
		OR tgt.DIM_PROVIDER_TAXONOMY_PRESCRIBER_KEY <> src.DIM_PROVIDER_TAXONOMY_PRESCRIBER_KEY
		OR tgt.DIM_FILLED_DATE_KEY <> src.DIM_FILLED_DATE_KEY
		OR tgt.DIM_PAYMENT_DATE_KEY <> src.DIM_PAYMENT_DATE_KEY
		OR tgt.DIM_RECEIVED_DATE_KEY <> src.DIM_RECEIVED_DATE_KEY
		OR tgt.DIM_ADJUDICATION_DATE_KEY <> src.DIM_ADJUDICATION_DATE_KEY
		OR tgt.DIM_PRESCRIPTION_WRITTEN_DATE_KEY <> src.DIM_PRESCRIPTION_WRITTEN_DATE_KEY
		OR NOT EQUAL_NULL(tgt.PHARMACY_CLAIM_CNT, src.PHARMACY_CLAIM_CNT)
		OR NOT EQUAL_NULL(tgt.CHARGE_AMT, src.CHARGE_AMT)
		OR NOT EQUAL_NULL(tgt.COPAY_AMT, src.COPAY_AMT)
		OR NOT EQUAL_NULL(tgt.DEDUCTIBLE_AMT, src.DEDUCTIBLE_AMT)
		OR NOT EQUAL_NULL(tgt.COINSURANCE_AMT, src.COINSURANCE_AMT)
		OR NOT EQUAL_NULL(tgt.DAY_SUPPLY_CNT, src.DAY_SUPPLY_CNT)
		OR NOT EQUAL_NULL(tgt.INGREDIENT_COST_AMT, src.INGREDIENT_COST_AMT)
		OR NOT EQUAL_NULL(tgt.SALES_TAX_AMT, src.SALES_TAX_AMT)
		OR NOT EQUAL_NULL(tgt.DISPENSING_FEE_AMT, src.DISPENSING_FEE_AMT)
		OR NOT EQUAL_NULL(tgt.NET_CHECK_DUE_AMT, src.NET_CHECK_DUE_AMT)
		OR NOT EQUAL_NULL(tgt.DRUG_METRIC_QTY, src.DRUG_METRIC_QTY)
		OR NOT EQUAL_NULL(tgt.PRODUCT_SELECTION_AMT, src.PRODUCT_SELECTION_AMT)
		OR NOT EQUAL_NULL(tgt.BENEFIT_EXCEED_AMT, src.BENEFIT_EXCEED_AMT)
		OR NOT EQUAL_NULL(tgt.AWP_UNIT_AMT, src.AWP_UNIT_AMT)
		OR NOT EQUAL_NULL(tgt.UNIT_PRICE_ALLOWED_MAX_AMT, src.UNIT_PRICE_ALLOWED_MAX_AMT)
		OR NOT EQUAL_NULL(tgt.USUAL_CUSTOMARY_AMT, src.USUAL_CUSTOMARY_AMT)
		OR NOT EQUAL_NULL(tgt.ADMINISTRATIVE_FEE_AMT, src.ADMINISTRATIVE_FEE_AMT)
		OR NOT EQUAL_NULL(tgt.AWP_TOTAL_AMT, src.AWP_TOTAL_AMT)
		OR NOT EQUAL_NULL(tgt.HRA_APPLIED_AMT, src.HRA_APPLIED_AMT)
		OR NOT EQUAL_NULL(tgt.PRE_COB_CLAIM_AMT, src.PRE_COB_CLAIM_AMT)
		OR NOT EQUAL_NULL(tgt.COB_RECOVERY_AMT, src.COB_RECOVERY_AMT)
		OR NOT EQUAL_NULL(tgt.DRUG_CALCULATED_DISCOUNT_AMT, src.DRUG_CALCULATED_DISCOUNT_AMT)
		OR NOT EQUAL_NULL(tgt.DRUG_DISCOUNT_ELIGIBLE_AMT, src.DRUG_DISCOUNT_ELIGIBLE_AMT)
		OR NOT EQUAL_NULL(tgt.HRA_SPENDING_AMT, src.HRA_SPENDING_AMT)
		OR NOT EQUAL_NULL(tgt.HRA_SPENDING_AMT_UPDATE_DATE, src.HRA_SPENDING_AMT_UPDATE_DATE)
		OR NOT EQUAL_NULL(tgt.HIA_SPENDING_AMT, src.HIA_SPENDING_AMT)
		OR NOT EQUAL_NULL(tgt.HIA_SPENDING_AMT_UPDATE_DATE, src.HIA_SPENDING_AMT_UPDATE_DATE)
		OR NOT EQUAL_NULL(tgt.TOTAL_SPENDING_AMT, src.TOTAL_SPENDING_AMT)
		OR NOT EQUAL_NULL(tgt.OTHER_PAYOR_AMT, src.OTHER_PAYOR_AMT)
		OR NOT EQUAL_NULL(tgt.TROOP_APPLIED_AMT, src.TROOP_APPLIED_AMT)
		OR NOT EQUAL_NULL(tgt.MEMBER_PAID_AMT, src.MEMBER_PAID_AMT)
		OR NOT EQUAL_NULL(tgt.REPORT_EFFECTIVE_DATE, src.REPORT_EFFECTIVE_DATE)
		OR NOT EQUAL_NULL(tgt.FILLED_DATE, src.FILLED_DATE)
		OR NOT EQUAL_NULL(tgt.PAYMENT_DATE, src.PAYMENT_DATE)
		OR NOT EQUAL_NULL(tgt.RECEIVED_DATE, src.RECEIVED_DATE)
		OR NOT EQUAL_NULL(tgt.ADJUDICATION_DATE, src.ADJUDICATION_DATE)
		OR NOT EQUAL_NULL(tgt.PRESCRIPTION_WRITTEN_DATE, src.PRESCRIPTION_WRITTEN_DATE)
	)

THEN UPDATE SET
		tgt.LAST_UPDATED_DATETIME = CURRENT_TIMESTAMP(),
		tgt.DIM_TPA_HIERARCHY_KEY = src.DIM_TPA_HIERARCHY_KEY,
		tgt.DIM_DATA_SOURCE_KEY = src.DIM_DATA_SOURCE_KEY,
		tgt.CLAIM_NBR = src.CLAIM_NBR,
		tgt.CLAIM_SEQUENCE_NBR = src.CLAIM_SEQUENCE_NBR,
		tgt.DIM_PHARMACY_CLAIM_HEADER_KEY = src.DIM_PHARMACY_CLAIM_HEADER_KEY,
		tgt.DIM_PHARMACY_CLAIM_DETAIL_KEY = src.DIM_PHARMACY_CLAIM_DETAIL_KEY,
		tgt.DIM_MEMBER_KEY = src.DIM_MEMBER_KEY,
		tgt.DIM_GROUP_KEY = src.DIM_GROUP_KEY,
		tgt.DIM_SUB_GROUP_KEY = src.DIM_SUB_GROUP_KEY,
		tgt.DIM_DRUG_KEY = src.DIM_DRUG_KEY,
		tgt.DIM_MEMBER_DEMOGRAPHIC_KEY = src.DIM_MEMBER_DEMOGRAPHIC_KEY,
		tgt.DIM_RIDER_KEY = src.DIM_RIDER_KEY,
		tgt.DIM_PLAN_KEY = src.DIM_PLAN_KEY,
		tgt.DIM_ENROLLMENT_SPAN_KEY = src.DIM_ENROLLMENT_SPAN_KEY,
		tgt.DIM_PROVIDER_PHARMACY_KEY = src.DIM_PROVIDER_PHARMACY_KEY,
		tgt.DIM_PROVIDER_ADDRESS_PHARMACY_KEY = src.DIM_PROVIDER_ADDRESS_PHARMACY_KEY,
		tgt.DIM_PROVIDER_CONTACT_INFO_PHARMACY_KEY = src.DIM_PROVIDER_CONTACT_INFO_PHARMACY_KEY,
		tgt.DIM_PROVIDER_IDENTIFIER_PHARMACY_NABP_NBR_KEY = src.DIM_PROVIDER_IDENTIFIER_PHARMACY_NABP_NBR_KEY,
		tgt.DIM_PROVIDER_IDENTIFIER_PHARMACY_NPI_KEY = src.DIM_PROVIDER_IDENTIFIER_PHARMACY_NPI_KEY,
		tgt.DIM_PROVIDER_PRESCRIBER_KEY = src.DIM_PROVIDER_PRESCRIBER_KEY,
		tgt.DIM_PROVIDER_ADDRESS_PRESCRIBER_MAILING_KEY = src.DIM_PROVIDER_ADDRESS_PRESCRIBER_MAILING_KEY,
		tgt.DIM_PROVIDER_ADDRESS_PRESCRIBER_PRACTICE_KEY = src.DIM_PROVIDER_ADDRESS_PRESCRIBER_PRACTICE_KEY,
		tgt.DIM_PROVIDER_CONTACT_INFO_PRESCRIBER_MAILING_KEY = src.DIM_PROVIDER_CONTACT_INFO_PRESCRIBER_MAILING_KEY,
		tgt.DIM_PROVIDER_CONTACT_INFO_PRESCRIBER_PRACTICE_KEY = src.DIM_PROVIDER_CONTACT_INFO_PRESCRIBER_PRACTICE_KEY,
		tgt.DIM_PROVIDER_IDENTIFIER_PRESCRIBER_NPI_KEY = src.DIM_PROVIDER_IDENTIFIER_PRESCRIBER_NPI_KEY,
		tgt.DIM_PROVIDER_TAXONOMY_PRESCRIBER_KEY = src.DIM_PROVIDER_TAXONOMY_PRESCRIBER_KEY,
		tgt.DIM_FILLED_DATE_KEY = src.DIM_FILLED_DATE_KEY,
		tgt.DIM_PAYMENT_DATE_KEY = src.DIM_PAYMENT_DATE_KEY,
		tgt.DIM_RECEIVED_DATE_KEY = src.DIM_RECEIVED_DATE_KEY,
		tgt.DIM_ADJUDICATION_DATE_KEY = src.DIM_ADJUDICATION_DATE_KEY,
		tgt.DIM_PRESCRIPTION_WRITTEN_DATE_KEY = src.DIM_PRESCRIPTION_WRITTEN_DATE_KEY,
		tgt.REPORT_EFFECTIVE_DATE = src.REPORT_EFFECTIVE_DATE,
		tgt.FILLED_DATE = src.FILLED_DATE,
		tgt.PAYMENT_DATE = src.PAYMENT_DATE,
		tgt.RECEIVED_DATE = src.RECEIVED_DATE,
		tgt.ADJUDICATION_DATE = src.ADJUDICATION_DATE,
		tgt.PRESCRIPTION_WRITTEN_DATE = src.PRESCRIPTION_WRITTEN_DATE,
		tgt.PHARMACY_CLAIM_CNT = src.PHARMACY_CLAIM_CNT,
		tgt.CHARGE_AMT = src.CHARGE_AMT,
		tgt.COPAY_AMT = src.COPAY_AMT,
		tgt.DEDUCTIBLE_AMT = src.DEDUCTIBLE_AMT,
		tgt.COINSURANCE_AMT = src.COINSURANCE_AMT,
		tgt.DAY_SUPPLY_CNT = src.DAY_SUPPLY_CNT,
		tgt.INGREDIENT_COST_AMT = src.INGREDIENT_COST_AMT,
		tgt.SALES_TAX_AMT = src.SALES_TAX_AMT,
		tgt.DISPENSING_FEE_AMT = src.DISPENSING_FEE_AMT,
		tgt.NET_CHECK_DUE_AMT = src.NET_CHECK_DUE_AMT,
		tgt.DRUG_METRIC_QTY = src.DRUG_METRIC_QTY,
		tgt.PRODUCT_SELECTION_AMT = src.PRODUCT_SELECTION_AMT,
		tgt.BENEFIT_EXCEED_AMT = src.BENEFIT_EXCEED_AMT,
		tgt.AWP_UNIT_AMT = src.AWP_UNIT_AMT,
		tgt.UNIT_PRICE_ALLOWED_MAX_AMT = src.UNIT_PRICE_ALLOWED_MAX_AMT,
		tgt.USUAL_CUSTOMARY_AMT = src.USUAL_CUSTOMARY_AMT,
		tgt.ADMINISTRATIVE_FEE_AMT = src.ADMINISTRATIVE_FEE_AMT,
		tgt.AWP_TOTAL_AMT = src.AWP_TOTAL_AMT,
		tgt.HRA_APPLIED_AMT = src.HRA_APPLIED_AMT,
		tgt.PRE_COB_CLAIM_AMT = src.PRE_COB_CLAIM_AMT,
		tgt.COB_RECOVERY_AMT = src.COB_RECOVERY_AMT,
		tgt.DRUG_CALCULATED_DISCOUNT_AMT = src.DRUG_CALCULATED_DISCOUNT_AMT,
		tgt.DRUG_DISCOUNT_ELIGIBLE_AMT = src.DRUG_DISCOUNT_ELIGIBLE_AMT,
		tgt.HRA_SPENDING_AMT = src.HRA_SPENDING_AMT,
		tgt.HRA_SPENDING_AMT_UPDATE_DATE = src.HRA_SPENDING_AMT_UPDATE_DATE,
		tgt.HIA_SPENDING_AMT = src.HIA_SPENDING_AMT,
		tgt.HIA_SPENDING_AMT_UPDATE_DATE = src.HIA_SPENDING_AMT_UPDATE_DATE,
		tgt.TOTAL_SPENDING_AMT = src.TOTAL_SPENDING_AMT,
		tgt.OTHER_PAYOR_AMT = src.OTHER_PAYOR_AMT,
		tgt.TROOP_APPLIED_AMT = src.TROOP_APPLIED_AMT,
		tgt.MEMBER_PAID_AMT = src.MEMBER_PAID_AMT

WHEN NOT MATCHED

THEN INSERT
    (
		FACT_PHARMACY_CLAIM_LINE_KEY
		,INSERT_DATETIME
		,LAST_UPDATED_DATETIME
		,DIM_TPA_HIERARCHY_KEY
		,DIM_DATA_SOURCE_KEY
