    	,HRA_SPENDING_AMT
		,HRA_SPENDING_AMT_UPDATE_DATE
    	,HIA_SPENDING_AMT
		,HIA_SPENDING_AMT_UPDATE_DATE
		,TOTAL_SPENDING_AMT
		,OTHER_PAYOR_AMT
		,TROOP_APPLIED_AMT
		,MEMBER_PAID_AMT
	)
VALUES
    (
		(SELECT IFNULL(MAX(FACT_PHARMACY_CLAIM_LINE_KEY), 1000) FROM DIMDATA.FACT_PHARMACY_CLAIM_LINE) + ROW_NUMBER() OVER (ORDER BY 1)
		,CURRENT_TIMESTAMP()
		,CURRENT_TIMESTAMP()
		,src.DIM_TPA_HIERARCHY_KEY
		,src.DIM_DATA_SOURCE_KEY
		,src.CLAIM_NBR
		,src.CLAIM_SEQUENCE_NBR
		,src.DIM_PHARMACY_CLAIM_HEADER_KEY
		,src.DIM_PHARMACY_CLAIM_DETAIL_KEY
		,src.DIM_MEMBER_KEY
		,src.DIM_GROUP_KEY
		,src.DIM_SUB_GROUP_KEY
		,src.DIM_DRUG_KEY
		,src.DIM_MEMBER_DEMOGRAPHIC_KEY
		,src.DIM_RIDER_KEY
		,src.DIM_PLAN_KEY
		,src.DIM_ENROLLMENT_SPAN_KEY
		,src.DIM_PROVIDER_PHARMACY_KEY
		,src.DIM_PROVIDER_ADDRESS_PHARMACY_KEY
		,src.DIM_PROVIDER_CONTACT_INFO_PHARMACY_KEY
		,src.DIM_PROVIDER_IDENTIFIER_PHARMACY_NABP_NBR_KEY
		,src.DIM_PROVIDER_IDENTIFIER_PHARMACY_NPI_KEY
		,src.DIM_PROVIDER_PRESCRIBER_KEY
		,src.DIM_PROVIDER_ADDRESS_PRESCRIBER_MAILING_KEY
		,src.DIM_PROVIDER_ADDRESS_PRESCRIBER_PRACTICE_KEY
		,src.DIM_PROVIDER_CONTACT_INFO_PRESCRIBER_MAILING_KEY
		,src.DIM_PROVIDER_CONTACT_INFO_PRESCRIBER_PRACTICE_KEY
		,src.DIM_PROVIDER_IDENTIFIER_PRESCRIBER_NPI_KEY
		,src.DIM_PROVIDER_TAXONOMY_PRESCRIBER_KEY
		,src.DIM_FILLED_DATE_KEY
		,src.DIM_PAYMENT_DATE_KEY
		,src.DIM_RECEIVED_DATE_KEY
		,src.DIM_ADJUDICATION_DATE_KEY
		,src.DIM_PRESCRIPTION_WRITTEN_DATE_KEY
		,src.REPORT_EFFECTIVE_DATE
		,src.FILLED_DATE
		,src.PAYMENT_DATE
		,src.RECEIVED_DATE
		,src.ADJUDICATION_DATE
		,src.PRESCRIPTION_WRITTEN_DATE
		,src.PHARMACY_CLAIM_CNT
		,src.CHARGE_AMT
		,src.COPAY_AMT
		,src.DEDUCTIBLE_AMT
		,src.COINSURANCE_AMT
		,src.DAY_SUPPLY_CNT
		,src.INGREDIENT_COST_AMT
		,src.SALES_TAX_AMT
		,src.DISPENSING_FEE_AMT
		,src.NET_CHECK_DUE_AMT
		,src.DRUG_METRIC_QTY
		,src.PRODUCT_SELECTION_AMT
		,src.BENEFIT_EXCEED_AMT
		,src.AWP_UNIT_AMT
		,src.UNIT_PRICE_ALLOWED_MAX_AMT
		,src.USUAL_CUSTOMARY_AMT
		,src.ADMINISTRATIVE_FEE_AMT
		,src.AWP_TOTAL_AMT
		,src.HRA_APPLIED_AMT
		,src.PRE_COB_CLAIM_AMT
		,src.COB_RECOVERY_AMT
		,src.DRUG_CALCULATED_DISCOUNT_AMT
		,src.DRUG_DISCOUNT_ELIGIBLE_AMT
    	,src.HRA_SPENDING_AMT
		,src.HRA_SPENDING_AMT_UPDATE_DATE
    	,src.HIA_SPENDING_AMT
		,src.HIA_SPENDING_AMT_UPDATE_DATE
		,src.TOTAL_SPENDING_AMT
		,src.OTHER_PAYOR_AMT
		,src.TROOP_APPLIED_AMT
		,src.MEMBER_PAID_AMT
	)
;`;

// set delete command which will physically delete fact_pharmacy_claim_line records whose corresponding dim_claim_detail_key records have been logically-deleted
var sqlDeleteCommand =
`
DELETE FROM DIMDATA.FACT_PHARMACY_CLAIM_LINE
WHERE FACT_PHARMACY_CLAIM_LINE_KEY IN
(
    SELECT
    FACT_PHARMACY_CLAIM_LINE.FACT_PHARMACY_CLAIM_LINE_KEY
    FROM DIMDATA.FACT_PHARMACY_CLAIM_LINE
    LEFT OUTER JOIN DIMDATA.DIM_PHARMACY_CLAIM_DETAIL
            ON (DIM_PHARMACY_CLAIM_DETAIL.DIM_PHARMACY_CLAIM_DETAIL_KEY = FACT_PHARMACY_CLAIM_LINE.DIM_PHARMACY_CLAIM_DETAIL_KEY)
    WHERE DIM_PHARMACY_CLAIM_DETAIL.DIM_PHARMACY_CLAIM_DETAIL_KEY IS NULL
    OR DIM_PHARMACY_CLAIM_DETAIL.IS_LOGICAL_DELETE_FLAG = TRUE
)
;`;

//Log results to table
var sqlLogCommand = 
`
INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
    (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT)
    VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9)
;`;

try  
{
    //Execute Merge Command
    var startTime = new Date().toISOString();
    var targetTableName = `DIMDATA.FACT_PHARMACY_CLAIM_LINE`;
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText()]
        }
    );

    //Execute Delete Command
    var startTime = new Date().toISOString();
    var targetTableName = `DIMDATA.FACT_PHARMACY_CLAIM_LINE`;
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";
	
    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText()]
        }
    );

}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[targetTableName, "TABLE", startTime, endTime, result, sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt]
        }
    );        
    throw result;
}
return result;
$$
;