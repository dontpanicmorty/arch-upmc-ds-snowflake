    INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
    (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT)
    VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6);`;
    
    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds: 
            [
            procedureName
            ,"Procedure"
            ,startTime
            ,endTime
            ,result
            ,procedureName
            ]
        }
    );
}
catch (err)
{
    var endTime = new Date().toISOString();
    var result = "Failed";
    
    //log results to table
    var sqlLogCommand = `
        INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
            (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;
    
    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds: 
            [
            procedureName
            ,"Procedure"
            ,startTime
            ,endTime
            ,result
            ,procedureName
            ,err.code
            ,err.state
            ,err.message
            ,err.stackTraceTxt
            ]
        }
    );        
    return result;
}
return result;
    
