CREATE OR REPLACE PROCEDURE DIMDATA.SPU_LOAD_DIM_MEMBER_DEMOGRAPHIC()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = "DIMDATA.DIM_MEMBER_DEMOGRAPHIC";

// Create merge statement to be executed.
var sqlMergeCommand =
`
MERGE INTO DIMDATA.DIM_MEMBER_DEMOGRAPHIC AS tgt
USING (
        SELECT
        FALSE AS IS_LOGICAL_DELETE_FLAG
        ,AGE AS MEMBER_AGE
        ,GENDER_CODE AS MEMBER_GENDER_CODE
        ,ACTUARIAL_AGE_RANGE
        ,CLINICAL_AGE_RANGE
        ,FINANCIAL_AGE_RANGE
        ,MEDICARE_HCFA_AGE_RANGE
        ,MEDICARE_RATE_AGE_RANGE
        FROM STAGEDATA.MEMBER_DEMOGRAPHIC_VW
    MINUS
        SELECT
        IS_LOGICAL_DELETE_FLAG
        ,MEMBER_AGE
        ,MEMBER_GENDER_CODE
        ,ACTUARIAL_AGE_RANGE
        ,CLINICAL_AGE_RANGE
        ,FINANCIAL_AGE_RANGE
        ,MEDICARE_HCFA_AGE_RANGE
        ,MEDICARE_RATE_AGE_RANGE
        FROM DIMDATA.DIM_MEMBER_DEMOGRAPHIC
    ) AS src
ON (src.MEMBER_AGE = tgt.MEMBER_AGE 
AND src.MEMBER_GENDER_CODE = tgt.MEMBER_GENDER_CODE)

WHEN MATCHED

THEN UPDATE SET
    tgt.LAST_UPDATED_DATETIME = CURRENT_TIMESTAMP(),
    tgt.IS_LOGICAL_DELETE_FLAG = FALSE,
    tgt.ACTUARIAL_AGE_RANGE = src.ACTUARIAL_AGE_RANGE,
    tgt.CLINICAL_AGE_RANGE = src.CLINICAL_AGE_RANGE,
    tgt.FINANCIAL_AGE_RANGE = src.FINANCIAL_AGE_RANGE,
    tgt.MEDICARE_RATE_AGE_RANGE = src.MEDICARE_RATE_AGE_RANGE,
    tgt.MEDICARE_HCFA_AGE_RANGE = src.MEDICARE_HCFA_AGE_RANGE

WHEN NOT MATCHED

THEN INSERT
    (
        DIM_MEMBER_DEMOGRAPHIC_KEY
        ,INSERT_DATETIME
        ,LAST_UPDATED_DATETIME
        ,IS_LOGICAL_DELETE_FLAG
        ,MEMBER_AGE
        ,MEMBER_GENDER_CODE
        ,ACTUARIAL_AGE_RANGE
        ,CLINICAL_AGE_RANGE
        ,FINANCIAL_AGE_RANGE
        ,MEDICARE_RATE_AGE_RANGE
        ,MEDICARE_HCFA_AGE_RANGE
    )
VALUES
    (
        (SELECT IFNULL(MAX(DIM_MEMBER_DEMOGRAPHIC_KEY), 1000) FROM DIMDATA.DIM_MEMBER_DEMOGRAPHIC) + ROW_NUMBER() OVER (ORDER BY 1)        
        ,CURRENT_TIMESTAMP()
        ,CURRENT_TIMESTAMP()
        ,FALSE
        ,src.MEMBER_AGE
        ,src.MEMBER_GENDER_CODE
        ,src.ACTUARIAL_AGE_RANGE
        ,src.CLINICAL_AGE_RANGE
        ,src.FINANCIAL_AGE_RANGE
        ,src.MEDICARE_RATE_AGE_RANGE
        ,src.MEDICARE_HCFA_AGE_RANGE
    )
;`;

// set delete command which will update to is_logical_delete to true
var sqlDeleteCommand =
`
UPDATE DIMDATA.DIM_MEMBER_DEMOGRAPHIC
SET IS_LOGICAL_DELETE_FLAG = TRUE, LAST_UPDATED_DATETIME  = CURRENT_TIMESTAMP()
WHERE DIM_MEMBER_DEMOGRAPHIC_KEY IN
(
    SELECT
    DIM_MEMBER_DEMOGRAPHIC.DIM_MEMBER_DEMOGRAPHIC_KEY
    FROM DIMDATA.DIM_MEMBER_DEMOGRAPHIC
        LEFT OUTER JOIN (
            SELECT
            AGE AS MEMBER_AGE
            ,GENDER_CODE AS MEMBER_GENDER_CODE
            ,URI
            FROM STAGEDATA.MEMBER_DEMOGRAPHIC_VW
            ) STAGE_DATA
            ON (STAGE_DATA.MEMBER_AGE = DIM_MEMBER_DEMOGRAPHIC.MEMBER_AGE
            AND STAGE_DATA.MEMBER_GENDER_CODE = DIM_MEMBER_DEMOGRAPHIC.MEMBER_GENDER_CODE)
    WHERE STAGE_DATA.URI IS NULL
    AND DIM_MEMBER_DEMOGRAPHIC.IS_LOGICAL_DELETE_FLAG = FALSE
    AND DIM_MEMBER_DEMOGRAPHIC.DIM_MEMBER_DEMOGRAPHIC_KEY > 999
);`;

var sqlLogCommand =
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10)
;`;

try 
{
    //Execute Merge Command
    var startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    ({
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
    });

    // You must run a seperate query to find records in the target that do not exist in the source and mark them as deleted
    //Execute DELETE Command
    var startTime = new Date().toISOString();

    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    ({
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
    });
}

catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10,:11);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[targetTableName, "TABLE", startTime, endTime, result, sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt, sfStatement.getQueryId()]
        }
    );        
    throw result;
}
return result;
$$
;
