CREATE OR REPLACE PROCEDURE DIMDATA.SPU_LOAD_DIM_PROVIDER_IDENTIFIER()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `DIMDATA.DIM_PROVIDER_IDENTIFIER`;


// Create merge statement to be executed.
var sqlMergeCommand =
`
MERGE INTO DIMDATA.DIM_PROVIDER_IDENTIFIER AS tgt
USING (
    SELECT
        MD5_VALUE_TEXT
        ,IS_LOGICAL_DELETE_FLAG
        ,DIM_PROVIDER_KEY
        ,IDENTIFIER_NAME
        ,IDENTIFIER_NBR
        FROM STAGEDATA.DIM_PROVIDER_IDENTIFIER_SELECT_VW
    MINUS
        SELECT
        MD5_VALUE_TEXT
        ,IS_LOGICAL_DELETE_FLAG
        ,DIM_PROVIDER_KEY
        ,IDENTIFIER_NAME
        ,IDENTIFIER_NBR
        FROM DIMDATA.DIM_PROVIDER_IDENTIFIER
    ) AS src

ON (tgt.DIM_PROVIDER_KEY = src.DIM_PROVIDER_KEY
AND tgt.IDENTIFIER_NAME = src.IDENTIFIER_NAME)

WHEN MATCHED
THEN UPDATE SET
    tgt.LAST_UPDATED_DATETIME=CURRENT_TIMESTAMP(),
    tgt.IS_LOGICAL_DELETE_FLAG = 'false',
    tgt.IDENTIFIER_NBR = src.IDENTIFIER_NBR

WHEN NOT MATCHED

THEN INSERT 
    (
    DIM_PROVIDER_IDENTIFIER_KEY,
    MD5_VALUE_TEXT,
    INSERT_DATETIME,
    LAST_UPDATED_DATETIME,
    DIM_PROVIDER_KEY,
    IDENTIFIER_NAME,
    IDENTIFIER_NBR
    )
VALUES
    (
    DIMDATA.DIM_PROVIDER_IDENTIFIER_KEY_SEQ.nextval,
    src.MD5_VALUE_TEXT,
    CURRENT_TIMESTAMP(),
    CURRENT_TIMESTAMP(),
    src.DIM_PROVIDER_KEY,
    src.IDENTIFIER_NAME,
    src.IDENTIFIER_NBR
    )
;`;

// set delete command which will update to is_logical_delete to true
// This specifically uses the source_system column as to not effect the records coming from SQL Server and ODS DIM Build
var sqlDeleteCommand =
`
UPDATE DIMDATA.DIM_PROVIDER_IDENTIFIER
SET 
IS_LOGICAL_DELETE_FLAG = TRUE
,LAST_UPDATED_DATETIME  = CURRENT_TIMESTAMP()
WHERE DIM_PROVIDER_IDENTIFIER_KEY IN
(
    SELECT DIM_PROVIDER_IDENTIFIER.DIM_PROVIDER_IDENTIFIER_KEY
    FROM DIMDATA.DIM_PROVIDER_IDENTIFIER
        JOIN DIMDATA.DIM_PROVIDER
            ON (DIM_PROVIDER.DIM_PROVIDER_KEY = DIM_PROVIDER_IDENTIFIER.DIM_PROVIDER_KEY)
        LEFT OUTER JOIN STAGEDATA.DIM_PROVIDER_IDENTIFIER_SELECT_VW
            ON (DIM_PROVIDER_IDENTIFIER_SELECT_VW.DIM_PROVIDER_KEY = DIM_PROVIDER_IDENTIFIER.DIM_PROVIDER_KEY
            AND DIM_PROVIDER_IDENTIFIER_SELECT_VW.IDENTIFIER_NAME = DIM_PROVIDER_IDENTIFIER.IDENTIFIER_NAME)
    WHERE DIM_PROVIDER_IDENTIFIER_SELECT_VW.DIM_PROVIDER_KEY IS NULL
    AND DIM_PROVIDER_IDENTIFIER.IS_LOGICAL_DELETE_FLAG = FALSE
    AND DIM_PROVIDER.SOURCE_SYSTEM IN (SELECT DISTINCT SOURCE_SYSTEM FROM STAGEDATA.DIM_PROVIDER_IDENTIFIER_SELECT_VW)
    AND DIM_PROVIDER.DATA_SOURCE_NAME <> 'ESI'
)
;`;

var sqlLogCommand =
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10)
;`;

try 
{
    //Execute Merge Command
    var startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    ({
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
    });

    // You must run a seperate query to find records in the target that do not exist in the source and mark them as deleted
    //Execute DELETE Command
    var startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    ({
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
    });
    
}

catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10,:11);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[targetTableName, "TABLE", startTime, endTime, result, sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt, sfStatement.getQueryId()]
        }
    );        
    throw result;
}
return result;
$$
;