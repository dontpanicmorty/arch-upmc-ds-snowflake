CREATE OR REPLACE PROCEDURE DIMDATA.SPU_LOAD_PHARMACY_DIM_PROVIDER()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `DIMDATA.DIM_PROVIDER`;


// Create merge statement to be executed.
var sqlMergeCommand =
`
MERGE INTO DIMDATA.DIM_PROVIDER AS tgt
USING (
        SELECT
        MD5_VALUE_TEXT
        ,FALSE AS IS_LOGICAL_DELETE_FLAG
        ,ROW_EFFECTIVE_DATETIME
        ,ROW_EXPIRATION_DATETIME
        ,IS_CURRENTROW_FLAG
        ,DATA_SOURCE_NAME
        ,PROVIDER_ID
        ,TPA_CLIENT_ID
        ,TPA_ID
        ,TPA_DIVISION_ID
        ,PROVIDER_TYPE_CODE
        ,PROVIDER_TYPE_DESC
        ,PROVIDER_ROLE_TYPE_CODE
        ,PROVIDER_ROLE_TYPE_DESC
        ,PROVIDER_FULL_NAME
        ,PRACTITIONER_LAST_NAME
        ,PRACTITIONER_FIRST_NAME
        ,PRACTITIONER_MIDDLE_NAME
        ,PRACTITIONER_MIDDLE_INITIAL
        ,PRACTITIONER_NAME_SUFFIX
        ,PRACTITIONER_GENDER_CODE
        ,PRACTITIONER_GENDER_NAME
        ,PRACTITIONER_BIRTH_DATE
        ,MEDICAL_GROUP_TIN_NBR
        ,PRACTITIONER_UPIN_NBR
        ,PRACTITIONER_SSN_NBR
        ,PRACTITIONER_DEGREE
        ,PROVIDER_EMAIL_ADDRESS
        ,PROVIDER_WEBSITE_URL 
        ,PRIMARY_SPECIALTY_NAME
        ,PRIMARY_PHO_CODE
        ,PRIMARY_PHO_NAME
        ,PRIMARY_PHO_TERMINATION_DATE
        ,SECONDARY_PHO_CODE
        ,SECONDARY_PHO_NAME
        ,SECONDARY_PHO_TERMINATION_DATE
        ,TERTIARY_PHO_CODE
        ,TERTIARY_PHO_NAME
        ,TERTIARY_PHO_TERMINATION_DATE
        ,PROVIDER_START_DATE
        ,FACILITY_INCEPTION_DATE
        ,PROVIDER_ACTIVE_IND
        ,PRACTITIONER_LOCUM_TENENS_IND
        ,INVISIBLE_PROVIDER_IND
        ,TEMPORARY_PROVIDER_IND
        ,PA_MEDICAID_IND
        ,PP_ACA_ENHANCED_PAY_IND
        ,HAS_MALPRACTICE_INSURANCE_IND
        ,OWNERSHIP_STATUS_CODE
        ,OWNERSHIP_STATUS_DESC
        ,SOURCE_PROVIDER_NBR
        ,SOURCE_SYSTEM
        FROM STAGEDATA.PHARMACY_DIM_PROVIDER_SELECT_VW
        WHERE HAS_MATCH_FROM_SQL_SERVER = FALSE  --ONLY SOURCE RECORDS THAT DO NOT HAVE MATCH FROM SQL SERVER!!!
    MINUS
        SELECT
        MD5_VALUE_TEXT
        ,IS_LOGICAL_DELETE_FLAG
        ,ROW_EFFECTIVE_DATETIME
        ,ROW_EXPIRATION_DATETIME
        ,IS_CURRENTROW_FLAG
        ,DATA_SOURCE_NAME
        ,PROVIDER_ID
        ,TPA_CLIENT_ID
        ,TPA_ID
        ,TPA_DIVISION_ID
        ,PROVIDER_TYPE_CODE
        ,PROVIDER_TYPE_DESC
        ,PROVIDER_ROLE_TYPE_CODE
        ,PROVIDER_ROLE_TYPE_DESC
        ,PROVIDER_FULL_NAME
        ,PRACTITIONER_LAST_NAME
        ,PRACTITIONER_FIRST_NAME
        ,PRACTITIONER_MIDDLE_NAME
        ,PRACTITIONER_MIDDLE_INITIAL
        ,PRACTITIONER_NAME_SUFFIX
        ,PRACTITIONER_GENDER_CODE
        ,PRACTITIONER_GENDER_NAME
        ,PRACTITIONER_BIRTH_DATE
        ,MEDICAL_GROUP_TIN_NBR
        ,PRACTITIONER_UPIN_NBR
        ,PRACTITIONER_SSN_NBR
        ,PRACTITIONER_DEGREE
        ,PROVIDER_EMAIL_ADDRESS
        ,PROVIDER_WEBSITE_URL
        ,PRIMARY_SPECIALTY_NAME
        ,PRIMARY_PHO_CODE
        ,PRIMARY_PHO_NAME
        ,PRIMARY_PHO_TERMINATION_DATE
        ,SECONDARY_PHO_CODE
        ,SECONDARY_PHO_NAME
        ,SECONDARY_PHO_TERMINATION_DATE
        ,TERTIARY_PHO_CODE
        ,TERTIARY_PHO_NAME
        ,TERTIARY_PHO_TERMINATION_DATE
        ,PROVIDER_START_DATE
        ,FACILITY_INCEPTION_DATE
        ,PROVIDER_ACTIVE_IND
        ,PRACTITIONER_LOCUM_TENENS_IND
        ,INVISIBLE_PROVIDER_IND
        ,TEMPORARY_PROVIDER_IND
        ,PA_MEDICAID_IND
        ,PP_ACA_ENHANCED_PAY_IND
        ,HAS_MALPRACTICE_INSURANCE_IND
        ,OWNERSHIP_STATUS_CODE
        ,OWNERSHIP_STATUS_DESC
        ,SOURCE_PROVIDER_NBR
        ,SOURCE_SYSTEM
        FROM DIMDATA.DIM_PROVIDER
        WHERE SOURCE_SYSTEM = 'UPMCHP_DATAHUB'
         AND DATA_SOURCE_NAME = 'ESI'
        --only compare the ESI records coming from UPMCHP_DATAHUB
        --we only want to insert or update records that do not exist in ProviderODS and SQL Server Dims
    ) AS src

ON (tgt.TPA_CLIENT_ID = src.TPA_CLIENT_ID
AND tgt.TPA_ID = src.TPA_ID
AND tgt.TPA_DIVISION_ID = src.TPA_DIVISION_ID
AND tgt.PROVIDER_ID = src.PROVIDER_ID)

WHEN MATCHED
THEN UPDATE SET
    tgt.LAST_UPDATED_DATETIME=CURRENT_TIMESTAMP(),
    tgt.IS_LOGICAL_DELETE_FLAG = 'false',
    tgt.MD5_VALUE_TEXT=src.MD5_VALUE_TEXT,
    tgt.IS_CURRENTROW_FLAG=src.IS_CURRENTROW_FLAG,
    tgt.DATA_SOURCE_NAME=src.DATA_SOURCE_NAME,
    tgt.PROVIDER_TYPE_CODE=src.PROVIDER_TYPE_CODE,
    tgt.PROVIDER_TYPE_DESC=src.PROVIDER_TYPE_DESC,
    tgt.PROVIDER_ROLE_TYPE_CODE=src.PROVIDER_ROLE_TYPE_CODE,
    tgt.PROVIDER_ROLE_TYPE_DESC=src.PROVIDER_ROLE_TYPE_DESC,
    tgt.PROVIDER_FULL_NAME=src.PROVIDER_FULL_NAME,
    tgt.PRACTITIONER_LAST_NAME=src.PRACTITIONER_LAST_NAME,
    tgt.PRACTITIONER_FIRST_NAME=src.PRACTITIONER_FIRST_NAME,
    tgt.PRACTITIONER_MIDDLE_NAME=src.PRACTITIONER_MIDDLE_NAME,
    tgt.PRACTITIONER_MIDDLE_INITIAL=src.PRACTITIONER_MIDDLE_INITIAL,
    tgt.PRACTITIONER_NAME_SUFFIX=src.PRACTITIONER_NAME_SUFFIX,
    tgt.PRACTITIONER_GENDER_CODE=src.PRACTITIONER_GENDER_CODE,
    tgt.PRACTITIONER_GENDER_NAME=src.PRACTITIONER_GENDER_NAME,
    tgt.PRACTITIONER_BIRTH_DATE=src.PRACTITIONER_BIRTH_DATE,
    tgt.MEDICAL_GROUP_TIN_NBR=src.MEDICAL_GROUP_TIN_NBR,
    tgt.PRACTITIONER_UPIN_NBR=src.PRACTITIONER_UPIN_NBR,
    tgt.PRACTITIONER_SSN_NBR=src.PRACTITIONER_SSN_NBR,
    tgt.PRACTITIONER_DEGREE=src.PRACTITIONER_DEGREE,
    tgt.PROVIDER_EMAIL_ADDRESS=src.PROVIDER_EMAIL_ADDRESS,
    tgt.PROVIDER_WEBSITE_URL=src.PROVIDER_WEBSITE_URL,
    tgt.PRIMARY_SPECIALTY_NAME=src.PRIMARY_SPECIALTY_NAME,
    tgt.PRIMARY_PHO_CODE=src.PRIMARY_PHO_CODE,
    tgt.PRIMARY_PHO_NAME=src.PRIMARY_PHO_NAME,
    tgt.PRIMARY_PHO_TERMINATION_DATE=src.PRIMARY_PHO_TERMINATION_DATE,
    tgt.SECONDARY_PHO_CODE=src.SECONDARY_PHO_CODE,
    tgt.SECONDARY_PHO_NAME=src.SECONDARY_PHO_NAME,
    tgt.SECONDARY_PHO_TERMINATION_DATE=src.SECONDARY_PHO_TERMINATION_DATE,
    tgt.TERTIARY_PHO_CODE=src.TERTIARY_PHO_CODE,
    tgt.TERTIARY_PHO_NAME=src.TERTIARY_PHO_NAME,
    tgt.TERTIARY_PHO_TERMINATION_DATE=src.TERTIARY_PHO_TERMINATION_DATE,
    tgt.PROVIDER_START_DATE=src.PROVIDER_START_DATE,
    tgt.FACILITY_INCEPTION_DATE=src.FACILITY_INCEPTION_DATE,
    tgt.PROVIDER_ACTIVE_IND=src.PROVIDER_ACTIVE_IND,
    tgt.PRACTITIONER_LOCUM_TENENS_IND=src.PRACTITIONER_LOCUM_TENENS_IND,
    tgt.INVISIBLE_PROVIDER_IND=src.INVISIBLE_PROVIDER_IND,
    tgt.TEMPORARY_PROVIDER_IND=src.TEMPORARY_PROVIDER_IND,
    tgt.PA_MEDICAID_IND=src.PA_MEDICAID_IND,
    tgt.PP_ACA_ENHANCED_PAY_IND=src.PP_ACA_ENHANCED_PAY_IND,
    tgt.HAS_MALPRACTICE_INSURANCE_IND=src.HAS_MALPRACTICE_INSURANCE_IND,
    tgt.OWNERSHIP_STATUS_CODE=src.OWNERSHIP_STATUS_CODE,
    tgt.OWNERSHIP_STATUS_DESC=src.OWNERSHIP_STATUS_DESC,
    tgt.SOURCE_PROVIDER_NBR=src.SOURCE_PROVIDER_NBR,
    tgt.SOURCE_SYSTEM = src.SOURCE_SYSTEM

WHEN NOT MATCHED

THEN INSERT 
    (
        DIM_PROVIDER_KEY,
        MD5_VALUE_TEXT,
        INSERT_DATETIME,
        LAST_UPDATED_DATETIME,
        IS_LOGICAL_DELETE_FLAG,
        ROW_EFFECTIVE_DATETIME,
        ROW_EXPIRATION_DATETIME,
        IS_CURRENTROW_FLAG,
        DATA_SOURCE_NAME,
        PROVIDER_ID,
        TPA_CLIENT_ID,
        TPA_ID,
        TPA_DIVISION_ID,
        PROVIDER_TYPE_CODE,
        PROVIDER_TYPE_DESC,
        PROVIDER_ROLE_TYPE_CODE,
        PROVIDER_ROLE_TYPE_DESC,
        PROVIDER_FULL_NAME,
        PRACTITIONER_LAST_NAME,
        PRACTITIONER_FIRST_NAME,
        PRACTITIONER_MIDDLE_NAME,
        PRACTITIONER_MIDDLE_INITIAL,
        PRACTITIONER_NAME_SUFFIX,
        PRACTITIONER_GENDER_CODE,
        PRACTITIONER_GENDER_NAME,
        PRACTITIONER_BIRTH_DATE,
        MEDICAL_GROUP_TIN_NBR,
        PRACTITIONER_UPIN_NBR,
        PRACTITIONER_SSN_NBR,
        PRACTITIONER_DEGREE,
        PROVIDER_EMAIL_ADDRESS,
        PROVIDER_WEBSITE_URL,
        PRIMARY_SPECIALTY_NAME,
        PRIMARY_PHO_CODE,
        PRIMARY_PHO_NAME,
        PRIMARY_PHO_TERMINATION_DATE,
        SECONDARY_PHO_CODE,
        SECONDARY_PHO_NAME,
        SECONDARY_PHO_TERMINATION_DATE,
        TERTIARY_PHO_CODE,
        TERTIARY_PHO_NAME,
        TERTIARY_PHO_TERMINATION_DATE,
        PROVIDER_START_DATE,
        FACILITY_INCEPTION_DATE,
        PROVIDER_ACTIVE_IND,
        PRACTITIONER_LOCUM_TENENS_IND,
        INVISIBLE_PROVIDER_IND,
        TEMPORARY_PROVIDER_IND,
        PA_MEDICAID_IND,
        PP_ACA_ENHANCED_PAY_IND,
        HAS_MALPRACTICE_INSURANCE_IND,
        OWNERSHIP_STATUS_CODE,
        OWNERSHIP_STATUS_DESC,
        SOURCE_PROVIDER_NBR,
        SOURCE_SYSTEM
    )
VALUES
    (
        (SELECT IFNULL(MAX(DIM_PROVIDER_KEY), 100000000) FROM DIMDATA.DIM_PROVIDER WHERE SOURCE_SYSTEM IN ('MARKLOGIC','UPMCHP_DATAHUB')) + ROW_NUMBER() OVER (ORDER BY 1),
        src.MD5_VALUE_TEXT,
        CURRENT_TIMESTAMP(),
        CURRENT_TIMESTAMP(),
        FALSE,
        src.ROW_EFFECTIVE_DATETIME,
        src.ROW_EXPIRATION_DATETIME,
        src.IS_CURRENTROW_FLAG,
        src.DATA_SOURCE_NAME,
        src.PROVIDER_ID,
        src.TPA_CLIENT_ID,
        src.TPA_ID,
        src.TPA_DIVISION_ID,
        src.PROVIDER_TYPE_CODE,
        src.PROVIDER_TYPE_DESC,
        src.PROVIDER_ROLE_TYPE_CODE,
        src.PROVIDER_ROLE_TYPE_DESC,
        src.PROVIDER_FULL_NAME,
        src.PRACTITIONER_LAST_NAME,
        src.PRACTITIONER_FIRST_NAME,
        src.PRACTITIONER_MIDDLE_NAME,
        src.PRACTITIONER_MIDDLE_INITIAL,
        src.PRACTITIONER_NAME_SUFFIX,
        src.PRACTITIONER_GENDER_CODE,
        src.PRACTITIONER_GENDER_NAME,
        src.PRACTITIONER_BIRTH_DATE,
        src.MEDICAL_GROUP_TIN_NBR,
        src.PRACTITIONER_UPIN_NBR,
        src.PRACTITIONER_SSN_NBR,
        src.PRACTITIONER_DEGREE,
        src.PROVIDER_EMAIL_ADDRESS,
        src.PROVIDER_WEBSITE_URL,
        src.PRIMARY_SPECIALTY_NAME,
        src.PRIMARY_PHO_CODE,
        src.PRIMARY_PHO_NAME,
        src.PRIMARY_PHO_TERMINATION_DATE,
        src.SECONDARY_PHO_CODE,
        src.SECONDARY_PHO_NAME,
        src.SECONDARY_PHO_TERMINATION_DATE,
        src.TERTIARY_PHO_CODE,
        src.TERTIARY_PHO_NAME,
        src.TERTIARY_PHO_TERMINATION_DATE,
        src.PROVIDER_START_DATE,
        src.FACILITY_INCEPTION_DATE,
        src.PROVIDER_ACTIVE_IND,
        src.PRACTITIONER_LOCUM_TENENS_IND,
        src.INVISIBLE_PROVIDER_IND,
        src.TEMPORARY_PROVIDER_IND,
        src.PA_MEDICAID_IND,
        src.PP_ACA_ENHANCED_PAY_IND,
        src.HAS_MALPRACTICE_INSURANCE_IND,
        src.OWNERSHIP_STATUS_CODE,
        src.OWNERSHIP_STATUS_DESC,
        src.SOURCE_PROVIDER_NBR,
        src.SOURCE_SYSTEM
    )
;`;

// set delete command which will update to is_logical_delete to true
// The >999 is done to not update any of the static data, inserts start at 1000 from autoincrement
// This specifically uses the source_system column as to not effect the records coming from SQL Server and ODS DIM Build
var sqlDeleteCommand =
`
UPDATE DIMDATA.DIM_PROVIDER
SET 
IS_LOGICAL_DELETE_FLAG = TRUE
,LAST_UPDATED_DATETIME  = CURRENT_TIMESTAMP()
WHERE DIM_PROVIDER_KEY IN
(
    SELECT DIM_PROVIDER.DIM_PROVIDER_KEY
    FROM DIMDATA.DIM_PROVIDER
        LEFT OUTER JOIN 
            (SELECT TPA_CLIENT_ID, TPA_ID, TPA_DIVISION_ID, DATA_SOURCE_NAME, PROVIDER_ID
            FROM STAGEDATA.PHARMACY_DIM_PROVIDER_SELECT_VW
            ) STAGE_DATA
        ON (STAGE_DATA.TPA_CLIENT_ID = DIM_PROVIDER.TPA_CLIENT_ID
        AND STAGE_DATA.TPA_ID = DIM_PROVIDER.TPA_ID
        AND STAGE_DATA.TPA_DIVISION_ID = DIM_PROVIDER.TPA_DIVISION_ID
        AND STAGE_DATA.DATA_SOURCE_NAME = DIM_PROVIDER.DATA_SOURCE_NAME
        AND STAGE_DATA.PROVIDER_ID = DIM_PROVIDER.PROVIDER_ID)
    WHERE STAGE_DATA.PROVIDER_ID IS NULL
    AND DIM_PROVIDER.IS_LOGICAL_DELETE_FLAG = FALSE
    AND DIM_PROVIDER.DIM_PROVIDER_KEY > 100000000 -- This is the start id for stuff coming from Marklogic and Upmchp_Datahub
    AND DIM_PROVIDER.SOURCE_SYSTEM = 'UPMCHP_DATAHUB'
    AND DIM_PROVIDER.DATA_SOURCE_NAME = 'ESI'
)
;`;


var sqlLogCommand =
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10)
;`;


try 
{
    //Execute Merge Command
    var startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    ({
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
    });

    // You must run a seperate query to find records in the target that do not exist in the source and mark them as deleted
    //Execute DELETE Command
    var startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    ({
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
    });
}

catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10,:11);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[targetTableName, "TABLE", startTime, endTime, result, sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt, sfStatement.getQueryId()]
        }
    );        
    throw result;
}
return result;
$$
;