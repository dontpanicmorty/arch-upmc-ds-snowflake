CREATE OR REPLACE PROCEDURE DIMDATA.SPU_LOAD_BRIDGE_CLAIM_DETAIL_FINANCIAL_SERVICE_CATEGORY()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS '
// get procedure start time and set variables
var procedureName = Object.keys(this)[0];


// Create merge statement to be executed.
var sqlMergeCommand =
`
MERGE INTO DIMDATA.BRIDGE_CLAIM_DETAIL_FINANCIAL_SERVICE_CATEGORY AS tgt
USING (
SELECT
    DIM_CLAIM_DETAIL_KEY
    ,DIM_FINANCIAL_SERVICE_CATEGORY_KEY
    FROM STAGEDATA.BRIDGE_CLAIM_DETAIL_FINANCIAL_SERVICE_CATEGORY_SELECT_VW
MINUS
SELECT
    DIM_CLAIM_DETAIL_KEY
    ,DIM_FINANCIAL_SERVICE_CATEGORY_KEY
    FROM DIMDATA.BRIDGE_CLAIM_DETAIL_FINANCIAL_SERVICE_CATEGORY
    ) as src
ON 
(
    tgt.DIM_CLAIM_DETAIL_KEY = src.DIM_CLAIM_DETAIL_KEY
    AND tgt.DIM_FINANCIAL_SERVICE_CATEGORY_KEY = src.DIM_FINANCIAL_SERVICE_CATEGORY_KEY
)

WHEN NOT MATCHED

THEN INSERT 
    (
        BRIDGE_CLAIM_DETAIL_FINANCIAL_SERVICE_CATEGORY_KEY
        ,INSERT_DATETIME
        ,LAST_UPDATED_DATETIME
        ,IS_LOGICAL_DELETE_FLAG
        ,DIM_CLAIM_DETAIL_KEY
        ,DIM_FINANCIAL_SERVICE_CATEGORY_KEY
    )
VALUES 
    (
        (SELECT IFNULL(MAX(BRIDGE_CLAIM_DETAIL_FINANCIAL_SERVICE_CATEGORY_KEY), 1000) FROM DIMDATA.BRIDGE_CLAIM_DETAIL_FINANCIAL_SERVICE_CATEGORY) + ROW_NUMBER() OVER (ORDER BY 1)
        ,CURRENT_TIMESTAMP()
        ,CURRENT_TIMESTAMP()
        ,FALSE
        ,src.DIM_CLAIM_DETAIL_KEY
        ,src.DIM_FINANCIAL_SERVICE_CATEGORY_KEY
    )
;`;

// set delete command which will update to is_logical_delete to true
// The >999 is done to not update any of the static data, inserts start at 1000 from autoincrement
var sqlDeleteCommand =
`
UPDATE DIMDATA.BRIDGE_CLAIM_DETAIL_FINANCIAL_SERVICE_CATEGORY
SET 
    IS_LOGICAL_DELETE_FLAG = TRUE,
    LAST_UPDATED_DATETIME = CURRENT_TIMESTAMP
WHERE (DIM_CLAIM_DETAIL_KEY, DIM_FINANCIAL_SERVICE_CATEGORY_KEY) IN
(
    SELECT BRIDGE_CLAIM_DETAIL_FINANCIAL_SERVICE_CATEGORY.DIM_CLAIM_DETAIL_KEY,
    BRIDGE_CLAIM_DETAIL_FINANCIAL_SERVICE_CATEGORY.DIM_FINANCIAL_SERVICE_CATEGORY_KEY
    FROM DIMDATA.BRIDGE_CLAIM_DETAIL_FINANCIAL_SERVICE_CATEGORY
        LEFT OUTER JOIN 
            (SELECT DIM_CLAIM_DETAIL_KEY, DIM_FINANCIAL_SERVICE_CATEGORY_KEY
            FROM STAGEDATA.BRIDGE_CLAIM_DETAIL_FINANCIAL_SERVICE_CATEGORY_SELECT_VW
            ) STAGE_DATA
        ON (BRIDGE_CLAIM_DETAIL_FINANCIAL_SERVICE_CATEGORY.DIM_CLAIM_DETAIL_KEY = STAGE_DATA.DIM_CLAIM_DETAIL_KEY
        AND BRIDGE_CLAIM_DETAIL_FINANCIAL_SERVICE_CATEGORY.DIM_FINANCIAL_SERVICE_CATEGORY_KEY = STAGE_DATA.DIM_FINANCIAL_SERVICE_CATEGORY_KEY
        )
    WHERE (STAGE_DATA.DIM_CLAIM_DETAIL_KEY IS NULL
    AND BRIDGE_CLAIM_DETAIL_FINANCIAL_SERVICE_CATEGORY.IS_LOGICAL_DELETE_FLAG = FALSE
    )
)
;`;


try 
{

    //Execute Merge Command
    var startTime = new Date().toISOString();
    var targetTableName = `DIMDATA.BRIDGE_CLAIM_DETAIL_FINANCIAL_SERVICE_CATEGORY`;
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

        // Log results to table
        snowflake.execute({
            sqlText: `
                INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
                (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
                VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);
            `,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        });

    // You must run a seperate query to find records in the target that do not exist in the source and mark them as deleted
    //Execute DELETE Command
    var startTime = new Date().toISOString();
    var targetTableName = `DIMDATA.BRIDGE_CLAIM_DETAIL_FINANCIAL_SERVICE_CATEGORY`;
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

        // Log results to table
        snowflake.execute({
            sqlText: `
                INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
                (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
                VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);
            `,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
        });
}

catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
        snowflake.execute({
            sqlText: `
                INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
                (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
                VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10,:11);
            `,
            binds:[
                targetTableName, "TABLE", startTime, endTime, result, sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt, sfStatement.getQueryId()]
        });       
    throw result;
}
return result;
';