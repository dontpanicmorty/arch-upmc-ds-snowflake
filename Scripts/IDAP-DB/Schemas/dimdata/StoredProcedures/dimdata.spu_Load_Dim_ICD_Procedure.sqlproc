CREATE OR REPLACE PROCEDURE DIMDATA.SPU_LOAD_DIM_ICD_PROCEDURE()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `DIMDATA.DIM_ICD_PROCEDURE`;

// Create merge statement to be executed.
var sqlMergeCommand =
`
MERGE INTO DIMDATA.DIM_ICD_PROCEDURE AS tgt
USING (
        SELECT DISTINCT
        FALSE AS IS_LOGICAL_DELETE_FLAG
        ,DIM_TPA_HIERARCHY_KEY
        ,DATA_SOURCE_NAME
        ,ICD_VERSION_NBR
        ,ICD_PROCEDURE_CODE
        ,ICD_PROCEDURE_DESC
        FROM STAGEDATA.DIM_ICD_PROCEDURE_SELECT_VW
    MINUS
        SELECT
        IS_LOGICAL_DELETE_FLAG
        ,DIM_TPA_HIERARCHY_KEY
        ,DATA_SOURCE_NAME
        ,ICD_VERSION_NBR
        ,ICD_PROCEDURE_CODE
        ,ICD_PROCEDURE_DESC
        FROM DIMDATA.DIM_ICD_PROCEDURE
    ) AS src
ON (tgt.DIM_TPA_HIERARCHY_KEY = src.DIM_TPA_HIERARCHY_KEY
AND tgt.DATA_SOURCE_NAME = src.DATA_SOURCE_NAME
AND tgt.ICD_VERSION_NBR = src.ICD_VERSION_NBR
AND tgt.ICD_PROCEDURE_CODE =src.ICD_PROCEDURE_CODE)

WHEN MATCHED

THEN UPDATE SET
    tgt.LAST_UPDATED_DATETIME=CURRENT_TIMESTAMP(),
    tgt.IS_LOGICAL_DELETE_FLAG = FALSE,
    tgt.ICD_PROCEDURE_DESC=src.ICD_PROCEDURE_DESC

WHEN NOT MATCHED

THEN INSERT 
    (
        DIM_ICD_PROCEDURE_KEY
        ,INSERT_DATETIME
        ,LAST_UPDATED_DATETIME
        ,IS_LOGICAL_DELETE_FLAG
        ,DIM_TPA_HIERARCHY_KEY
        ,DATA_SOURCE_NAME
        ,ICD_VERSION_NBR
        ,ICD_PROCEDURE_CODE
        ,ICD_PROCEDURE_DESC
        ,ICD_PROCEDURE_GROUP_CODE
    )
    VALUES
    (
        (SELECT IFNULL(MAX(DIM_ICD_PROCEDURE_KEY), 1000) FROM DIMDATA.DIM_ICD_PROCEDURE) + ROW_NUMBER() OVER (ORDER BY 1)
        ,CURRENT_TIMESTAMP()
        ,CURRENT_TIMESTAMP()
        ,FALSE
        ,src.DIM_TPA_HIERARCHY_KEY
        ,src.DATA_SOURCE_NAME
        ,src.ICD_VERSION_NBR
        ,src.ICD_PROCEDURE_CODE
        ,src.ICD_PROCEDURE_DESC
        ,NULL
    )
;`;

// set delete command which will update to is_logical_delete to true
// The > 999 is done to not update any of the static data, inserts start at 1000 from autoincrement
var sqlDeleteCommand =
`
UPDATE DIMDATA.DIM_ICD_PROCEDURE
SET IS_LOGICAL_DELETE_FLAG = TRUE, LAST_UPDATED_DATETIME  = CURRENT_TIMESTAMP()
WHERE DIM_ICD_PROCEDURE_KEY IN
(
    SELECT DIM_ICD_PROCEDURE.DIM_ICD_PROCEDURE_KEY
    FROM DIMDATA.DIM_ICD_PROCEDURE
        LEFT OUTER JOIN 
            (SELECT DISTINCT 
            DIM_TPA_HIERARCHY_KEY
            ,DATA_SOURCE_NAME
            ,ICD_VERSION_NBR
            ,ICD_PROCEDURE_CODE
            FROM STAGEDATA.DIM_ICD_PROCEDURE_SELECT_VW) STAGE_DATA
        ON (STAGE_DATA.DIM_TPA_HIERARCHY_KEY = DIM_ICD_PROCEDURE.DIM_TPA_HIERARCHY_KEY
        AND STAGE_DATA.DATA_SOURCE_NAME = DIM_ICD_PROCEDURE.DATA_SOURCE_NAME
        AND STAGE_DATA.ICD_VERSION_NBR = DIM_ICD_PROCEDURE.ICD_VERSION_NBR
        AND STAGE_DATA.ICD_PROCEDURE_CODE = DIM_ICD_PROCEDURE.ICD_PROCEDURE_CODE)
    WHERE STAGE_DATA.ICD_PROCEDURE_CODE IS NULL
    AND DIM_ICD_PROCEDURE.IS_LOGICAL_DELETE_FLAG = FALSE
    AND DIM_ICD_PROCEDURE.DIM_ICD_PROCEDURE_KEY > 999
)
;`    

var sqlLogCommand =
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10)
;`;

try 
{
    //Execute Merge Command
    var startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    ({
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
    });

    // You must run a seperate query to find records in the target that do not exist in the source and mark them as deleted
    //Execute DELETE Command
    var startTime = new Date().toISOString();

    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    ({
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
    });
}

catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10,:11);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[targetTableName, "TABLE", startTime, endTime, result, sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt, sfStatement.getQueryId()]
        }
    );        
    throw result;
}
return result;
$$
;
