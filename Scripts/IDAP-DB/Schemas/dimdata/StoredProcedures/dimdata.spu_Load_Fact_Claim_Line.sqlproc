        ,DIM_REVENUE_PROCEDURE_KEY
    )
VALUES
    (
        (SELECT IFNULL(MAX(FACT_CLAIM_LINE_KEY), 1000) FROM DIMDATA.FACT_CLAIM_LINE) + ROW_NUMBER() OVER (ORDER BY 1)
        ,CURRENT_TIMESTAMP()
        ,CURRENT_TIMESTAMP()
        ,src.DIM_TPA_HIERARCHY_KEY
