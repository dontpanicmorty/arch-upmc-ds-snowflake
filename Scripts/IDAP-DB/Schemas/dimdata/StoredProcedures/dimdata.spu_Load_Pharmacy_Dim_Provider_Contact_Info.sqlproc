CREATE OR REPLACE PROCEDURE DIMDATA.SPU_LOAD_PHARMACY_DIM_PROVIDER_CONTACT_INFO() 
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `DIMDATA.DIM_PROVIDER_CONTACT_INFO`;

// Create merge statement to be executed.
var sqlMergeCommand =
`
MERGE INTO DIMDATA.DIM_PROVIDER_CONTACT_INFO AS tgt
USING (
    SELECT
        MD5_VALUE_TEXT
        ,FALSE AS IS_LOGICAL_DELETE_FLAG
        ,PROVIDER_PRIMARY_PHONE_NBR
		,PROVIDER_PRIMARY_PHONE_EXTENSION_NBR 
		,PROVIDER_PRIMARY_PHONE_NBR_FORMATTED
        ,PROVIDER_ALTERNATE_PHONE_NBR
		,PROVIDER_ALTERNATE_PHONE_EXTENSION_NBR
		,PROVIDER_ALTERNATE_PHONE_NBR_FORMATTED
		,PROVIDER_FAX_NBR
		,PROVIDER_FAX_NBR_FORMATTED
		,PROVIDER_INTERNATIONAL_PHONE_CODE 
		,PROVIDER_EMAIL_ADDRESS_TEXT
        FROM STAGEDATA.PHARMACY_DIM_PROVIDER_CONTACT_INFO_SELECT_VW
    MINUS
        SELECT
        MD5_VALUE_TEXT
        ,IS_LOGICAL_DELETE_FLAG
        ,PROVIDER_PRIMARY_PHONE_NBR
		,PROVIDER_PRIMARY_PHONE_EXTENSION_NBR 
		,PROVIDER_PRIMARY_PHONE_NBR_FORMATTED
        ,PROVIDER_ALTERNATE_PHONE_NBR
		,PROVIDER_ALTERNATE_PHONE_EXTENSION_NBR
		,PROVIDER_ALTERNATE_PHONE_NBR_FORMATTED
		,PROVIDER_FAX_NBR
		,PROVIDER_FAX_NBR_FORMATTED
		,PROVIDER_INTERNATIONAL_PHONE_CODE 
		,PROVIDER_EMAIL_ADDRESS_TEXT
        FROM DIMDATA.DIM_PROVIDER_CONTACT_INFO
    ) AS src

ON (tgt.PROVIDER_PRIMARY_PHONE_NBR = src.PROVIDER_PRIMARY_PHONE_NBR
AND tgt.PROVIDER_PRIMARY_PHONE_EXTENSION_NBR = src.PROVIDER_PRIMARY_PHONE_EXTENSION_NBR
AND tgt.PROVIDER_ALTERNATE_PHONE_NBR = src.PROVIDER_ALTERNATE_PHONE_NBR
AND tgt.PROVIDER_ALTERNATE_PHONE_EXTENSION_NBR = src.PROVIDER_ALTERNATE_PHONE_EXTENSION_NBR
AND tgt.PROVIDER_FAX_NBR = src.PROVIDER_FAX_NBR
AND tgt.PROVIDER_INTERNATIONAL_PHONE_CODE = src.PROVIDER_INTERNATIONAL_PHONE_CODE
AND tgt.PROVIDER_EMAIL_ADDRESS_TEXT = src.PROVIDER_EMAIL_ADDRESS_TEXT)

WHEN MATCHED
THEN UPDATE SET
    tgt.LAST_UPDATED_DATETIME=CURRENT_TIMESTAMP(),
    tgt.IS_LOGICAL_DELETE_FLAG = FALSE,
    tgt.PROVIDER_PRIMARY_PHONE_NBR_FORMATTED = src.PROVIDER_PRIMARY_PHONE_NBR_FORMATTED,
    tgt.PROVIDER_ALTERNATE_PHONE_NBR_FORMATTED = src.PROVIDER_ALTERNATE_PHONE_NBR_FORMATTED,
    tgt.PROVIDER_FAX_NBR_FORMATTED = src.PROVIDER_FAX_NBR_FORMATTED

WHEN NOT MATCHED

THEN INSERT 
    (
    DIM_PROVIDER_CONTACT_INFO_KEY,
    MD5_VALUE_TEXT,
    INSERT_DATETIME,
    LAST_UPDATED_DATETIME,
    IS_LOGICAL_DELETE_FLAG,
    PROVIDER_PRIMARY_PHONE_NBR,
	PROVIDER_PRIMARY_PHONE_EXTENSION_NBR, 
	PROVIDER_PRIMARY_PHONE_NBR_FORMATTED,
    PROVIDER_ALTERNATE_PHONE_NBR,
	PROVIDER_ALTERNATE_PHONE_EXTENSION_NBR,
	PROVIDER_ALTERNATE_PHONE_NBR_FORMATTED,
	PROVIDER_FAX_NBR,
	PROVIDER_FAX_NBR_FORMATTED,
	PROVIDER_INTERNATIONAL_PHONE_CODE, 
	PROVIDER_EMAIL_ADDRESS_TEXT
    )
VALUES
    (
    (SELECT IFNULL(MAX(DIM_PROVIDER_CONTACT_INFO_KEY), 100000000) FROM DIMDATA.DIM_PROVIDER_CONTACT_INFO WHERE MD5_VALUE_TEXT = 'N/A-UPMCHP_DATAHUB') + ROW_NUMBER() OVER (ORDER BY 1),
    src.MD5_VALUE_TEXT,
    CURRENT_TIMESTAMP(),
    CURRENT_TIMESTAMP(),
    FALSE,
    src.PROVIDER_PRIMARY_PHONE_NBR,
	src.PROVIDER_PRIMARY_PHONE_EXTENSION_NBR, 
	src.PROVIDER_PRIMARY_PHONE_NBR_FORMATTED,
    src.PROVIDER_ALTERNATE_PHONE_NBR,
	src.PROVIDER_ALTERNATE_PHONE_EXTENSION_NBR,
	src.PROVIDER_ALTERNATE_PHONE_NBR_FORMATTED,
	src.PROVIDER_FAX_NBR,
	src.PROVIDER_FAX_NBR_FORMATTED,
	src.PROVIDER_INTERNATIONAL_PHONE_CODE,
	src.PROVIDER_EMAIL_ADDRESS_TEXT
    )
;`;

// set delete command which will update to is_logical_delete to true
// This specifically uses the source_system column as to not effect the records coming from SQL Server and ODS DIM Build
var sqlDeleteCommand =
`
UPDATE DIMDATA.DIM_PROVIDER_CONTACT_INFO
SET 
IS_LOGICAL_DELETE_FLAG = TRUE
,LAST_UPDATED_DATETIME  = CURRENT_TIMESTAMP()
WHERE DIM_PROVIDER_CONTACT_INFO_KEY IN
(
    SELECT DIM_PROVIDER_CONTACT_INFO.DIM_PROVIDER_CONTACT_INFO_KEY
    FROM DIMDATA.DIM_PROVIDER_CONTACT_INFO
        LEFT OUTER JOIN STAGEDATA.PHARMACY_DIM_PROVIDER_CONTACT_INFO_SELECT_VW
            ON (PHARMACY_DIM_PROVIDER_CONTACT_INFO_SELECT_VW.PROVIDER_PRIMARY_PHONE_NBR = DIM_PROVIDER_CONTACT_INFO.PROVIDER_PRIMARY_PHONE_NBR
            AND PHARMACY_DIM_PROVIDER_CONTACT_INFO_SELECT_VW.PROVIDER_PRIMARY_PHONE_EXTENSION_NBR = DIM_PROVIDER_CONTACT_INFO.PROVIDER_PRIMARY_PHONE_EXTENSION_NBR
            AND PHARMACY_DIM_PROVIDER_CONTACT_INFO_SELECT_VW.PROVIDER_ALTERNATE_PHONE_NBR = DIM_PROVIDER_CONTACT_INFO.PROVIDER_ALTERNATE_PHONE_NBR
            AND PHARMACY_DIM_PROVIDER_CONTACT_INFO_SELECT_VW.PROVIDER_ALTERNATE_PHONE_EXTENSION_NBR = DIM_PROVIDER_CONTACT_INFO.PROVIDER_ALTERNATE_PHONE_EXTENSION_NBR
            AND PHARMACY_DIM_PROVIDER_CONTACT_INFO_SELECT_VW.PROVIDER_FAX_NBR = DIM_PROVIDER_CONTACT_INFO.PROVIDER_FAX_NBR
            AND PHARMACY_DIM_PROVIDER_CONTACT_INFO_SELECT_VW.PROVIDER_INTERNATIONAL_PHONE_CODE = DIM_PROVIDER_CONTACT_INFO.PROVIDER_INTERNATIONAL_PHONE_CODE
            AND PHARMACY_DIM_PROVIDER_CONTACT_INFO_SELECT_VW.PROVIDER_EMAIL_ADDRESS_TEXT = DIM_PROVIDER_CONTACT_INFO.PROVIDER_EMAIL_ADDRESS_TEXT)
    WHERE PHARMACY_DIM_PROVIDER_CONTACT_INFO_SELECT_VW.MD5_VALUE_TEXT IS NULL
    AND DIM_PROVIDER_CONTACT_INFO.IS_LOGICAL_DELETE_FLAG = FALSE
    AND DIM_PROVIDER_CONTACT_INFO.MD5_VALUE_TEXT = 'N/A-UPMCHP_DATAHUB' --Only want to update records inserted by this stored proc. DO not want to edit records added by SQL Server
)
;`;

var sqlLogCommand =
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10)
;`;

try 
{
    //Execute Merge Command
    var startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    ({
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
    });

    // You must run a seperate query to find records in the target that do not exist in the source and mark them as deleted
    //Execute DELETE Command
    var startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    ({
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
    });
    
}

catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10,:11);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[targetTableName, "TABLE", startTime, endTime, result, sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt, sfStatement.getQueryId()]
        }
    );        
    throw result;
}
return result;
$$
;