CREATE OR REPLACE PROCEDURE DIMDATA.SPU_LOAD_GRP_ICD_DIAGNOSIS_FLAT()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `DIMDATA.GRP_ICD_DIAGNOSIS_FLAT`;

// Create merge statement to be executed.
var sqlMergeCommand =
`
MERGE INTO DIMDATA.GRP_ICD_DIAGNOSIS_FLAT AS TGT
USING (
SELECT GRP_ICD_DIAGNOSIS_KEY,
DIAGNOSIS_01,
DIAGNOSIS_02,
DIAGNOSIS_03,
DIAGNOSIS_04,
DIAGNOSIS_05,
DIAGNOSIS_06,
DIAGNOSIS_07,
DIAGNOSIS_08,
DIAGNOSIS_09,
DIAGNOSIS_10,
DIAGNOSIS_11,
DIAGNOSIS_12,
DIAGNOSIS_13,
DIAGNOSIS_14,
DIAGNOSIS_15,
DIAGNOSIS_16,
DIAGNOSIS_17,
DIAGNOSIS_18,
DIAGNOSIS_19,
DIAGNOSIS_20,
DIAGNOSIS_21,
DIAGNOSIS_22,
DIAGNOSIS_23,
DIAGNOSIS_24,
DIAGNOSIS_25,
DIAGNOSIS_26,
DIAGNOSIS_27,
DIAGNOSIS_28,
DIAGNOSIS_29,
DIAGNOSIS_30,
DIAGNOSIS_31,
DIAGNOSIS_32,
DIAGNOSIS_33,
DIAGNOSIS_34,
DIAGNOSIS_35,
DIAGNOSIS_36,
DIAGNOSIS_37,
DIAGNOSIS_38,
DIAGNOSIS_39,
DIAGNOSIS_40,
DIAGNOSIS_41
FROM STAGEDATA.GRP_ICD_DIAGNOSIS_FLAT_SELECT_VW
--ONLY LOOK AT RECORDS THAT HAVE BEEN CHANGED SINCE WE LAST UPDATED THE TARGET TABLE
WHERE GRP_ICD_DIAGNOSIS_FLAT_SELECT_VW.LAST_UPDATED_DATETIME > (SELECT IFNULL(MAX(LAST_UPDATED_DATETIME), '1/1/1900 12:00:00') FROM DIMDATA.GRP_ICD_DIAGNOSIS_FLAT)
) AS SRC
ON (SRC.GRP_ICD_DIAGNOSIS_KEY = TGT.GRP_ICD_DIAGNOSIS_KEY) --SINCE WE ARE ONLY GRABBING THE DELTA, USING ONLY KEYS HERE TO DETERMINE IF WE NEED INSERT OR UPDATE

WHEN MATCHED
THEN UPDATE
    SET TGT.LAST_UPDATED_DATETIME = CURRENT_TIMESTAMP()
    ,TGT.IS_LOGICAL_DELETE_FLAG = FALSE
    ,TGT.DIAGNOSIS_01  = SRC.DIAGNOSIS_01 
    ,TGT.DIAGNOSIS_02  = SRC.DIAGNOSIS_02 
    ,TGT.DIAGNOSIS_03  = SRC.DIAGNOSIS_03 
    ,TGT.DIAGNOSIS_04  = SRC.DIAGNOSIS_04 
    ,TGT.DIAGNOSIS_05  = SRC.DIAGNOSIS_05 
    ,TGT.DIAGNOSIS_06  = SRC.DIAGNOSIS_06 
    ,TGT.DIAGNOSIS_07  = SRC.DIAGNOSIS_07 
    ,TGT.DIAGNOSIS_08  = SRC.DIAGNOSIS_08 
    ,TGT.DIAGNOSIS_09  = SRC.DIAGNOSIS_09 
    ,TGT.DIAGNOSIS_10 = SRC.DIAGNOSIS_10
    ,TGT.DIAGNOSIS_11 = SRC.DIAGNOSIS_11
    ,TGT.DIAGNOSIS_12 = SRC.DIAGNOSIS_12
    ,TGT.DIAGNOSIS_13 = SRC.DIAGNOSIS_13
    ,TGT.DIAGNOSIS_14 = SRC.DIAGNOSIS_14
    ,TGT.DIAGNOSIS_15 = SRC.DIAGNOSIS_15
    ,TGT.DIAGNOSIS_16 = SRC.DIAGNOSIS_16
    ,TGT.DIAGNOSIS_17 = SRC.DIAGNOSIS_17
    ,TGT.DIAGNOSIS_18 = SRC.DIAGNOSIS_18
    ,TGT.DIAGNOSIS_19 = SRC.DIAGNOSIS_19
    ,TGT.DIAGNOSIS_20 = SRC.DIAGNOSIS_20
    ,TGT.DIAGNOSIS_21 = SRC.DIAGNOSIS_21
    ,TGT.DIAGNOSIS_22 = SRC.DIAGNOSIS_22
    ,TGT.DIAGNOSIS_23 = SRC.DIAGNOSIS_23
    ,TGT.DIAGNOSIS_24 = SRC.DIAGNOSIS_24
    ,TGT.DIAGNOSIS_25 = SRC.DIAGNOSIS_25
    ,TGT.DIAGNOSIS_26 = SRC.DIAGNOSIS_26
    ,TGT.DIAGNOSIS_27 = SRC.DIAGNOSIS_27
    ,TGT.DIAGNOSIS_28 = SRC.DIAGNOSIS_28
    ,TGT.DIAGNOSIS_29 = SRC.DIAGNOSIS_29
    ,TGT.DIAGNOSIS_30 = SRC.DIAGNOSIS_30
    ,TGT.DIAGNOSIS_31 = SRC.DIAGNOSIS_31
    ,TGT.DIAGNOSIS_32 = SRC.DIAGNOSIS_32
    ,TGT.DIAGNOSIS_33 = SRC.DIAGNOSIS_33
    ,TGT.DIAGNOSIS_34 = SRC.DIAGNOSIS_34
    ,TGT.DIAGNOSIS_35 = SRC.DIAGNOSIS_35
    ,TGT.DIAGNOSIS_36 = SRC.DIAGNOSIS_36
    ,TGT.DIAGNOSIS_37 = SRC.DIAGNOSIS_37
    ,TGT.DIAGNOSIS_38 = SRC.DIAGNOSIS_38
    ,TGT.DIAGNOSIS_39 = SRC.DIAGNOSIS_39
    ,TGT.DIAGNOSIS_40 = SRC.DIAGNOSIS_40
    ,TGT.DIAGNOSIS_41 = SRC.DIAGNOSIS_41
WHEN NOT MATCHED
THEN INSERT
    (GRP_ICD_DIAGNOSIS_KEY
    ,INSERT_DATETIME
    ,LAST_UPDATED_DATETIME
    ,IS_LOGICAL_DELETE_FLAG
    ,DIAGNOSIS_01
    ,DIAGNOSIS_02
    ,DIAGNOSIS_03
    ,DIAGNOSIS_04
    ,DIAGNOSIS_05
    ,DIAGNOSIS_06
    ,DIAGNOSIS_07
    ,DIAGNOSIS_08
    ,DIAGNOSIS_09
    ,DIAGNOSIS_10
    ,DIAGNOSIS_11
    ,DIAGNOSIS_12
    ,DIAGNOSIS_13
    ,DIAGNOSIS_14
    ,DIAGNOSIS_15
    ,DIAGNOSIS_16
    ,DIAGNOSIS_17
    ,DIAGNOSIS_18
    ,DIAGNOSIS_19
    ,DIAGNOSIS_20
    ,DIAGNOSIS_21
    ,DIAGNOSIS_22
    ,DIAGNOSIS_23
    ,DIAGNOSIS_24
    ,DIAGNOSIS_25
    ,DIAGNOSIS_26
    ,DIAGNOSIS_27
    ,DIAGNOSIS_28
    ,DIAGNOSIS_29
    ,DIAGNOSIS_30
    ,DIAGNOSIS_31
    ,DIAGNOSIS_32
    ,DIAGNOSIS_33
    ,DIAGNOSIS_34
    ,DIAGNOSIS_35
    ,DIAGNOSIS_36
    ,DIAGNOSIS_37
    ,DIAGNOSIS_38
    ,DIAGNOSIS_39
    ,DIAGNOSIS_40
    ,DIAGNOSIS_41
    )
VALUES
    (
    SRC.GRP_ICD_DIAGNOSIS_KEY
    ,CURRENT_TIMESTAMP()
    ,CURRENT_TIMESTAMP()
    ,FALSE
    ,SRC.DIAGNOSIS_01 
    ,SRC.DIAGNOSIS_02 
    ,SRC.DIAGNOSIS_03 
    ,SRC.DIAGNOSIS_04 
    ,SRC.DIAGNOSIS_05 
    ,SRC.DIAGNOSIS_06 
    ,SRC.DIAGNOSIS_07 
    ,SRC.DIAGNOSIS_08 
    ,SRC.DIAGNOSIS_09 
    ,SRC.DIAGNOSIS_10
    ,SRC.DIAGNOSIS_11
    ,SRC.DIAGNOSIS_12
    ,SRC.DIAGNOSIS_13
    ,SRC.DIAGNOSIS_14
    ,SRC.DIAGNOSIS_15
    ,SRC.DIAGNOSIS_16
    ,SRC.DIAGNOSIS_17
    ,SRC.DIAGNOSIS_18
    ,SRC.DIAGNOSIS_19
    ,SRC.DIAGNOSIS_20
    ,SRC.DIAGNOSIS_21
    ,SRC.DIAGNOSIS_22
    ,SRC.DIAGNOSIS_23
    ,SRC.DIAGNOSIS_24
    ,SRC.DIAGNOSIS_25
    ,SRC.DIAGNOSIS_26
    ,SRC.DIAGNOSIS_27
    ,SRC.DIAGNOSIS_28
    ,SRC.DIAGNOSIS_29
    ,SRC.DIAGNOSIS_30
    ,SRC.DIAGNOSIS_31
    ,SRC.DIAGNOSIS_32
    ,SRC.DIAGNOSIS_33
    ,SRC.DIAGNOSIS_34
    ,SRC.DIAGNOSIS_35
    ,SRC.DIAGNOSIS_36
    ,SRC.DIAGNOSIS_37
    ,SRC.DIAGNOSIS_38
    ,SRC.DIAGNOSIS_39
    ,SRC.DIAGNOSIS_40
    ,SRC.DIAGNOSIS_41
    );
`;

// set delete command which will update to is_logical_delete to true
var sqlDeleteCommand =
`
UPDATE DIMDATA.GRP_ICD_DIAGNOSIS_FLAT
    SET LAST_UPDATED_DATETIME = CURRENT_TIMESTAMP()
    ,IS_LOGICAL_DELETE_FLAG = TRUE
WHERE GRP_ICD_DIAGNOSIS_KEY NOT IN (SELECT DISTINCT GRP_ICD_DIAGNOSIS_KEY FROM DIMDATA.GRP_ICD_DIAGNOSIS)
;`;

var sqlLogCommand =
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10)
;`;

try 
{
    //Execute Merge Command
    var startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    ({
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
    });

    // You must run a seperate query to find records in the target that do not exist in the source and mark them as deleted
    //Execute DELETE Command
    var startTime = new Date().toISOString();

    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    ({
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
    });
}

catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10,:11);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[targetTableName, "TABLE", startTime, endTime, result, sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt, sfStatement.getQueryId()]
        }
    );        
    throw result;
}
return result;
$$
;
