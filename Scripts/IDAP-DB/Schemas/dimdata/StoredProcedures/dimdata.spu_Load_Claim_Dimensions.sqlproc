CREATE OR REPLACE PROCEDURE DIMDATA.SPU_LOAD_CLAIM_DIMENSIONS()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS CALLER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var sqlCommand="";

try 
{

    //set query_tag for session logging
    sqlCommand = `CALL UTIL.SPU_SET_QUERY_TAG();`;
    var resultSet = snowflake.execute({sqlText: sqlCommand});

   //generate a JOB_ID for tracing validations and failures
   sqlCommand = `CALL LOGDATA.SPU_SET_JOB_ID('${procedureName}')`;
   resultSet = snowflake.execute({sqlText: sqlCommand});
   resultSet.next();
   var jobId = resultSet.getColumnValue(1);


    //*****************************************************************************
    //Call Merge Stored Procedures To Load data from STAGEDATA to DIMDATA
    //*****************************************************************************

    //<raw table name>  (Repeat these calls for all the tables you want to load)
    //sqlCommand = 'CALL <schema_name>.<procedure name>();';
    //var resultSet = snowflake.execute({sqlText: sqlCommand});

    // A control table might be used as this grows.
    // The order in which these stored procedures are processed is important!!!

    //*****************************************************************************
    // Stage RAWDATA from source systems
    //*****************************************************************************

    sqlCommand = `CALL RAWDATA.SPU_LOAD_RAWDATA_SCHEMA(${jobId});`;
    snowflake.execute({sqlText: sqlCommand});


    //*****************************************************************************
    // Load work tables in STAGEDATA schema to result in DIMDATA Dimensions
    //*****************************************************************************

    // STAGEDATA.TEMP_CLAIM_DETAIL_DEDUPE
    sqlCommand = `CALL STAGEDATA.SPU_TEMP_CLAIM_DETAIL_DEDUPE();`;
    resultSet = snowflake.execute({sqlText: sqlCommand});
    
    // STAGEDATA.CLAIM_HEADER_ICD_DIAGNOSIS_CODE
    sqlCommand = `CALL STAGEDATA.SPU_LOAD_CLAIM_HEADER_ICD_DIAGNOSIS_CODE();`;
    resultSet = snowflake.execute({sqlText: sqlCommand});

    // STAGEDATA.CLAIM_HEADER_ICD_DIAGNOSIS_CODE_GRP
    sqlCommand = `CALL STAGEDATA.SPU_LOAD_CLAIM_HEADER_ICD_DIAGNOSIS_CODE_GRP();`;
    resultSet = snowflake.execute({sqlText: sqlCommand});

    // STAGEDATA.GRP_ICD_DIAGNOSIS
    sqlCommand = `CALL STAGEDATA.SPU_LOAD_GRP_ICD_DIAGNOSIS();`;
    resultSet = snowflake.execute({sqlText: sqlCommand});
    //***************************************************

    // STAGEDATA.CLAIM_HEADER_ICD_PROCEDURE_CODE
