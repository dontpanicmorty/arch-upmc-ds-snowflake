//    sqlCommand = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK(${jobId}, 'DIMDATA.GRP_PROCEDURE_MODIFIER');`;
//    snowflake.execute({sqlText: sqlCommand});  
  
    //GRP_CLAIM_RIDER
    sqlCommand = `CALL DIMDATA.SPU_LOAD_GRP_CLAIM_RIDER();`;
    resultSet = snowflake.execute({sqlText: sqlCommand});

    sqlCommand = `CALL LOGDATA.SPU_VALIDATE_DATA_DUPE_CHECK(${jobId}, 'DIMDATA.GRP_CLAIM_RIDER');`;
    snowflake.execute({sqlText: sqlCommand});

// This cannot be run on a group table.  the PK value is intentionally duplicated
//    sqlCommand = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK(${jobId}, 'DIMDATA.GRP_CLAIM_RIDER');`;
//    snowflake.execute({sqlText: sqlCommand});
  
    //GRP_ICD_DIAGNOSIS_FLAT
    sqlCommand = `CALL DIMDATA.SPU_LOAD_GRP_ICD_DIAGNOSIS_FLAT();`;
    resultSet = snowflake.execute({sqlText: sqlCommand});

    sqlCommand = `CALL LOGDATA.SPU_VALIDATE_DATA_DUPE_CHECK(${jobId}, 'DIMDATA.GRP_ICD_DIAGNOSIS_FLAT');`;
    snowflake.execute({sqlText: sqlCommand});

    sqlCommand = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK(${jobId}, 'DIMDATA.GRP_ICD_DIAGNOSIS_FLAT');`;
    snowflake.execute({sqlText: sqlCommand});

    //GRP_PROCEDURE_MODIFIER_FLAT
    sqlCommand = `CALL DIMDATA.SPU_LOAD_GRP_PROCEDURE_MODIFIER_FLAT();`;
    resultSet = snowflake.execute({sqlText: sqlCommand});   

    sqlCommand = `CALL LOGDATA.SPU_VALIDATE_DATA_DUPE_CHECK(${jobId}, 'DIMDATA.GRP_PROCEDURE_MODIFIER_FLAT');`;
    snowflake.execute({sqlText: sqlCommand});

    sqlCommand = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK(${jobId}, 'DIMDATA.GRP_PROCEDURE_MODIFIER_FLAT');`;
    snowflake.execute({sqlText: sqlCommand});
  
/***********************************************************************************
************************ Load staging for fact table build *************************
************************************************************************************/
    
    //DIM_DIAGNOSIS_RELATED_GROUP_LOOKUP
    sqlCommand = `CALL STAGEDATA.SPU_LOAD_DIM_DIAGNOSIS_RELATED_GROUP_LOOKUP();`;
    snowflake.execute({sqlText: sqlCommand});   

    sqlCommand = `CALL LOGDATA.SPU_VALIDATE_DATA_DUPE_CHECK(${jobId}, 'STAGEDATA.DIM_DIAGNOSIS_RELATED_GROUP_LOOKUP');`;
    snowflake.execute({sqlText: sqlCommand});

    sqlCommand = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK(${jobId}, 'STAGEDATA.DIM_DIAGNOSIS_RELATED_GROUP_LOOKUP');`;
    snowflake.execute({sqlText: sqlCommand});

    //STAGEDATA.SPU_LOAD_GRP_LOOKUP_TABLES  (Dup check are in this procedure)
    sqlCommand = `CALL STAGEDATA.SPU_LOAD_GRP_LOOKUP_TABLES(${jobId});`;
    snowflake.execute({sqlText: sqlCommand});   


/***********************************************************************************
******************************** Load Fact Table ***********************************
************************************************************************************/

    //FACT_CLAIM_LINE
    sqlCommand = `CALL DIMDATA.SPU_LOAD_FACT_CLAIM_LINE();`;
    snowflake.execute({sqlText: sqlCommand});
  
    sqlCommand = `CALL LOGDATA.SPU_VALIDATE_DATA_DUPE_CHECK(${jobId}, 'DIMDATA.FACT_CLAIM_LINE');`;
    snowflake.execute({sqlText: sqlCommand});

    sqlCommand = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK(${jobId}, 'DIMDATA.FACT_CLAIM_LINE');`;
    snowflake.execute({sqlText: sqlCommand});

    sqlCommand = `CALL LOGDATA.SPU_VALIDATE_DATA_FOREIGN_KEY_CHECK(${jobId}, 'DIMDATA.FACT_CLAIM_LINE');`;
    snowflake.execute({sqlText: sqlCommand});
 
    sqlCommand = `CALL LOGDATA.SPU_UNKNOWN_FOREIGN_KEY_CHECK (${jobId}, 'DIMDATA.FACT_CLAIM_LINE');`;
    snowflake.execute({sqlText: sqlCommand});

    //FACT_CLAIM_AUTHORIZATION_DETAIL
    sqlCommand = `CALL DIMDATA.SPU_LOAD_FACT_CLAIM_AUTHORIZATION_DETAIL();`;
    snowflake.execute({sqlText: sqlCommand});
  
    sqlCommand = `CALL LOGDATA.SPU_VALIDATE_DATA_DUPE_CHECK(${jobId}, 'DIMDATA.FACT_CLAIM_AUTHORIZATION_DETAIL');`;
    snowflake.execute({sqlText: sqlCommand});

    sqlCommand = `CALL LOGDATA.SPU_VALIDATE_DATA_PRIMARY_KEY_CHECK(${jobId}, 'DIMDATA.FACT_CLAIM_AUTHORIZATION_DETAIL');`;
    snowflake.execute({sqlText: sqlCommand});

    sqlCommand = `CALL LOGDATA.SPU_VALIDATE_DATA_FOREIGN_KEY_CHECK(${jobId}, 'DIMDATA.FACT_CLAIM_AUTHORIZATION_DETAIL');`;
    snowflake.execute({sqlText: sqlCommand});
 
    sqlCommand = `CALL LOGDATA.SPU_UNKNOWN_FOREIGN_KEY_CHECK (${jobId}, 'DIMDATA.FACT_CLAIM_AUTHORIZATION_DETAIL');`;
    snowflake.execute({sqlText: sqlCommand});
    //*****************************************************************************
    // End calls to merge procedures
    //*****************************************************************************
   

    var endTime = new Date().toISOString();
    var result = "Succeeded";

    sqlCommand = `CALL LOGDATA.SPU_SET_JOB_ID_ENDTIME(${jobId});`;
    snowflake.execute({sqlText: sqlCommand});

    //log results to table
    var sqlLogCommand = `
        INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
            (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6);`;
    
    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds: 
            [
            procedureName
            ,"Procedure"
            ,startTime
            ,endTime
            ,result
            ,procedureName
            ]
        }
    );        
}
catch (err)
{
    var endTime = new Date().toISOString();
    var result = "Failed";
    
    //log results to table
    var sqlLogCommand = `
        INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
            (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;
    
    snowflake.execute
    (
        {sqlText: sqlLogCommand, binds: 
            [
            procedureName
            ,"Procedure"
            ,startTime
            ,endTime
            ,result
            ,sqlCommand
            ,err.code
            ,err.state
            ,err.message
            ,err.stackTraceTxt
            ]
        }
    );        
    throw result;
}
return result;
$$
;