CREATE OR REPLACE PROCEDURE DIMDATA.SPU_LOAD_DIM_PHARMACY_CLAIM_HEADER()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `DIMDATA.DIM_PHARMACY_CLAIM_HEADER`;

// Create merge statement to be executed.
var sqlMergeCommand =
`
MERGE INTO DIMDATA.DIM_PHARMACY_CLAIM_HEADER AS tgt
USING (
        SELECT
        FALSE AS IS_LOGICAL_DELETE_FLAG
        ,TPA_CLIENT_ID
        ,TPA_ID
        ,TPA_DIV_ID
        ,DATA_SOURCE_NAME
        ,CLAIM_NBR
        ,CARE_TYPE_NAME
        ,ORIGINAL_CLAIM_LOB
        ,CLAIM_TYPE_CODE
        ,CLAIM_TYPE_DESC
        ,DISPENSE_CODE
        ,DISPENSE_CODE_DESC
        ,REFILL_CODE
        ,PRESCRIPTION_NBR
        ,AUTHORIZATION_NBR
        ,PRESCRIPTION_ORIGIN_CODE
        ,PRESCRIPTION_ORIGIN_DESC
        ,PHARMACY_NETWORK_CODE
        ,PHARMACY_NETWORK_DESC
        ,PRICE_SOURCE_CODE
        ,PRICE_SOURCE_DESC
        ,COMPOUND_CODE
        ,COMPOUND_CODE_DESC
        ,ESI_FUNDED_IND
        ,ESI_FUNDED_IND_DESC
        ,TROOP_ELIGIBILITY_CODE
        ,LOW_INCOME_SUBSIDY_CODE
        ,LOW_INCOME_SUBSIDY_DESC
        ,PARTIAL_FILL_STATUS_CODE
        ,PARTIAL_FILL_STATUS_DESC
        ,FORMULARY_FLAG_CODE
        ,FORMULARY_FLAG_CODE_DESC
        ,DISPENSE_PHARMACY_TYPE_CODE
        ,DISPENSE_PHARMACY_TYPE_DESC
        ,OTHER_COVERAGE_CODE
        ,OTHER_COVERAGE_DESC
        ,DRUG_DISCOUNT_EXCLUSION_CODE
        ,DRUG_DISCOUNT_EXCLUSION_DESC
        ,DRUG_DISCOUNT_APPLICABLE_CODE
        ,DRUG_DISCOUNT_APPLICABLE_DESC
        ,AWP_INDICATION_CODE
        ,AWP_INDICATION_DESC
        ,PATIENT_RESIDENCE_CODE
        ,PATIENT_RESIDENCE_DESC
        ,BENEFIT_PLAN_LEVEL_CODE
        ,FILL_METHOD_CODE
        ,FILL_METHOD_DESC
        ,ESI_PLAN_NBR
        ,CMS_CONTRACT_ID
        ,CMS_PBP_ID
        ,CLAIM_GENERIC_PRICE_CODE
        ,CLAIM_GENERIC_PRICE_DESC
        ,SAVE_ON_RX_IND
        ,M3P_ORIGIN
        ,M3P_ORIGIN_DESC
        ,MANUFACTURER_DISCOUNT_TYPE
        ,MANUFACTURER_DISCOUNT_TYPE_DESC
        ,CLAIM_HIC3_CODE
        ,CLAIM_HIC3_DESC
        ,CLAIM_GENERIC_SOURCE_CODE
        ,CLAIM_GENERIC_SOURCE_DESC
        ,PRICING_USED_IND
        ,PRICING_USED_IND_DESC
        ,SUPPLEMENTAL_COVERAGE_TROOP_QUALIFICATION
        ,SUPPLEMENTAL_COVERAGE_TROOP_DESC
        ,RX_FORMULARY_CODE
        ,RX_FORMULARY_DESC
        ,PRESCRIBER_SOURCE_CODE
        ,SOURCE_SYSTEM
        ,SOURCE_ID
        FROM STAGEDATA.DIM_PHARMACY_CLAIM_HEADER_SELECT_VW
    MINUS
        SELECT
        IS_LOGICAL_DELETE_FLAG
        ,TPA_CLIENT_ID
        ,TPA_ID
        ,TPA_DIV_ID
        ,DATA_SOURCE_NAME
        ,CLAIM_NBR
        ,CARE_TYPE_NAME
        ,ORIGINAL_CLAIM_LOB
        ,CLAIM_TYPE_CODE
        ,CLAIM_TYPE_DESC
        ,DISPENSE_CODE
        ,DISPENSE_CODE_DESC
        ,REFILL_CODE
        ,PRESCRIPTION_NBR
        ,AUTHORIZATION_NBR
        ,PRESCRIPTION_ORIGIN_CODE
        ,PRESCRIPTION_ORIGIN_DESC
        ,PHARMACY_NETWORK_CODE
        ,PHARMACY_NETWORK_DESC
        ,PRICE_SOURCE_CODE
        ,PRICE_SOURCE_DESC
        ,COMPOUND_CODE
        ,COMPOUND_CODE_DESC
        ,ESI_FUNDED_IND
        ,ESI_FUNDED_IND_DESC
        ,TROOP_ELIGIBILITY_CODE
        ,LOW_INCOME_SUBSIDY_CODE
        ,LOW_INCOME_SUBSIDY_DESC
        ,PARTIAL_FILL_STATUS_CODE
        ,PARTIAL_FILL_STATUS_DESC
        ,FORMULARY_FLAG_CODE
        ,FORMULARY_FLAG_CODE_DESC
        ,DISPENSE_PHARMACY_TYPE_CODE
        ,DISPENSE_PHARMACY_TYPE_DESC
        ,OTHER_COVERAGE_CODE
        ,OTHER_COVERAGE_DESC
        ,DRUG_DISCOUNT_EXCLUSION_CODE
        ,DRUG_DISCOUNT_EXCLUSION_DESC
        ,DRUG_DISCOUNT_APPLICABLE_CODE
        ,DRUG_DISCOUNT_APPLICABLE_DESC
        ,AWP_INDICATION_CODE
        ,AWP_INDICATION_DESC
        ,PATIENT_RESIDENCE_CODE
        ,PATIENT_RESIDENCE_DESC
        ,BENEFIT_PLAN_LEVEL_CODE
        ,FILL_METHOD_CODE
        ,FILL_METHOD_DESC
        ,ESI_PLAN_NBR
        ,CMS_CONTRACT_ID
        ,CMS_PBP_ID
        ,CLAIM_GENERIC_PRICE_CODE
        ,CLAIM_GENERIC_PRICE_DESC
        ,SAVE_ON_RX_IND
        ,M3P_ORIGIN
        ,M3P_ORIGIN_DESC
        ,MANUFACTURER_DISCOUNT_TYPE
        ,MANUFACTURER_DISCOUNT_TYPE_DESC
        ,CLAIM_HIC3_CODE
        ,CLAIM_HIC3_DESC
        ,CLAIM_GENERIC_SOURCE_CODE
        ,CLAIM_GENERIC_SOURCE_DESC
        ,PRICING_USED_IND
        ,PRICING_USED_IND_DESC
        ,SUPPLEMENTAL_COVERAGE_TROOP_QUALIFICATION
        ,SUPPLEMENTAL_COVERAGE_TROOP_DESC
        ,RX_FORMULARY_CODE
        ,RX_FORMULARY_DESC
        ,PRESCRIBER_SOURCE_CODE
        ,SOURCE_SYSTEM
        ,SOURCE_ID
        FROM DIMDATA.DIM_PHARMACY_CLAIM_HEADER
    ) AS src
ON (tgt.TPA_CLIENT_ID = src.TPA_CLIENT_ID
AND tgt.TPA_ID = src.TPA_ID
AND tgt.TPA_DIV_ID = src.TPA_DIV_ID
AND tgt.DATA_SOURCE_NAME = src.DATA_SOURCE_NAME
AND tgt.CLAIM_NBR = src.CLAIM_NBR
AND tgt.SOURCE_SYSTEM = src.SOURCE_SYSTEM
AND tgt.SOURCE_ID = src.SOURCE_ID)

WHEN MATCHED AND 
    (tgt.IS_LOGICAL_DELETE_FLAG = TRUE
    OR NOT EQUAL_NULL(tgt.CARE_TYPE_NAME, src.CARE_TYPE_NAME)
    OR NOT EQUAL_NULL(tgt.ORIGINAL_CLAIM_LOB, src.ORIGINAL_CLAIM_LOB)
    OR NOT EQUAL_NULL(tgt.CLAIM_TYPE_CODE, src.CLAIM_TYPE_CODE)
    OR NOT EQUAL_NULL(tgt.CLAIM_TYPE_DESC, src.CLAIM_TYPE_DESC)
    OR NOT EQUAL_NULL(tgt.DISPENSE_CODE, src.DISPENSE_CODE)
    OR NOT EQUAL_NULL(tgt.DISPENSE_CODE_DESC, src.DISPENSE_CODE_DESC)
    OR NOT EQUAL_NULL(tgt.REFILL_CODE, src.REFILL_CODE)
    OR NOT EQUAL_NULL(tgt.PRESCRIPTION_NBR, src.PRESCRIPTION_NBR)
    OR NOT EQUAL_NULL(tgt.AUTHORIZATION_NBR, src.AUTHORIZATION_NBR)
    OR NOT EQUAL_NULL(tgt.PRESCRIPTION_ORIGIN_CODE, src.PRESCRIPTION_ORIGIN_CODE)
    OR NOT EQUAL_NULL(tgt.PRESCRIPTION_ORIGIN_DESC, src.PRESCRIPTION_ORIGIN_DESC)
    OR NOT EQUAL_NULL(tgt.PHARMACY_NETWORK_CODE, src.PHARMACY_NETWORK_CODE)
    OR NOT EQUAL_NULL(tgt.PHARMACY_NETWORK_DESC, src.PHARMACY_NETWORK_DESC)
    OR NOT EQUAL_NULL(tgt.PRICE_SOURCE_CODE, src.PRICE_SOURCE_CODE)
    OR NOT EQUAL_NULL(tgt.PRICE_SOURCE_DESC, src.PRICE_SOURCE_DESC)
    OR NOT EQUAL_NULL(tgt.COMPOUND_CODE, src.COMPOUND_CODE)
    OR NOT EQUAL_NULL(tgt.COMPOUND_CODE_DESC, src.COMPOUND_CODE_DESC)
    OR NOT EQUAL_NULL(tgt.ESI_FUNDED_IND, src.ESI_FUNDED_IND)
    OR NOT EQUAL_NULL(tgt.ESI_FUNDED_IND_DESC, src.ESI_FUNDED_IND_DESC)
    OR NOT EQUAL_NULL(tgt.TROOP_ELIGIBILITY_CODE, src.TROOP_ELIGIBILITY_CODE)
    OR NOT EQUAL_NULL(tgt.LOW_INCOME_SUBSIDY_CODE, src.LOW_INCOME_SUBSIDY_CODE)
    OR NOT EQUAL_NULL(tgt.LOW_INCOME_SUBSIDY_DESC, src.LOW_INCOME_SUBSIDY_DESC)
    OR NOT EQUAL_NULL(tgt.PARTIAL_FILL_STATUS_CODE, src.PARTIAL_FILL_STATUS_CODE)
    OR NOT EQUAL_NULL(tgt.PARTIAL_FILL_STATUS_DESC, src.PARTIAL_FILL_STATUS_DESC)
    OR NOT EQUAL_NULL(tgt.FORMULARY_FLAG_CODE, src.FORMULARY_FLAG_CODE)
    OR NOT EQUAL_NULL(tgt.FORMULARY_FLAG_CODE_DESC, src.FORMULARY_FLAG_CODE_DESC)
    OR NOT EQUAL_NULL(tgt.DISPENSE_PHARMACY_TYPE_CODE, src.DISPENSE_PHARMACY_TYPE_CODE)
    OR NOT EQUAL_NULL(tgt.DISPENSE_PHARMACY_TYPE_DESC, src.DISPENSE_PHARMACY_TYPE_DESC)
    OR NOT EQUAL_NULL(tgt.OTHER_COVERAGE_CODE, src.OTHER_COVERAGE_CODE)
    OR NOT EQUAL_NULL(tgt.OTHER_COVERAGE_DESC, src.OTHER_COVERAGE_DESC)
    OR NOT EQUAL_NULL(tgt.DRUG_DISCOUNT_EXCLUSION_CODE, src.DRUG_DISCOUNT_EXCLUSION_CODE)
    OR NOT EQUAL_NULL(tgt.DRUG_DISCOUNT_EXCLUSION_DESC, src.DRUG_DISCOUNT_EXCLUSION_DESC)
    OR NOT EQUAL_NULL(tgt.DRUG_DISCOUNT_APPLICABLE_CODE, src.DRUG_DISCOUNT_APPLICABLE_CODE)
    OR NOT EQUAL_NULL(tgt.DRUG_DISCOUNT_APPLICABLE_DESC, src.DRUG_DISCOUNT_APPLICABLE_DESC)
    OR NOT EQUAL_NULL(tgt.AWP_INDICATION_CODE, src.AWP_INDICATION_CODE)
    OR NOT EQUAL_NULL(tgt.AWP_INDICATION_DESC, src.AWP_INDICATION_DESC)
    OR NOT EQUAL_NULL(tgt.PATIENT_RESIDENCE_CODE, src.PATIENT_RESIDENCE_CODE)
    OR NOT EQUAL_NULL(tgt.PATIENT_RESIDENCE_DESC, src.PATIENT_RESIDENCE_DESC)
    OR NOT EQUAL_NULL(tgt.BENEFIT_PLAN_LEVEL_CODE, src.BENEFIT_PLAN_LEVEL_CODE)
    OR NOT EQUAL_NULL(tgt.FILL_METHOD_CODE, src.FILL_METHOD_CODE)
    OR NOT EQUAL_NULL(tgt.FILL_METHOD_DESC, src.FILL_METHOD_DESC)
    OR NOT EQUAL_NULL(tgt.ESI_PLAN_NBR, src.ESI_PLAN_NBR)
    OR NOT EQUAL_NULL(tgt.CMS_CONTRACT_ID, src.CMS_CONTRACT_ID)
    OR NOT EQUAL_NULL(tgt.CMS_PBP_ID, src.CMS_PBP_ID)
    OR NOT EQUAL_NULL(tgt.CLAIM_GENERIC_PRICE_CODE, src.CLAIM_GENERIC_PRICE_CODE)
    OR NOT EQUAL_NULL(tgt.CLAIM_GENERIC_PRICE_DESC, src.CLAIM_GENERIC_PRICE_DESC)
    OR NOT EQUAL_NULL(tgt.SAVE_ON_RX_IND, src.SAVE_ON_RX_IND)
    OR NOT EQUAL_NULL(tgt.M3P_ORIGIN, src.M3P_ORIGIN)
    OR NOT EQUAL_NULL(tgt.M3P_ORIGIN_DESC, src.M3P_ORIGIN_DESC)
    OR NOT EQUAL_NULL(tgt.MANUFACTURER_DISCOUNT_TYPE, src.MANUFACTURER_DISCOUNT_TYPE)
    OR NOT EQUAL_NULL(tgt.MANUFACTURER_DISCOUNT_TYPE_DESC, src.MANUFACTURER_DISCOUNT_TYPE_DESC)
    OR NOT EQUAL_NULL(tgt.CLAIM_HIC3_CODE, src.CLAIM_HIC3_CODE)
    OR NOT EQUAL_NULL(tgt.CLAIM_HIC3_DESC, src.CLAIM_HIC3_DESC)
    OR NOT EQUAL_NULL(tgt.CLAIM_GENERIC_SOURCE_CODE, src.CLAIM_GENERIC_SOURCE_CODE)
    OR NOT EQUAL_NULL(tgt.CLAIM_GENERIC_SOURCE_DESC, src.CLAIM_GENERIC_SOURCE_DESC)
    OR NOT EQUAL_NULL(tgt.PRICING_USED_IND, src.PRICING_USED_IND)
    OR NOT EQUAL_NULL(tgt.PRICING_USED_IND_DESC, src.PRICING_USED_IND_DESC)
    OR NOT EQUAL_NULL(tgt.SUPPLEMENTAL_COVERAGE_TROOP_QUALIFICATION, src.SUPPLEMENTAL_COVERAGE_TROOP_QUALIFICATION)
    OR NOT EQUAL_NULL(tgt.SUPPLEMENTAL_COVERAGE_TROOP_DESC, src.SUPPLEMENTAL_COVERAGE_TROOP_DESC)
    OR NOT EQUAL_NULL(tgt.RX_FORMULARY_CODE, src.RX_FORMULARY_CODE)
    OR NOT EQUAL_NULL(tgt.RX_FORMULARY_DESC, src.RX_FORMULARY_DESC)
    OR NOT EQUAL_NULL(tgt.PRESCRIBER_SOURCE_CODE, src.PRESCRIBER_SOURCE_CODE))

THEN UPDATE SET
    tgt.LAST_UPDATED_DATETIME=CURRENT_TIMESTAMP(),
    tgt.IS_LOGICAL_DELETE_FLAG = FALSE,
    tgt.CARE_TYPE_NAME = src.CARE_TYPE_NAME,
    tgt.ORIGINAL_CLAIM_LOB = src.ORIGINAL_CLAIM_LOB,
    tgt.CLAIM_TYPE_CODE = src.CLAIM_TYPE_CODE,
    tgt.CLAIM_TYPE_DESC = src.CLAIM_TYPE_DESC,
    tgt.DISPENSE_CODE = src.DISPENSE_CODE,
    tgt.DISPENSE_CODE_DESC = src.DISPENSE_CODE_DESC,
    tgt.REFILL_CODE = src.REFILL_CODE,
    tgt.PRESCRIPTION_NBR = src.PRESCRIPTION_NBR,
    tgt.AUTHORIZATION_NBR = src.AUTHORIZATION_NBR,
    tgt.PRESCRIPTION_ORIGIN_CODE = src.PRESCRIPTION_ORIGIN_CODE,
    tgt.PRESCRIPTION_ORIGIN_DESC = src.PRESCRIPTION_ORIGIN_DESC,
    tgt.PHARMACY_NETWORK_CODE = src.PHARMACY_NETWORK_CODE,
    tgt.PHARMACY_NETWORK_DESC = src.PHARMACY_NETWORK_DESC,
    tgt.PRICE_SOURCE_CODE = src.PRICE_SOURCE_CODE,
    tgt.PRICE_SOURCE_DESC = src.PRICE_SOURCE_DESC,
    tgt.COMPOUND_CODE = src.COMPOUND_CODE,
    tgt.COMPOUND_CODE_DESC = src.COMPOUND_CODE_DESC,
    tgt.ESI_FUNDED_IND = src.ESI_FUNDED_IND,
    tgt.ESI_FUNDED_IND_DESC = src.ESI_FUNDED_IND_DESC,
    tgt.TROOP_ELIGIBILITY_CODE = src.TROOP_ELIGIBILITY_CODE,
    tgt.LOW_INCOME_SUBSIDY_CODE = src.LOW_INCOME_SUBSIDY_CODE,
    tgt.LOW_INCOME_SUBSIDY_DESC = src.LOW_INCOME_SUBSIDY_DESC,
    tgt.PARTIAL_FILL_STATUS_CODE = src.PARTIAL_FILL_STATUS_CODE,
    tgt.PARTIAL_FILL_STATUS_DESC = src.PARTIAL_FILL_STATUS_DESC,
    tgt.FORMULARY_FLAG_CODE = src.FORMULARY_FLAG_CODE,
    tgt.FORMULARY_FLAG_CODE_DESC = src.FORMULARY_FLAG_CODE_DESC,
    tgt.DISPENSE_PHARMACY_TYPE_CODE = src.DISPENSE_PHARMACY_TYPE_CODE,
    tgt.DISPENSE_PHARMACY_TYPE_DESC = src.DISPENSE_PHARMACY_TYPE_DESC,
    tgt.OTHER_COVERAGE_CODE = src.OTHER_COVERAGE_CODE,
    tgt.OTHER_COVERAGE_DESC = src.OTHER_COVERAGE_DESC,
    tgt.DRUG_DISCOUNT_EXCLUSION_CODE = src.DRUG_DISCOUNT_EXCLUSION_CODE,
    tgt.DRUG_DISCOUNT_EXCLUSION_DESC = src.DRUG_DISCOUNT_EXCLUSION_DESC,
    tgt.DRUG_DISCOUNT_APPLICABLE_CODE = src.DRUG_DISCOUNT_APPLICABLE_CODE,
    tgt.DRUG_DISCOUNT_APPLICABLE_DESC = src.DRUG_DISCOUNT_APPLICABLE_DESC,
    tgt.AWP_INDICATION_CODE = src.AWP_INDICATION_CODE,
    tgt.AWP_INDICATION_DESC = src.AWP_INDICATION_DESC,
    tgt.PATIENT_RESIDENCE_CODE = src.PATIENT_RESIDENCE_CODE,
    tgt.PATIENT_RESIDENCE_DESC = src.PATIENT_RESIDENCE_DESC,
    tgt.BENEFIT_PLAN_LEVEL_CODE = src.BENEFIT_PLAN_LEVEL_CODE,
    tgt.FILL_METHOD_CODE = src.FILL_METHOD_CODE,
    tgt.FILL_METHOD_DESC = src.FILL_METHOD_DESC,
    tgt.ESI_PLAN_NBR = src.ESI_PLAN_NBR,
    tgt.CMS_CONTRACT_ID = src.CMS_CONTRACT_ID,
    tgt.CMS_PBP_ID = src.CMS_PBP_ID,
    tgt.CLAIM_GENERIC_PRICE_CODE = src.CLAIM_GENERIC_PRICE_CODE,
    tgt.CLAIM_GENERIC_PRICE_DESC = src.CLAIM_GENERIC_PRICE_DESC,
    tgt.SAVE_ON_RX_IND = src.SAVE_ON_RX_IND,
    tgt.M3P_ORIGIN = src.M3P_ORIGIN,
    tgt.M3P_ORIGIN_DESC = src.M3P_ORIGIN_DESC,
    tgt.MANUFACTURER_DISCOUNT_TYPE = src.MANUFACTURER_DISCOUNT_TYPE,
    tgt.MANUFACTURER_DISCOUNT_TYPE_DESC = src.MANUFACTURER_DISCOUNT_TYPE_DESC,
    tgt.CLAIM_HIC3_CODE = src.CLAIM_HIC3_CODE,
    tgt.CLAIM_HIC3_DESC = src.CLAIM_HIC3_DESC,
    tgt.CLAIM_GENERIC_SOURCE_CODE = src.CLAIM_GENERIC_SOURCE_CODE,
    tgt.CLAIM_GENERIC_SOURCE_DESC = src.CLAIM_GENERIC_SOURCE_DESC,
    tgt.PRICING_USED_IND = src.PRICING_USED_IND,
    tgt.PRICING_USED_IND_DESC = src.PRICING_USED_IND_DESC,
    tgt.SUPPLEMENTAL_COVERAGE_TROOP_QUALIFICATION = src.SUPPLEMENTAL_COVERAGE_TROOP_QUALIFICATION,
    tgt.SUPPLEMENTAL_COVERAGE_TROOP_DESC = src.SUPPLEMENTAL_COVERAGE_TROOP_DESC,
    tgt.RX_FORMULARY_CODE = src.RX_FORMULARY_CODE,
    tgt.RX_FORMULARY_DESC = src.RX_FORMULARY_DESC,
    tgt.PRESCRIBER_SOURCE_CODE = src.PRESCRIBER_SOURCE_CODE

WHEN NOT MATCHED

THEN INSERT 
    (
        DIM_PHARMACY_CLAIM_HEADER_KEY
        ,INSERT_DATETIME
        ,LAST_UPDATED_DATETIME
        ,IS_LOGICAL_DELETE_FLAG
        ,TPA_CLIENT_ID
        ,TPA_ID
        ,TPA_DIV_ID
        ,DATA_SOURCE_NAME
        ,CLAIM_NBR
        ,CARE_TYPE_NAME
        ,ORIGINAL_CLAIM_LOB
        ,CLAIM_TYPE_CODE
        ,CLAIM_TYPE_DESC
        ,DISPENSE_CODE
        ,DISPENSE_CODE_DESC
        ,REFILL_CODE
        ,PRESCRIPTION_NBR
        ,AUTHORIZATION_NBR
        ,PRESCRIPTION_ORIGIN_CODE
        ,PRESCRIPTION_ORIGIN_DESC
        ,PHARMACY_NETWORK_CODE
        ,PHARMACY_NETWORK_DESC
        ,PRICE_SOURCE_CODE
        ,PRICE_SOURCE_DESC
        ,COMPOUND_CODE
        ,COMPOUND_CODE_DESC
        ,ESI_FUNDED_IND
        ,ESI_FUNDED_IND_DESC
        ,TROOP_ELIGIBILITY_CODE
        ,LOW_INCOME_SUBSIDY_CODE
        ,LOW_INCOME_SUBSIDY_DESC
        ,PARTIAL_FILL_STATUS_CODE
        ,PARTIAL_FILL_STATUS_DESC
        ,FORMULARY_FLAG_CODE
        ,FORMULARY_FLAG_CODE_DESC
        ,DISPENSE_PHARMACY_TYPE_CODE
        ,DISPENSE_PHARMACY_TYPE_DESC
        ,OTHER_COVERAGE_CODE
        ,OTHER_COVERAGE_DESC
        ,DRUG_DISCOUNT_EXCLUSION_CODE
        ,DRUG_DISCOUNT_EXCLUSION_DESC
        ,DRUG_DISCOUNT_APPLICABLE_CODE
        ,DRUG_DISCOUNT_APPLICABLE_DESC
        ,AWP_INDICATION_CODE
        ,AWP_INDICATION_DESC
        ,PATIENT_RESIDENCE_CODE
        ,PATIENT_RESIDENCE_DESC
        ,BENEFIT_PLAN_LEVEL_CODE
        ,FILL_METHOD_CODE
        ,FILL_METHOD_DESC
        ,ESI_PLAN_NBR
        ,CMS_CONTRACT_ID
        ,CMS_PBP_ID
        ,CLAIM_GENERIC_PRICE_CODE
        ,CLAIM_GENERIC_PRICE_DESC
        ,SAVE_ON_RX_IND
        ,M3P_ORIGIN
        ,M3P_ORIGIN_DESC
        ,MANUFACTURER_DISCOUNT_TYPE
        ,MANUFACTURER_DISCOUNT_TYPE_DESC
        ,CLAIM_HIC3_CODE
        ,CLAIM_HIC3_DESC
        ,CLAIM_GENERIC_SOURCE_CODE
        ,CLAIM_GENERIC_SOURCE_DESC
        ,PRICING_USED_IND
        ,PRICING_USED_IND_DESC
        ,SUPPLEMENTAL_COVERAGE_TROOP_QUALIFICATION
        ,SUPPLEMENTAL_COVERAGE_TROOP_DESC
        ,RX_FORMULARY_CODE
        ,RX_FORMULARY_DESC
        ,PRESCRIBER_SOURCE_CODE
        ,SOURCE_SYSTEM
        ,SOURCE_ID
    )
VALUES 
    (
        (SELECT IFNULL(MAX(DIM_PHARMACY_CLAIM_HEADER_KEY), 1000) FROM DIMDATA.DIM_PHARMACY_CLAIM_HEADER) + ROW_NUMBER() OVER (ORDER BY 1)
        ,CURRENT_TIMESTAMP()
        ,CURRENT_TIMESTAMP()
        ,FALSE
        ,src.TPA_CLIENT_ID
        ,src.TPA_ID
        ,src.TPA_DIV_ID
        ,src.DATA_SOURCE_NAME
        ,src.CLAIM_NBR
        ,src.CARE_TYPE_NAME
        ,src.ORIGINAL_CLAIM_LOB
        ,src.CLAIM_TYPE_CODE
        ,src.CLAIM_TYPE_DESC
        ,src.DISPENSE_CODE
        ,src.DISPENSE_CODE_DESC
        ,src.REFILL_CODE
        ,src.PRESCRIPTION_NBR
        ,src.AUTHORIZATION_NBR
        ,src.PRESCRIPTION_ORIGIN_CODE
        ,src.PRESCRIPTION_ORIGIN_DESC
        ,src.PHARMACY_NETWORK_CODE
        ,src.PHARMACY_NETWORK_DESC
        ,src.PRICE_SOURCE_CODE
        ,src.PRICE_SOURCE_DESC
        ,src.COMPOUND_CODE
        ,src.COMPOUND_CODE_DESC
        ,src.ESI_FUNDED_IND
        ,src.ESI_FUNDED_IND_DESC
        ,src.TROOP_ELIGIBILITY_CODE
        ,src.LOW_INCOME_SUBSIDY_CODE
        ,src.LOW_INCOME_SUBSIDY_DESC
        ,src.PARTIAL_FILL_STATUS_CODE
        ,src.PARTIAL_FILL_STATUS_DESC
        ,src.FORMULARY_FLAG_CODE
        ,src.FORMULARY_FLAG_CODE_DESC
        ,src.DISPENSE_PHARMACY_TYPE_CODE
        ,src.DISPENSE_PHARMACY_TYPE_DESC
        ,src.OTHER_COVERAGE_CODE
        ,src.OTHER_COVERAGE_DESC
        ,src.DRUG_DISCOUNT_EXCLUSION_CODE
        ,src.DRUG_DISCOUNT_EXCLUSION_DESC
        ,src.DRUG_DISCOUNT_APPLICABLE_CODE
        ,src.DRUG_DISCOUNT_APPLICABLE_DESC
        ,src.AWP_INDICATION_CODE
        ,src.AWP_INDICATION_DESC
        ,src.PATIENT_RESIDENCE_CODE
        ,src.PATIENT_RESIDENCE_DESC
        ,src.BENEFIT_PLAN_LEVEL_CODE
        ,src.FILL_METHOD_CODE
        ,src.FILL_METHOD_DESC
        ,src.ESI_PLAN_NBR
        ,src.CMS_CONTRACT_ID
        ,src.CMS_PBP_ID
        ,src.CLAIM_GENERIC_PRICE_CODE
        ,src.CLAIM_GENERIC_PRICE_DESC
        ,src.SAVE_ON_RX_IND
        ,src.M3P_ORIGIN
        ,src.M3P_ORIGIN_DESC
        ,src.MANUFACTURER_DISCOUNT_TYPE
        ,src.MANUFACTURER_DISCOUNT_TYPE_DESC
        ,src.CLAIM_HIC3_CODE
        ,src.CLAIM_HIC3_DESC
        ,src.CLAIM_GENERIC_SOURCE_CODE
        ,src.CLAIM_GENERIC_SOURCE_DESC
        ,src.PRICING_USED_IND
        ,src.PRICING_USED_IND_DESC
        ,src.SUPPLEMENTAL_COVERAGE_TROOP_QUALIFICATION
        ,src.SUPPLEMENTAL_COVERAGE_TROOP_DESC
        ,src.RX_FORMULARY_CODE
        ,src.RX_FORMULARY_DESC
        ,src.PRESCRIBER_SOURCE_CODE
        ,src.SOURCE_SYSTEM
        ,src.SOURCE_ID
    )
;`;

// set delete command which will update to is_logical_delete to true
// The >999 is done to not update any of the static data, inserts start at 1000 from autoincrement
var sqlDeleteCommand =
`
UPDATE DIMDATA.DIM_PHARMACY_CLAIM_HEADER
SET IS_LOGICAL_DELETE_FLAG = TRUE, LAST_UPDATED_DATETIME  = CURRENT_TIMESTAMP()
WHERE DIM_PHARMACY_CLAIM_HEADER_KEY IN
(
    SELECT DIM_PHARMACY_CLAIM_HEADER.DIM_PHARMACY_CLAIM_HEADER_KEY
    FROM DIMDATA.DIM_PHARMACY_CLAIM_HEADER
        LEFT OUTER JOIN STAGEDATA.DIM_PHARMACY_CLAIM_HEADER_SELECT_VW STAGE_DATA
        ON (STAGE_DATA.TPA_CLIENT_ID = DIM_PHARMACY_CLAIM_HEADER.TPA_CLIENT_ID
        AND STAGE_DATA.TPA_ID = DIM_PHARMACY_CLAIM_HEADER.TPA_ID
        AND STAGE_DATA.TPA_DIV_ID = DIM_PHARMACY_CLAIM_HEADER.TPA_DIV_ID
        AND STAGE_DATA.DATA_SOURCE_NAME = DIM_PHARMACY_CLAIM_HEADER.DATA_SOURCE_NAME
        AND STAGE_DATA.CLAIM_NBR = DIM_PHARMACY_CLAIM_HEADER.CLAIM_NBR
        AND STAGE_DATA.SOURCE_SYSTEM = DIM_PHARMACY_CLAIM_HEADER.SOURCE_SYSTEM
        AND STAGE_DATA.SOURCE_ID = DIM_PHARMACY_CLAIM_HEADER.SOURCE_ID)
    WHERE STAGE_DATA.SOURCE_ID IS NULL
    AND DIM_PHARMACY_CLAIM_HEADER.DIM_PHARMACY_CLAIM_HEADER_KEY > 999
    AND DIM_PHARMACY_CLAIM_HEADER.IS_LOGICAL_DELETE_FLAG = FALSE
)
;`    

try 
{
    //Execute Merge Command
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), result, sfStatement.getSqlText()]
        }
    );

    // You must run a seperate query to find records in the target that do not exist in the source and mark them as deleted
    //Execute DELETE Command
    startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand});
    sfStatement.execute();
    endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsUpdated(), result, sfStatement.getSqlText()]
        }
    );
}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[targetTableName, "TABLE", startTime, endTime, result, sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt]
        }
    );        
    throw result;
}
return result;
$$
;