CREATE OR REPLACE PROCEDURE DIMDATA.SPU_LOAD_DIM_PHARMACY_CLAIM_DETAIL()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `DIMDATA.DIM_PHARMACY_CLAIM_DETAIL`;

// Create merge statement to be executed.
var sqlMergeCommand =
`
MERGE INTO DIMDATA.DIM_PHARMACY_CLAIM_DETAIL AS tgt
USING (
        SELECT FALSE AS IS_LOGICAL_DELETE_FLAG
                ,TPA_CLIENT_ID
                ,TPA_ID
                ,TPA_DIV_ID
                ,DATA_SOURCE_NAME
                ,CLAIM_NBR
                ,CLAIM_LINE_NBR
                ,CLAIM_SEQUENCE_NBR
                ,PROCEDURE_ADJ_CODE
                ,ADJUSTMENT_CLAIM_ID
                ,TRANSACTION_TYPE_CODE
                ,TRANSACTION_TYPE_DESC
                ,TRANSACTION_ADJUSTMENT_TYPE_CODE
                ,TRANSACTION_ADJUSTMENT_TYPE_DESC
                ,BATCH_CODE
                ,COPAY_TIER_LEVEL_NBR
                ,ADJUDICATION_PHARMACY_CLASS_CODE
                ,ADJUDICATION_PHARMACY_CLASS_DESC
                ,CLAIM_COB_CODE
                ,CLAIM_COB_DESC
                ,ADJUSTMENT_TYPE_CODE
                ,ADJUSTMENT_TYPE_DESC
                ,TRANSITION_FILL_IND
                ,SOURCE_SYSTEM
                ,SOURCE_ID
        FROM STAGEDATA.DIM_PHARMACY_CLAIM_DETAIL_SELECT_VW 
    MINUS
        SELECT  IS_LOGICAL_DELETE_FLAG
                ,TPA_CLIENT_ID
                ,TPA_ID
                ,TPA_DIV_ID
                ,DATA_SOURCE_NAME
                ,CLAIM_NBR
                ,CLAIM_LINE_NBR
                ,CLAIM_SEQUENCE_NBR
                ,PROCEDURE_ADJ_CODE
                ,ADJUSTMENT_CLAIM_ID
                ,TRANSACTION_TYPE_CODE
                ,TRANSACTION_TYPE_DESC
                ,TRANSACTION_ADJUSTMENT_TYPE_CODE
                ,TRANSACTION_ADJUSTMENT_TYPE_DESC
                ,BATCH_CODE
                ,COPAY_TIER_LEVEL_NBR
                ,ADJUDICATION_PHARMACY_CLASS_CODE
                ,ADJUDICATION_PHARMACY_CLASS_DESC
                ,CLAIM_COB_CODE
                ,CLAIM_COB_DESC
                ,ADJUSTMENT_TYPE_CODE
                ,ADJUSTMENT_TYPE_DESC
                ,TRANSITION_FILL_IND
                ,SOURCE_SYSTEM
                ,SOURCE_ID
        FROM DIMDATA.DIM_PHARMACY_CLAIM_DETAIL
    ) AS src

ON (tgt.TPA_CLIENT_ID = src.TPA_CLIENT_ID
AND tgt.TPA_ID = src.TPA_ID
AND tgt.TPA_DIV_ID = src.TPA_DIV_ID
AND tgt.DATA_SOURCE_NAME = src.DATA_SOURCE_NAME
AND tgt.CLAIM_NBR = src.CLAIM_NBR
AND tgt.CLAIM_LINE_NBR = src.CLAIM_LINE_NBR
AND tgt.CLAIM_SEQUENCE_NBR = src.CLAIM_SEQUENCE_NBR
AND tgt.PROCEDURE_ADJ_CODE = src.PROCEDURE_ADJ_CODE
AND tgt.SOURCE_SYSTEM = src.SOURCE_SYSTEM
AND tgt.SOURCE_ID = src.SOURCE_ID
)

WHEN MATCHED AND 
    (tgt.IS_LOGICAL_DELETE_FLAG = TRUE
        OR NOT EQUAL_NULL(tgt.ADJUSTMENT_CLAIM_ID, src.ADJUSTMENT_CLAIM_ID)
        OR NOT EQUAL_NULL(tgt.TRANSACTION_TYPE_CODE, src.TRANSACTION_TYPE_CODE)
        OR NOT EQUAL_NULL(tgt.TRANSACTION_TYPE_DESC, src.TRANSACTION_TYPE_DESC)
        OR NOT EQUAL_NULL(tgt.TRANSACTION_ADJUSTMENT_TYPE_CODE, src.TRANSACTION_ADJUSTMENT_TYPE_CODE)
        OR NOT EQUAL_NULL(tgt.TRANSACTION_ADJUSTMENT_TYPE_DESC, src.TRANSACTION_ADJUSTMENT_TYPE_DESC)        
        OR NOT EQUAL_NULL(tgt.BATCH_CODE, src.BATCH_CODE)
        OR NOT EQUAL_NULL(tgt.COPAY_TIER_LEVEL_NBR, src.COPAY_TIER_LEVEL_NBR)
        OR NOT EQUAL_NULL(tgt.ADJUDICATION_PHARMACY_CLASS_CODE, src.ADJUDICATION_PHARMACY_CLASS_CODE)
        OR NOT EQUAL_NULL(tgt.ADJUDICATION_PHARMACY_CLASS_DESC, src.ADJUDICATION_PHARMACY_CLASS_DESC)
        OR NOT EQUAL_NULL(tgt.CLAIM_COB_CODE, src.CLAIM_COB_CODE)
        OR NOT EQUAL_NULL(tgt.CLAIM_COB_DESC,  src.CLAIM_COB_DESC)
        OR NOT EQUAL_NULL(tgt.ADJUSTMENT_TYPE_CODE, src.ADJUSTMENT_TYPE_CODE)
        OR NOT EQUAL_NULL(tgt.ADJUSTMENT_TYPE_DESC, src.ADJUSTMENT_TYPE_DESC)
        OR NOT EQUAL_NULL(tgt.TRANSITION_FILL_IND, src.TRANSITION_FILL_IND)
    )

THEN UPDATE SET
    tgt.LAST_UPDATED_DATETIME=CURRENT_TIMESTAMP(),
    tgt.IS_LOGICAL_DELETE_FLAG = FALSE,
    tgt.ADJUSTMENT_CLAIM_ID = src.ADJUSTMENT_CLAIM_ID,
    tgt.TRANSACTION_TYPE_CODE = src.TRANSACTION_TYPE_CODE,
    tgt.TRANSACTION_TYPE_DESC = src.TRANSACTION_TYPE_DESC,
    tgt.TRANSACTION_ADJUSTMENT_TYPE_CODE = src.TRANSACTION_ADJUSTMENT_TYPE_CODE,
    tgt.TRANSACTION_ADJUSTMENT_TYPE_DESC = src.TRANSACTION_ADJUSTMENT_TYPE_DESC,
    tgt.BATCH_CODE = src.BATCH_CODE,
    tgt.COPAY_TIER_LEVEL_NBR = src.COPAY_TIER_LEVEL_NBR,
    tgt.ADJUDICATION_PHARMACY_CLASS_CODE = src.ADJUDICATION_PHARMACY_CLASS_CODE,
    tgt.ADJUDICATION_PHARMACY_CLASS_DESC = src.ADJUDICATION_PHARMACY_CLASS_DESC,
    tgt.CLAIM_COB_CODE = src.CLAIM_COB_CODE,
    tgt.CLAIM_COB_DESC = src.CLAIM_COB_DESC,
    tgt.ADJUSTMENT_TYPE_CODE = src.ADJUSTMENT_TYPE_CODE,
    tgt.ADJUSTMENT_TYPE_DESC = src.ADJUSTMENT_TYPE_DESC,
    tgt.TRANSITION_FILL_IND = src.TRANSITION_FILL_IND   

WHEN NOT MATCHED

THEN INSERT 
    (
        DIM_PHARMACY_CLAIM_DETAIL_KEY
        ,INSERT_DATETIME
        ,LAST_UPDATED_DATETIME
        ,IS_LOGICAL_DELETE_FLAG
        ,TPA_CLIENT_ID
        ,TPA_ID
        ,TPA_DIV_ID
        ,DATA_SOURCE_NAME
        ,CLAIM_NBR
        ,CLAIM_LINE_NBR
        ,CLAIM_SEQUENCE_NBR
        ,PROCEDURE_ADJ_CODE
        ,ADJUSTMENT_CLAIM_ID
        ,TRANSACTION_TYPE_CODE
        ,TRANSACTION_TYPE_DESC
        ,TRANSACTION_ADJUSTMENT_TYPE_CODE
        ,TRANSACTION_ADJUSTMENT_TYPE_DESC
        ,BATCH_CODE
        ,COPAY_TIER_LEVEL_NBR
        ,ADJUDICATION_PHARMACY_CLASS_CODE
        ,ADJUDICATION_PHARMACY_CLASS_DESC
        ,CLAIM_COB_CODE
        ,CLAIM_COB_DESC
        ,ADJUSTMENT_TYPE_CODE
        ,ADJUSTMENT_TYPE_DESC
        ,TRANSITION_FILL_IND
        ,SOURCE_SYSTEM
        ,SOURCE_ID
    )
VALUES 
    (
        (SELECT IFNULL(MAX(DIM_PHARMACY_CLAIM_DETAIL_KEY), 1000) FROM DIMDATA.DIM_PHARMACY_CLAIM_DETAIL) + ROW_NUMBER() OVER (ORDER BY 1)
        ,CURRENT_TIMESTAMP()
        ,CURRENT_TIMESTAMP()
        ,FALSE
        ,src.TPA_CLIENT_ID
        ,src.TPA_ID
        ,src.TPA_DIV_ID
        ,src.DATA_SOURCE_NAME
        ,src.CLAIM_NBR
        ,src.CLAIM_LINE_NBR
        ,src.CLAIM_SEQUENCE_NBR
        ,src.PROCEDURE_ADJ_CODE
        ,src.ADJUSTMENT_CLAIM_ID
        ,src.TRANSACTION_TYPE_CODE
        ,src.TRANSACTION_TYPE_DESC
        ,src.TRANSACTION_ADJUSTMENT_TYPE_CODE
        ,src.TRANSACTION_ADJUSTMENT_TYPE_DESC
        ,src.BATCH_CODE
        ,src.COPAY_TIER_LEVEL_NBR
        ,src.ADJUDICATION_PHARMACY_CLASS_CODE
        ,src.ADJUDICATION_PHARMACY_CLASS_DESC
        ,src.CLAIM_COB_CODE
        ,src.CLAIM_COB_DESC
        ,src.ADJUSTMENT_TYPE_CODE
        ,src.ADJUSTMENT_TYPE_DESC
        ,src.TRANSITION_FILL_IND
        ,src.SOURCE_SYSTEM
        ,src.SOURCE_ID
    )
;`;

// set delete command which will update to is_logical_delete to true
// The >999 is done to not update any of the static data, inserts start at 1000 from autoincrement
var sqlDeleteCommand =
`
UPDATE DIMDATA.DIM_PHARMACY_CLAIM_DETAIL
SET IS_LOGICAL_DELETE_FLAG = 'TRUE', LAST_UPDATED_DATETIME  = CURRENT_TIMESTAMP()
WHERE DIM_PHARMACY_CLAIM_DETAIL_KEY IN
(
    SELECT DIM_PHARMACY_CLAIM_DETAIL.DIM_PHARMACY_CLAIM_DETAIL_KEY
    FROM DIMDATA.DIM_PHARMACY_CLAIM_DETAIL
    LEFT OUTER JOIN STAGEDATA.DIM_PHARMACY_CLAIM_DETAIL_SELECT_VW STAGE_DATA
        ON (DIM_PHARMACY_CLAIM_DETAIL.TPA_CLIENT_ID = STAGE_DATA.TPA_CLIENT_ID
        AND DIM_PHARMACY_CLAIM_DETAIL.TPA_ID = STAGE_DATA.TPA_ID
        AND DIM_PHARMACY_CLAIM_DETAIL.TPA_DIV_ID = STAGE_DATA.TPA_DIV_ID
        AND DIM_PHARMACY_CLAIM_DETAIL.DATA_SOURCE_NAME = STAGE_DATA.DATA_SOURCE_NAME
        AND DIM_PHARMACY_CLAIM_DETAIL.CLAIM_NBR = STAGE_DATA.CLAIM_NBR
        AND DIM_PHARMACY_CLAIM_DETAIL.CLAIM_LINE_NBR = STAGE_DATA.CLAIM_LINE_NBR
        AND DIM_PHARMACY_CLAIM_DETAIL.CLAIM_SEQUENCE_NBR = STAGE_DATA.CLAIM_SEQUENCE_NBR
        AND DIM_PHARMACY_CLAIM_DETAIL.PROCEDURE_ADJ_CODE = STAGE_DATA.PROCEDURE_ADJ_CODE
        AND DIM_PHARMACY_CLAIM_DETAIL.SOURCE_SYSTEM = STAGE_DATA.SOURCE_SYSTEM
        AND DIM_PHARMACY_CLAIM_DETAIL.SOURCE_ID = STAGE_DATA.SOURCE_ID)
WHERE STAGE_DATA.SOURCE_ID IS NULL
    AND DIM_PHARMACY_CLAIM_DETAIL.IS_LOGICAL_DELETE_FLAG = FALSE
    AND DIM_PHARMACY_CLAIM_DETAIL.DIM_PHARMACY_CLAIM_DETAIL_KEY > 999
)
;`    

try 
{
    //Execute Merge Command
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), result, sfStatement.getSqlText()]
        }
    );

    // You must run a seperate query to find records in the target that do not exist in the source and mark them as deleted
    //Execute DELETE Command
    startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand});
    sfStatement.execute();
    endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, UPDATE_COUNT, RESULT_TEXT, SQL_STATEMENT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsUpdated(), result, sfStatement.getSqlText()]
        }
    );
}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[targetTableName, "TABLE", startTime, endTime, result, sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt]
        }
    );        
    throw result;
}
return result;
$$
;