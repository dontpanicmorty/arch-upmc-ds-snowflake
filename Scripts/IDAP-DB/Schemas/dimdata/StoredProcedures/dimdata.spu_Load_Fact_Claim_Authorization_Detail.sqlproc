CREATE OR REPLACE PROCEDURE DIMDATA.SPU_LOAD_FACT_CLAIM_AUTHORIZATION_DETAIL()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = 'DIMDATA.FACT_CLAIM_AUTHORIZATION_DETAIL';

// Create merge statement to be executed.
var sqlMergeCommand =
`
MERGE INTO DIMDATA.FACT_CLAIM_AUTHORIZATION_DETAIL AS tgt
USING (
        SELECT
        DIM_CLAIM_AUTHORIZATION_DETAIL_KEY,
        DIM_TPA_HIERARCHY_KEY,
        DIM_DATA_SOURCE_KEY,
        DIM_CLAIM_AUTHORIZATION_KEY,
        DIM_MEMBER_KEY,
        DIM_PLAN_KEY,
        DIM_SUBMITTING_PROVIDER_KEY,
        DIM_RENDERING_PROVIDER_KEY,
        DIM_CLAIM_PROCEDURE_KEY,
        DIM_SERVICE_BEGIN_DATE_KEY,
        DIM_SERVICE_END_DATE_KEY,
        AUTHORIZATION_NBR,
        AUTHORIZATION_LINE_NBR,
        SERVICE_BEGIN_DATE,
        SERVICE_END_DATE,
        AUTHORIZED_QTY,
        CONSUMED_QTY,
        DENIED_QTY,
        REQUESTED_QTY,
        ALLOWED_AMT,
        AUTHORIZED_AMT,
        AUTHORIZED_PER_UNIT_AMT,
        BALANCE_DUE_AMT,
        BILLED_AMT,
        COINSURANCE_AMT,
        COPAY_AMT,
        DEDUCTIBLE_APPLIED_AMT,
        PAID_AMT,
        PATIENT_PAY_APPLIED_AMT,
        PAYABLE_AMT,
        USUAL_AND_CUSTOMARY_AMT
        FROM STAGEDATA.FACT_CLAIM_AUTHORIZATION_DETAIL_UPMCHP_DATAHUB_SELECT_VW
    MINUS
        SELECT
        DIM_CLAIM_AUTHORIZATION_DETAIL_KEY,
        DIM_TPA_HIERARCHY_KEY,
        DIM_DATA_SOURCE_KEY,
        DIM_CLAIM_AUTHORIZATION_KEY,
        DIM_MEMBER_KEY,
        DIM_PLAN_KEY,
        DIM_SUBMITTING_PROVIDER_KEY,
        DIM_RENDERING_PROVIDER_KEY,
        DIM_CLAIM_PROCEDURE_KEY,
        DIM_SERVICE_BEGIN_DATE_KEY,
        DIM_SERVICE_END_DATE_KEY,
        AUTHORIZATION_NBR,
        AUTHORIZATION_LINE_NBR,
        SERVICE_BEGIN_DATE,
        SERVICE_END_DATE,
        AUTHORIZED_QTY,
        CONSUMED_QTY,
        DENIED_QTY,
        REQUESTED_QTY,
        ALLOWED_AMT,
        AUTHORIZED_AMT,
        AUTHORIZED_PER_UNIT_AMT,
        BALANCE_DUE_AMT,
        BILLED_AMT,
        COINSURANCE_AMT,
        COPAY_AMT,
        DEDUCTIBLE_APPLIED_AMT,
        PAID_AMT,
        PATIENT_PAY_APPLIED_AMT,
        PAYABLE_AMT,
        USUAL_AND_CUSTOMARY_AMT
        FROM DIMDATA.FACT_CLAIM_AUTHORIZATION_DETAIL
    ) AS src
    ON (src.DIM_CLAIM_AUTHORIZATION_DETAIL_KEY = tgt.DIM_CLAIM_AUTHORIZATION_DETAIL_KEY) 
    
WHEN MATCHED 
/*
AND 
    (src.DIM_TPA_HIERARCHY_KEY <> tgt.DIM_TPA_HIERARCHY_KEY
    OR src.DIM_DATA_SOURCE_KEY <> tgt.DIM_DATA_SOURCE_KEY
    OR src.DIM_CLAIM_AUTHORIZATION_KEY <> tgt.DIM_CLAIM_AUTHORIZATION_KEY
    OR src.DIM_MEMBER_KEY <> tgt.DIM_MEMBER_KEY
    OR src.DIM_PLAN_KEY <> tgt.DIM_PLAN_KEY
    OR src.DIM_SUBMITTING_PROVIDER_KEY <> tgt.DIM_SUBMITTING_PROVIDER_KEY
    OR src.DIM_RENDERING_PROVIDER_KEY <> tgt.DIM_RENDERING_PROVIDER_KEY
    OR src.DIM_CLAIM_PROCEDURE_KEY <> tgt.DIM_CLAIM_PROCEDURE_KEY
    OR src.DIM_SERVICE_BEGIN_DATE_KEY <> tgt.DIM_SERVICE_BEGIN_DATE_KEY
    OR src.DIM_SERVICE_END_DATE_KEY <> tgt.DIM_SERVICE_END_DATE_KEY
    OR src.AUTHORIZATION_NBR <> tgt.AUTHORIZATION_NBR
    OR src.AUTHORIZATION_LINE_NBR <> tgt.AUTHORIZATION_LINE_NBR
    OR NOT (EQUALNULL(src.SERVICE_BEGIN_DATE,tgt.SERVICE_BEGIN_DATE))
    OR NOT (EQUALNULL(src.SERVICE_END_DATE,tgt.SERVICE_END_DATE))
    OR NOT (EQUALNULL(src.AUTHORIZED_QTY, tgt.AUTHORIZED_QTY))
    OR NOT (EQUALNULL(src.CONSUMED_QTY, tgt.CONSUMED_QTY))
    OR NOT (EQUALNULL(src.DENIED_QTY, tgt.DENIED_QTY))
    OR NOT (EQUALNULL(src.REQUESTED_QTY, tgt.REQUESTED_QTY))
    OR NOT (EQUALNULL(src.ALLOWED_AMT, tgt.ALLOWED_AMT))
    OR NOT (EQUALNULL(src.AUTHORIZED_AMT, tgt.AUTHORIZED_AMT))
    OR NOT (EQUALNULL(src.AUTHORIZED_PER_UNIT_AMT, tgt.AUTHORIZED_PER_UNIT_AMT))
    OR NOT (EQUALNULL(src.BALANCE_DUE_AMT, tgt.BALANCE_DUE_AMT))
    OR NOT (EQUALNULL(src.BILLED_AMT, tgt.BILLED_AMT))
    OR NOT (EQUALNULL(src.COINSURANCE_AMT, tgt.COINSURANCE_AMT))
    OR NOT (EQUALNULL(src.COPAY_AMT, tgt.COPAY_AMT))
    OR NOT (EQUALNULL(src.DEDUCTIBLE_APPLIED_AMT, tgt.DEDUCTIBLE_APPLIED_AMT))
    OR NOT (EQUALNULL(src.PAID_AMT, tgt.PAID_AMT))
    OR NOT (EQUALNULL(src.PATIENT_PAY_APPLIED_AMT, tgt.PATIENT_PAY_APPLIED_AMT))
    OR NOT (EQUALNULL(src.PAYABLE_AMT, tgt.PAYABLE_AMT))
    OR NOT (EQUALNULL(src.USUAL_AND_CUSTOMARY_AMT, tgt.USUAL_AND_CUSTOMARY_AMT))
    ) */
THEN UPDATE SET
    tgt.LAST_UPDATED_DATETIME = CURRENT_TIMESTAMP(),
    tgt.DIM_TPA_HIERARCHY_KEY = src.DIM_TPA_HIERARCHY_KEY,
    tgt.DIM_DATA_SOURCE_KEY = src.DIM_DATA_SOURCE_KEY,
    tgt.DIM_CLAIM_AUTHORIZATION_KEY = src.DIM_CLAIM_AUTHORIZATION_KEY,
    tgt.DIM_MEMBER_KEY = src.DIM_MEMBER_KEY,
    tgt.DIM_PLAN_KEY = src.DIM_PLAN_KEY,
    tgt.DIM_SUBMITTING_PROVIDER_KEY = src.DIM_SUBMITTING_PROVIDER_KEY,
    tgt.DIM_RENDERING_PROVIDER_KEY = src.DIM_RENDERING_PROVIDER_KEY,
    tgt.DIM_CLAIM_PROCEDURE_KEY = src.DIM_CLAIM_PROCEDURE_KEY,
    tgt.DIM_SERVICE_BEGIN_DATE_KEY = src.DIM_SERVICE_BEGIN_DATE_KEY,
    tgt.DIM_SERVICE_END_DATE_KEY = src.DIM_SERVICE_END_DATE_KEY,
    tgt.AUTHORIZATION_NBR = src.AUTHORIZATION_NBR,
    tgt.AUTHORIZATION_LINE_NBR = src.AUTHORIZATION_LINE_NBR,
    tgt.SERVICE_BEGIN_DATE = src.SERVICE_BEGIN_DATE,
    tgt.SERVICE_END_DATE = src.SERVICE_END_DATE,
    tgt.AUTHORIZED_QTY = src.AUTHORIZED_QTY,
    tgt.CONSUMED_QTY = src.CONSUMED_QTY,
    tgt.DENIED_QTY = src.DENIED_QTY,
    tgt.REQUESTED_QTY = src.REQUESTED_QTY,
    tgt.ALLOWED_AMT = src.ALLOWED_AMT,
    tgt.AUTHORIZED_AMT = src.AUTHORIZED_AMT,
    tgt.AUTHORIZED_PER_UNIT_AMT = src.AUTHORIZED_PER_UNIT_AMT,
    tgt.BALANCE_DUE_AMT = src.BALANCE_DUE_AMT,
    tgt.BILLED_AMT = src.BILLED_AMT,
    tgt.COINSURANCE_AMT = src.COINSURANCE_AMT,
    tgt.COPAY_AMT = src.COPAY_AMT,
    tgt.DEDUCTIBLE_APPLIED_AMT = src.DEDUCTIBLE_APPLIED_AMT,
    tgt.PAID_AMT = src.PAID_AMT,
    tgt.PATIENT_PAY_APPLIED_AMT = src.PATIENT_PAY_APPLIED_AMT,
    tgt.PAYABLE_AMT = src.PAYABLE_AMT,
    tgt.USUAL_AND_CUSTOMARY_AMT = src.USUAL_AND_CUSTOMARY_AMT

WHEN NOT MATCHED
THEN INSERT
    (
        FACT_CLAIM_AUTHORIZATION_DETAIL_KEY
        ,INSERT_DATETIME
        ,LAST_UPDATED_DATETIME
        ,DIM_CLAIM_AUTHORIZATION_DETAIL_KEY
        ,DIM_TPA_HIERARCHY_KEY
        ,DIM_DATA_SOURCE_KEY
        ,DIM_CLAIM_AUTHORIZATION_KEY
        ,DIM_MEMBER_KEY
        ,DIM_PLAN_KEY
        ,DIM_SUBMITTING_PROVIDER_KEY
        ,DIM_RENDERING_PROVIDER_KEY
        ,DIM_CLAIM_PROCEDURE_KEY
        ,DIM_SERVICE_BEGIN_DATE_KEY
        ,DIM_SERVICE_END_DATE_KEY
        ,AUTHORIZATION_NBR
        ,AUTHORIZATION_LINE_NBR
        ,SERVICE_BEGIN_DATE
        ,SERVICE_END_DATE
        ,AUTHORIZED_QTY
        ,CONSUMED_QTY
        ,DENIED_QTY
        ,REQUESTED_QTY
        ,ALLOWED_AMT
        ,AUTHORIZED_AMT
        ,AUTHORIZED_PER_UNIT_AMT
        ,BALANCE_DUE_AMT
        ,BILLED_AMT
        ,COINSURANCE_AMT
        ,COPAY_AMT
        ,DEDUCTIBLE_APPLIED_AMT
        ,PAID_AMT
        ,PATIENT_PAY_APPLIED_AMT
        ,PAYABLE_AMT
        ,USUAL_AND_CUSTOMARY_AMT
    )
VALUES
    (
        (SELECT IFNULL(MAX(FACT_CLAIM_AUTHORIZATION_DETAIL_KEY), 1000) FROM DIMDATA.FACT_CLAIM_AUTHORIZATION_DETAIL) + ROW_NUMBER() OVER (ORDER BY 1)
        ,CURRENT_TIMESTAMP()
        ,CURRENT_TIMESTAMP()
        ,src.DIM_CLAIM_AUTHORIZATION_DETAIL_KEY
        ,src.DIM_TPA_HIERARCHY_KEY
        ,src.DIM_DATA_SOURCE_KEY
        ,src.DIM_CLAIM_AUTHORIZATION_KEY
        ,src.DIM_MEMBER_KEY
        ,src.DIM_PLAN_KEY
        ,src.DIM_SUBMITTING_PROVIDER_KEY
        ,src.DIM_RENDERING_PROVIDER_KEY
        ,src.DIM_CLAIM_PROCEDURE_KEY
        ,src.DIM_SERVICE_BEGIN_DATE_KEY
        ,src.DIM_SERVICE_END_DATE_KEY
        ,src.AUTHORIZATION_NBR
        ,src.AUTHORIZATION_LINE_NBR
        ,src.SERVICE_BEGIN_DATE
        ,src.SERVICE_END_DATE
        ,src.AUTHORIZED_QTY
        ,src.CONSUMED_QTY
        ,src.DENIED_QTY
        ,src.REQUESTED_QTY
        ,src.ALLOWED_AMT
        ,src.AUTHORIZED_AMT
        ,src.AUTHORIZED_PER_UNIT_AMT
        ,src.BALANCE_DUE_AMT
        ,src.BILLED_AMT
        ,src.COINSURANCE_AMT
        ,src.COPAY_AMT
        ,src.DEDUCTIBLE_APPLIED_AMT
        ,src.PAID_AMT
        ,src.PATIENT_PAY_APPLIED_AMT
        ,src.PAYABLE_AMT
        ,src.USUAL_AND_CUSTOMARY_AMT
    )
;`;

// set delete command which will physically delete records from DIMDATA.FACT_CLAIM_AUTHORIZATION_DETAIL where the corresponding record of DIMDATA.DIM_CLAIM_AUTHORIZATION_DETAIL has been logically deleted
var sqlDeleteCommand =
`
DELETE FROM DIMDATA.FACT_CLAIM_AUTHORIZATION_DETAIL
WHERE FACT_CLAIM_AUTHORIZATION_DETAIL_KEY IN
(
    SELECT
    FACT_CLAIM_AUTHORIZATION_DETAIL.FACT_CLAIM_AUTHORIZATION_DETAIL_KEY
    FROM DIMDATA.FACT_CLAIM_AUTHORIZATION_DETAIL
    LEFT OUTER JOIN DIMDATA.DIM_CLAIM_AUTHORIZATION_DETAIL
            ON (DIM_CLAIM_AUTHORIZATION_DETAIL.DIM_CLAIM_AUTHORIZATION_DETAIL_KEY = FACT_CLAIM_AUTHORIZATION_DETAIL.DIM_CLAIM_AUTHORIZATION_DETAIL_KEY)
    WHERE DIM_CLAIM_AUTHORIZATION_DETAIL.DIM_CLAIM_AUTHORIZATION_DETAIL_KEY IS NULL
    OR DIM_CLAIM_AUTHORIZATION_DETAIL.IS_LOGICAL_DELETE_FLAG = 'TRUE'
)
;`;

var sqlLogCommand =
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9)
;`;

try 
{
    //Execute Merge Command
    var startTime = new Date().toISOString();
    var targetTableName = `DIMDATA.FACT_CLAIM_AUTHORIZATION_DETAIL`;
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    ({
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText()]
    });

    //Execute Delete Command
    var startTime = new Date().toISOString();
    var targetTableName = `DIMDATA.FACT_CLAIM_AUTHORIZATION_DETAIL`;
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    ({
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText()]
    });    
}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[targetTableName, "TABLE", startTime, endTime, result, sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt]
        }
    );        
    throw result;
}
return result;
$$
;