CREATE OR REPLACE PROCEDURE DIMDATA.SPU_LOAD_DIM_FINANCIAL_SERVICE_CATEGORY()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `DIMDATA.DIM_FINANCIAL_SERVICE_CATEGORY`;

// Create merge statement to be executed.
var sqlMergeCommand =
`
MERGE INTO DIMDATA.DIM_FINANCIAL_SERVICE_CATEGORY AS tgt
USING (
        SELECT DISTINCT
        FALSE AS IS_LOGICAL_DELETE_FLAG
       ,CONTROLLABLE_EXPENSE_CODE
       ,FINANCIAL_SERVICE_DECISION_STEP
       ,TO_VARCHAR(FINANCIAL_SERVICE_GROUP_CODE) AS FINANCIAL_SERVICE_GROUP_CODE
       ,FINANCIAL_SERVICE_GROUP_DESC
       ,TO_VARCHAR(FINANCIAL_SERVICE_SUBGRP_CODE) AS FINANCIAL_SERVICE_SUBGRP_CODE
       ,FINANCIAL_SERVICE_SUBGRP_DESC
       ,UNIT_MEASURE_CODE
       ,CLOSING_CATEGORY_DESC
        FROM STAGEDATA.DIM_FINANCIAL_SERVICE_CATEGORY_SELECT_VW
    MINUS
        SELECT DISTINCT
        IS_LOGICAL_DELETE_FLAG
       ,CONTROLLABLE_EXPENSE_CODE
       ,FINANCIAL_SERVICE_DECISION_STEP
       ,TO_VARCHAR(FINANCIAL_SERVICE_GROUP_CODE) AS FINANCIAL_SERVICE_GROUP_CODE
       ,FINANCIAL_SERVICE_GROUP_DESC
       ,TO_VARCHAR(FINANCIAL_SERVICE_SUBGRP_CODE) AS FINANCIAL_SERVICE_SUBGRP_CODE
       ,FINANCIAL_SERVICE_SUBGRP_DESC
       ,UNIT_MEASURE_CODE
       ,CLOSING_CATEGORY_DESC
        FROM DIMDATA.DIM_FINANCIAL_SERVICE_CATEGORY
    ) AS src
ON (tgt.FINANCIAL_SERVICE_SUBGRP_CODE = src.FINANCIAL_SERVICE_SUBGRP_CODE
AND tgt.FINANCIAL_SERVICE_DECISION_STEP = src.FINANCIAL_SERVICE_DECISION_STEP)

WHEN MATCHED

THEN UPDATE SET
    tgt.LAST_UPDATED_DATETIME=CURRENT_TIMESTAMP(),
    tgt.IS_LOGICAL_DELETE_FLAG = FALSE,
    tgt.CONTROLLABLE_EXPENSE_CODE = src.CONTROLLABLE_EXPENSE_CODE,
    tgt.FINANCIAL_SERVICE_DECISION_STEP = src.FINANCIAL_SERVICE_DECISION_STEP,
    tgt.FINANCIAL_SERVICE_GROUP_CODE = src.FINANCIAL_SERVICE_GROUP_CODE,
    tgt.FINANCIAL_SERVICE_GROUP_DESC = src.FINANCIAL_SERVICE_GROUP_DESC,
    tgt.FINANCIAL_SERVICE_SUBGRP_DESC = src.FINANCIAL_SERVICE_SUBGRP_DESC,
    tgt.UNIT_MEASURE_CODE = src.UNIT_MEASURE_CODE,
    tgt.CLOSING_CATEGORY_DESC = src.CLOSING_CATEGORY_DESC

WHEN NOT MATCHED

THEN INSERT 
    (
        DIM_FINANCIAL_SERVICE_CATEGORY_KEY
        ,INSERT_DATETIME
        ,LAST_UPDATED_DATETIME
        ,IS_LOGICAL_DELETE_FLAG
        ,CONTROLLABLE_EXPENSE_CODE
        ,FINANCIAL_SERVICE_DECISION_STEP
        ,FINANCIAL_SERVICE_GROUP_CODE
        ,FINANCIAL_SERVICE_GROUP_DESC
        ,FINANCIAL_SERVICE_SUBGRP_CODE
        ,FINANCIAL_SERVICE_SUBGRP_DESC
        ,UNIT_MEASURE_CODE
        ,CLOSING_CATEGORY_DESC
    )
    VALUES
    (
        (SELECT IFNULL(MAX(DIM_FINANCIAL_SERVICE_CATEGORY_KEY), 1000) FROM DIMDATA.DIM_FINANCIAL_SERVICE_CATEGORY) + ROW_NUMBER() OVER (ORDER BY 1)
        ,CURRENT_TIMESTAMP()
        ,CURRENT_TIMESTAMP()
        ,FALSE
        ,src.CONTROLLABLE_EXPENSE_CODE
        ,src.FINANCIAL_SERVICE_DECISION_STEP
        ,src.FINANCIAL_SERVICE_GROUP_CODE
        ,src.FINANCIAL_SERVICE_GROUP_DESC
        ,src.FINANCIAL_SERVICE_SUBGRP_CODE
        ,src.FINANCIAL_SERVICE_SUBGRP_DESC
        ,src.UNIT_MEASURE_CODE
        ,src.CLOSING_CATEGORY_DESC
    )
;`;

// set delete command which will update to is_logical_delete to true
// The > 999 is done to not update any of the static data, inserts start at 1000 from autoincrement
var sqlDeleteCommand =
`
UPDATE DIMDATA.DIM_FINANCIAL_SERVICE_CATEGORY
SET IS_LOGICAL_DELETE_FLAG = TRUE, LAST_UPDATED_DATETIME  = CURRENT_TIMESTAMP()
WHERE DIM_FINANCIAL_SERVICE_CATEGORY_KEY IN
(
    SELECT DIM_FINANCIAL_SERVICE_CATEGORY.DIM_FINANCIAL_SERVICE_CATEGORY_KEY
    FROM DIMDATA.DIM_FINANCIAL_SERVICE_CATEGORY
    LEFT OUTER JOIN STAGEDATA.DIM_FINANCIAL_SERVICE_CATEGORY_SELECT_VW
        ON (DIM_FINANCIAL_SERVICE_CATEGORY.FINANCIAL_SERVICE_SUBGRP_CODE = DIM_FINANCIAL_SERVICE_CATEGORY_SELECT_VW.FINANCIAL_SERVICE_SUBGRP_CODE)
    WHERE DIM_FINANCIAL_SERVICE_CATEGORY.IS_LOGICAL_DELETE_FLAG = FALSE
    AND DIM_FINANCIAL_SERVICE_CATEGORY.DIM_FINANCIAL_SERVICE_CATEGORY_KEY > 999
    AND DIM_FINANCIAL_SERVICE_CATEGORY_SELECT_VW.FINANCIAL_SERVICE_SUBGRP_CODE IS NULL
)
;`    

var sqlLogCommand =
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT, QUERY_ID)
VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10)
;`;

try 
{
    //Execute Merge Command
    var startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    ({
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
    });

    // You must run a seperate query to find records in the target that do not exist in the source and mark them as deleted
    //Execute DELETE Command
    var startTime = new Date().toISOString();
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    ({
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText(), sfStatement.getQueryId()]
    });
}

catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT, QUERY_ID)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10,:11);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[targetTableName, "TABLE", startTime, endTime, result, sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt, sfStatement.getQueryId()]
        }
    );        
    throw result;
}
return result;
$$
;