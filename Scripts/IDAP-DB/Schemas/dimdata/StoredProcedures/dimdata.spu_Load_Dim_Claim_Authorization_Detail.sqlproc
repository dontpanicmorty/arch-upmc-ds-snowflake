CREATE OR REPLACE PROCEDURE DIMDATA.SPU_LOAD_DIM_CLAIM_AUTHORIZATION_DETAIL()
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var targetTableName = `DIMDATA.DIM_CLAIM_AUTHORIZATION_DETAIL`;

var sqlTempTableCommand =
`
CREATE OR REPLACE TRANSIENT TABLE STAGEDATA.DIM_CLAIM_AUTHORIZATION_DETAIL
AS
SELECT * FROM STAGEDATA.DIM_CLAIM_AUTHORIZATION_DETAIL_SELECT_VW
;`;

// Create merge statement to be executed.
var sqlMergeCommand =
`
MERGE INTO DIMDATA.DIM_CLAIM_AUTHORIZATION_DETAIL AS tgt
USING (
        SELECT
        FALSE AS IS_LOGICAL_DELETE_FLAG
        ,TPA_CLIENT_ID
        ,TPA_ID
        ,TPA_DIV_ID
        ,DATA_SOURCE_NAME
        ,AUTHORIZATION_NBR
        ,AUTHORIZATION_LINE_NBR
        ,DETERMINATION_STATUS_DESC
        ,DETERMINATION_DATE
        ,TOOTH_ID
        ,TOOTH_ARCH
        ,TOOTH_QUADRANT
        FROM STAGEDATA.DIM_CLAIM_AUTHORIZATION_DETAIL
    MINUS
        SELECT
        IS_LOGICAL_DELETE_FLAG
        ,TPA_CLIENT_ID
        ,TPA_ID
        ,TPA_DIV_ID
        ,DATA_SOURCE_NAME
        ,AUTHORIZATION_NBR
        ,AUTHORIZATION_LINE_NBR
        ,DETERMINATION_STATUS_DESC
        ,DETERMINATION_DATE
        ,TOOTH_ID
        ,TOOTH_ARCH
        ,TOOTH_QUADRANT
        FROM DIMDATA.DIM_CLAIM_AUTHORIZATION_DETAIL
    ) AS src
ON (tgt.TPA_CLIENT_ID = src.TPA_CLIENT_ID
AND tgt.TPA_ID = src.TPA_ID
AND tgt.TPA_DIV_ID = src.TPA_DIV_ID
AND tgt.DATA_SOURCE_NAME = src.DATA_SOURCE_NAME
AND tgt.AUTHORIZATION_NBR=src.AUTHORIZATION_NBR
AND tgt.AUTHORIZATION_LINE_NBR = src.AUTHORIZATION_LINE_NBR)

WHEN MATCHED

THEN UPDATE SET
    tgt.LAST_UPDATED_DATETIME=CURRENT_TIMESTAMP(),
    tgt.IS_LOGICAL_DELETE_FLAG = FALSE,
    tgt.DETERMINATION_STATUS_DESC = src.DETERMINATION_STATUS_DESC,
    tgt.DETERMINATION_DATE = src.DETERMINATION_DATE,
    tgt.TOOTH_ID = src.TOOTH_ID,
    tgt.TOOTH_ARCH = src.TOOTH_ARCH,
    tgt.TOOTH_QUADRANT = src.TOOTH_QUADRANT

WHEN NOT MATCHED

THEN INSERT 
    (
        DIM_CLAIM_AUTHORIZATION_DETAIL_KEY
        ,INSERT_DATETIME
        ,LAST_UPDATED_DATETIME
        ,IS_LOGICAL_DELETE_FLAG
        ,TPA_CLIENT_ID
        ,TPA_ID
        ,TPA_DIV_ID
        ,DATA_SOURCE_NAME
        ,AUTHORIZATION_NBR
        ,AUTHORIZATION_LINE_NBR
        ,DETERMINATION_STATUS_DESC
        ,DETERMINATION_DATE
        ,TOOTH_ID
        ,TOOTH_ARCH
        ,TOOTH_QUADRANT
    )
VALUES 
    (
        (SELECT IFNULL(MAX(DIM_CLAIM_AUTHORIZATION_DETAIL_KEY), 1000) FROM DIMDATA.DIM_CLAIM_AUTHORIZATION_DETAIL) + ROW_NUMBER() OVER (ORDER BY 1)
        ,CURRENT_TIMESTAMP()
        ,CURRENT_TIMESTAMP()
        ,FALSE
        ,src.TPA_CLIENT_ID
        ,src.TPA_ID
        ,src.TPA_DIV_ID
        ,src.DATA_SOURCE_NAME
        ,src.AUTHORIZATION_NBR
        ,src.AUTHORIZATION_LINE_NBR
        ,src.DETERMINATION_STATUS_DESC
        ,src.DETERMINATION_DATE
        ,src.TOOTH_ID
        ,src.TOOTH_ARCH
        ,src.TOOTH_QUADRANT
    )
;`;

// set delete command which will update to is_logical_delete to true
// The >999 is done to not update any of the static data, inserts start at 1000 from autoincrement
var sqlDeleteCommand =
`
UPDATE DIMDATA.DIM_CLAIM_AUTHORIZATION_DETAIL
SET IS_LOGICAL_DELETE_FLAG = TRUE, LAST_UPDATED_DATETIME  = CURRENT_TIMESTAMP()
WHERE DIM_CLAIM_AUTHORIZATION_DETAIL_KEY IN
(
    SELECT DIM_CLAIM_AUTHORIZATION_DETAIL.DIM_CLAIM_AUTHORIZATION_DETAIL_KEY
    FROM DIMDATA.DIM_CLAIM_AUTHORIZATION_DETAIL
        LEFT OUTER JOIN 
            (SELECT TPA_CLIENT_ID, TPA_ID, TPA_DIV_ID, DATA_SOURCE_NAME, AUTHORIZATION_NBR, AUTHORIZATION_LINE_NBR
            FROM STAGEDATA.DIM_CLAIM_AUTHORIZATION_DETAIL
            ) STAGE_DATA
        ON (STAGE_DATA.TPA_CLIENT_ID = DIM_CLAIM_AUTHORIZATION_DETAIL.TPA_CLIENT_ID
        AND STAGE_DATA.TPA_ID = DIM_CLAIM_AUTHORIZATION_DETAIL.TPA_ID
        AND STAGE_DATA.TPA_DIV_ID = DIM_CLAIM_AUTHORIZATION_DETAIL.TPA_DIV_ID
        AND STAGE_DATA.DATA_SOURCE_NAME = DIM_CLAIM_AUTHORIZATION_DETAIL.DATA_SOURCE_NAME
        AND STAGE_DATA.AUTHORIZATION_NBR = DIM_CLAIM_AUTHORIZATION_DETAIL.AUTHORIZATION_NBR
        AND STAGE_DATA.AUTHORIZATION_LINE_NBR = DIM_CLAIM_AUTHORIZATION_DETAIL.AUTHORIZATION_LINE_NBR)
    WHERE STAGE_DATA.AUTHORIZATION_NBR IS NULL
    AND DIM_CLAIM_AUTHORIZATION_DETAIL.IS_LOGICAL_DELETE_FLAG = FALSE
    AND DIM_CLAIM_AUTHORIZATION_DETAIL.DIM_CLAIM_AUTHORIZATION_DETAIL_KEY > 999
)
;`;

var sqlLogCommand =
`INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
(NAME, TYPE, START_TIME, END_TIME, INSERT_COUNT, UPDATE_COUNT, DELETE_COUNT, RESULT_TEXT, SQL_STATEMENT)
VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9)
;`;

try 
{
    //Stage source data to temp table to be reused later.
    var startTime = new Date().toISOString();
    var targetTableName = `STAGEDATA.DIM_CLAIM_AUTHORIZATION_DETAIL`;
    var sfStatement = snowflake.createStatement({sqlText: sqlTempTableCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    ({
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText()]
    });

    //Execute Merge Command
    var startTime = new Date().toISOString();
    var targetTableName = `DIMDATA.DIM_CLAIM_AUTHORIZATION_DETAIL`;    
    var sfStatement = snowflake.createStatement({sqlText: sqlMergeCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    ({
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText()]
    });

    // You must run a seperate query to find records in the target that do not exist in the source and mark them as deleted
    //Execute DELETE Command
    startTime = new Date().toISOString();
    var targetTableName = `DIMDATA.DIM_CLAIM_AUTHORIZATION_DETAIL`;    
    var sfStatement = snowflake.createStatement({sqlText: sqlDeleteCommand});
    sfStatement.execute();
    var endTime = new Date().toISOString();
    var result = "Succeeded";

    //Log results to table
    snowflake.execute
    ({
        sqlText: sqlLogCommand,
        binds: [targetTableName, "TABLE", startTime, endTime, sfStatement.getNumRowsInserted(), sfStatement.getNumRowsUpdated(), sfStatement.getNumRowsDeleted(), result, sfStatement.getSqlText()]
    });
}
catch (err)
{
    var result = "Failed";
    var endTime = new Date().toISOString();

    //Log results to table
    var sqlLogCommand = `INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT, ERROR_CODE, ERROR_STATE, ERROR_MESSAGE, ERROR_STACK_TRACE_TEXT)
        VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6,:7,:8,:9,:10);`;

    snowflake.execute
    (
        {
        sqlText: sqlLogCommand,
        binds:[targetTableName, "TABLE", startTime, endTime, result, sfStatement.getSqlText(), err.code, err.state, err.message, err.stackTraceTxt]
        }
    );        
    throw result;
}
return result;
$$
;