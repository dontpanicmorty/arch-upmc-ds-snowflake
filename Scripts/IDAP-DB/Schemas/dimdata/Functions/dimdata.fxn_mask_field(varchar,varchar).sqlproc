-- Mask String
CREATE OR REPLACE FUNCTION DIMDATA.FXN_MASK_FIELD (S VARCHAR, MASK_IND VARCHAR)
RETURNS STRING
RETURNS NULL ON NULL INPUT
AS
$$
CASE 
    WHEN NOT (MASK_IND = 'Y' AND IS_ROLE_IN_SESSION('IDAP_R_ROLE')) THEN S
    WHEN LENGTH(S) = 1 THEN '*'
    WHEN LENGTH(S) = 2 THEN '**'
    ELSE '*****'
END
$$;

