/**
Truncates and loads the RAWDATA.DWOAO_PROVIDERS table from MC400 Database. 
*/
!set variable_substitution=true;

CREATE OR REPLACE PROCEDURE RAWDATA.SPU_LOAD_CMS_RAWDATA_DWOAO_PROVIDERS()
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$

let procName = Object.keys(this).find(a => a.startsWith('SPU'));
let startTime = new Date();
let sqlText, resultSet;



try {
  sqlText = `INSERT OVERWRITE INTO RAWDATA.DWOAO_PROVIDERS (ADDRESS1,ADDRESS2,BOARDCERTIFIED,CITY,CLIANBR,CONTACT,DATEOFBIRTH,DEANBR,DEGREE,EMAILADDRESS,ESPDTNBR,FAXNBR,FEDPROVIDERID,FIRSTNAME,GENDER,LANGUAGE1,LANGUAGE2,LANGUAGE3,LANGUAGE4,MEDICARENBR,MINAME,
NAME,NATIONALPROVIDERNBR,PHONEEXTENSION,PHONENBR,PRIMARYPREFDELIVERYMETHOD,PRIMARYSPECIALTY,PROVIDERLANGUAGECODE,PROVIDERLASTNAME,PROVIDERNAME,PROVIDERNBR,
SECONDARYPREFDELIVERYMETH,SECONDARYSPECIALTY,SSN,STATE,STATELICENSE,STATEMEDICAIDID,TITLE,ZIPCODE,ACTUALPRACTICECOUNT,ALTERNATEPROVIDERNO,ASSIGNEDMEMBERLIMIT,ASSIGNMENTPRIORITY,
CASSCERTIFIEDADDRESS,COVERAGEPROVIDER1,COVERAGEPROVIDER2,COVERAGEPROVIDER3,LASTASSIGNEDDATE,LASTASSIGNEDTIME,MEDICAREPROVIDERFLAG,PHYSICIANGROUPFLAG,PROVIDERADDDATE,
PROVIDERCHANGEDATE,PROVIDERCROSSREFERENCE,BILLINGPROVIDERCLAIMTYPE,PAYFORPERFORMANCEIND,TPACLIENT,TPAIDOFCLIENT,TPADIVISION,CHGUSER,CHGORIG,CHGLAST)

SELECT TRIM(ADDRESS1),NULLIF(TRIM(ADDRESS2), ''),TRIM(BOARDCERTIFIED),NULLIF(TRIM(CITY),''),NULLIF(TRIM(CLIANBR), ''),NULLIF(TRIM(CONTACT), ''),TRIM(DATEOFBIRTH),NULLIF(TRIM(DEANBR), ''),NULLIF(TRIM(DEGREE), ''),NULLIF(TRIM(EMAILADDRESS), ''),
NULLIF(TRIM(ESPDTNBR), ''),NULLIF(TRIM(FAXNBR), ''),NULLIF(TRIM(FEDPROVIDERID), ''),NULLIF(TRIM(FIRSTNAME), ''),NULLIF(TRIM(GENDER), ''),NULLIF(TRIM(LANGUAGE1), ''),NULLIF(TRIM(LANGUAGE2), ''),NULLIF(TRIM(LANGUAGE3), ''),
NULLIF(TRIM(LANGUAGE4), ''),NULLIF(TRIM(MEDICARENBR), ''),NULLIF(TRIM(MINAME), ''),TRIM(NAME),NULLIF(TRIM(NATIONALPROVIDERNBR), ''),NULLIF(TRIM(PHONEEXTENSION), ''),NULLIF(TRIM(PHONENBR), ''),TRIM(PRIMARYPREFDELIVERYMETHOD),
TRIM(PRIMARYSPECIALTY),NULLIF(TRIM(PROVIDERLANGUAGECODE), ''),NULLIF(TRIM(PROVIDERLASTNAME), ''),NULLIF(TRIM(PROVIDERNAME), ''),TRIM(PROVIDERNBR),NULLIF(TRIM(SECONDARYPREFDELIVERYMETH), ''),NULLIF(TRIM(SECONDARYSPECIALTY), ''),
NULLIF(TRIM(SSN), ''),NULLIF(TRIM(STATE), ''),NULLIF(TRIM(STATELICENSE), ''),NULLIF(TRIM(STATEMEDICAIDID), ''),NULLIF(TRIM(TITLE), ''),NULLIF(TRIM(ZIPCODE),''),TRIM(ACTUALPRACTICECOUNT),NULLIF(TRIM(ALTERNATEPROVIDERNO), ''),TRIM(ASSIGNEDMEMBERLIMIT),
TRIM(ASSIGNMENTPRIORITY),NULLIF(TRIM(CASSCERTIFIEDADDRESS), ''),NULLIF(TRIM(COVERAGEPROVIDER1), ''),NULLIF(TRIM(COVERAGEPROVIDER2), ''),NULLIF(TRIM(COVERAGEPROVIDER3), ''),LASTASSIGNEDDATE,LASTASSIGNEDTIME,
TRIM(MEDICAREPROVIDERFLAG),NULLIF(TRIM(PHYSICIANGROUPFLAG), ''),PROVIDERADDDATE,PROVIDERCHANGEDATE,NULLIF(TRIM(PROVIDERCROSSREFERENCE), ''),NULLIF(TRIM(BILLINGPROVIDERCLAIMTYPE), ''),NULLIF(TRIM(PAYFORPERFORMANCEIND), ''),TPACLIENT,TPAIDOFCLIENT,TPADIVISION,CHGUSER,CHGORIG,CHGLAST
FROM  &{MC400}.DWOAO.PROVIDERS`;

  resultSet = snowflake.execute({sqlText});
  var result = "Succeeded";

  // Logging success
  let endTime = new Date();
  sqlText = `INSERT INTO LOGDATA.EXTRACT_HISTORY (
      NAME
      ,TYPE
      ,START_TIME
      ,END_TIME
      ,RESULT_TEXT
      ,SQL_STATEMENT
  ) VALUES (
    '${procName}',
    'PROCEDURE',
    '${startTime.toISOString()}',
    '${endTime.toISOString()}',
    'Complete',
    '${sqlText.replace(/'/g, "''")}'
  )`;
  snowflake.execute({sqlText});
}
// Error logging
catch (err) {
  sqlText = (sqlText || '(no SQL run yet)').replace(/'/g, "''");
  let code = err.code || err.name;
  let state = err.state || '(JavaScript error, not provided)'
  let message = (err.message || '(JavaScript error, not provided)').replace(/'/g, "''")
  let stack = (err.stackTraceTxt || err.stack).replace(/'/g, "''");
  var result = "Failure";
  let endTime = new Date();
  sqlText = `INSERT INTO LOGDATA.EXTRACT_HISTORY (
      NAME
      ,TYPE
      ,START_TIME
      ,END_TIME
      ,SQL_STATEMENT
      ,ERROR_CODE
      ,ERROR_STATE
      ,ERROR_MESSAGE
      ,ERROR_STACK_TRACE_TEXT
  ) VALUES (
    '${procName}',
    'PROCEDURE',
    '${startTime.toISOString()}',
    '${endTime.toISOString()}',
    '${sqlText}',
    '${code}',
    '${state}',
    '${message}',
    '${stack}'
  )`;
  snowflake.execute({sqlText});
  return result;
}
return result;
$$;

!set variable_substitution=false;