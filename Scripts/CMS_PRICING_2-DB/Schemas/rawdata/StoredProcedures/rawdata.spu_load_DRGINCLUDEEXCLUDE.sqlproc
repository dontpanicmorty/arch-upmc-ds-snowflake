/**
Truncates and loads the RAWDATA.DWOAO_DRGINCLUDEEXCLUDE table from MC400 Database. 
*/
!set variable_substitution=true;

CREATE OR REPLACE PROCEDURE RAWDATA.SPU_LOAD_CMS_RAWDATA_DWOAO_DRGINCLUDEEXCLUDE()
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$

let procName = Object.keys(this).find(a => a.startsWith('SPU'));
let startTime = new Date();
let sqlText, resultSet;



try {
  sqlText = `INSERT OVERWRITE INTO RAWDATA.DWOAO_DRGINCLUDEEXCLUDE (PRIORITY,AGERANGESELEXCLFLAG,BILLTYPE,BILLTYPESELEXCLFLAG,
CONTRACTEFFECTIVEDATE,CONTRACTTERMDATE,DESCRIPTION,DIAGNOSISTYPE1,DIAGTYPESELEXCLFLAG,DRGCODE,DRGCODESELEXCLFLAG,ENCNREASONSELEXCLFLAG,ENCOUNTERREASON,
GENDERRANGESELEXCLFLAG,IPACODE,IPACODESELEXCLFLAG,MEMBERFROMAGE,MEMBERSEX,MEMBERTOAGE,PARFLAGSELEXCLFLAG,PLANTYPE,PLANTYPESELEXCLFLAG,PROCEDURETYPE1,
PROCTYPESELEXCLFLAG,PROVIDERNO,PROVIDERPARSTATUS,PROVIDERSELEXCLFLAG,PROVIDERTYPE4A,PROVTYPESELEXCLFLAG,SERVICETYPE,SERVICETYPESELEXCLFLAG,SURGICALTYPE,
SURGICALTYPESELEXCLFLAG,POA,POASELECT,CHGLAST,CHGORIG,CHGUSER,TPACLIENT,TPADIVISION,TPAIDOFCLIENT,GPG_CODE,GPG_CODE_SELECT_FLAG,IPG_CODE,IPG_CODE_SELECT_FLAG)

SELECT PRIORITY,NULLIF(AGERANGESELEXCLFLAG,''),NULLIF(BILLTYPE,''),NULLIF(BILLTYPESELEXCLFLAG,''),CONTRACTEFFECTIVEDATE,CONTRACTTERMDATE,NULLIF(TRIM(DESCRIPTION),''),NULLIF(DIAGNOSISTYPE1,''),
NULLIF(DIAGTYPESELEXCLFLAG,''),NULLIF(DRGCODE,''),NULLIF(DRGCODESELEXCLFLAG,''),NULLIF(ENCNREASONSELEXCLFLAG,''),NULLIF(ENCOUNTERREASON,''),NULLIF(GENDERRANGESELEXCLFLAG,''),
NULLIF(IPACODE,''),NULLIF(IPACODESELEXCLFLAG,''),MEMBERFROMAGE,NULLIF(MEMBERSEX,''),MEMBERTOAGE,NULLIF(PARFLAGSELEXCLFLAG,''),NULLIF(PLANTYPE,''),NULLIF(PLANTYPESELEXCLFLAG,''),
NULLIF(PROCEDURETYPE1,''),NULLIF(PROCTYPESELEXCLFLAG,''),NULLIF(PROVIDERNO,''),NULLIF(PROVIDERPARSTATUS,''),NULLIF(PROVIDERSELEXCLFLAG,''),NULLIF(PROVIDERTYPE4A,''),
NULLIF(PROVTYPESELEXCLFLAG,''),NULLIF(SERVICETYPE,''),NULLIF(SERVICETYPESELEXCLFLAG,''),NULLIF(SURGICALTYPE,''),NULLIF(SURGICALTYPESELEXCLFLAG,''),NULLIF(POA,''),NULLIF(POASELECT,''),
CHGLAST,CHGORIG,NULLIF(CHGUSER,''),TPACLIENT,TPADIVISION,TPAIDOFCLIENT,NULLIF(GPG_CODE,''),NULLIF(GPG_CODE_SELECT_FLAG,''),NULLIF(IPG_CODE,''),NULLIF(IPG_CODE_SELECT_FLAG,'')
FROM &{MC400}.DWOAO.DRGINCLUDEEXCLUDE`;

  resultSet = snowflake.execute({sqlText});
  var result = "Succeeded";

  // Logging success
  let endTime = new Date();
  sqlText = `INSERT INTO LOGDATA.EXTRACT_HISTORY (
      NAME
      ,TYPE
      ,START_TIME
      ,END_TIME
      ,RESULT_TEXT
      ,SQL_STATEMENT
  ) VALUES (
    '${procName}',
    'PROCEDURE',
    '${startTime.toISOString()}',
    '${endTime.toISOString()}',
    'Complete',
    '${sqlText.replace(/'/g, "''")}'
  )`;
  snowflake.execute({sqlText});
}
// Error logging
catch (err) {
  sqlText = (sqlText || '(no SQL run yet)').replace(/'/g, "''");
  let code = err.code || err.name;
  let state = err.state || '(JavaScript error, not provided)'
  let message = (err.message || '(JavaScript error, not provided)').replace(/'/g, "''")
  let stack = (err.stackTraceTxt || err.stack).replace(/'/g, "''");
  var result = "Failure";
  let endTime = new Date();
  sqlText = `INSERT INTO LOGDATA.EXTRACT_HISTORY (
      NAME
      ,TYPE
      ,START_TIME
      ,END_TIME
      ,SQL_STATEMENT
      ,ERROR_CODE
      ,ERROR_STATE
      ,ERROR_MESSAGE
      ,ERROR_STACK_TRACE_TEXT
  ) VALUES (
    '${procName}',
    'PROCEDURE',
    '${startTime.toISOString()}',
    '${endTime.toISOString()}',
    '${sqlText}',
    '${code}',
    '${state}',
    '${message}',
    '${stack}'
  )`;
  snowflake.execute({sqlText});
  return result;
}
return result;
$$;

!set variable_substitution=false;