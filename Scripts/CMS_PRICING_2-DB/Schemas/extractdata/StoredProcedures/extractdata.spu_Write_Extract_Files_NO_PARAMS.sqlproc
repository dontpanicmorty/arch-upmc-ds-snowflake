CREATE OR REPLACE PROCEDURE EXTRACTDATA.SPU_WRITE_EXTRACT_FILES ()
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$
// Proxy empty arguments to the full-parameter version
let sqlText = `CALL EXTRACTDATA.SPU_WRITE_EXTRACT_FILES('', '');`;
let resultSet = snowflake.execute({sqlText});

// Proxy the result back
resultSet.next();
return resultSet.getColumnValue(1);
$$;