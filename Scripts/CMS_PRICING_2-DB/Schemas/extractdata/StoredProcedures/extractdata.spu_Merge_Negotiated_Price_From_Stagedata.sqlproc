CREATE OR REPLACE PROCEDURE EXTRACTDATA.SPU_MERGE_NEGOTIATED_PRICE_FROM_STAGEDATA ()
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$

let procName = Object.keys(this).find(a => a.startsWith('SPU'));
let startTime = new Date();
let resultSet, result;

/* Create MERGE statement to be run */
let sqlText = `MERGE INTO EXTRACTDATA.NEGOTIATED_PRICE AS tgt
USING (
  SELECT DISTINCT NEGOTIATED_TYPE_NAME, NEGOTIATED_RATE_AMT, EXPIRATION_DATE, PLACE_OF_SERVICE_CODES, BILLING_CLASS_NAME, BILLING_CODE_MODIFIERS, OUTPATIENT_PROCEDURE_CODE, OUTPATIENT_MODIFIER, OUTPATIENT_PRICE
  FROM STAGEDATA.NEGOTIATED_PRICE_INTERNAL_HOLD
) AS src
ON (
  tgt.NEGOTIATED_TYPE_NAME = src.NEGOTIATED_TYPE_NAME
  AND tgt.NEGOTIATED_RATE_AMT = src.NEGOTIATED_RATE_AMT
  AND ((tgt.EXPIRATION_DATE = src.EXPIRATION_DATE) OR
    (tgt.EXPIRATION_DATE IS NULL AND src.EXPIRATION_DATE IS NULL))
  AND tgt.PLACE_OF_SERVICE_CODES = src.PLACE_OF_SERVICE_CODES
  AND tgt.BILLING_CLASS_NAME = src.BILLING_CLASS_NAME
  AND tgt.BILLING_CODE_MODIFIERS = src.BILLING_CODE_MODIFIERS
  AND tgt.OUTPATIENT_PROCEDURE_CODE = src.OUTPATIENT_PROCEDURE_CODE
  AND tgt.OUTPATIENT_MODIFIER = src.OUTPATIENT_MODIFIER
  AND tgt.OUTPATIENT_PRICE = src.OUTPATIENT_PRICE
)

WHEN NOT MATCHED THEN
INSERT 
    (NEGOTIATED_TYPE_NAME, NEGOTIATED_RATE_AMT, EXPIRATION_DATE, PLACE_OF_SERVICE_CODES, BILLING_CLASS_NAME, BILLING_CODE_MODIFIERS, OUTPATIENT_PROCEDURE_CODE, OUTPATIENT_MODIFIER, OUTPATIENT_PRICE)
VALUES
    (src.NEGOTIATED_TYPE_NAME, src.NEGOTIATED_RATE_AMT, src.EXPIRATION_DATE, src.PLACE_OF_SERVICE_CODES, src.BILLING_CLASS_NAME, src.BILLING_CODE_MODIFIERS, src.OUTPATIENT_PROCEDURE_CODE, src.OUTPATIENT_MODIFIER, src.OUTPATIENT_PRICE)
;`;

try 
{
    /*Execute INSERT OVERRIDE Command */
    const sfStatement = snowflake.createStatement({sqlText});
    resultSet = sfStatement.execute();    
    resultSet.next();

    result = 'Successful';
    
    const endTime = new Date();
    sqlText = `INSERT INTO LOGDATA.EXTRACT_HISTORY (
        NAME
        ,TYPE
        ,START_TIME
        ,END_TIME
        ,INSERT_COUNT
        ,RESULT_TEXT
        ,SQL_STATEMENT
    ) VALUES (
      '${procName}',
      'PROCEDURE',
      '${startTime.toISOString()}',
      '${endTime.toISOString()}',
      '${resultSet.getColumnValueAsString("number of rows inserted")}',
      '${result}',
      '${sqlText}'
    )`;
    snowflake.execute({sqlText});
}
catch (err)
{
    sqlText = (sqlText || '(no SQL run yet)').replace(/'/g, "''");
    let code = err.code || err.name;
    let state = err.state || '(JavaScript error, not provided)'
    let message = (err.message || '(JavaScript error, not provided)').replace(/'/g, "''")
    let stack = (err.stackTraceTxt || err.stack).replace(/'/g, "''");
    
    result = 'Failed';
    let endTime = new Date();
    sqlText = `INSERT INTO LOGDATA.EXTRACT_HISTORY (
        NAME
        ,TYPE
        ,START_TIME
        ,END_TIME
        ,RESULT_TEXT
        ,SQL_STATEMENT
        ,ERROR_CODE
        ,ERROR_STATE
        ,ERROR_MESSAGE
        ,ERROR_STACK_TRACE_TEXT
    ) VALUES (
      '${procName}',
      'PROCEDURE',
      '${startTime.toISOString()}',
      '${endTime.toISOString()}',
      '${result}',
      '${sqlText}',
      '${code}',
      '${state}',
      '${message}',
      '${stack}'
    )`;
    snowflake.execute({sqlText});
    throw err;
}
return result;

$$;
