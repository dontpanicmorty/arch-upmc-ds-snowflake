CREATE OR REPLACE PROCEDURE LOGDATA.SPU_VALIDATE_DATA_FOREIGN_KEY_CHECK_BULK(JOB_ID VARCHAR, DB VARCHAR, SCHEMA VARCHAR)
RETURNS VARCHAR NOT NULL
LANGUAGE JAVASCRIPT
EXECUTE AS OWNER
AS
$$

/*
JOB_ID must be generated first by the top level caller so we can tie together the outputs.

Takes the input schema and generates a list of tables that need validated.
TODO: how do we exclude certain stuff (or things w/o any FK)
*/

// get procedure start time and set variables
var startTime = new Date().toISOString();
var procedureName = Object.keys(this)[0];
var minusQuery = 'not set';
var fkName = 'not set';

//get the foreign keys we need to check first by using SHOW IMPORTED KEYS
sqlCommand = `SHOW IMPORTED KEYS IN SCHEMA ${DB}.${SCHEMA}`;
var sfStatement = snowflake.createStatement({sqlText: sqlCommand});
var resultSet = sfStatement.execute();

//grab what we need from the SHOW results and turn it into a query
sqlCommand = `SELECT "fk_name" as FK_NAME
, "fk_table_name" as TABLE_NAME 
,'SELECT ' || "fk_table_name" ||'.' || "fk_column_name" || ' FROM ' || "fk_schema_name" ||'.' || "fk_table_name" || ' MINUS SELECT ' 
    || "pk_table_name" || '.' || "pk_column_name" || ' FROM ' || "pk_schema_name" ||'.' || "pk_table_name" AS MINUS_QUERY
FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))`;
var sfStatement = snowflake.createStatement({sqlText: sqlCommand});
var resultSet = sfStatement.execute();
//need a loop here because some tables have multiple foreign keys
while(resultSet.next()){
    minusQuery = resultSet.getColumnValue('MINUS_QUERY');
    fkName = resultSet.getColumnValue('FK_NAME');
    tableName = resultSet.getColumnValue('TABLE_NAME');

    //build the query to check for orphan keys
    sqlCommand2 = `SELECT COUNT(*) AS RESULT_COUNT FROM (${minusQuery})`;

    var sfStatement2 = snowflake.createStatement({sqlText: sqlCommand2});
    var resultSet2 = sfStatement2.execute();
    resultSet2.next(); 
    var resultCount = resultSet2.getColumnValue('RESULT_COUNT')
    
    //insert the results to the logdata table for future reference
    var sqlCountInsert = `INSERT INTO LOGDATA.DATA_VALIDATION_RESULT 
        (JOB_ID, TABLE_NAME, VALIDATION_PROCEDURE_NAME, VALIDATION_RESULT_NBR, EXPECTED_RESULT_NBR, VALIDATION_DESC) 
        VALUES (${JOB_ID},'${tableName}','${procedureName}', ${resultCount}, 0, '${fkName}')`;
    snowflake.execute({sqlText: sqlCountInsert});
};

//see if we found any orphan keys this run
sqlCommand = `SELECT SUM(VALIDATION_RESULT_NBR) - SUM(EXPECTED_RESULT_NBR) AS ORPHAN_KEY_CNT FROM LOGDATA.DATA_VALIDATION_RESULT 
WHERE JOB_ID = '${JOB_ID}' AND VALIDATION_PROCEDURE_NAME = '${procedureName}'`;
var sfStatement = snowflake.createStatement({sqlText: sqlCommand});
var resultSet = sfStatement.execute();
resultSet.next();
resultCount = resultSet.getColumnValue('ORPHAN_KEY_CNT');

if(resultCount === 0){
    var result = `PASS: All validation checks successed`
}
else {
    var result = `FAIL: Validation failed because of orphan keys. 
    SELECT * FROM LOGDATA.DATA_VALIDATION_RESULT WHERE JOB_ID = '${JOB_ID}' AND VALIDATION_RESULT_NBR <> EXPECTED_RESULT_NBR`;
    throw result;
};

var endTime = new Date().toISOString();

//log results to table
var sqlLogCommand = `
    INSERT INTO LOGDATA.TABLE_LOAD_HISTORY 
        (NAME, TYPE, START_TIME, END_TIME, RESULT_TEXT, SQL_STATEMENT)
    VALUES (:1,:2,:3::timestamp_ltz,:4::timestamp_ltz,:5,:6);`;
    
snowflake.execute
(
    {sqlText: sqlLogCommand, binds: 
        [
        procedureName
        ,"Procedure"
        ,startTime
        ,endTime
        ,result
        ,procedureName
        ]
    }
); 
return result;
$$
;